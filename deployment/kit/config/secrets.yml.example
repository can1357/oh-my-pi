# Secret redaction entries — copy to ~/.omp/agent/secrets.yml (global)
# or <repo>/.omp/secrets.yml (project; overrides global entries).
# Requires: secrets.enabled: true in config.yml
#
# These values are replaced with reversible placeholders before any text
# leaves the process toward an LLM provider. See docs/secrets.md upstream.

# Obfuscate a specific API key (default mode; reversible)
- type: plain
  content: sk-proj-abc123def456
  friendlyName: Internal API key

# Obfuscate anything shaped like an AWS access key
- type: regex
  content: "AKIA[0-9A-Z]{16}"

# One-way replace for connection strings
- type: regex
  content: "postgres://[^\\s]+"
  mode: replace
  replacement: "postgres://***"
