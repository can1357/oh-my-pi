# omp provider credentials template — copy to ~/.omp/agent/.env
#
# PERMISSIONS MATTER: chmod 700 ~/.omp/agent && chmod 600 ~/.omp/agent/.env
# NEVER commit this file or copy it into a repository.
#
# omp loads env values from (first non-empty wins):
#   process env -> <repo>/.env -> ~/.omp/agent/.env -> ~/.omp/.env -> ~/.env
#
# Only set the variable(s) for the provider you actually use.
# Full table: docs/environment-variables.md upstream.

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- OpenAI --------------------------------------------------------------
# OPENAI_API_KEY=sk-REPLACE_ME

# --- Google Gemini -------------------------------------------------------
# GEMINI_API_KEY=REPLACE_ME

# --- xAI / OpenRouter / DeepSeek -----------------------------------------
# XAI_API_KEY=xai-REPLACE_ME
# OPENROUTER_API_KEY=sk-or-REPLACE_ME
# DEEPSEEK_API_KEY=REPLACE_ME

# --- Org auth-broker (if deployed; keys then live on the broker host) ----
# OMP_AUTH_BROKER_URL=https://broker.internal.example.com:8765
# OMP_AUTH_BROKER_TOKEN=REPLACE_ME

# --- Local inference (Ollama/LM Studio/llama.cpp/vLLM): no key needed ----
