{
  "schema_version": 1,
  "cases": [
    {
      "id": "google.request.schema-normalization.v1",
      "input": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          },
          "mode": {
            "enum": [
              "fast",
              "safe"
            ]
          },
          "empty": {
            "type": "object"
          }
        },
        "required": [
          "answer"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "nullable": true
          },
          "mode": {
            "enum": [
              "fast",
              "safe"
            ],
            "type": "string"
          },
          "empty": {
            "type": "object",
            "properties": {}
          }
        },
        "required": [
          "answer"
        ]
      },
      "unsupported": []
    },
    {
      "id": "google.request.cache-resource.v1",
      "input": {
        "google/cached_content": "cachedContents/oracle"
      },
      "output": {
        "cachedContent": "cachedContents/oracle"
      },
      "errors": [
        {
          "input": {
            "google/cached_content": "  "
          },
          "kind": "provider",
          "detail": "google/cached_content must not be blank"
        },
        {
          "input": {
            "google/cached_content": 17
          },
          "kind": "provider",
          "detail": "google/cached_content must be a string resource name"
        },
        {
          "input": {
            "google/cached_content": "cachedContents/oracle",
            "request_root": {
              "systemInstruction": {
                "parts": []
              }
            }
          },
          "kind": "provider",
          "detail": "google/cached_content cannot be combined with request-level systemInstruction"
        },
        {
          "input": {
            "google/cached_content": "cachedContents/oracle",
            "request_root": {
              "tools": []
            }
          },
          "kind": "provider",
          "detail": "google/cached_content cannot be combined with request-level tools"
        }
      ]
    },
    {
      "id": "google.request.provider-options.v1",
      "input": {
        "google/safety_settings": [
          {
            "category": "HARM_CATEGORY_HARASSMENT",
