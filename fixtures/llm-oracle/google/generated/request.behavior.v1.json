        "generationConfig": {
          "responseModalities": [
            "TEXT"
          ]
        },
        "tools": [
          {
            "googleSearch": {}
          },
          {
            "codeExecution": {}
          }
        ]
      },
      "errors": [
        {
          "option": "google/safety_settings",
          "invalid": "not-array",
          "kind": "provider",
          "detail": "google/safety_settings must be an array"
        },
        {
          "option": "google/response_modalities",
          "invalid": [
            "TEXT",
            1
          ],
          "kind": "provider",
          "detail": "google/response_modalities must contain only strings"
        },
        {
          "option": "google/google_search",
          "invalid": "true",
          "kind": "provider",
          "detail": "google/google_search must be a boolean"
        }
      ]
    },
    {
