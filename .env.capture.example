# Capture-to-agent workflow configuration (see docs/capture-to-agent.md).
# Copy the values you need into your environment or an omp .env file.
# Never commit real tokens.

CAPTURE_ENABLED=true
# CAPTURE_DATA_DIR=~/.ompk/agent/capture
CAPTURE_ASSET_RETENTION_DAYS=14
CAPTURE_MAX_UPLOAD_MB=20
CAPTURE_DEFAULT_AGENT_ROLE=task
CAPTURE_DEFAULT_RUNNER_ID=
CAPTURE_GLOBAL_SHORTCUT=Ctrl+Shift+Space
# Require "Authorization: Bearer <token>" on capture endpoints:
CAPTURE_GATEWAY_TOKEN=
# Headless capture sessions REJECT side-effecting tools by default; opt in to fully
# autonomous runs ONLY when TELEGRAM_ALLOWED_CHAT_IDS is tightly scoped:
CAPTURE_AUTO_APPROVE=false

TELEGRAM_CAPTURE_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Secret echoed back by Telegram in X-Telegram-Bot-Api-Secret-Token (webhook mode):
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat ids allowed to control the agent (empty = deny all):
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional additional user filter:
TELEGRAM_ALLOWED_USER_IDS=
# Chat used when a task does not name one:
TELEGRAM_DEFAULT_CHAT_ID=
# Poll getUpdates instead of requiring a public webhook (recommended):
TELEGRAM_LONG_POLL=
# Ignore non-reply text as follow-ups (only replies to bot messages drive the agent):
TELEGRAM_REQUIRE_REPLY=true
