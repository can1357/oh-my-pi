{
 "cases": [
  {"name":"create file","files":{},"args":{"path":"add.txt","edits":[{"op":"create","diff":"ab\ncd"}]},"expect":{"files":{"add.txt":"ab\ncd\n"}}},
  {"name":"create with allowCreateOverwrite replaces an existing file (JSON patch contract)","files":{"exists.txt":"original\n"},"args":{"path":"exists.txt","edits":[{"op":"create","diff":"replacement\n"}]},"expect":{"files":{"exists.txt":"replacement\n"}}},
  {"name":"delete file","files":{"del.txt":"x"},"args":{"path":"del.txt","edits":[{"op":"delete"}]},"expect":{"deleted":["del.txt"]}},
  {"name":"update file","files":{"update.txt":"foo\nbar\n"},"args":{"path":"update.txt","edits":[{"op":"update","diff":"@@\n foo\n-bar\n+baz"}]},"expect":{"files":{"update.txt":"foo\nbaz\n"}}},
  {"name":"update with move","files":{"src.txt":"line\n"},"args":{"path":"src.txt","edits":[{"op":"update","rename":"dst.txt","diff":"@@\n-line\n+line2"}]},"expect":{"files":{"dst.txt":"line2\n"},"deleted":["src.txt"]}},
  {"name":"multiple hunks in single update","files":{"multi.txt":"foo\nbar\nbaz\nqux\n"},"args":{"path":"multi.txt","edits":[{"op":"update","diff":"@@\n-bar\n+BAR\n@@\n-qux\n+QUX"}]},"expect":{"files":{"multi.txt":"foo\nBAR\nbaz\nQUX\n"}}},
  {"name":"@@ scope and first context line can be identical","files":{"scope.txt":"## [Unreleased]\n\n### Changed\n\n- Old entry\n"},"args":{"path":"scope.txt","edits":[{"op":"update","diff":"@@ ## [Unreleased]\n ## [Unreleased]\n \n+### Added\n+\n+- New feature\n+\n ### Changed"}]},"expect":{"files":{"scope.txt":"## [Unreleased]\n\n### Added\n\n- New feature\n\n### Changed\n\n- Old entry\n"}}},
  {"name":"unicode dash matching","files":{"unicode.py":"import asyncio  # local import – avoids top‑level dep\n"},"args":{"path":"unicode.py","edits":[{"op":"update","diff":"@@\n-import asyncio  # local import - avoids top-level dep\n+import asyncio  # HELLO"}]},"expect":{"files":{"unicode.py":"import asyncio  # HELLO\n"}}},
  {"name":"missing file for update fails","files":{},"args":{"path":"nonexistent.txt","edits":[{"op":"update","diff":"@@\n-foo\n+bar"}]},"expect":{"error":"File not found: nonexistent.txt","writes":0}},
  {"name":"update without diff fails","files":{"nodiff.txt":"content\n"},"args":{"path":"nodiff.txt","edits":[{"op":"update"}]},"expect":{"error":"requires diff","writes":0}},
  {"name":"creates parent directories for create","files":{},"args":{"path":"nested/deep/file.txt","edits":[{"op":"create","diff":"content"}]},"expect":{"files":{"nested/deep/file.txt":"content\n"}}},
  {"name":"creates parent directories for move","files":{"src.txt":"line\n"},"args":{"path":"src.txt","edits":[{"op":"update","rename":"nested/deep/dst.txt","diff":"@@\n-line\n+newline"}]},"expect":{"files":{"nested/deep/dst.txt":"newline\n"},"deleted":["src.txt"]}},
  {"name":"simple -/+ only diff uses character-based fuzzy matching","files":{"fuzzy.txt":"console.log(\"Hello\");\n"},"args":{"path":"fuzzy.txt","edits":[{"op":"update","diff":"-console.log(\"Hello\");\n+console.log(\"World\");"}]},"expect":{"files":{"fuzzy.txt":"console.log(\"World\");\n"}}},
  {"name":"simple diff adjusts indentation to match actual content","files":{"indent.ts":"function test() {\n    const x = 1;\n    return x;\n}\n"},"args":{"path":"indent.ts","edits":[{"op":"update","diff":"-const x = 1;\n+const x = 42;"}]},"expect":{"files":{"indent.ts":"function test() {\n    const x = 42;\n    return x;\n}\n"}}},
  {"name":"diff with context lines falls back to line-based matching","files":{"context.txt":"header\nfoo\nbar\nmiddle\nfoo\nbaz\nfooter\n"},"args":{"path":"context.txt","edits":[{"op":"update","diff":"@@\n middle\n-foo\n+FOO"}]},"expect":{"files":{"context.txt":"header\nfoo\nbar\nmiddle\nFOO\nbaz\nfooter\n"}}},
  {"name":"multiple chunks use line-based matching","files":{"multi.txt":"aaa\nbbb\nccc\nddd\n"},"args":{"path":"multi.txt","edits":[{"op":"update","diff":"@@\n-bbb\n+BBB\n@@\n-ddd\n+DDD"}]},"expect":{"files":{"multi.txt":"aaa\nBBB\nccc\nDDD\n"}}},
  {"name":"simple diff with @@ context uses line-based matching","files":{"scoped.txt":"class Foo {\n  method() {\n    return 1;\n  }\n}\n"},"args":{"path":"scoped.txt","edits":[{"op":"update","diff":"@@ class Foo {\n-    return 1;\n+    return 42;"}]},"expect":{"files":{"scoped.txt":"class Foo {\n  method() {\n    return 42;\n  }\n}\n"}}},
  {"name":"simple diff rejects multiple occurrences","files":{"dupe.txt":"foo\nbar\nfoo\n"},"args":{"path":"dupe.txt","edits":[{"op":"update","diff":"-foo\n+FOO"}]},"expect":{"files":{"dupe.txt":"foo\nbar\nfoo\n"},"error":"2 occurrences","writes":0}},
  {"name":"JSON patch mode: op create over an existing file is a full-file overwrite","files":{"exists.txt":"original\n"},"args":{"path":"exists.txt","edits":[{"op":"create","diff":"replacement\n"}]},"expect":{"files":{"exists.txt":"replacement\n"}}}
 ]
