{
	"source": "packages/hashline/test/patcher.test.ts",
	"cases": [
		{
			"name": "applies when the section tag is the live file's content hash",
			"parse": [
				{
					"input": "PUT 1-1:\n+after",
					"expect": {
						"editCount": 2,
						"warnings": []
					}
				}
			],
			"apply": [
				{
					"text": "before\n",
					"input": "PUT 1-1:\n+after",
					"path": "a.ts",
					"expect": {
						"text": "after\n",
						"firstChangedLine": 1
					}
				}
			]
		},
		{
