// Canonical grammar for the sloppy edit payload (constrained decoding).
//
// Shape:
//   *** SM:EDIT relative/path.ts   open edits in that file
//   *** SM:EDIT relative/path.ts all
//                                  apply every match
//   *** SM:EDIT                    continue with the same file
//   *** SM:FIND                    current-text body; … elides gaps
//   *** SM:PUT                     final replacement body; empty deletes
//   *** SM:AFTER                   lines inserted after the match
// Headers are standalone and case-insensitive. A body continues until the
// next recognized header or EOF; no closing delimiter is used. AFTER treats
// foreign Begin/End Patch rows as literal insertion text.
start: begin_patch? edit+

begin_patch: BEGIN_PATCH LF

edit: edit_open pair+
edit_open: EDIT_HEADER LF
pair: find (put | after)
find: FIND_HEADER LF body_line*
put: PUT_HEADER action_body?
after: AFTER_HEADER after_body?
action_body: LF body_line* BODY_TEXT?
after_body: LF after_body_line* AFTER_TEXT?

body_line: BODY_TEXT LF | LF
after_body_line: AFTER_TEXT LF | LF

BEGIN_PATCH: /[ \t]*\*{3}[ \t]+(?i:Begin[ \t]+Patch)[ \t]*/
END_PATCH: /[ \t]*\*{3}[ \t]+(?i:End[ \t]+Patch)[ \t]*/
EDIT_HEADER: /[ \t]*\*{3}[ \t]+(?i:SM:EDIT)(?:[ \t]+[^\r\n]*)?/
FIND_HEADER: /[ \t]*\*{3}[ \t]+(?i:SM:FIND)[ \t]*/
PUT_HEADER: /[ \t]*\*{3}[ \t]+(?i:SM:PUT)[ \t]*/
AFTER_HEADER: /[ \t]*\*{3}[ \t]+(?i:SM:AFTER)[ \t]*/

// LLGuidance supports terminal intersection/complement, not priorities or lookarounds.
BODY_TEXT: /[^\r\n]+/ & ~(EDIT_HEADER | FIND_HEADER | PUT_HEADER | AFTER_HEADER | BEGIN_PATCH | END_PATCH)
AFTER_TEXT: /[^\r\n]+/ & ~(EDIT_HEADER | FIND_HEADER | PUT_HEADER | AFTER_HEADER)

%import common.LF
