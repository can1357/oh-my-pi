load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# Vendored napi-rs with the per-env leak fix (see README.md), promoted to a
# workspace member so Bazel treats it as first-party (crate_universe's path-dep
# rendering is machine-local and breaks lockfile portability). Feature list
# mirrors cargo's resolved set for pi-natives. build.rs is not wired in: it
# only sets cfgs for wasm32-wasip1-threads and links windows-gnu, neither of
# which ships; its check-cfg declarations are covered by --cap-lints.
rust_library(
    name = "napi",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "default",
        "dyn-symbols",
        "napi1",
        "napi10",
        "napi2",
        "napi3",
        "napi4",
        "napi5",
        "napi6",
        "napi7",
        "napi8",
        "napi9",
        "tokio",
        "tokio_rt",
        "tokio_time",
    ],
    crate_name = "napi",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = ["--cap-lints=allow"],
    tags = [
        "noclippy",
        "norustfmt",
    ],
    version = "3.13.0",
    deps = all_crate_deps(normal = True),
)
