load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_shared_library", "rust_test")
load("//bazel/toolchains/swift:defs.bzl", "applefm_bridge")
load(":darwin_helper.bzl", "darwin_helper")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_binary(
    name = "generate_syntax_set",
    srcs = [
        "src/syntaxes/builder.rs",
        "src/syntaxes/generate.rs",
    ],
    compile_data = glob(["src/syntaxes/*.sublime-syntax"]),
    crate_root = "src/syntaxes/generate.rs",
    edition = "2024",
    deps = ["@crates//:syntect"],
)

genrule(
    name = "syntax_set",
    outs = ["syntaxes.packdump"],
    cmd = "$(execpath :generate_syntax_set) $@",
    tools = [":generate_syntax_set"],
)

darwin_helper(
    name = "oauth_callback_darwin_helper",
    src = "src/oauth_callback/darwin-helper.m",
)

darwin_helper(
    name = "capture_darwin_helper",
    src = "src/desktop/macos/capture/helper.m",
    frameworks = ["AppKit", "ScreenCaptureKit", "CoreGraphics"],
    minimum_macos = "14.0",
)

# Apple Foundation Models bridge (src/applefm/build-bridge.sh): a bridge.swift
# dylib built with the //bazel/toolchains/swift toolchain (host Xcode on mac
# exec hosts, pinned swift.org Swift + @macos_sdk on linux ones), else an empty
# file. The addon embeds it as compile data and dlopens it only on macOS 27+.
# Mac hosts key the action on the detected toolchain's fingerprint
# (toolchain.txt), linux hosts on the pinned toolchain's files, so cached
# outputs never cross toolchains. build.rs does the same for cargo builds.
applefm_bridge(
    name = "applefm_bridge",
    src = "src/applefm/bridge.swift",
    out = "libomp_applefm.dylib",
    script = "src/applefm/build-bridge.sh",
    target_compatible_with = ["@platforms//os:macos"],
)

rust_binary(
    name = "oauth_callback_relay",
    srcs = [
        "src/oauth_callback/publication.rs",
        "src/oauth_callback/relay.rs",
    ],
    crate_root = "src/oauth_callback/relay.rs",
    edition = "2024",
    rustc_flags = [
        "-Ccodegen-units=1",
        "-Copt-level=z",
        "-Cpanic=abort",
        "-Cstrip=symbols",
    ] + select({
        "//bazel/variants:baseline": ["-Ctarget-cpu=x86-64-v2"],
        "//bazel/variants:modern": ["-Ctarget-cpu=x86-64-v3"],
        "//conditions:default": [],
    }) + select({
        "//bazel/triples:x86_64-unknown-linux-musl": ["-Ctarget-feature=-crt-static"],
        "//bazel/triples:aarch64-unknown-linux-musl": ["-Ctarget-feature=-crt-static"],
        "//bazel/triples:x86_64-pc-windows-msvc": ["-Ctarget-feature=+crt-static"],
        "//bazel/triples:aarch64-pc-windows-msvc": ["-Ctarget-feature=+crt-static"],
        "//conditions:default": [],
    }),
)

# The NAPI cdylib. build.rs is intentionally not wired in: napi_build::setup()
# link args are hardcoded below, and the OAuth relay executable and the
# `:syntax_set` genrule output are separate targets embedded as compile data.
# TypeScript typedef regeneration stays a cargo-side dev flow
# (`bun --cwd packages/natives run build:bindings`); index.js/index.d.ts are
# committed, so artifact builds never need the napi CLI.
rust_shared_library(
    name = "pi_natives",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [":syntax_set"] + glob([
        "src/syntaxes/*.sublime-syntax",
        "src/fonts/*",
        "data/*.bin.zst",
        "src/utok/claude/testdata/*.json",
        "src/desktop/linux/wayland/testdata/*.xkb",
        "fixtures/*.json",
        "fixtures/hpatch/*",
    ]) + select({
        "@platforms//os:macos": [
            ":applefm_bridge",
            ":oauth_callback_darwin_helper",
            ":capture_darwin_helper",
        ],
        "//conditions:default": [":oauth_callback_relay"],
    }),
    crate_features = [],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = select({
        "@platforms//os:macos": {
            "OMP_APPLEFM_BRIDGE": "$(execpath :applefm_bridge)",
            "OMP_OAUTH_DARWIN_HELPER": "$(execpath :oauth_callback_darwin_helper)",
            "OMP_SYNTAX_SET": "$(execpath :syntax_set)",
            "OMP_CAPTURE_DARWIN_HELPER": "$(execpath :capture_darwin_helper)",
        },
        "//conditions:default": {
            "OMP_OAUTH_RELAY_BINARY": "$(execpath :oauth_callback_relay)",
            "OMP_SYNTAX_SET": "$(execpath :syntax_set)",
        },
    }),
    rustc_flags = select({
        "//bazel/variants:baseline": ["-Ctarget-cpu=x86-64-v2"],
        "//bazel/variants:modern": ["-Ctarget-cpu=x86-64-v3"],
        "//conditions:default": [],
    }) + select({
        # napi_build::setup() equivalents (build.rs is not wired into Bazel):
        # napi addons resolve Node symbols at load time on macOS; DF_1_NODELETE
        # keeps the addon resident across Worker teardown on linux-gnu (napi
        # emits it for gnu; harmless under musl's loader). windows-msvc needs
        # nothing — napi-sys v3 imports node.exe via raw-dylib.
        # -adhoc_codesign: linkers sign arm64 ad hoc by default but not
        # x86_64; every shipped darwin addon carries a signature.
        "@platforms//os:macos": [
            "-Clink-arg=-Wl,-undefined,dynamic_lookup",
            "-Clink-arg=-Wl,-adhoc_codesign",
        ],
        "@platforms//os:linux": ["-Clink-arg=-Wl,-z,nodelete"],
        "//conditions:default": [],
    }) + select({
        # musl defaults to +crt-static, under which rustc silently emits no
        # cdylib at all; napi musl addons have always linked the dynamic CRT.
        "//bazel/triples:x86_64-unknown-linux-musl": ["-Ctarget-feature=-crt-static"],
        "//bazel/triples:aarch64-unknown-linux-musl": ["-Ctarget-feature=-crt-static"],
        # Statically link the MSVC CRT so the shipped .node does not import
        # VCRUNTIME140.dll from the Visual C++ Redistributable, which is absent
        # on a clean Windows install and makes the loader's dlopen fail with
        # "The specified module could not be found" (error 126). The C deps are
        # switched to /MT in lock-step via the static_link_msvcrt cc feature in
        # the native_addon transition (bazel/defs.bzl).
        "//bazel/triples:x86_64-pc-windows-msvc": ["-Ctarget-feature=+crt-static"],
        "//bazel/triples:aarch64-pc-windows-msvc": ["-Ctarget-feature=+crt-static"],
        "//conditions:default": [],
    }),
    version = "17.1.5",
    deps = all_crate_deps(normal = True) + [
        "//crates/pi-ast",
        "//crates/pi-builtins",
        "//crates/pi-diff",
        "//crates/pi-edit",
        "//crates/pi-iso",
        "//crates/pi-predict",
        "//crates/pi-shell",
        "//crates/pi-vcs",
        "//crates/pi-vfs",
        "//crates/pi-voice",
        "//crates/pi-walker",
        "//crates/vendor/napi",
    ],
)

rust_test(
    name = "oauth_callback_relay_test",
    srcs = [
        "src/oauth_callback/publication.rs",
        "src/oauth_callback/relay.rs",
    ],
    crate_root = "src/oauth_callback/relay.rs",
    edition = "2024",
)

rust_test(
    name = "pi_natives_test",
    crate = ":pi_natives",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        # dev-dependency on every platform (desktop_x11's pure keysym helpers
        # compile under cfg(test) everywhere), but cargo-bazel folds it into
        # the linux-only normal dep entry; restore it for the test build.
        "@crates//:xkeysym",
    ],
)
