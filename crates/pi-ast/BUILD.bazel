load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# Owns every linked tree-sitter grammar (17 crates + runtime); the other
# languages load WebAssembly grammars at runtime (src/language/grammar.rs).
rust_library(
    name = "pi-ast",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "pi_ast",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "17.1.5",
    deps = all_crate_deps(normal = True) + [
        "//crates/vendor/tree-sitter-go",
    ],
)

rust_test(
    name = "pi-ast_test",
    compile_data = ["src/language/testdata/ini.wasm"],
    crate = ":pi-ast",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
