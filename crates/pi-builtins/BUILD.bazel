load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# First-party: the in-process command-line utilities and process builtins the
# shell ships. Feature list mirrors cargo's resolved default set.
rust_library(
    name = "pi-builtins",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob([
        "src/*.txt",
        # `include_bytes!` wire captures for the rsync sender tests.
        "src/rsync/sender/testdata/*",
    ]),
    crate_features = [
        "util.ast-grep",
        "util.awk",
        "util.b2sum",
        "util.base32",
        "util.base64",
        "util.basename",
        "util.bre",
        "util.cat",
        "util.chmod",
        "util.cksum",
        "util.cmp",
        "util.combine",
        "util.comm",
        "util.cp",
        "util.cut",
        "util.date",
        "util.dd",
        "util.df",
        "util.diff",
        "util.dirname",
        "util.du",
        "util.env",
        "util.errno",
        "util.fd",
        "util.find",
        "util.fold",
        "util.grep",
        "util.head",
        "util.hostname",
        "util.id",
        "util.ifne",
        "util.isutf8",
        "util.jq",
        "util.ln",
        "util.ls",
        "util.lsof",
        "util.md5",
        "util.md5sum",
        "util.mkdir",
        "util.mktemp",
        "util.mv",
        "util.nl",
        "util.nproc",
        "util.od",
        "util.paste",
        "util.pgrep",
        "util.pidwait",
        "util.pkill",
        "util.printenv",
        "util.proc-match",
        "util.procs",
        "util.ps",
        "util.readlink",
        "util.realpath",
        "util.rg",
        "util.rm",
        "util.rmdir",
        "util.rsync",
        "util.sd",
        "util.sed",
        "util.seq",
        "util.sha1sum",
        "util.sha224sum",
        "util.sha256sum",
        "util.sha384sum",
        "util.sha512sum",
        "util.shasum",
        "util.sleep",
        "util.sort",
        "util.sponge",
        "util.stat",
        "util.strings",
        "util.tac",
        "util.tail",
        "util.tar",
        "util.tee",
        "util.top",
        "util.touch",
        "util.tr",
        "util.truncate",
        "util.ts",
        "util.uname",
        "util.uniq",
        "util.uptime",
        "util.wc",
        "util.which",
        "util.whoami",
        "util.xargs",
        "util.yes",
        "utils",
    ],
    crate_name = "pi_builtins",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.2.0",
    deps = all_crate_deps(normal = True) + [
        "//crates/pi-ast",
        "//crates/pi-diff",
        "//crates/pi-walker",
        "//crates/pi-iso",
        "//crates/pi-vfs",
        "//crates/vendor/jaq-core",
        "//crates/vendor/jaq-json",
        "//crates/vendor/jaq-std",
        "//crates/vendor/grep-searcher",
    ],
)

rust_test(
    name = "pi-builtins_test",
    crate = ":pi-builtins",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + ["//crates/vendor/grep-searcher"],
)
