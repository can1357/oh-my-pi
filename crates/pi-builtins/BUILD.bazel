load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# First-party: the brush builtins fork plus the in-process command-line
# utilities the shell ships. Feature list mirrors cargo's resolved default set.
rust_library(
    name = "pi-builtins",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(["src/*.txt"]),
    crate_features = [
        "base",
        "builtin.alias",
        "builtin.bg",
        "builtin.bind",
        "builtin.break",
        "builtin.builtin",
        "builtin.caller",
