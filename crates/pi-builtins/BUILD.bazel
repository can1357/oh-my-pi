        "builtin.dirs",
        "builtin.dot",
        "builtin.echo",
        "builtin.enable",
        "builtin.eval",
        "builtin.exec",
        "builtin.exit",
        "builtin.export",
        "builtin.false",
        "builtin.fc",
        "builtin.fg",
        "builtin.getopts",
        "builtin.hash",
        "builtin.help",
        "builtin.history",
        "builtin.jobs",
        "builtin.kill",
        "builtin.let",
        "builtin.mapfile",
