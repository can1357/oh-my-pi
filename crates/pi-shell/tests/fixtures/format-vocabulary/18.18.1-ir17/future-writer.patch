+#[derive(Clone, Copy, Serialize, Deserialize)]
+enum FutureAwaited {
+	Call(CallId),
+	Task(NativeRef),
+	Ext { pid: u32 },
+	Frame,
+	Jobs { force: bool },
+	AllJobs,
+	AnyJob,
+	NextCall(CallId),
+}
+
+impl From<Awaited> for FutureAwaited {
+	fn from(value: Awaited) -> Self {
+		match value {
+			Awaited::Call(id) => Self::NextCall(id),
+			Awaited::Task(id) => Self::Task(id),
+			Awaited::Ext { pid } => Self::Ext { pid },
+			Awaited::Frame => Self::Frame,
+			Awaited::Jobs { force } => Self::Jobs { force },
+			Awaited::AllJobs => Self::AllJobs,
+			Awaited::AnyJob => Self::AnyJob,
+		}
+	}
+}
+
+impl From<FutureAwaited> for Awaited {
+	fn from(value: FutureAwaited) -> Self {
+		match value {
+			FutureAwaited::Call(id) | FutureAwaited::NextCall(id) => Self::Call(id),
+			FutureAwaited::Task(id) => Self::Task(id),
+			FutureAwaited::Ext { pid } => Self::Ext { pid },
+			FutureAwaited::Frame => Self::Frame,
+			FutureAwaited::Jobs { force } => Self::Jobs { force },
+			FutureAwaited::AllJobs => Self::AllJobs,
+			FutureAwaited::AnyJob => Self::AnyJob,
+		}
+	}
+}
+
