load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# build.rs concatenates src/minimizer/defs/*.toml into OUT_DIR/builtin_filters.toml,
# consumed via include_str!(concat!(env!("OUT_DIR"), ...)) in minimizer/engine.rs.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = glob(["src/minimizer/defs/*.toml"]),
    edition = "2024",
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "pi-shell",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    aliases = aliases(),
    compile_data = glob(["src/minimizer/filters/fixtures/**"]),
    crate_name = "pi_shell",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = select({
        # Cargo.toml `[profile.dev.package.pi-shell]`: the bash engine's
        # unoptimized frames overflow the 2 MiB test-thread stack before its
        # recursion limits hit.
        "//bazel:fastbuild": ["-Copt-level=1"],
        "//conditions:default": [],
    }),
    version = "18.15.0",
    deps = all_crate_deps(normal = True) + [
        ":build_script",
        "//crates/pi-builtins",
        "//crates/pi-vcs",
        "//crates/pi-vfs",
    ],
)

# obash: the engine as a standalone shell, for differential tests and
# benchmarks against bash. Its C `main` (`#![no_main]`) keeps the SIGPIPE
# disposition it was started with.
rust_binary(
    name = "obash",
    srcs = glob(["src/bin/obash/**/*.rs"]),
    aliases = aliases(),
    crate_name = "obash",
    crate_root = "src/bin/obash/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "18.15.0",
    deps = all_crate_deps(normal = True) + [":pi-shell"],
)

# Unit tests, including the engine, host and pi-host suites under
# `src/**/suites`, which read their data at compile time (syntax goldens,
# zsh glob tables) and at run time (testkit fixtures).
rust_test(
    name = "pi-shell_test",
    compile_data = glob([
        "src/bash/syntax/suites/data/**",
        "src/bash/pattern/zsh/testdata/**",
    ]),
    crate = ":pi-shell",
    data = glob(["src/testkit/fixtures/**"]),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_flags = select({
        # Cargo.toml `[profile.dev.package.pi-shell]`: the bash engine's
        # unoptimized frames overflow the 2 MiB test-thread stack before its
        # recursion limits hit.
        "//bazel:fastbuild": ["-Copt-level=1"],
        "//conditions:default": [],
    }),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "vfs_test",
    srcs = ["tests/vfs.rs"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal = True) + all_crate_deps(normal_dev = True) + [
        ":pi-shell",
        "//crates/pi-vfs",
    ],
)

rust_test(
    name = "minimizer_fixtures_test",
    srcs = ["tests/minimizer_fixtures.rs"],
    data = glob(["tests/fixtures/minimizer/**"]),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [":pi-shell"],
)
