// Provider-wire compat for "modular". Modular Cloud serves open models on an
// OpenAI-compatible API; the provider is catalog-only, so models, prices and
// limits come from the bundled roster. Reasoning controls differ per model.
// Origin: upstream `packages/catalog/src/compat/rules/providers/modular.kdl`
// (c308970263); see THIRD-PARTY-NOTICES.txt.

provider "modular" {
	thinking-mode "effort"
	// The API takes OpenRouter's `reasoning` object for every model, so a model
	// added later works without its own block: on sends `reasoning.effort`, off
	// sends `reasoning.enabled = false`.
	thinking-format "openrouter"

	// MiniMax M3.1 Flash takes a nested `reasoning.effort` and always thinks:
	// `reasoning.enabled = false` still returns reasoning tokens.
	models "MiniMaxAI/MiniMax-M3.1-Flash" {
		thinking-requires-effort #true
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
	// MiniMax M3 and Gemma 4 31B switch reasoning with `reasoning.enabled` and
	// ignore any effort, so the ladder is one on-rung beside off. Upstream also
	// sends `reasoning.enabled = true` for the on-rung through `when-thinking
	// extra-body`; omp's typed `ReasoningBodyOverride` models only `thinking`,
	// `enable_thinking` and `venice_parameters`, so that body addition is not
	// expressible as data here (ADR 0059, Status in omp).
	models "minimax/minimax-m3" "google/gemma-4-31b-it" {
		thinking-efforts "high"
	}
}
