// Provider-wire compat for "anthropic"; regenerated from the frozen census using deployment contract selectors.

provider "anthropic" {
	class "anthropic" {
		revision ">=3.7 <4.6" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	// Native `output_config.format` constrained decoding. Beta headers are no
	// longer required; the format object carries `type` and `schema` only.
	// Listed per model rather than by revision range: the documented support
	// list is not a contiguous interval, and a range would also claim models
	// Anthropic does not list.
	models "claude-sonnet-4-5*" "claude-opus-4-5*" "claude-haiku-4-5*" "claude-opus-4-6" \
		"claude-opus-4-7" "claude-opus-4-8" "claude-opus-5" "claude-sonnet-4-6" \
		"claude-sonnet-5" "claude-fable-5" "claude-fable-5-1" "claude-mythos-5" \
		"claude-mythos-5-1" "claude-mythos-preview" {
		supports-response-schema #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*20240229" "claude-3-7-sonnet-20250219" {
		disable-adaptive-thinking #false
		escape-builtin-tool-names #false
		official-endpoint #true
		replay-unsigned-thinking #false
		requires-thinking-enabled #false
		requires-tool-result-id #false
		signing-endpoint #true
		supports-eager-tool-input-streaming #true
		supports-forced-tool-choice #true
		supports-long-cache-retention #true
		supports-mid-conversation-system #false
		supports-sampling-params #true
	}
}
