collapse {
	thinking-suffix "-thinking"
	// Thinking-pair tokens: bounded (possibly infix) markers that name the
	// thinking sibling of a live bare twin (`sonar-reasoning-pro` beside
	// `sonar-pro`). Consumed only by thinking-pair derivation - never by
	// identity suffix collapse, which stays on `thinking-suffix`.
	pair-token "thinking" "reasoning" "reasoner"
	effort-suffix "-extra-high" tier="xhigh"
	effort-suffix "-none" tier="off"
	effort-suffix "-minimal" tier="minimal"
	effort-suffix "-medium" tier="medium"
	effort-suffix "-xhigh" tier="xhigh"
	effort-suffix "-high" tier="high"
	effort-suffix "-low" tier="low"
	effort-suffix "-max" tier="max" except-bare-prefix="qwen"
	// Codex backend discovery advertises worker-mode routing variants under a
	// `-wm` suffix (`gpt-5.6-luna-wm`): the same model behind a different route,
	// with base-model metadata owned by the plain bundled SKU.
	routing-variant-suffix "-wm" "openai-codex" "openai-codex-device"
	// Cursor discovery serves pure effort-suffixed siblings as one logical
	// model. The reviewed GPT-5.6 seeds enable the generic grouping rule for
	// the provider; live metadata and duplicate-tier checks decide every
	// candidate family, including later model generations.
	effort-family "cursor" "gpt-5.6-luna"
	effort-family "cursor" "gpt-5.6-sol"
	effort-family "cursor" "gpt-5.6-terra"
	// `-fast` is a parallel SKU lane. It stays in the logical identifier while
	// the effort token immediately before it selects the wire sibling.
	effort-lane-suffix "-fast" "cursor"

	// Reviewed per-provider variant families: logical models served as
	// per-effort/thinking sibling wire ids, with explicit routing, ladders,
	// budgets, and wire facts. Ported verbatim from the legacy hand tables.
	//
	// Cloud Code Assist serves every Gemini Flash generation from 3.6 on as
	// `-low`/`-medium`/`-high` thinking-level SKUs plus a `-tiered` alias. One
	// template per provider covers each revision discovery advertises; the
	// minimal tier is served by the `-low` SKU (Gemini 3.7+ rejects MINIMAL).
	variant-family "google-antigravity" "gemini-{rev}-flash" name="Gemini {rev} Flash" revision=">=3.6" {
		members "gemini-{rev}-flash-low" "gemini-{rev}-flash-medium" "gemini-{rev}-flash-high" "gemini-{rev}-flash-tiered"
		route "minimal" "gemini-{rev}-flash-low"
		route "low" "gemini-{rev}-flash-low"
		route "medium" "gemini-{rev}-flash-medium"
		route "high" "gemini-{rev}-flash-high"
		mode "google-level"
		efforts "minimal" "low" "medium" "high"
		requires-effort #true
	}
	variant-family "google-antigravity" "gemini-3.5-flash" name="Gemini 3.5 Flash" {
		members "gemini-3.5-flash-extra-low" "gemini-3.5-flash-low" "gemini-3-flash-agent"
		route "off" "gemini-3.5-flash-extra-low"
		route "minimal" "gemini-3.5-flash-extra-low"
		route "low" "gemini-3.5-flash-extra-low"
		route "medium" "gemini-3.5-flash-low"
		route "high" "gemini-3-flash-agent"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		budget "minimal" "1000"
		budget "low" "1000"
		budget "medium" "4000"
		budget "high" "10000"
		aliases "gemini-3-flash"
		suppress-when-off #true
	}
	variant-family "google-antigravity" "gemini-3.1-pro" name="Gemini 3.1 Pro" {
		members "gemini-3.1-pro-low" "gemini-pro-agent" "gemini-3.1-pro-high"
		route "off" "gemini-3.1-pro-low"
		route "low" "gemini-3.1-pro-low"
		route "high" "gemini-pro-agent"
		mode "budget"
		efforts "low" "high"
		budget "low" "1001"
		budget "high" "10001"
		retired "gemini-3.1-pro-high"
		suppress-when-off #true
	}
	variant-family "google-antigravity" "gemini-3-pro" name="Gemini 3 Pro" {
		members "gemini-3-pro-low" "gemini-3-pro-high"
		route "off" "gemini-3-pro-low"
		route "low" "gemini-3-pro-low"
		route "high" "gemini-3-pro-high"
		mode "google-level"
		efforts "low" "high"
		suppress-when-off #true
	}
	variant-family "google-antigravity" "gpt-oss-120b" name="GPT-OSS 120B" {
		members "gpt-oss-120b-medium"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
	}
	variant-family "google-antigravity" "claude-sonnet-4-6" name="Claude Sonnet 4.6" {
		members "claude-sonnet-4-6" "claude-sonnet-4-6-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		retired "claude-sonnet-4-6-thinking"
	}
	variant-family "google-antigravity" "claude-opus-4-6" name="Claude Opus 4.6" {
		members "claude-opus-4-6-thinking" "claude-opus-4-6"
