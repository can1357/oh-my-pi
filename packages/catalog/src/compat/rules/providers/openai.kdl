// Provider-wire compat for "openai"; regenerated from the frozen census using deployment contract selectors.

provider "openai" {
	default-model "gpt-5.5"
	env "OPENAI_API_KEY"

	// Daybreak models are approval-gated first-party Responses models that are
	// not yet present in stencil.so. Seed the documented aliases and current
	// Cyber snapshot so fresh installs expose them without credentialed
	// discovery; upstream catalog rows outrank these once discovery serves them.
	// Blue rides the standard GPT-5.6 Sol tariff, Red and Cyber the standard
	// GPT-5.6 Cyber tariff. The >272K long-context tier is rule-owned
	// (`providers/openai.kdl` long-context-cost) and baked at build time.
	seed api="openai-responses" base-url="https://api.openai.com/v1" bundle="always" {
		model "daybreak-blue-latest" name="Daybreak Blue" {
			reasoning #true
			input "text" "image"
			cost input=5 output=30 cache-read=0.5 cache-write=6.25
			limits context=1050000 max-tokens=128000
		}
		model "daybreak-red-latest" name="Daybreak Red" {
			reasoning #true
			input "text" "image"
			cost input=12.5 output=75 cache-read=1.25 cache-write=15.625
			limits context=400000 max-tokens=128000
		}
		model "gpt-5.6-cyber" name="GPT-5.6 Cyber" {
			reasoning #true
			input "text" "image"
			cost input=12.5 output=75 cache-read=1.25 cache-write=15.625
			limits context=400000 max-tokens=128000
		}
	}

	// Replaces the strict-mode provider whitelist entry.
	supports-strict-mode #true
	// Replaces both OpenAI tool-call id-limit baselines.
	uses-openai-tool-call-id-limit #true
	thinking-mode "effort"
	class "unknown" {
		revision ">=5.6 <5.7" {
			reasoning-disable-mode "none-effort"
			thinking-efforts "low" "medium" "high" "xhigh" "max"
		}
		revision ">=5 <6" {
			apply-patch-tool-type "freeform"
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "codex-mini-latest" "gpt-realtime-2.1" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.1-codex" "gpt-5.1-codex-max" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.1-codex-mini" {
		thinking-efforts "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.6-cyber" {
		reasoning-disable-mode "none-effort"
	}
	// The 5.6 generation reasons through the wire `none` tier when disabled,
	// and every first-party GPT-5 Responses SKU takes the freeform apply_patch
	// custom tool.
	class "openai" {
		family "gpt" {
			revision "=5.6" {
				reasoning-disable-mode "none-effort"
			}
		}
		revision ">=5 <7" {
			apply-patch-tool-type "freeform"
		}
	}
	// First-party GPT-5.6 whole-request long-context tiers (>272K input).
	models "daybreak-blue-latest" "gpt-5.6" "gpt-5.6-sol*" {
		long-context-cost {
			input-threshold 272000
			input 10.0
			output 45.0
			cache-read 1.0
			cache-write 12.5
		}
	}
	models "gpt-5.6-luna*" {
		long-context-cost {
			input-threshold 272000
			input 0.4
			output 1.8
			cache-read 0.04
			cache-write 0.5
		}
	}
	models "gpt-5.6-terra*" {
		long-context-cost {
			input-threshold 272000
			input 4.0
			output 18.0
			cache-read 0.4
			cache-write 5.0
		}
	}
	// Astra API route bills the documented long-context tier above 272K input:
	// 2x input and cache rates, 1.5x output for the full request; cache writes
	// stay 1.25x the long input rate (25.0). The Codex subscription route stays
	// exempt (credit-equivalent, free cache writes) — see openai-codex.kdl.
	models "gpt-6-astra*" {
		long-context-cost {
			input-threshold 272000
			input 20.0
			output 75.0
			cache-read 2.0
			cache-write 25.0
		}
	}
	// residue: the bare Daybreak rolling aliases pin the documented 5.6-gen
	// wire restrictions without carrying the gpt- prefix identity.
	models "daybreak-blue-latest" "daybreak-red-latest" {
		prompt-cache-breakpoint-ttl "30m"
		supports-prompt-cache-breakpoints #true
		supports-sampling-params #false
	}
}
