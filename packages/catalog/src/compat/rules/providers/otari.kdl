// Provider-wire compat for "otari": an OpenAI-compatible AI gateway and
// control plane at https://api.otari.ai/api/v1. The gateway routes requests
// to upstream providers on the workspace's behalf; the model roster is
// workspace-scoped and dynamic (a workspace enables upstream providers and
// models in Otari), so nothing is bundled. Verified live 2026-11-02:
// `/api/v1/models` is key-protected (401 without and with a bad key) and
// returns OpenRouter-style rows (`supported_parameters`, `architecture`,
// per-million `pricing`, limits); discovery is authoritative so a successful
// fetch prunes whatever the workspace has since disabled.
// Self-hosted gateways are reached by overriding the provider `baseUrl` in
// `models.yml` to the deployment's API root (`https://host.example.com/api/v1`).

provider "otari" {
	// A placeholder, not a guaranteed id: the roster is per-workspace and
	// `/models` marks no workspace default. `default-model` only ranks
	// already-available models and never fabricates a row, so when the
	// workspace does not enable this id the resolver falls back to the first
	// available model. `deepseek/deepseek-v4.1-flash` is the catalog id
	// Otari's own `/models` API docs use as the example selector. Otari
	// selectors are `<upstream-provider>/<model>`.
	default-model "deepseek/deepseek-v4.1-flash"
	env "OTARI_API_KEY"
	dynamic-models-authoritative #true
	// The workspace roster is the whole catalog for this token; never borrow
	// capabilities from same-id rows on other hosts, which may serve the same
	// upstream model with different limits or prices.
	skip-cross-provider-reference-fills #true
	discovery label="Otari"

	// Otari forwards chat requests through any-llm to whichever upstream
	// serves the model, and not every upstream accepts the `developer` role:
	// a streamed request to `anthropic/claude-haiku-4.5` answers 400 with a
	// `developer` message and 200 with `system` (verified live 2026-11-02).
	// `store`, `max_completion_tokens`, tool calls, and every
	// `reasoning_effort` level (`minimal`..`xhigh`) passed through for
	// `anthropic/` and `google/` rows in the same check; the gateway maps the
	// effort to each upstream's own control.
	supports-developer-role #false
}
