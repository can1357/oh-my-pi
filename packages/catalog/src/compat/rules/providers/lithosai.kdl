// LithosAI's hosted inference engine (api.lithosai.cloud): one
// OpenAI-compatible chat-completions endpoint serving open-weight models —
// Kimi K3, DeepSeek V4.1 Flash, GLM-5.3 — at full precision on the operator's
// own GPUs. The roster is account-scoped ("Lists the models your organization
// can call"), so `GET /v1/models` answers 401 `invalid API key` without a
// credential, and with one it publishes bare `{id, object, created, owned_by}`
// rows: no limits, tariffs, or capability metadata. Nothing about a row is
// therefore discoverable, and no rows are frozen here.
//
// Deliberately no `discovery` node: that node enrolls a provider in
// generate-models.ts, which would demand a live account credential on every
// regeneration and freeze one organization's roster into models.json.
// `dynamic-models-authoritative` prunes rows the roster drops.
//
// The wire facts below are transcribed from the vendor's published OpenAPI
// document (docs.lithosai.com/openapi.yaml, `info.version: 2026-09-17`), not
// from a live probe: the account used to read the roster carried no credit, so
// every chat completion answered 402 `insufficient_quota` before any request
// field could be exercised. Fields the schema documents are declared; anything
// the schema is silent about is left at the openai-completions default.
//
// The roster names each model family in base, `-fast`, `-ultra` and
// `-ultra-chat` tiers (13 ids over three families as of 2026-10-03). Base,
// `-fast` and `-ultra` are the same weights at different serving speeds and
// are priced in step; `-chat` ids are tuned for short-context chat, not
// coding agents, which is the vendor's own wording on the console card.
//
// The tiers are priced on the vendor's console Models page, which is the only
// place the numbers exist — the `/v1/models` rows carry none. The exact-id
// `models` blocks below transcribe that page as seen 2026-10-03. Every tier
// carries the same `chat`/`vision`/`tools`/`json_mode`/`reasoning` tags, so
// capability metadata is left at the discovery defaults and only cost is
// patched; the `-chat` distinction is a serving variant the tags do not show.
provider "lithosai" {
	default-model "moonshotai/Kimi-K3"
	env "LITHOSAI_API_KEY"
	dynamic-models-authoritative #true

	// Request schema: `max_tokens` and `max_completion_tokens` are both
	// accepted, `reasoning_effort` takes a named effort string, and the
	// response message and streamed delta both carry `reasoning_content`.
	// `role` enumerates `developer`; `store` is not a documented field.
	max-tokens-field "max_tokens"
	thinking-mode "effort"
	reasoning-content-field "reasoning_content"
	supports-developer-role #true
	supports-store #false

	// Every roster row is a DeepSeek V4.1 Flash, GLM-5.3 or Kimi K3 deployment,
	// and the endpoint takes two effort shapes (both verified live 2026-10-04):
	// the named strings `none|minimal|low|medium|high|xhigh|max`, and a float
	// in `[0, 0.99]`. An unknown value returns 400 naming both —
	// `reasoning_effort.literal[...]` then `reasoning_effort.constrained-float:
	// Input should be less than or equal to 0.99`. The float is not the model's
	// own 1-100 budget (`low`=50, `high`=75, `max`=100, default `high`, per the
	// `encoding/README.md` on huggingface.co/deepseek-ai/DeepSeek-V4.1-Flash):
	// integers on that scale are rejected here, so neither form reaches
	// `thinking.efforts`.
	//
	// The selectable tiers are DeepSeek's published ones — the class's
	// low/high/max ladder, whose mid-range aliases (`minimal`/`medium`/`xhigh`)
	// fold onto those same three points
	// (api-docs.deepseek.com/guides/thinking_mode) — and the off state is
	// `none`, which the endpoint honors as a real switch (`reasoning_content`
	// empty, `reasoning_tokens` 0). `none` is not an effort tier here, so it is
	// expressed with `reasoning-disable-mode` rather than in the ladder.
	//
	// The same block declares the vision modality: the endpoint reads image_url
	// content on every roster row (a 2×2 PNG returned `image_tokens: 184` plus a
	// correct description, 2026-10-04), while live discovery seeds `input:
	// ["text"]`. As on OpenCode Go, clearing `strip-image-input` alone would
	// leave the row text-only, so the modality is declared here too.
	//
	// Matched by selector rather than a provider-wide axis so the four tier ids
	// keep text wording and the `-chat` serving variants are covered with their
	// non-chat siblings: no capability difference between them is observed
	// (identical reasoning behavior and the same null
	// `completion_tokens_details`), so the console's `-chat` label is a naming
	// variant, not a capability axis.
	models "deepseek-ai/DeepSeek-V4.1-Flash*" "zai-org/GLM-5.3*" "moonshotai/Kimi-K3*" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
		reasoning-disable-mode "none-effort"
		input-modalities "text" "image"
		strip-image-input #false
	}

	// residue: the console tariff table, which no selector can isolate — the
	// roster ids are namespaced by upstream org (`deepseek-ai/`, `zai-org/`,
	// `moonshotai/`) and the tiers are serving variants, not taxonomy
	// families. `-chat` rows are priced by the vendor at the same rate as
	// their non-chat sibling and carry the same card, so each pair shares one
	// block. Context is 1,048,576 on every row; the endpoint reports no
	// limits, so `limits-patch` states the documented window. Unlike DeepSeek's
	// own API (which rejects `max_tokens` above 393216), this endpoint accepts
	// any value that fits the window — 1048000 succeeded, 1048576 was rejected
	// as exceeding the 1048576-token context — so the output cap is the context
	// window rather than the model's published 384K.
	models "deepseek-ai/DeepSeek-V4.1-Flash" {
		cost-patch {
			input 0.15
			output 0.60
			cache-read 0.003
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
	models "deepseek-ai/DeepSeek-V4.1-Flash-fast" {
		cost-patch {
			input 0.25
			output 1.00
			cache-read 0.005
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
	models "deepseek-ai/DeepSeek-V4.1-Flash-ultra" "deepseek-ai/DeepSeek-V4.1-Flash-ultra-chat" {
		cost-patch {
			input 0.35
			output 1.40
			cache-read 0.007
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
	models "zai-org/GLM-5.3" {
		cost-patch {
			input 1.05
			output 3.30
			cache-read 0.195
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
	models "zai-org/GLM-5.3-Flash" "zai-org/GLM-5.3-Flash-ultra" "zai-org/GLM-5.3-Flash-ultra-chat" {
		cost-patch {
			input 0.30
			output 1.00
			cache-read 0.06
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
	models "zai-org/GLM-5.3-ultra-chat" {
		cost-patch {
			input 2.10
			output 6.60
			cache-read 0.39
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
	models "moonshotai/Kimi-K3" {
		cost-patch {
			input 2.40
			output 12.00
			cache-read 0.24
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
	models "moonshotai/Kimi-K3-fast" {
		cost-patch {
			input 4.00
			output 20.00
			cache-read 0.40
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
	models "moonshotai/Kimi-K3-ultra" "moonshotai/Kimi-K3-ultra-chat" {
		cost-patch {
			input 5.60
			output 28.00
			cache-read 0.56
			cache-write 0
		}
		limits-patch {
			context-window 1048576
			max-tokens 1048576
		}
	}
}
