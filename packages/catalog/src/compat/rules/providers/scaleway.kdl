// Provider-wire compat for "scaleway": Scaleway Generative APIs, an
// OpenAI-compatible gateway at https://api.scaleway.ai/v1 serving serverless
// open-weight chat models. Verified live 2026-10-21: /v1/models returns bare
// OpenAI rows with no capability metadata, reasoning traces stream back on
// the message `reasoning` field, and reasoning_effort accepts `max`, `xhigh`,
// and `none` (the request-schema enum is stale; `none` answers with
// reasoning_tokens 0), so the ladders below follow the model cards, not the
// schema.
// Docs: https://www.scaleway.com/en/docs/generative-apis/reference-content/supported-models/
// Pricing (EUR/Mtok, pre-tax): https://www.scaleway.com/en/pricing/model-as-a-service/

provider "scaleway" {
	default-model "glm-5.3"
	env "SCW_SECRET_KEY" "SCW_API_KEY"
	// The key-protected `/v1/models` roster is the serverless catalog: a
	// successful fetch prunes bundled rows Scaleway has retired (glm-5.2 is
	// routed to glm-5.3 after 2026-11-16). Same-id rows on other hosts carry
	// other deployments' limits and modalities (zai serves glm-5.3 at
	// 1M/131k), so the generator must never backfill from them.
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="Scaleway"

	// Documented serverless catalog (supported-models + pricing pages,
	// 2026-11-02). `/v1/models` carries ids only, so these rows are the
	// bundle in every regeneration and outrank the bare discovered rows; at
	// runtime they are the reference discovery merges names, modalities,
	// prices, and limits from. Prices are EUR list rates converted at the
	// 2026-10-21 ECB reference rate (1 EUR = 1.1234 USD); Scaleway publishes
	// no cache-write rate and cache-read only where listed. Limits read the
	// documented "k" as 1,000 tokens, never overstating a serverless cap.
	seed api="openai-completions" base-url="https://api.scaleway.ai/v1" bundle="always" precedence="seed" {
		model "glm-5.3" name="GLM 5.3" {
			reasoning #true
			input "text"
			cost input=2.02 output=6.18 cache-read=0 cache-write=0
			limits context=256000 max-tokens=16000
		}
		model "glm-5.2" name="GLM 5.2" {
			reasoning #true
			input "text"
			cost input=2.02 output=6.18 cache-read=0 cache-write=0
			limits context=256000 max-tokens=16000
		}
		model "deepseek-v4.1-flash" name="DeepSeek V4.1 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0.67 output=2.02 cache-read=0.13 cache-write=0
			limits context=256000 max-tokens=32000
		}
		model "deepseek-v4-flash-0731" name="DeepSeek V4 Flash 0731" {
			reasoning #true
			input "text"
			cost input=0.45 output=0.9 cache-read=0.09 cache-write=0
			limits context=256000 max-tokens=32000
		}
		model "qwen3.8-27b" name="Qwen3.8 27B" {
			reasoning #true
			input "text" "image"
			cost input=0.67 output=3.71 cache-read=0.13 cache-write=0
			limits context=256000 max-tokens=32000
		}
		model "qwen3.6-35b-a3b" name="Qwen3.6 35B A3B" {
			reasoning #true
			input "text" "image"
			cost input=0.28 output=1.69 cache-read=0 cache-write=0
			limits context=256000 max-tokens=32000
		}
		model "qwen3.5-397b-a17b" name="Qwen3.5 397B A17B" {
			reasoning #true
			input "text" "image"
			cost input=0.67 output=4.04 cache-read=0 cache-write=0
			limits context=250000 max-tokens=16000
		}
		model "qwen3-235b-a22b-instruct-2507" name="Qwen3 235B A22B Instruct 2507" {
			reasoning #false
			input "text"
			cost input=0.84 output=2.53 cache-read=0 cache-write=0
			limits context=250000 max-tokens=16000
		}
		model "gemma-4-26b-a4b-it" name="Gemma 4 26B A4B IT" {
			reasoning #true
			input "text" "image"
			cost input=0.28 output=0.56 cache-read=0 cache-write=0
			limits context=256000 max-tokens=32000
		}
		model "mistral-medium-3.5-128b" name="Mistral Medium 3.5 128B" {
			reasoning #true
			input "text" "image"
			cost input=1.69 output=8.43 cache-read=0 cache-write=0
			limits context=180000 max-tokens=16000
		}
		model "mistral-small-3.2-24b-instruct-2506" name="Mistral Small 3.2 24B Instruct 2506" {
			reasoning #false
			input "text" "image"
			cost input=0.17 output=0.39 cache-read=0 cache-write=0
			limits context=128000 max-tokens=32000
		}
		model "llama-3.3-70b-instruct" name="Llama 3.3 70B Instruct" {
			reasoning #false
			input "text"
			cost input=1.01 output=1.01 cache-read=0 cache-write=0
			limits context=100000 max-tokens=16000
		}
	}

	thinking-mode "effort"

	// Scaleway takes OpenAI reasoning_effort on every lineage it serves —
	// never Qwen-native enable_thinking — and documents `none` as the off
	// value on every reasoning model it serves over Chat Completions, so
	// thinking-off must send `none`: omitting the field would fall back to
	// the server default (medium) and keep reasoning on.
	class "qwen" {
		thinking-format "openai"
		reasoning-disable-mode "none-effort"
	}
	class "glm" {
		reasoning-disable-mode "none-effort"
	}
	class "deepseek" {
		reasoning-disable-mode "none-effort"
	}
	class "gemma" {
		reasoning-disable-mode "none-effort"
	}
	class "mistral" {
		reasoning-disable-mode "none-effort"
	}

	// The ladders below are cascade rules rather than seed thinking so they
	// also reach bare discovered rows that have no bundled reference yet.
	// GLM 5.3 diverges from the lineage glob (classes/glm.kdl priority=10:
	// low/high/max, thinking cannot be disabled): Scaleway's card documents
	// none/low/high/max and `none` is verified to disable reasoning, so this
	// residue outranks the glob; the default effort stays the lineage's `max`.
	models "glm-5.3" priority=20 {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
		thinking-requires-effort #false
	}
	// GLM 5.2 documents none/high/max, dropping the lineage's
	// minimal/low/medium tiers.
	models "glm-5.2" priority=20 {
		thinking-upgrade-neutral #true
		thinking-efforts "high" "max"
		thinking-default-level "max"
		thinking-requires-effort #false
	}
	// DeepSeek Flash ladders match the lineage's wire-exact low/high/max;
	// `none` is documented on both cards. Restated here because the
	// vendor-suffixed -v4.1-flash and dated -0731 ids have no same-id census
	// row the family ladder could ride in on.
	models "deepseek-v4.1-flash" "deepseek-v4-flash-0731" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "high" "max"
	}
	// Qwen cards: 3.8 keeps its native xhigh tier; 3.6 and 3.5 stop at high.
	models "qwen3.8-27b" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "medium" "xhigh"
	}
	models "qwen3.6-35b-a3b" "qwen3.5-397b-a17b" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "medium" "high"
	}
	// Gemma 4 documents none/low/medium/high.
	models "gemma-4-26b-a4b-it" {
		thinking-upgrade-neutral #true
		thinking-efforts "low" "medium" "high"
	}
	// Mistral Medium 3.5 documents none/high only; the server default
	// (medium) is not a valid tier, so the omp default pins high.
	models "mistral-medium-3.5-128b" {
		thinking-upgrade-neutral #true
		thinking-efforts "high"
		thinking-default-level "high"
	}
}
