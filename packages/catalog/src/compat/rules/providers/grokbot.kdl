// Provider-wire compat for "grokbot" (sand InferenceService).
// Offline seed effort ladders are rule-owned here so buildModel derives them
// from neutral seeds instead of TypeScript per-id branches.

provider "grokbot" {
	// Anthropic rejects composed tool schemas added by product Read/Write aliases.
	// Live Opus 5 medium: identical three-tool request fails 400 before projection,
	// then emits a valid Shell call with the shared Cursor schema projection.
	class "anthropic" {
		requires-cursor-tool-schema-projection #true
	}
	// AvailableModels / seed-owned ladders must survive generate-models rebake,
	// and buildModel must not invent fallback efforts when no thinking-efforts
	// rule matched (routers, fast-only, unrecognized upstream-only values).
	preserve-authored-thinking #true
	// Live discovery owns limits/modality; gen:models must not backfill from
	// canonical-family or stencil.so same-id references.
	credential-scoped-catalog #true
	// Synthetic routers + offline seeds: reviewed budgeting floor when live
	// AvailableModels omits contextTokenLimit (proto3 zero/absent).
	// Synthetic sand-default router: reviewed reasoning capability (discovery/seeds stay neutral).
	models "sand-default" {
		reasoning #true
		sand-tools-wire "parent-chat"
		sand-promote-json-text-tools #true
	}
	models "sand-cua" {
		sand-tools-wire "parent-chat"
		sand-promote-json-text-tools #true
	}
	models "sand-automation" {
		sand-tools-wire "automation"
		sand-promote-json-text-tools #true
	}
	// Auto / default sand routers land on cursor-grok-4.5-high with native omp
	// tools (HTTP 422). Product parent-chat is the same wire as sand-default;
	// rewrite requestedModel to bare sand-default so a Read/Write follow-up
	// does not hang mid-tool on cursor-grok-4.5-high. sand-default / sand-cua
	// omit sand-wire-model-id so the product wire keeps their router ids.
	// sand-wire-model-id-when=tools keeps text-only turns on the selected Auto id.
	models "default" "default[]" "auto" "auto[]" {
		sand-tools-wire "parent-chat"
		sand-wire-model-id "sand-default"
		sand-wire-model-id-when "tools"
		sand-promote-json-text-tools #true
	}
	// Live AvailableModels still lists gemini-3-flash / gemini-3-flash[], but
	// that slug empty-bodies on tools. The working peer is gemini-3.8-flash
	// (and its effort variants). Rewrite requestedModel to a bare 3.8-flash
	// only when tools are present; text-only keeps the listed slug.
	models "gemini-3-flash" "gemini-3-flash[]" {
		sand-wire-model-id "gemini-3.8-flash"
		sand-wire-model-id-when "tools"
		sand-promote-json-text-tools #true
	}
	models "sand-default" "sand-cua" "sand-automation" "default" "default[]" "auto" "auto[]" {
		context-window-floor 200000
	}
	// Static offline seed for grok-4.6: exact selector so cascade upgrades
	// target.reasoning (thinking axes are gated; globs do not unlock).
	// Live AvailableModels may report reasoning:false; discovery marks that
	// with an empty thinking ladder so preserve-authored-thinking keeps
	// buildModel from OR-upgrading the capability surface.
	models "grok-4.6" {
		reasoning #true
		thinking-mode "effort"
		thinking-efforts "low" "medium" "high" "xhigh"
		context-window-floor 200000
		sand-parameter-ids "effort" "fast"
	}
	// Sand rejects any tools payload for grok-4.5 (HTTP 422); keep text-only.
	models "grok-4.5*" {
		supports-tools #false
	}
}
