// Provider-wire compat for "google-vertex"; regenerated from the frozen census using deployment contract selectors.

provider "google-vertex" {
	class "anthropic" {
		revision ">=4.5 <4.6" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*latest" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai/gpt-oss-120b-maas" {
		thinking-mode "effort"
	}
}
