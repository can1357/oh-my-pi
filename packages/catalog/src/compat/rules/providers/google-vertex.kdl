// Provider-wire compat for "google-vertex"; regenerated from the frozen census using deployment contract selectors.

provider "google-vertex" {
	default-model "gemini-3.1-pro-preview"
	allow-unauthenticated #true
	image-count-budget 200
	// Vertex publishes Anthropic ids pinned to a revision (`claude-opus-4-8@default`);
	// `google-vertex/claude-opus-4-8` names that model exactly.
	selector-revision-suffix "@default"

	// Replaces google-shared.ts stripping functionCall/functionResponse ids for Vertex.
	supports-function-part-id #false
	// Replaces the hard-coded provider exclusion in anthropic.ts context_management gating.
	supports-context-management #false
	// Vertex rejects `output_config.effort` and its effort beta header;
	// replaces the provider checks in anthropic.ts request shaping.
	supports-output-effort #false

	// Vertex rejects maxOutputTokens=65536 for the Gemini 2.5 Flash-Lite line
	// with 400 "supported range is from 1 (inclusive) to 65536 (exclusive)";
	// the 2.5 Flash/Pro siblings accept 65536 on the same endpoint (Pro does
	// not validate the field at all), so only the Lite line is clamped here.
	// Other hosts are unverified and keep the documented value.
	class "gemini" {
		family "lite" {
			revision ">=2.5 <2.6" {
				limits-patch {
					max-tokens 65535
				}
			}
		}
	}
	class "anthropic" {
		// Vertex rawPredict honors `cache_control.ttl: "1h"` (writes bill to
		// `ephemeral_1h_input_tokens`, entries outlive 5m) without any beta; the
		// `extended-cache-ttl-2025-04-11` beta is rejected in `anthropic_beta`.
		supports-long-cache-retention #true
		revision ">=4.5 <4.6" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*latest" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai/gpt-oss-120b-maas" {
		thinking-mode "effort"
	}
}
