// Provider-wire compat for "google-vertex"; regenerated from the frozen census using deployment contract selectors.

provider "google-vertex" {
	// Replaces google-shared.ts stripping functionCall/functionResponse ids for Vertex.
	supports-function-part-id #false
	// Replaces the hard-coded provider exclusion in anthropic.ts context_management gating.
	supports-context-management #false
	// Vertex rejects `output_config.effort` and its effort beta header;
	// replaces the provider checks in anthropic.ts request shaping.
	supports-output-effort #false
	class "anthropic" {
		revision ">=4.5 <4.6" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*latest" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai/gpt-oss-120b-maas" {
		thinking-mode "effort"
	}
}
