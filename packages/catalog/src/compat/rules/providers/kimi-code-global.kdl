// Provider-wire compat for "kimi-code-global", the kimi.ai global Kimi Code
// deployment. Mirrors "kimi-code" (mainland China); keep the two in sync.

provider "kimi-code-global" {
	default-model "kimi-for-coding"
	dynamic-models-authoritative #true
	// Global Kimi Code keys are not interchangeable with mainland `KIMI_API_KEY`
	// keys, so this provider owns a dedicated env var; runtime resolution and
	// discovery select this provider's regional base URL.
	env "KIMI_CODE_GLOBAL_API_KEY"
	// Managed `/coding/v1` base URL (chat, models, usages, search); mirrors the
	// official client's region profile. The global deployment has no base URL
	// override env (the official client's `KIMI_BASE_URL` fork only rewrites the
	// mainland api.kimi.com deployment).
	base-url "https://api.kimi.ai/coding/v1"
	// Kimi Code managed endpoint: the dedicated Kimi stream dispatcher handles
	// its streams, requests carry the shared Kimi CLI client headers, and both
	// transports (OpenAI completions, Anthropic messages) share one prompt-cache
	// affinity identity.
	kimi-code-endpoint #true
	discovery label="Kimi Code (Global)"

	class "kimi" {
		// Replaces the native Kimi provider thinking-format branch.
		thinking-format "zai"
		family "k3" {
			thinking-format "openai"
		}
	}
	// Kimi Code serves the K2 chat template on every model; heal leaked
	// section/tool-call markup regardless of family.
	stream-markup-healing-pattern "kimi"
	// Replaces streamKimi's TS fallback for models whose discovery metadata omits the protocol.
	kimi-api-format "anthropic"
	// Kimi Code derives cache routing from top-level `prompt_cache_key` on
	// chat completions; replaces the provider check in the request builder.
	supports-prompt-cache-key #true
	thinking-mode "effort"
	// /models omits `supports_image_in` for K2.5, which is vision-capable on
	// the coding endpoint; the correction is rule-owned.
	class "kimi" {
		family "k2.5" {
			input-modalities "text" "image"
		}
	}
	class "unknown" {
		reasoning-content-field "reasoning_content"
		supports-developer-role #false
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-format "kimi"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "kimi-for*" {
		reasoning-content-field "reasoning_content"
		supports-developer-role #false
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-format "zai"
	}
	// K2.7 Code Highspeed always thinks (`supports_thinking_type: "only"`) but
	// exposes no adjustable effort ladder (`think_efforts` is omitted).
	models "kimi-for-coding-highspeed" {
		thinking-efforts
	}

	// /coding/v1/models carries no pricing. `cost-fallback` seeds the public
	// Moonshot list price only when discovery reports $0, so a future priced
	// envelope keeps its real rates. `kimi-for-coding` is K2.8 Preview — no
	// public API SKU exists yet, so it uses the K2.7 Code line rate.
	// K3 bills cache writes at the default 5m TTL rate (omp never requests
	// 1h); K2.x SKUs have no cache-write charge.
	// https://platform.kimi.ai/docs/guide/context-caching
	models "k3" "k3-256k" {
		cost-fallback {
			input 3.0
			output 15.0
			cache-read 0.3
			cache-write 3.0
		}
	}
	models "k3.1-pro" {
		cost-fallback {
			input 2.0
			output 10.0
			cache-read 0.2
			cache-write 2.0
		}
	}
	models "k3.1-pro-highspeed" {
		cost-fallback {
			input 4.0
			output 20.0
			cache-read 0.2
			cache-write 4.0
		}
	}
	models "kimi-for-coding" {
		cost-fallback {
			input 0.95
			output 4.0
			cache-read 0.19
		}
	}
	models "kimi-for-coding-highspeed" {
		cost-fallback {
			input 1.9
			output 8.0
			cache-read 0.38
		}
	}
	// Moonshot K2 list (`kimi-k2-0711-preview` / `kimi-k2-0905-preview`), not K2.6.
	models "kimi-k2" {
		cost-fallback {
			input 0.6
			output 2.5
			cache-read 0.15
		}
	}
	models "kimi-k2.5" {
		cost-fallback {
			input 0.6
			output 3.0
			cache-read 0.1
		}
	}
	models "kimi-k2-turbo-preview" {
		cost-fallback {
			input 2.4
			output 10.0
			cache-read 0.6
		}
	}
}
