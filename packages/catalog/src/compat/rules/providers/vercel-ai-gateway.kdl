// Provider-wire compat for "vercel-ai-gateway"; regenerated from the frozen census using deployment contract selectors.

provider "vercel-ai-gateway" {
	default-model "anthropic/claude-opus-5"
	env "AI_GATEWAY_API_KEY"
	discovery label="Vercel AI Gateway" allow-unauthenticated=#true {
		env "VERCEL_AI_GATEWAY_API_KEY"
	}

	// convaiinnovations/laya-free is a temporary promo model expiring 2026-10-31;
	// author only the long-lived stable evaluation models here.
	seed api="typesafe" base-url="https://ai-gateway.vercel.sh" bundle="always" {
		model "typesafe-ai/jev" name="Jev" {
			reasoning #false
			input "text"
			cost input=0.042 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "microsoft/microsoft-decision-1" name="Decision-1" {
			reasoning #false
			input "text"
			cost input=0.042 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "liquid/d1" name="Liquid d1" {
			reasoning #false
			input "text" "image"
			cost input=0.04 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
		model "openai/gpt-6-luna-decisions" name="GPT-6 Luna Decisions" {
			reasoning #false
			input "text" "image"
			cost input=0.1 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
	}

	// residue: evaluation rows are runtime-discovered ids no selector can
	// isolate; the typesafe-scoped /v1/evaluate wire facts cover them all
	// since chat rows are excluded.
	on-api "typesafe" {
		models "*" {
			judgment {
				route "/v1/evaluate"
				type-map {
					noul "boolean"
				}
				value-map {
					noul "probability"
				}
				usage-map {
					input "inputTokens"
					output "outputTokens"
				}
			}
		}
		// residue: chat rows are anthropic-messages so excluded; future eval ids
		// covered automatically.
		models "*" {
			kind "judge"
		}
	}

	// Live /v1/models reports text-only modalities with no vision tag, but
	// first-party luna seed + upstream description confirm image input.
	models "openai/gpt-6-luna-decisions" {
		input-modalities "text" "image"
	}

	// residue: the bare `deepseek/*` namespace rides the Anthropic route, whose
	// ladder is the generic five-tier scale.
	models "deepseek/*" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	class "anthropic" {
		revision ">=3.7 <4.6" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	class "gemini" {
		revision ">=3 <3.7" {
			thinking-mode "budget"
		}
	}
	class "mimo" {
		family "v2" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
			thinking-mode "budget"
		}
	}
	class "stepfun" {
		family "step" {
			thinking-mode "budget"
		}
	}
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "budget"
	}
	class "xai" {
		family "grok" {
			thinking-mode "budget"
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*fast-reasoning" "alibaba*thinking" "meituan/longcat-flash-thinking*" \
		"*grok-4.20-reasoning*" "arcee-ai/trinity-large-thinking" "openai/gpt-5.1-thinking*" {
		thinking-requires-effort #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "alibaba/qwen3-max" {
		replay-unsigned-thinking #false
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "amazon/nova-2-lite" {
		thinking-mode "budget"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "deepseek/deepseek-v3.1*" "deepseek/deepseek-v3.2" {
		requires-reasoning-content-for-all-assistant-turns #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "deepseek/deepseek-v3.2-thinking" {
		requires-reasoning-content-for-all-assistant-turns #true
		thinking-requires-effort #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai/codex-mini" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai/gpt-5.1-codex" "openai/gpt-5.1-codex-max" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai/gpt-5.1-codex-mini" {
		thinking-efforts "medium" "high"
	}
}
