// Provider-wire compat for "yolo-auto"; wire constraints apply to every discovered model.

provider "yolo-auto" {
	default-model "deepseek-flash-v4"
	env "YOLO_AUTO_API_KEY"
	dynamic-models-authoritative #true
	discovery label="Yolo-Auto"

	// Documented Yolo-Auto catalog (yolo-auto.com/docs, 2026-08) bundled so the
	// provider is usable when generation and first boot have no live key. The
	// flat-rate `/v1/models` response is authoritative once discovery runs.
	// The compat block mirrors the provider's documented wire surface: the API
	// speaks the generic chat template with `reasoning_effort` support and rejects
	// the `developer` role and `store` param.
	seed api="openai-completions" base-url="https://yolo-auto.com/v1" bundle="fallback" {
		model "deepseek-flash-v4" name="DeepSeek Flash V4" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=131072
			thinking-mode "effort"
			thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
			thinking-effort-map { minimal "low"; low "low"; medium "high"; high "high"; xhigh "max"; max "max" }
			supports-developer-role #false
			supports-store #false
			supports-reasoning-effort #true
			thinking-format "chat-template"
		}
	}

	supports-developer-role #false
	supports-store #false
	models "deepseek-flash-v4" {
		disable-reasoning-on-tool-choice #true
		max-tokens-field "max_completion_tokens"
		requires-reasoning-content-for-all-assistant-turns #true
		requires-reasoning-content-for-tool-calls #true
		supports-reasoning-effort #true
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
		thinking-format "chat-template"
		thinking-mode "effort"
	}
}
