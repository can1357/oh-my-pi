// Provider-wire compat for "yolo-auto"; wire constraints apply to every discovered model.

provider "yolo-auto" {
	default-model "qwen3.8-27b"
	env "YOLO_AUTO_API_KEY"
	dynamic-models-authoritative #true
	discovery label="Yolo-Auto"

	// Documented Yolo-Auto catalog (yolo-auto.com/models, yolo-auto.com/docs,
	// 2026-10): `qwen3.8-27b`, `yolo`, `yolo-small` (256K) and `yolo-128k`
	// (128K), all paid-only. `qwen3.8-27b` is the recommended default; the
	// `yolo` route is currently backed by the same Qwen3.8-27B deployment
	// (its server-side target can change). The flat-rate `/v1/models`
	// response is authoritative once discovery runs. Without provider-local
	// seeds the bare `qwen3.8-27b` slug resolves through the global reference
	// index, which prefers the largest bundled window (1M) and misreports the
	// deployment cap. The compat block mirrors the provider's documented wire
	// surface: the API speaks the Qwen chat-template dialect with
	// `reasoning_effort` support and rejects the `developer` role and `store`
	// param. `yolo-small` and `yolo-128k` are documented only by id and
	// context, and their `/v1/models` rows advertise no thinking ladder, so
	// they seed as plain text routes until the provider documents more.
	seed api="openai-completions" base-url="https://yolo-auto.com/v1" bundle="fallback" {
		model "qwen3.8-27b" name="Qwen3.8-27B" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=131072
			thinking-mode "effort"
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
			supports-developer-role #false
			supports-store #false
			supports-reasoning-effort #true
			thinking-format "qwen-chat-template"
			template-reasoning-effort #true
		}
		model "yolo" name="Yolo" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=131072
			thinking-mode "effort"
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
			supports-developer-role #false
			supports-store #false
			supports-reasoning-effort #true
			thinking-format "qwen-chat-template"
			template-reasoning-effort #true
		}
		model "yolo-small" name="Yolo Small" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144
			supports-developer-role #false
			supports-store #false
		}
		model "yolo-128k" name="Yolo 128K" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=131072
			supports-developer-role #false
			supports-store #false
		}
	}

	supports-developer-role #false
	supports-store #false
	// Live /v1/models advertises `thinking: minimal..xhigh` for the Qwen3.8
	// rows; the cascade rule carries it into the regenerated bundle, whose
	// thinking re-bake ignores seed-level ladders.
	models "qwen3.8-27b" "yolo" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
