// Provider-wire compat for "doubleword".

provider "doubleword" {
	default-model "deepseek-ai/DeepSeek-V4-Flash"
	env "DOUBLEWORD_API_KEY"
	dynamic-models-authoritative #true
	// Deliberately NO `discovery` node: `/v1/models` needs a key and ships
	// nothing but ids, so a generated snapshot would bake a roster with no
	// metadata and freeze it. Discovery is runtime-only, where the bundled
	// reference index supplies each id's real limits (same shape as
	// charm-hyper, pinned runtime-only in compat-conformance.test.ts).
	// Doubleword prices the serving path, and the cheaper asynchronous path is
	// opt-in on the wire: a request that omits `service_tier` is served at the
	// realtime rate (verified — the response echoes `service_tier: "default"`).
	// Declaring the field supported enrolls these models in the `openai`
	// service-tier family, so the OpenAI tier setting and `/fast` drive them;
	// the default then makes async the resting state, with `/fast`
	// (`priority`) switching a turn back to realtime.
	supports-service-tier #true
	default-service-tier "flex"
	// Realtime is Doubleword's standard rate, not a premium serving path — the
	// endpoint answers a `priority` request with `service_tier: "default"`. The
	// API-generic 2x priority multiplier would over-report those turns.
	service-tier-cost {
		priority 1
	}
}
