// Provider-wire compat for "bedrock-mantle"; regenerated from the frozen census using deployment contract selectors.

provider "bedrock-mantle" {
	default-model "openai.gpt-5.6-terra"
	env "AWS_BEARER_TOKEN_BEDROCK"
	dynamic-models-authoritative #true

	// OpenAI frontier models served exclusively through Bedrock Mantle's Responses
	// endpoint. Pricing is per million tokens from the Amazon Bedrock pricing page.
	seed api="openai-responses" base-url="https://bedrock-mantle.{region}.api.aws/openai/v1" bundle="always" {
		model "openai.gpt-5.4" name="GPT-5.4" {
			reasoning #true
			input "text" "image"
			cost input=2.75 output=16.5 cache-read=0.275 cache-write=0
			limits context=272000 max-tokens=128000
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high" "xhigh"
		}
		model "openai.gpt-5.5" name="GPT-5.5" {
			reasoning #true
			input "text" "image"
			cost input=5.5 output=33 cache-read=0.55 cache-write=0
			limits context=272000 max-tokens=128000
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high" "xhigh"
		}
		model "openai.gpt-5.6-luna" name="GPT-5.6 Luna" {
			reasoning #true
			input "text" "image"
			cost input=0.22 output=1.32 cache-read=0.022 cache-write=0.275
			limits context=272000 max-tokens=128000
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high" "xhigh" "max"
		}
		model "openai.gpt-5.6-sol" name="GPT-5.6 Sol" {
			reasoning #true
			input "text" "image"
			cost input=5.5 output=33 cache-read=0.55 cache-write=6.88
			limits context=272000 max-tokens=128000
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high" "xhigh" "max"
		}
		model "openai.gpt-5.6-terra" name="GPT-5.6 Terra" {
			reasoning #true
			input "text" "image"
			cost input=2.2 output=13.2 cache-read=0.22 cache-write=2.75
			limits context=272000 max-tokens=128000
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high" "xhigh" "max"
		}
	}

	class "unknown" {
		thinking-mode "effort"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai.gpt-5.4" "openai.gpt-5.5" {
		thinking-efforts "low" "medium" "high" "xhigh"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai.gpt-5.6*" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
}
