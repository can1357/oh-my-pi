	// Upstream serving regions (the CLI's upstream region table). A model's own
	// `region-upstreams-*` rule replaces its region's set (the CLI's
	// regionOverrides): it may enable an upstream this table omits (EU Mistral),
	// and a bare directive means the region does not serve the model.
	region-upstreams-global "fireworks" "baseten" "mistral" "anthropic" "azure_anthropic" "vertex_anthropic" \
		"bedrock_anthropic" "openai" "azure_openai" "bedrock_openai" "google" "xai" "snowflake" "databricks"
	region-upstreams-us "baseten" "anthropic" "vertex_anthropic" "bedrock_anthropic" "openai" "bedrock_openai" \
		"google" "xai"
	region-upstreams-eu "vertex_anthropic" "bedrock_anthropic" "openai" "bedrock_openai"

	// Per-model registry entries: live-routing family, upstream rotation (first
	// entry is the default `x-api-provider`), region overrides, Standard Credits
	// rates, list-price source, org-policy aliases, the effort ladder (an off/none
	// rung means `thinking-requires-effort #false`), and account gates.
	models "claude-fable-5.1" {
		routing-family "anthropic"
		upstream-rotation "anthropic" "vertex_anthropic" "bedrock_anthropic"
		region-upstreams-eu
		credit-rates { input 4; output 5; cache-read 0.025 }
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		thinking-requires-effort #false
		thinking-default-level "high"
		entitlement { requires-explicit-opt-in #true }
	}
	models "claude-fable-5" {
		routing-family "anthropic"
		upstream-rotation "anthropic" "vertex_anthropic" "bedrock_anthropic"
		region-upstreams-eu
		credit-rates { input 4; output 5 }
		list-price-from "anthropic"
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		thinking-requires-effort #false
		thinking-default-level "high"
		entitlement { requires-explicit-opt-in #true }
	}
	models "claude-opus-5-5" {
		routing-family "anthropic"
		upstream-rotation "anthropic" "vertex_anthropic" "bedrock_anthropic" "azure_anthropic" "snowflake"
		credit-rates { input 1.6; output 5; cache-read 0.05 }
		list-price-from "anthropic"
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		thinking-requires-effort #true
		thinking-default-level "medium"
	}
	models "claude-opus-5-5-fast" {
		routing-family "anthropic"
		upstream-rotation "anthropic"
		credit-rates { input 3.2; output 5; cache-read 0.05 }
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		thinking-requires-effort #true
		thinking-default-level "medium"
		entitlement { feature-flag "claude_opus_5_5_fast"; base-variant "claude-opus-5-5" }
	}
	models "claude-opus-5" {
		routing-family "anthropic"
		upstream-rotation "anthropic" "vertex_anthropic" "bedrock_anthropic" "azure_anthropic" "snowflake"
		region-upstreams-eu "bedrock_anthropic"
		credit-rates { input 2 }
		list-price-from "anthropic"
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		thinking-requires-effort #false
		thinking-default-level "high"
	}
	models "claude-opus-5-fast" {
		routing-family "anthropic"
		upstream-rotation "anthropic"
		credit-rates { input 4 }
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		thinking-requires-effort #false
		thinking-default-level "high"
		entitlement { base-variant "claude-opus-5" }
	}
	models "claude-opus-4-8" {
		routing-family "anthropic"
		upstream-rotation "anthropic" "vertex_anthropic" "bedrock_anthropic" "azure_anthropic" "snowflake"
		region-upstreams-eu "bedrock_anthropic"
