	}
	models "claude-haiku-4-5-20251001" {
		routing-family "anthropic"
		upstream-rotation "anthropic" "vertex_anthropic" "bedrock_anthropic"
		region-upstreams-us "vertex_anthropic" "bedrock_anthropic"
