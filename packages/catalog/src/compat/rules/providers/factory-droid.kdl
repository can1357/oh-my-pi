// Factory Droid: the native CLI's model registry plus the request dialect each
// selected upstream speaks. These are Factory contracts, NOT direct-host
// inheritance. Registry facts are reviewed against the CLI version pinned by
// FACTORY_DROID_CLIENT_VERSION (wire/factory-droid.ts); request ground truth is
// the native CLI's own traffic: packages/ai/test/fixtures/
// factory-droid-native-requests.json, checked by factory-droid-native-parity.test.ts.
// Each model's wire and billing pool live in runtime/behavior.kdl
// (`api-routes` / `quota-tiers provider="factory-droid"`).
provider "factory-droid" {
	default-model "kimi-k3"
	allow-unauthenticated #true
	dynamic-models-authoritative #true
	// Native subscription limits are not direct-host price-tier or capacity heuristics.
	context-window-authoritative #true

	// The registry roster. Factory has no model-listing endpoint, so first-party
	// clients ship this list and narrow it per account with feature flags, org
	// policy and live routing (discovery/factory-droid.ts). The rows never enter
	// models.json: gated models must stay hidden until live flags prove access,
	// and each account rebuilds them on its residency host and wire path. Cost is
	// zero here because Factory bills credits; `list-price-from` supplies the
	// upstream list price shown beside the credit rate.
	seed api="factory-droid-agent" base-url="https://api.factory.ai" bundle="never" {
		model "claude-fable-5.1" name="Fable 5.1" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=867000 max-tokens=128000
		}
		model "claude-fable-5" name="Fable 5" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=867000 max-tokens=128000
		}
		model "claude-opus-5-5" name="Opus 5.5" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=872000 max-tokens=128000
		}
		model "claude-opus-5-5-fast" name="Opus 5.5 Fast Mode" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=872000 max-tokens=128000
		}
		model "claude-opus-5" name="Opus 5" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=867000 max-tokens=128000
		}
		model "claude-opus-5-fast" name="Opus 5 Fast Mode" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
