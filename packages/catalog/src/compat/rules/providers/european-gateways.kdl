// Reviewed fallback metadata for the European OpenAI-compatible gateways.
// Static seeds retain only identity and transport; buildModel applies these
// facts equally to offline seeds and sparse discovery rows.

provider "aki-io" {
	models "kimi-k2.7-code-1100b" {
		cost-patch {
			input 0.86
			output 3.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-patch {
			context-window 262144
			max-tokens 262144
		}
		reasoning #true
		supports-tools #true
	}
}

provider "melious" {
	models "gpt-oss-120b" {
		cost-patch {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-patch {
			context-window 131000
			max-tokens 8192
		}
		reasoning #true
	}
}

