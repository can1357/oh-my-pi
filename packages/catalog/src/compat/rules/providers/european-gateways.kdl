// Reviewed fallback metadata for the European OpenAI-compatible gateways.
// Static seeds retain only identity and transport; buildModel applies these
// facts equally to offline seeds and sparse discovery rows. Pricing, limits,
// input modalities, reasoning, and tool capability rules are fallbacks so
// explicit provider metadata remains authoritative.

provider "aki-io" {
	models "kimi-k2.7-code-1100b" {
		cost-fallback {
			input 0.86
			output 3.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 262144
			max-tokens 262144
		}
		reasoning-fallback #true
		supports-tools-fallback #true
	}
}

provider "melious" {
	models "gpt-oss-120b" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 131000
			max-tokens 8192
		}
		reasoning-fallback #true
	}
}

provider "nebius" {
	models "Qwen/Qwen3-235B-A22B-Instruct-2507" {
		cost-fallback {
			input 0.2
			output 0.6
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 262144
			max-tokens 262144
		}
		supports-tools-fallback #true
	}
}

provider "cortecs" {
	models "gpt-oss-120b" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 131000
			max-tokens 8192
		}
		reasoning-fallback #true
	}
}

provider "eurouter" {
	models "mistral-large-3" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		input-modalities-fallback "text" "image"
		limits-fallback {
			context-window 262144
		}
	}
}

provider "scaleway" {
	models "glm-5.2" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 256000
			max-tokens 16000
		}
		reasoning-fallback #true
		supports-tools-fallback #true
	}
}

provider "opper" {
	models "mistral/devstral-2512" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 262144
			max-tokens 262144
		}
		supports-tools-fallback #true
	}
}

provider "ovhcloud" {
	models "gpt-oss-120b" {
		cost-fallback {
			input 0.09
			output 0.47
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 131072
			max-tokens 131072
		}
		reasoning-fallback #true
		supports-tools-fallback #true
	}
}

// Grok reasoning revisions are a reviewed gateway fallback. Keep this
// deployment-specific capability in the compatibility policy so new gateway
// mappings do not require a second TypeScript revision table.
class "xai" {
	on "aki-io" "melious" "nebius" "cortecs" "eurouter" "scaleway" "opper" "ovhcloud" {
		family "grok" {
			revision "=3" {
				reasoning-fallback #true
			}
			revision "=4.3" {
				reasoning-fallback #true
			}
			revision "=4.5" {
				reasoning-fallback #true
			}
			revision "=4.6" {
				reasoning-fallback #true
			}
			revision "=4.20" {
				reasoning-fallback #true
			}
		}
	}
}
