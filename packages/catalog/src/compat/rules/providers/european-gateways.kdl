// Reviewed fallback metadata for the European OpenAI-compatible gateways.
// Static seeds retain only identity and transport; buildModel applies these
// facts equally to offline seeds and sparse discovery rows. Pricing, limits,
// input modalities, reasoning, and tool capability rules are fallbacks so
// explicit provider metadata remains authoritative.

provider "aki-io" {
	default-model "kimi-k2.7-code-1100b"
	env "AKI_API_KEY"
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="AKI.IO"
	models "kimi-k2.7-code-1100b" {
		cost-fallback {
			input 0.86
			output 3.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 262144
			max-tokens 262144
		}
		reasoning-fallback #true
		supports-tools-fallback #true
	}
}

provider "melious" {
	default-model "gpt-oss-120b"
	env "MELIOUS_API_KEY"
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="Melious"
	models "gpt-oss-120b" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 131000
			max-tokens 8192
		}
		reasoning-fallback #true
	}
}

provider "nebius" {
	default-model "Qwen/Qwen3-235B-A22B-Instruct-2507"
	env "NEBIUS_API_KEY"
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="Nebius Token Factory"
	models "Qwen/Qwen3-235B-A22B-Instruct-2507" {
		cost-fallback {
			input 0.2
			output 0.6
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 262144
			max-tokens 262144
		}
		supports-tools-fallback #true
	}
}

provider "cortecs" {
	default-model "gpt-oss-120b"
	env "CORTECS_API_KEY"
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="Cortecs" allow-unauthenticated=#true
	models "gpt-oss-120b" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 131000
			max-tokens 8192
		}
		reasoning-fallback #true
	}
}

provider "eurouter" {
	default-model "mistral-large-3"
	env "EUROUTER_API_KEY"
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="EUrouter" allow-unauthenticated=#true
	models "mistral-large-3" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		input-modalities-fallback "text" "image"
		limits-fallback {
			context-window 262144
		}
	}
}

provider "opper" {
	default-model "mistral/devstral-2512"
	env "OPPER_API_KEY"
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="Opper"
	models "mistral/devstral-2512" {
		cost-fallback {
			input 0.0
			output 0.0
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 262144
			max-tokens 262144
		}
		supports-tools-fallback #true
	}
}

provider "ovhcloud" {
	default-model "gpt-oss-120b"
	env "OVH_AI_ENDPOINTS_ACCESS_TOKEN"
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="OVHcloud AI Endpoints" allow-unauthenticated=#true
	models "gpt-oss-120b" {
		cost-fallback {
			input 0.09
			output 0.47
			cache-read 0.0
			cache-write 0.0
		}
		limits-fallback {
			context-window 131072
			max-tokens 131072
		}
		reasoning-fallback #true
		supports-tools-fallback #true
	}
}

// Grok reasoning revisions are a reviewed gateway fallback. Keep this
// deployment-specific capability in the compatibility policy so new gateway
// mappings do not require a second TypeScript revision table.
class "xai" {
	on "aki-io" "melious" "nebius" "cortecs" "eurouter" "opper" "ovhcloud" {
		family "grok" {
			revision "=3" {
				reasoning-fallback #true
			}
			revision "=4.3" {
				reasoning-fallback #true
			}
			revision "=4.5" {
				reasoning-fallback #true
			}
			revision "=4.6" {
				reasoning-fallback #true
			}
			revision "=4.20" {
				reasoning-fallback #true
			}
		}
	}
}
