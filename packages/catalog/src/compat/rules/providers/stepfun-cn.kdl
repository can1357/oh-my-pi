// Provider-wire compat for "stepfun-cn" (StepFun Step Plan, China).
// Chat Completions base URL: https://api.stepfun.com/step_plan/v1
// The pay-as-you-go Open Platform is the separate `stepfun` provider
// (`api.stepfun.ai`, `STEPFUN_API_KEY`). Those keys do not authorize this host.
// Costs are zero because the plan debits monthly credits, not a USD meter.

provider "stepfun-cn" {
	default-model "step-5-preview"
	env "STEPFUN_CN_API_KEY"
	// A successful `/models` snapshot replaces the bundled seed, so a model
	// the plan retires leaves the picker instead of staying selectable.
	dynamic-models-authoritative #true
	// Relay hosts serve the same ids with stray ceilings and broader ladders.
	// This deployment's seed is the source for limits and capabilities.
	skip-cross-provider-reference-fills #true
	discovery label="StepFun Step Plan (China)"

	// Documented Step Plan chat roster, bundled so the provider is selectable
	// before the first discovery. `/models` also lists StepAudio speech SKUs;
	// runtime/behavior.kdl drops those prefixes.
	// step-3.5 and step-3.7 publish a 256K window and no completion cap.
	// step-5-preview publishes a 1M window. The chat-completions transport
	// still clamps a sent output cap at 64K, so the seed records that ceiling.
	// step-router-v1 can land on step-3.7-flash (256K) or deepseek-v4-pro (1M);
	// the shared id keeps the smaller window so a flash route is not overfilled.
	seed api="openai-completions" base-url="https://api.stepfun.com/step_plan/v1" bundle="always" {
		model "step-5-preview" name="Step 5 Preview" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=64000
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high"
		}
		model "step-3.7-flash" name="Step 3.7 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=256000
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high"
		}
		model "step-3.5-flash" name="Step 3.5 Flash" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=256000
			thinking-mode "effort"
			thinking-efforts "low" "high"
		}
		model "step-3.5-flash-2603" name="Step 3.5 Flash 2603" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=256000
			thinking-mode "effort"
			thinking-efforts "low" "high"
		}
		model "step-router-v1" name="Step Router V1" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=256000
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high"
		}
	}

	// The Step Plan chat API documents `max_tokens`. `store` and `developer`
	// are absent from that surface.
	max-tokens-field "max_tokens"
	supports-developer-role #false
	supports-store #false
	supports-reasoning-effort #true
	// Step Plan returns thinking as `reasoning` and as `reasoning_content`.
	// step-router-v1 can hand multi-turn tool work to deepseek-v4-pro, which
	// needs the prior reasoning text on tool-call turns and rejects a synthetic
	// placeholder, so the real text is replayed.
	reasoning-content-field "reasoning_content"
	requires-reasoning-content-for-tool-calls #true
	allows-synthetic-reasoning-content-for-tool-calls #false

	// The shared stepfun class ladder (minimal…xhigh) documents relay hosts.
	// Step Plan exposes low/medium/high. Scoped by family, not revision: the
	// stepfun taxonomy extracts no revision.
	class "stepfun" {
		family "step" {
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high"
		}
	}
	// residue: the Step Plan chat reference documents only low and high for
	// the step-3.5 pair. The .ai Open Platform accepts medium on these ids;
	// this deployment was not re-probed, so the family ladder must not offer
	// them medium.
	models "step-3.5-flash" "step-3.5-flash-2603" {
		thinking-efforts "low" "high"
	}
	// `/models` carries no modality. These two SKUs accept images.
	models "step-5-preview" "step-3.7-flash" {
		input-modalities "text" "image"
	}
}
