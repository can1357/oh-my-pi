// Provider-wire compat for "orcarouter". OrcaRouter serves an OpenAI-compatible
// Responses API at https://api.orcarouter.ai/v1. Models are discovered dynamically
// from /v1/models. The default model is the router "orcarouter/fusion".

provider "orcarouter" {
	default-model "orcarouter/fusion"
	env "ORCA_KEY"
	discovery label="OrcaRouter" allow-unauthenticated=#true
	// The public /v1/models roster is the source of truth: rows it retires
	// stop shipping with the next generated bundle and disappear at runtime.
	dynamic-models-authoritative #true

	// Replaces the strict-mode provider whitelist entry.
	supports-strict-mode #true
	wire-model-id-mode "raw"
	thinking-mode "effort"

	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
