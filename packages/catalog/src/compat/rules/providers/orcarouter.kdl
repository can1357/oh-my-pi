// Provider-wire compat for "orcarouter". OrcaRouter serves an OpenAI-compatible
// Responses API at https://api.orcarouter.ai/v1. Models are discovered dynamically
// from /v1/models. The default model is the router "orcarouter/fusion".

provider "orcarouter" {
	default-model "orcarouter/fusion"
	env "ORCA_KEY"
	discovery label="OrcaRouter"

	// Strict tool schemas are unverified across routed upstreams; the axis
	// stays at its default until a live tool-call check confirms wire behavior.
	wire-model-id-mode "raw"
	thinking-mode "effort"

	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}