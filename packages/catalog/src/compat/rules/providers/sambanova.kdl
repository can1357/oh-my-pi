// Provider-wire compat for "sambanova". SambaNova Cloud is an OpenAI-compatible
// gateway whose roster changes often (preview models come and go on short
// notice), so the live `/v1/models` roster is authoritative. Its rows carry
// pricing and limits but no capability metadata; the selectors below own
// reasoning, thinking wire format, and image input.

provider "sambanova" {
	default-model "gpt-oss-120b"
	env "SAMBANOVA_API_KEY"
	discovery label="SambaNova"

	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true

	// `/v1/models` requires a key. This row keeps the provider visible in
	// `/model` before login; the first live roster replaces it. Rate card from
	// https://cloud.sambanova.ai/pricing.
	seed api="openai-completions" base-url="https://api.sambanova.ai/v1" bundle="fallback" {
		model "gpt-oss-120b" name="GPT OSS 120B" {
			reasoning #true
			input "text"
			cost input=0.22 output=0.59 cache-read=0 cache-write=0
			limits context=131072
		}
	}

	// `/chat/completions` documents `reasoning_effort` as low/medium/high
	// (https://docs.sambanova.ai/docs/api-reference/chat-completions/create-chat-based-completion).
	thinking-mode "effort"
	thinking-format "openai"
	class "gpt-oss" {
		thinking-efforts "low" "medium" "high"
		thinking-upgrade-neutral #true
	}
	class "minimax" {
		family "m3" {
			thinking-efforts "low" "medium" "high"
			thinking-upgrade-neutral #true
		}
	}
	// DeepSeek V3.x and Gemma 4 think only when the request sets
	// `chat_template_kwargs.enable_thinking`; it is off by default and no
	// effort reaches the template, so the ladder is one on-rung beside off
	// (https://docs.sambanova.ai/docs/en/features/text-generation).
	class "deepseek" {
		revision ">=3.1 <4" {
			thinking-format "qwen-chat-template"
			thinking-efforts "high"
			thinking-upgrade-neutral #true
		}
	}
	class "gemma" {
		revision ">=4" {
			thinking-format "qwen-chat-template"
			thinking-efforts "high"
			thinking-upgrade-neutral #true
			input-modalities "text" "image"
		}
	}
}
