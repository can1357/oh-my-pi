// Provider-wire compat for "kimi-code"; regenerated from the frozen census using deployment contract selectors.

provider "kimi-code" {
	default-model "kimi-for-coding"
	discovery label="Kimi Code" {
		env "KIMI_API_KEY"
	}

	class "kimi" {
		// Replaces the native Kimi provider thinking-format branch.
		thinking-format "zai"
		family "k3" {
			thinking-format "openai"
		}
	}
	// Replaces streamKimi's TS fallback for models whose discovery metadata omits the protocol.
	kimi-api-format "anthropic"
	// Kimi Code derives cache routing from top-level `prompt_cache_key` on
	// chat completions; replaces the provider check in the request builder.
	supports-prompt-cache-key #true
	thinking-mode "effort"
	// /models omits `supports_image_in` for K2.5, which is vision-capable on
	// the coding endpoint; the correction is rule-owned.
	class "kimi" {
		family "k2.5" {
			input-modalities "text" "image"
		}
	}
	class "unknown" {
		reasoning-content-field "reasoning_content"
		supports-developer-role #false
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-format "kimi"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "kimi-for*" {
		reasoning-content-field "reasoning_content"
		supports-developer-role #false
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-format "zai"
	}

	// /coding/v1/models carries no pricing. Bundled rows are priced at
	// generation time via the `pricing-peer` rule (runtime/behavior.kdl);
	// `cost-fallback` covers runtime-discovered rows that have no bundled
	// counterpart, seeding the public Moonshot list price only when upstream
	// reports no token price.
	models "k3" "k3-256k" {
		cost-fallback {
			input 3
			output 15
			cache-read 0.3
			cache-write 0
		}
	}
	models "kimi-for-coding" {
		cost-fallback {
			input 0.95
			output 4
			cache-read 0.19
			cache-write 0
		}
	}
	models "kimi-for-coding-highspeed" {
		cost-fallback {
			input 1.9
			output 8
			cache-read 0.38
			cache-write 0
		}
	}
	models "kimi-k2" {
		cost-fallback {
			input 0.95
			output 4
			cache-read 0.16
			cache-write 0
		}
	}
	models "kimi-k2-turbo-preview" {
		cost-fallback {
			input 2.4
			output 10
			cache-read 0.6
			cache-write 0
		}
	}
	models "kimi-k2.5" {
		cost-fallback {
			input 0.6
			output 3
			cache-read 0.1
			cache-write 0
		}
	}
}
