// Provider-wire compat for "zed-hosted"

provider "zed-hosted" {
	default-model "claude-3-7-sonnet"
	env "ZED_ACCESS_TOKEN"
	discovery label="Zed Hosted" oauth-provider="zed-hosted" {
		env "ZED_ACCESS_TOKEN"
	}

	seed api="zed-hosted" base-url="https://cloud.zed.dev" bundle="always" {
		model "claude-3-7-sonnet" name="Claude 3.7 Sonnet" {
			reasoning #true
			input "text" "image"
			cost input=3 output=15 cache-read=0.3 cache-write=3.75
			limits context=200000 max-tokens=64000
			supports-tools #true
		}
		model "claude-3-5-sonnet" name="Claude 3.5 Sonnet" {
			reasoning #false
			input "text" "image"
			cost input=3 output=15 cache-read=0.3 cache-write=3.75
			limits context=200000 max-tokens=8192
			supports-tools #true
		}
		model "claude-3-5-haiku" name="Claude 3.5 Haiku" {
			reasoning #false
			input "text" "image"
			cost input=0.8 output=4 cache-read=0.08 cache-write=1
			limits context=200000 max-tokens=8192
			supports-tools #true
		}
		model "claude-opus-4-6" name="Claude Opus 4.6" {
			reasoning #true
			input "text" "image"
			cost input=15 output=75 cache-read=1.5 cache-write=18.75
			limits context=200000 max-tokens=32000
			supports-tools #true
		}
		model "gemini-2.5-pro" name="Gemini 2.5 Pro" {
			reasoning #true
			input "text" "image"
			cost input=1.25 output=5 cache-read=0.3125 cache-write=1.25
			limits context=1000000 max-tokens=65536
			supports-tools #true
		}
		model "gemini-2.5-flash" name="Gemini 2.5 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0.075 output=0.3 cache-read=0.01875 cache-write=0.075
			limits context=1000000 max-tokens=65536
			supports-tools #true
		}
		model "gpt-4o" name="GPT-4o" {
			reasoning #false
			input "text" "image"
			cost input=2.5 output=10 cache-read=1.25 cache-write=0
			limits context=128000 max-tokens=16384
			supports-tools #true
		}
		model "o3-mini" name="o3-mini" {
			reasoning #true
			input "text"
			cost input=1.1 output=4.4 cache-read=0.55 cache-write=0
			limits context=200000 max-tokens=100000
			supports-tools #true
		}
	}
}
