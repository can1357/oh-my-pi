// Catalog entry and deployment contract for "devin".

provider "devin" {
	default-model "swe-1-6"
	env "DEVIN_API_KEY"
	dynamic-models-authoritative #true
	discovery label="Devin" oauth-provider="devin" {
		env "DEVIN_API_KEY"
	}

	// Curated Devin seed — the entire bundled surface for the provider. The
	// Cascade catalog is credential-scoped (gated per account/team), so catalog
	// generation never fetches it: baking one account's roster into the shared
	// bundle would misstate every other account's entitlements and leave zombie
	// rows behind (see CREDENTIAL_SCOPED_PROVIDERS in generate-models.ts). SWE-1.6
	// is verified live against `GetCliModelConfigs` (SWE-1.6 Fast is retired);
	// the seed's `default-model` (`swe-1-6`) must resolve synchronously at boot;
	// discovery then replaces the seed and the account default it marks wins. Field
	// shape mirrors `devinModelSpec` so seeded and discovered rows are
	// indistinguishable downstream.
	seed api="devin-agent" base-url="https://server.codeium.com" bundle="always" {
		model "swe-1-6" name="SWE-1.6" {
			reasoning #true
			// SWE-1.6 ignores inline images despite upstream `supports_images`
			// (see DEVIN_IMAGE_BLIND_UIDS in ../discovery/devin.ts).
			input "text"
			supports-tools #true
			// Included in the Coding Plan: upstream reports no cost dimensions.
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=128000
			supports-parallel-tool-calls #true
		}
	}


	// Cascade rejects `temperature: 0` with an opaque `invalid_argument`
	// ("an internal error occurred") while any positive value is accepted;
	// 0.0001 is the smallest verified accepted. Local features that pin 0 for
	// deterministic decoding (session titles, Mnemopi memory extraction) would
	// otherwise fail and silently fall back to the next model (issue #18423).
	temperature-floor 0.0001

	// Enterprise (ACUs) fallback prices: https://docs.devin.ai/desktop/models
	// (as of 2026-11-05). Seed only when upstream reports no token price.
	// Self-serve SWE-2 Flash is free until 2026-12-04 18:00 UTC; SWE-2 in
	// Desktop/CLI through 2026-11-30. Account-specific token rates stay intact.

	// SWE-2 promo ends at 2027-01-01 08:00 UTC (midnight Pacific after 2026-12-31).
	// residue: the family's logical id plus its raw effort uids, which stay
	// standalone when a row arrives without `modelFamilyMetadata`.
	models "swe-2" "swe-2-medium" "swe-2-high" "swe-2-max" {
		cost-fallback {
			input 0.5
			output 2.5
			cache-read 0.05
			cache-write 0
			effective-rates {
				list-price {
					effective-from "2027-01-01T08:00:00Z"
					input 3
					output 15
					cache-read 0.3
					cache-write 0
				}
			}
		}
	}

	// SWE-2 Fast (wire uids `swe-2-<effort>-lightning`): the docs publish no
	// price, but GetCliModelConfigs reports $1 input / $0.10 cached input /
	// $5 output (2026-11-06), twice SWE-2's promo rate. No end date or list
	// price is published for it.
	// residue: the logical fast lane plus its raw uids, as for SWE-2 above.
	models "swe-2-fast" "swe-2-medium-lightning" "swe-2-high-lightning" "swe-2-max-lightning" {
		cost-fallback {
			input 1
			output 5
			cache-read 0.1
			cache-write 0
		}
	}

	// SWE-2 Flash: enterprise promo is 25% off until 2026-11-18 18:00 UTC.
	// All three variants then use the same list price. Discovery exposes the
	// family as `swe-2-flash`, distinct from SWE-2 and Fusion pairings.
	// residue: the logical id plus its raw effort uids, as for SWE-2 above.
	models "swe-2-flash" "swe-2-flash-medium" "swe-2-flash-high" "swe-2-flash-max" {
		cost-fallback {
			input 0.075
			output 0.375
			cache-read 0.0075
			cache-write 0.09375
			effective-rates {
				list-price {
					effective-from "2026-11-18T18:00:00Z"
					input 0.1
					output 0.5
					cache-read 0.01
					cache-write 0.125
				}
			}
		}
	}

	// SWE-1.7 and GLM-5.2 High: plan-included on PRO, no published promo
	// schedule — enterprise list is the only published per-token price.
	models "swe-1-7" "swe-1-7-medium" {
		cost-fallback {
			input 0.5
			output 2.5
			cache-read 0.2
			cache-write 0
		}
	}
	models "glm-5-2" {
		cost-fallback {
			input 1.4
			output 4.4
			cache-read 0.26
			cache-write 0
		}
	}

	// Cache-write rates come from Devin's published price card
	// (https://docs.devin.ai/desktop/models, `modelCostData`);
	// `GetCliModelConfigs` and the v2alpha models endpoint carry none. Chat
	// usage reports cache-write tokens for Claude and GPT-5.6+ (Gemini
	// reports none), and the card bills them at 1.25x input. Earlier GPT,
	// Grok, Kimi, GLM, DeepSeek, and earlier SWE rows publish no cache-write rate.
	// The GPT selector stops at the next major generation, like the tiers
	// below, so an unpublished generation records no cache-write price.
	class "anthropic" {
		cache-write-rate 1.25
	}
	class "openai" {
		family "gpt" {
			revision ">=5.6 <7" {
				cache-write-rate 1.25
			}
		}
	}
	// residue: Adaptive is a router uid with no model identity; its card
	// bills cache writes at the input rate.
	models "adaptive" {
		cache-write-rate 1.0
	}

	// Long-context tiers come from the same page's `longContextFamilies`,
	// which no Devin endpoint carries. A tier bills the whole request once
	// total prompt tokens (uncached input, cache reads, and cache writes)
	// exceed the threshold. GPT and Gemini Pro tiers double input and cache
	// rates and raise output 1.5x; Grok doubles every leg. Cache writes
	// follow `cache-write-rate`. Each selector stops at the next major
	// generation, and Gemini Pro skips 3.0: the page lists GPT 5.4–6.1,
	// Gemini 2.5 and 3.1 Pro, and Grok 4.5–4.7, so an unlisted generation
	// carries no tier.
	class "openai" {
		family "gpt" {
			// Every GPT-6 lane, Fast (`-priority`) lanes included.
			revision ">=6 <7" {
				long-context-cost {
					input-threshold 272000
					multiplier 2.0
					output-multiplier 1.5
				}
				// mini and nano share the class rank but have no published tier.
				models token="mini" {
					long-context-cost {}
				}
				models token="nano" {
					long-context-cost {}
				}
			}
		}
	}
	// residue: GPT-5.4 through 5.6 tiers cover only the standard lanes; the
	// Fast (`-priority`) lanes and GPT-5.4 mini share their class rank.
	models "gpt-5-4" "gpt-5-4-none" "gpt-5-4-low" "gpt-5-4-medium" "gpt-5-4-high" "gpt-5-4-xhigh" \
		"gpt-5-5" "gpt-5-5-none" "gpt-5-5-low" "gpt-5-5-medium" "gpt-5-5-high" "gpt-5-5-xhigh" \
		"gpt-5-6-sol" "gpt-5-6-sol-none" "gpt-5-6-sol-low" "gpt-5-6-sol-medium" "gpt-5-6-sol-high" \
		"gpt-5-6-sol-xhigh" "gpt-5-6-sol-max" \
		"gpt-5-6-terra" "gpt-5-6-terra-none" "gpt-5-6-terra-low" "gpt-5-6-terra-medium" "gpt-5-6-terra-high" \
		"gpt-5-6-terra-xhigh" "gpt-5-6-terra-max" \
		"gpt-5-6-luna" "gpt-5-6-luna-none" "gpt-5-6-luna-low" "gpt-5-6-luna-medium" "gpt-5-6-luna-high" \
		"gpt-5-6-luna-xhigh" "gpt-5-6-luna-max" {
		long-context-cost {
			input-threshold 272000
			multiplier 2.0
			output-multiplier 1.5
		}
	}
	class "gemini" {
		family "pro" {
			revision ">=2.5 <3" {
				long-context-cost {
					input-threshold 200000
					multiplier 2.0
					output-multiplier 1.5
				}
			}
			revision ">=3.1 <4" {
				long-context-cost {
					input-threshold 200000
					multiplier 2.0
					output-multiplier 1.5
				}
			}
		}
	}
	// residue: Gemini 2.5 Pro's legacy uid carries no model identity.
	models "MODEL_GOOGLE_GEMINI_2_5_PRO" {
		long-context-cost {
			input-threshold 200000
			multiplier 2.0
			output-multiplier 1.5
		}
	}
	class "xai" {
		family "grok" {
			revision ">=4.5 <5" {
				long-context-cost {
					input-threshold 200000
					multiplier 2.0
				}
			}
		}
	}
}

// Devin's Cascade catalog reports each model's thinking surface; a row
// without one carries no reasoning ladder.
on-api "devin-agent" {
	trust-explicit-thinking-only #true
}
