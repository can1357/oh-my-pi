// Catalog entry for "devin"; no deployment-contract compat rules are needed.

provider "devin" {
	default-model "swe-1-6"
	env "DEVIN_API_KEY"
	dynamic-models-authoritative #true
	discovery label="Devin" oauth-provider="devin" {
		env "DEVIN_API_KEY"
	}

	// Curated Devin seed — the entire bundled surface for the provider. The
	// Cascade catalog is credential-scoped (gated per account/team), so catalog
	// generation never fetches it: baking one account's roster into the shared
	// bundle would misstate every other account's entitlements and leave zombie
	// rows behind (see CREDENTIAL_SCOPED_PROVIDERS in generate-models.ts). Both
	// SWE-1.6 lanes are verified live against `GetCliModelConfigs`; the
	// seed's `default-model` (`swe-1-6`) must resolve synchronously at
	// boot, before credential-scoped runtime discovery replaces the seed. Field
	// shape mirrors `devinModelSpec` so seeded and discovered rows are
	// indistinguishable downstream.
	seed api="devin-agent" base-url="https://server.codeium.com" bundle="always" {
		model "swe-1-6-fast" name="SWE-1.6 Fast" {
			reasoning #true
			// SWE-1.6 lanes ignore inline images despite upstream `supports_images`
			// (see DEVIN_IMAGE_BLIND_UIDS in ../discovery/devin.ts).
			input "text"
			supports-tools #true
			cost input=0.3 output=1.5 cache-read=0.03 cache-write=0
			limits context=200000 max-tokens=128000
			supports-parallel-tool-calls #true
		}
		model "swe-1-6" name="SWE-1.6" {
			reasoning #true
			input "text"
			supports-tools #true
			// Included in the Coding Plan: upstream reports no cost dimensions.
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=128000
			supports-parallel-tool-calls #true
		}
	}


	// Devin omits cost dimensions for plan-included models on lower tiers
	// (PRO reports $0 for SWE-2, SWE-1.7, and GLM-5.2 High). `cost-fallback`
	// seeds the enterprise-tier list price only when upstream reports no
	// token price, so accounts whose discovery does carry dimensions keep
	// their real rates.

	// SWE-2: enterprise promo is 75% off list through 2026-12-31; list
	// pricing ($3/$15, $0.30 cache read) applies from 2027-01-01.
	models "swe-2*" {
		cost-fallback {
			input 0.75
			output 3.75
			cache-read 0.075
			cache-write 0.75
			effective-rates {
				list-price {
					effective-from "2027-01-01T00:00:00Z"
					input 3
					output 15
					cache-read 0.3
					cache-write 3
				}
			}
		}
	}

	// SWE-1.7 and GLM-5.2 High: plan-included on PRO, no published promo
	// schedule — enterprise list is the only published per-token price.
	models "swe-1-7" "swe-1-7-medium" {
		cost-fallback {
			input 0.5
			output 2.5
			cache-read 0.2
			cache-write 0.5
		}
	}
	models "glm-5-2" {
		cost-fallback {
			input 1.4
			output 4.4
			cache-read 0.26
			cache-write 1.4
		}
	}
}
