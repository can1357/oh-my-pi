// Command Code Provider API deployment contract. Model capabilities and effort
// ladders follow command-code@1.67.0. The thinking-efforts below reproduce that
// bundle's effort registry exactly, including the Muse Spark ids it now lists.
// An id that 1.67.0 serves without an effort dial has no ladder here on
// purpose, not by oversight (`modelSupportsReasoningEffort` is false for it in
// that bundle). The one exception is `claude-sonnet-5-5`: served since
// 2026-09-29 but not yet in the command-code@1.67.0 registry, so its ladder,
// image input, and price come from Anthropic's first-party catalog at
// Anthropic list price.
provider "commandcode" {
	default-model "claude-sonnet-5"
	env "COMMAND_CODE_API_KEY" "COMMANDCODE_API_KEY"
	allow-unauthenticated #true
	dynamic-models-authoritative #true
	// The Provider API rows carry no reasoning/modality metadata and KDL owns
	// the deployment policy: same-id references on other hosts must not
	// backfill reasoning, input, or limits during generation.
	skip-cross-provider-reference-fills #true
	discovery label="Command Code" allow-unauthenticated=#true
	// Command Code serves TypeSafe's jev only through the System One route
	// (`POST /provider/v1/systemone`); `/provider/v1/models` omits it.
	seed api="typesafe" base-url="https://api.commandcode.ai/provider" bundle="always" {
		model "typesafe/jev" name="TypeSafe Jev" {
			reasoning #false
			input "text"
			// Jev bills input only (command-code@1.67.0 display rate after its free window).
			cost input=0.042 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
	}

	supports-developer-role #false
	supports-store #false
	// No effort dial by default. Only the exact ids below expose one upstream
	// (command-code@1.67.0 effort registry); every other served id must omit
	// the effort control on the wire.
	supports-reasoning-effort #false
	// Discovery rows carry no reasoning metadata and stay neutral, so exact
	// ladders below opt into repairing the neutral default (the cascade
	// upgrade for stale source capability data).
	thinking-upgrade-neutral #true
	thinking-mode "effort"
	max-tokens-field "max_tokens"
	// Default output cap: the Provider API exposes no per-model maximum, and
	// the CLI requests 64K by default, so the default is 64K (2^16). The
	// per-model caps below are the only maxOutputTokens that the
	// command-code@1.67.0 registry sets.
	limits-patch {
		max-tokens 65536
	}
	class "anthropic" {
		thinking-mode "anthropic-adaptive"
		supports-eager-tool-input-streaming #false
		supports-long-cache-retention #false
	}
	// Endpoint contract for every id `api-routes provider="commandcode"` sends to
	// Responses. Responses accepts `reasoning.effort: "none"` while chat
	// completions rejects it (low|medium|high|xhigh|max only), so thinking-off
	// disables reasoning instead of clamping to the lowest effort. Ids without
	// an effort ladder stay inert through provider-level
	// `supports-reasoning-effort #false`. The Responses endpoint also rejects an
	// object `tool_choice` (verified 2026-09-29), so named choices degrade to
	// `"required"`.
	on-api "openai-responses" {
		reasoning-disable-mode "none-effort"
		supports-named-tool-choice #false
	}
	// First-party OpenAI grants `none` only to the 5.6 generation
	// (`providers/openai.kdl`); the gateway may forward `reasoning.effort`
	// unchanged, so the other GPT ids keep the first-party lowest-effort off.
	models "gpt-5.3-codex" "gpt-5.4" "gpt-5.4-mini" "gpt-5.5" "gpt-6-astra" "gpt-6-luna" "gpt-6-sol" {
		reasoning-disable-mode "lowest-effort"
	}
	models "typesafe/jev" {
		kind "judge"
	}
	models "claude-fable-5" "claude-fable-5-1" "claude-opus-4-7" "claude-opus-4-8" \
		"claude-opus-5" "claude-opus-5-5" "claude-sonnet-4-6" "claude-sonnet-5" "claude-sonnet-5-5" \
		"gpt-5.6-luna" "gpt-5.6-sol" "gpt-5.6-terra" "gpt-6-astra" "gpt-6-luna" "gpt-6-sol" \
		"meta/muse-spark-1.3" {
		supports-reasoning-effort #true
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
	models "deepseek/deepseek-v4-flash" "deepseek/deepseek-v4-flash-vision-exp" \
		"deepseek/deepseek-v4-pro" "zai-org/GLM-5.2" {
		supports-reasoning-effort #true
		thinking-efforts "high" "max"
	}
	models "deepseek/deepseek-v4-flash-fast" "deepseek/deepseek-v4.1-flash" \
		"deepseek/deepseek-v4.1-flash-fast" "moonshotai/Kimi-K3" "z-ai/glm-5.3-flash" \
		"z-ai/glm-5.3-flashx" "zai-org/GLM-5.3" {
		supports-reasoning-effort #true
		thinking-efforts "low" "high" "max"
	}
	models "google/gemini-3.1-flash-lite" "google/gemini-3.5-flash" \
		"google/gemini-3.5-flash-lite" "google/gemini-3.6-flash" "google/gemini-3.7-flash" \
		"google/gemini-3.8-flash" "gpt-5.4-mini" "MiniMaxAI/MiniMax-M3" \
		"stealth/space-bunny-alpha" "stepfun/Step-5-Preview" "tencent/hy4-preview" "xai/grok-4.5" {
		supports-reasoning-effort #true
		thinking-efforts "low" "medium" "high"
	}
	models "gpt-5.3-codex" "gpt-5.4" "gpt-5.5" "meta/muse-spark-1.1" "meta/muse-spark-1.2" \
		"meta/muse-spark-1.2-contributor" "meta/muse-spark-1.3-contributor" "xai/grok-4.6" \
		"xai/grok-4.7" {
		supports-reasoning-effort #true
		thinking-efforts "low" "medium" "high" "xhigh"
	}
	models "Qwen/Qwen3.8-27B" "Qwen/Qwen3.8-Flash" "Qwen/Qwen3.8-Max" "Qwen/Qwen3.8-Max-0902" \
		"Qwen/Qwen3.8-Omni-Flash" "stealth/pixel-canary" {
		supports-reasoning-effort #true
		thinking-efforts "low" "medium" "xhigh"
	}
	models "sakana/fugu-ultra" {
		supports-reasoning-effort #true
		thinking-efforts "high" "xhigh"
	}
	// Image input follows command-code@1.67.0: every served id outside its text-only set.
	// residue: the vendor's text-only set cuts across classes (Qwen, DeepSeek, GLM,
	// MiniMax, and Xiaomi each have ids on both sides), so no class selector
	// expresses this list.
	models "claude-fable-5" "claude-fable-5-1" "claude-haiku-4-5-20251001" "claude-opus-4-7" \
		"claude-opus-4-8" "claude-opus-5" "claude-opus-5-5" "claude-sonnet-4-6" "claude-sonnet-5" \
		"claude-sonnet-5-5" \
		"deepseek/deepseek-v4-flash-vision-exp" "deepseek/deepseek-v4.1-flash-fast" \
		"google/gemini-3.1-flash-lite" \
		"google/gemini-3.5-flash" "google/gemini-3.5-flash-lite" "google/gemini-3.6-flash" \
		"google/gemini-3.7-flash" "google/gemini-3.8-flash" "gpt-5.3-codex" "gpt-5.4" \
		"gpt-5.4-mini" "gpt-5.5" "gpt-5.6-luna" "gpt-5.6-sol" "gpt-5.6-terra" "gpt-6-astra" \
		"gpt-6-luna" "gpt-6-sol" "meta/muse-spark-1.1" "meta/muse-spark-1.2" \
		"meta/muse-spark-1.2-contributor" "meta/muse-spark-1.3" "meta/muse-spark-1.3-contributor" \
		"MiniMaxAI/MiniMax-M3" "moonshotai/Kimi-K2.5" "moonshotai/Kimi-K2.6" \
		"moonshotai/Kimi-K2.7-Code" "moonshotai/Kimi-K2.7-Code-Highspeed" "moonshotai/Kimi-K3" \
		"Qwen/Qwen3.6-Plus" "Qwen/Qwen3.7-Flash" "Qwen/Qwen3.7-Plus" "Qwen/Qwen3.8-27B" \
		"Qwen/Qwen3.8-Flash" "Qwen/Qwen3.8-Max" "Qwen/Qwen3.8-Max-0902" "Qwen/Qwen3.8-Omni-Flash" \
		"sakana/fugu-ultra" "stealth/pixel-canary" "stealth/space-bunny-alpha" \
		"stepfun/Step-3.7-Flash" "stepfun/Step-5-Preview" "thinkingmachines/inkling" \
		"thinkingmachines/inkling-small" "xai/grok-4.5" "xai/grok-4.6" "xai/grok-4.7" \
		"xiaomi/mimo-v2.5" "xiaomi/mimo-v2.6-flash" "xiaomi/mimo-v2.6-pro" \
		"xiaomi/mimo-v2.6-pro-ultraspeed" "z-ai/glm-5.3-flash" "z-ai/glm-5.3-flashx" {
		input-modalities "text" "image"
	}
	// The class's `token="vision"` exemption misses this id (its name carries no
	// `vision` token) even though the deployment serves it with image input, so
	// the opt-out is explicit here.
	models "deepseek/deepseek-v4.1-flash" {
		strip-image-input #false
		input-modalities "text" "image"
	}
	models "inclusionai/ling-3.0-flash-sante:free" "poolside/laguna-s-2.1-free" "Qwen/Qwen3.8-27B" {
		limits-patch {
			max-tokens 32768
		}
	}
	models "Qwen/Qwen3.8-Omni-Flash" "stealth/pixel-canary" "z-ai/glm-5.3-flash" \
		"z-ai/glm-5.3-flashx" {
		limits-patch {
			max-tokens 131072
		}
	}
	models "stealth/space-bunny-alpha" {
		limits-patch {
			max-tokens 524288
		}
	}
	// Codex SKUs report the output budget inside the advertised window, so
	// the class lineage pins the 272K prompt window; restate it here or the
	// class rule wins the whole limits axis and drops the 64K provider cap.
	models "gpt-5.3-codex" {
		limits-patch {
			context-window 272000
			max-tokens 65536
		}
	}
	// Command Code's Responses endpoint returns no bytes from `image_generation`
	// (verified 2026-09-29), so the openai class's hosted-image and image-model
	// grants do not apply. Hosted web search still works with a string `tool_choice`.
	models "gpt-5.3-codex" "gpt-5.4" "gpt-5.4-mini" "gpt-5.5" "gpt-5.6-luna" "gpt-5.6-sol" \
		"gpt-5.6-terra" "gpt-6-astra" "gpt-6-luna" "gpt-6-sol" {
		hosted-image #false
		image-model #false
	}
	// ---------------------------------------------------------------------------
	// This table prices every model id that GET /provider/v1/models serves.
	// Discovery defaults each model to zero cost and the mapper never inherits
	// another provider's rates, so this table is the only pricing source.
	// Base rates are Command Code's per-1M-token USD display rates. They follow
	// `getDisplayRates` in command-code@1.67.0, read on 2026-09-29. That table
	// prices 83 of the 84 ids the live catalog served that day; it has no
	// `claude-sonnet-5-5`. DeepSeek V4 Flash and its vision-exp variant bill on
	// the V4.1 Flash gateway slug.
	// A missing cache-write rate means 0. Standing deals (MiniMax M3 50% off,
	// MiMo discounts) use their current effective rates.
	// Free models (`poolside/laguna-s-2.1-free`,
	// `inclusionai/ling-3.0-flash-sante:free`, `stealth/pixel-canary`,
	// `stealth/space-bunny-alpha`) keep the zero discovery default.
	// ---------------------------------------------------------------------------
	models "claude-sonnet-5" "claude-sonnet-5-5" {
		cost-patch {
			input 2.0
			output 10.0
			cache-read 0.2
			cache-write 2.5
		}
	}
	models "claude-sonnet-4-6" {
		cost-patch {
			input 3.0
			output 15.0
			cache-read 0.3
			cache-write 3.75
		}
	}
	// Fable 5.1 cut cache reads to 0.25; Fable 5 stays at 1.0.
	models "claude-fable-5-1" {
		cost-patch {
			input 10.0
			output 50.0
			cache-read 0.25
			cache-write 12.5
		}
	}
	models "claude-fable-5" {
		cost-patch {
			input 10.0
			output 50.0
			cache-read 1.0
			cache-write 12.5
		}
	}
	models "claude-opus-5" "claude-opus-4-8" "claude-opus-4-7" {
		cost-patch {
			input 5.0
			output 25.0
			cache-read 0.5
			cache-write 6.25
		}
	}
	models "claude-opus-5-5" {
		cost-patch {
			input 4.0
			output 20.0
			cache-read 0.2
			cache-write 5.0
		}
	}
	models "claude-haiku-4-5-20251001" {
		cost-patch {
			input 1.0
			output 5.0
			cache-read 0.1
			cache-write 1.25
		}
	}
	models "gpt-6-astra" {
		cost-patch {
			input 10.0
			output 50.0
			cache-read 1.0
			cache-write 12.5
		}
		long-context-cost {
			input-threshold 272000
			input 20.0
			output 75.0
			cache-read 2.0
			cache-write 25.0
		}
	}
	models "gpt-6-sol" {
		cost-patch {
			input 2.0
			output 10.0
			cache-read 0.2
			cache-write 2.5
		}
		long-context-cost {
			input-threshold 272000
			input 4.0
			output 15.0
			cache-read 0.4
			cache-write 5.0
		}
	}
	models "gpt-6-luna" {
		cost-patch {
			input 0.1
			output 0.5
			cache-read 0.01
			cache-write 0.125
		}
		long-context-cost {
			input-threshold 272000
			input 0.2
			output 0.75
			cache-read 0.02
			cache-write 0.25
		}
	}
	models "gpt-5.6-sol" {
		cost-patch {
			input 5.0
			output 30.0
			cache-read 0.5
			cache-write 6.25
		}
	}
	models "gpt-5.6-terra" {
		cost-patch {
			input 2.0
			output 12.0
			cache-read 0.2
			cache-write 2.5
		}
	}
	models "gpt-5.6-luna" {
		cost-patch {
			input 0.2
			output 1.2
			cache-read 0.02
			cache-write 0.25
		}
	}
	models "gpt-5.5" {
		cost-patch {
			input 5.0
			output 30.0
			cache-read 0.5
			cache-write 0.0
		}
	}
	models "gpt-5.4" {
		cost-patch {
			input 2.5
			output 15.0
			cache-read 0.25
			cache-write 0.0
		}
	}
	models "gpt-5.3-codex" {
		cost-patch {
			input 2.0
			output 8.0
			cache-read 0.5
			cache-write 0.0
		}
	}
	models "gpt-5.4-mini" {
		cost-patch {
			input 0.75
			output 4.5
			cache-read 0.075
			cache-write 0.0
		}
	}
	// DeepSeek V4 bills time-dependent rates; the page displays the off-peak
	// rates that apply 17h/day (peak doubles input/output). Off-peak is the
	// documented display convention; the Usage page stays authoritative.
	// V4.1 Flash Fast displays 0.16 / 0.58 / 0.016.
	models "deepseek/deepseek-v4-pro" {
		cost-patch {
			input 0.66
			output 1.98
			cache-read 0.022
			cache-write 0.0
		}
	}
	// command-code@1.67.0 bills the flash id and its vision-exp variant on the
	// V4.1 Flash gateway slug, so all three ids share the V4.1 Flash off-peak rates.
	models "deepseek/deepseek-v4-flash" "deepseek/deepseek-v4-flash-vision-exp" \
		"deepseek/deepseek-v4.1-flash" {
		cost-patch {
			input 0.15
			output 0.6
			cache-read 0.003
			cache-write 0.0
		}
	}
	models "deepseek/deepseek-v4-flash-fast" {
		cost-patch {
			input 0.28
			output 0.56
			cache-read 0.07
			cache-write 0.0
		}
	}
	models "deepseek/deepseek-v4.1-flash-fast" {
		cost-patch {
			input 0.16
			output 0.58
			cache-read 0.016
			cache-write 0.0
		}
	}
	models "moonshotai/Kimi-K3" {
		cost-patch {
			input 3.0
			output 15.0
			cache-read 0.3
			cache-write 0.0
		}
	}
	models "moonshotai/Kimi-K2.7-Code" {
		cost-patch {
			input 0.95
			output 4.0
			cache-read 0.19
			cache-write 0.0
		}
	}
	models "moonshotai/Kimi-K2.7-Code-Highspeed" {
		cost-patch {
			input 1.9
			output 8.0
			cache-read 0.38
			cache-write 0.0
		}
	}
	models "moonshotai/Kimi-K2.6" {
		cost-patch {
			input 0.95
			output 4.0
			cache-read 0.16
			cache-write 0.0
		}
	}
	models "moonshotai/Kimi-K2.5" {
		cost-patch {
			input 0.6
			output 3.0
			cache-read 0.1
			cache-write 0.0
		}
	}
	// Permanent documented list price, matching the zai-host correction in
	// classes/glm.kdl (stencil.so's launch promotion expired 2026-09-09).
	models "z-ai/glm-5.3-flash" {
		cost-patch {
			input 0.15
			output 0.5
			cache-read 0.03
			cache-write 0.0
		}
	}
	models "z-ai/glm-5.3-flashx" {
		cost-patch {
			input 0.37
			output 1.25
			cache-read 0.075
			cache-write 0.0
		}
	}
	models "zai-org/GLM-5.3" "zai-org/GLM-5.2" "zai-org/GLM-5.1" {
		cost-patch {
			input 1.4
			output 4.4
			cache-read 0.26
			cache-write 0.0
		}
	}
	models "zai-org/GLM-5.2-Fast" {
		cost-patch {
			input 3.0
			output 10.25
			cache-read 0.5
			cache-write 0.0
		}
	}
	models "zai-org/GLM-5" {
		cost-patch {
			input 1.0
			output 3.2
			cache-read 0.2
			cache-write 0.0
		}
	}
	// MiniMax M3 carries a standing 50%-off deal; priced at the effective rate.
	models "MiniMaxAI/MiniMax-M3" "MiniMaxAI/MiniMax-M2.7" {
		cost-patch {
			input 0.3
			output 1.2
			cache-read 0.06
			cache-write 0.0
		}
	}
	models "MiniMaxAI/MiniMax-M2.5" {
		cost-patch {
			input 0.3
			output 1.2
			cache-read 0.03
			cache-write 0.0
		}
	}
	models "meituan/LongCat-2.0" {
		cost-patch {
			input 0.3
			output 1.2
			cache-read 0.006
			cache-write 0.0
		}
	}
	// MiMo carries standing Xiaomi discounts; priced at the current
	// unified-context effective rates.
	models "xiaomi/mimo-v2.5-pro" "xiaomi/mimo-v2.6-pro" {
		cost-patch {
			input 0.435
			output 0.87
			cache-read 0.0036
			cache-write 0.0
		}
	}
	models "xiaomi/mimo-v2.5" "xiaomi/mimo-v2.6-flash" {
		cost-patch {
			input 0.14
			output 0.28
			cache-read 0.0028
			cache-write 0.0
		}
	}
	models "xiaomi/mimo-v2.6-pro-ultraspeed" {
		cost-patch {
			input 4.35
			output 8.7
			cache-read 0.036
			cache-write 0.0
		}
	}
	models "Qwen/Qwen3.8-Max-0902" {
		cost-patch {
			input 2.0
			output 6.0
			cache-read 0.25
			cache-write 0.0
		}
	}
	models "Qwen/Qwen3.8-Max" {
		cost-patch {
			input 2.0
			output 6.0
			cache-read 0.25
			cache-write 2.5
		}
	}
	models "Qwen/Qwen3.8-27B" {
		cost-patch {
			input 0.4
			output 3.0
			cache-read 0.04
			cache-write 0.0
		}
	}
	models "Qwen/Qwen3.8-Flash" {
		cost-patch {
			input 0.16
			output 0.47
			cache-read 0.016
			cache-write 0.0
		}
	}
	models "Qwen/Qwen3.8-Omni-Flash" {
		cost-patch {
			input 0.15
			output 0.47
			cache-read 0.016
			cache-write 0.0
		}
	}
	models "Qwen/Qwen3.7-Max" {
		cost-patch {
			input 2.5
			output 7.5
			cache-read 0.5
			cache-write 3.13
		}
	}
	models "Qwen/Qwen3.7-Plus" {
		cost-patch {
			input 0.4
			output 1.6
			cache-read 0.08
			cache-write 0.5
		}
		long-context-cost {
			input-threshold 256000
			input 1.2
			output 4.8
			cache-read 0.24
			cache-write 1.5
		}
	}
	// Two upstream tiers (>32K at 0.10/0.40 and >256K at 0.20/0.80); the
	// catalog carries a single long-context slot, so the highest tier is
	// encoded from the first crossing — 32K-256K over-reports rather than
	// under-reporting spend above 256K.
	models "Qwen/Qwen3.7-Flash" {
		cost-patch {
			input 0.03
			output 0.13
			cache-read 0.006
			cache-write 0.038
		}
		long-context-cost {
			input-threshold 32000
			input 0.2
			output 0.8
			cache-read 0.04
			cache-write 0.25
		}
	}
	models "Qwen/Qwen3.6-Max-Preview" {
		cost-patch {
			input 1.3
			output 7.8
			cache-read 0.26
			cache-write 1.63
		}
	}
	models "Qwen/Qwen3.6-Plus" {
		cost-patch {
			input 0.5
			output 3.0
			cache-read 0.1
			cache-write 0.0
