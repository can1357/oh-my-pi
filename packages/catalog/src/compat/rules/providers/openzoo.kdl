// Provider-wire compat for "openzoo". The live /v1/models roster is
// OpenRouter-shaped for pricing and windows but does not advertise
// reasoning or input modalities; discovery leaves those fields
// neutral unless the row reports them. This file owns reviewed
// capability corrections applied at build time.

provider "openzoo" {
	// The router. Contract pinned upstream (staccDOTsol/openzoo@211f6cf):
	// the shim mints no auto row of its own, but the backend catalog
	// publishes the aliases, they pass through /v1/models, and the wire
	// routes them — measured on 0.50.84 (auto listed; paid completion 200).
	default-model "auto"
	// The local proxy is keyless (it pays per call from its own wallet), and
	// the live `/v1/models` is the whole catalog: nothing is bundled.
	allow-unauthenticated #true
	dynamic-models-authoritative #true
	// Deliberately NO `discovery` node: that node enrolls a provider in
	// generate-models.ts. The proxy roster is live deployment truth, so
	// generating would freeze one snapshot into models.json.

	// Modern Claude and Gemini are multimodal on the OpenAI-completions
	// proxy; the roster carries no architecture.modality.
	class "anthropic" {
		input-modalities "text" "image"
	}
	class "gemini" {
		input-modalities "text" "image"
	}
	class "glm" {
		family "vision" {
			input-modalities "text" "image"
		}
	}
	// Bounded id tokens the roster uses for vision SKUs.
	models token="vision" {
		input-modalities "text" "image"
	}
	models token="vl" {
		input-modalities "text" "image"
	}
}
