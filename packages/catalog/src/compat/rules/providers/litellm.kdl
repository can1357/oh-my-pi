// LiteLLM's GPT-5.6 Sol route enforces a 64-character tool-call ID limit;
// other routes (including Gemini) use opaque signature-bearing IDs.

provider "litellm" {
	default-model "claude-opus-5-5"
	env "LITELLM_API_KEY"
	discovery label="LiteLLM" allow-unauthenticated=#true
	models "gpt-5.6-sol" {
		max-tool-call-id-length 64
	}
}
