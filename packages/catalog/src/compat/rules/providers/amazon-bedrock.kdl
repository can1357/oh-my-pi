// Provider-wire compat for "amazon-bedrock"; regenerated from the frozen census using deployment contract selectors.

provider "amazon-bedrock" {
	default-model "us.anthropic.claude-opus-4-8"

	// AWS publishes Kimi K3 only as the global/us cross-region inference
	// profiles (no in-region or bare sku), served over the OpenAI Chat
	// Completions endpoint. SigV4 signing is provided by the transport via
	// the provider's native AWS auth chain.
	// precedence="seed": generate-models dedup places upstream rows ahead of
	// seeds under the default upstream precedence, which would let a same-id
	// models.dev Converse row shadow these reviewed Chat rows.
	seed api="openai-completions" base-url="https://bedrock-runtime.{region}.amazonaws.com/openai/v1" bundle="always" precedence="seed" {
		model "global.moonshotai.kimi-k3" name="Kimi K3 (Global)" {
			reasoning #true
			input "text" "image"
			cost input=3 output=15 cache-read=0.3 cache-write=3.75
			limits context=1000000 max-tokens=128000
		}
		model "us.moonshotai.kimi-k3" name="Kimi K3 (US)" {
			reasoning #true
			input "text" "image"
			cost input=3.3 output=16.5 cache-read=0.33 cache-write=4.125
			limits context=1000000 max-tokens=128000
		}
	}

	// The Converse assembler positions content blocks by wire index
	// (`amazon-bedrock.ts`), so a block can land above text already rendered.
	stream-revision "possible"
	class "anthropic" {
		family "fable" {
			revision ">=5.1 <5.2" {
				thinking-efforts "low" "medium" "high" "xhigh" "max"
			}
		}
		family "opus" {
			revision ">=4.6 <4.7" {
				thinking-mode "anthropic-adaptive"
			}
		}
		revision ">=4.7 <5.1" {
			// Replaces the adaptive Anthropic Bedrock timeout branch.
			stream-idle-timeout-ms 900000
			thinking-efforts "low" "medium" "high" "max"
		}
	}
	class "openai" {
		thinking-mode "effort"
		// OpenAI models reject Converse image blocks nested inside toolResult content.
		requires-tool-result-image-hoisting #true
	}
	class "deepseek" {
		requires-reasoning-content-for-all-assistant-turns #true
		thinking-efforts "minimal" "low" "medium" "high"
	}
	class "minimax" {
		family "m2" {
			thinking-mode "budget"
		}
	}
	class "kimi" {
		family "k3" {
			// K3 is always-thinking on the Chat route and reasons for long
			// stretches without emitting bytes; mirror the Moonshot-native
			// hosts' stream-idle ceiling.
			stream-idle-timeout-ms 300000
			// The live OpenAI-route output cap (128000) is below the seeded
			// ceiling, so clamp oversize requests instead of 400ing.
			clamp-output-to-model-max #true
			// Root verified the live AWS Chat route accepts
			// max_completion_tokens=128000 with reasoning_effort=max.
			max-tokens-field "max_completion_tokens"
			// Marks always-thinking K3: native reasoning stays enabled when a
			// tool is forced (root verified tool_choice="required" round-trips
			// with reasoning_effort=max), and a named forced tool choice is
			// downgraded to "required" instead of pinning a function.
			native-kimi-k3-reasoning #true
			// AWS requires genuine replayed reasoning_content; never fall back
			// to a synthetic "." placeholder on tool-call continuation.
			allows-synthetic-reasoning-content-for-tool-calls #false
		}
	}
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
		// Opaque application-inference-profile ARNs carry no vendor signal, so an
		// OpenAI-backed profile classifies here and would otherwise nest images in
		// toolResult content and hit the same rejection. Hoisting is accepted by
		// every Converse model measured, so it is the safe default for unknowns.
		requires-tool-result-image-hoisting #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "moonshot.kimi-k2-thinking" {
		thinking-requires-effort #true
	}
	// The Qwen rows arrive with maxTokens copied from the upstream context
	// window (262000 on a 262144 window), so a request that does not set an
	// output budget of its own asks Bedrock for more than the model accepts
	// and gets a 400 back ("you requested 262000 output tokens"). AWS
	// publishes the real caps on the model cards — 8K for Qwen3-Next 80B A3B
	// and Qwen3 VL 235B A22B, 16K for Qwen3 Coder Next — and the context
	// windows already match, so only the output side needs patching (#12089).
	models "qwen.qwen3-next-80b-a3b" {
		limits-patch {
			max-tokens 8000
		}
	}
	models "qwen.qwen3-vl-235b-a22b" {
		limits-patch {
			max-tokens 8000
		}
	}
	models "qwen.qwen3-coder-next" {
		limits-patch {
			max-tokens 16000
		}
	}
}
