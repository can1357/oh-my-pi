// Provider-wire compat for "amazon-bedrock"; regenerated from the frozen census using deployment contract selectors.

provider "amazon-bedrock" {
	default-model "us.anthropic.claude-opus-5-5"
	image-count-budget 90

	// The Converse assembler positions content blocks by wire index
	// (`amazon-bedrock.ts`), so a block can land above text already rendered.
	stream-revision "possible"
	class "anthropic" {
		family "opus" {
			revision ">=4.6 <4.7" {
				thinking-mode "anthropic-adaptive"
			}
		}
		revision ">=4.7 <5.1" {
			// Replaces the adaptive Anthropic Bedrock timeout branch.
			stream-idle-timeout-ms 900000
			thinking-efforts "low" "medium" "high" "max"
		}
		// First-party >=4.7 xhigh/max omits amazon-bedrock: the host rule
		// above is a shorter ladder. From 5.1 the host accepts the full set.
		revision ">=5.1" {
			thinking-efforts "low" "medium" "high" "xhigh" "max"
		}
	}
	class "xai" {
		family "grok" {
			// Converse accepts reasoning.effort for Grok 4.6; budget_tokens is
			// the Anthropic path and the unknown-class default. Older Groks
			// are unverified and keep budget.
			revision ">=4.6" {
				thinking-mode "effort"
				thinking-efforts "low" "medium" "high" "xhigh"
			}
		}
	}
	class "openai" {
		thinking-mode "effort"
	}
	class "deepseek" {
		requires-reasoning-content-for-all-assistant-turns #true
		thinking-efforts "minimal" "low" "medium" "high"
	}
	class "minimax" {
		family "m2" {
			thinking-mode "budget"
		}
	}
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
	}
	// AWS documents compact-2026-09-04 for native Runtime APIs, not Converse.
	// Expose this only as a side-compaction capability; ordinary turns
	// continue to use the model's bedrock-converse-stream API. These revisions
	// are limited to the Bedrock model cards that name the new beta:
	// https://docs.aws.amazon.com/bedrock/latest/userguide/claude-messages-compaction.html
	// https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-haiku-4-5.html
	// https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-haiku-5-5.html
	// https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-sonnet-5.html
	// https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-sonnet-5-5.html
	// https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-opus-4-7.html
	// https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-opus-4-8.html
	// https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-opus-5.html
	// https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-opus-5-5.html
	// The haiku/sonnet/opus families are Anthropic-only (taxonomy/anthropic.kdl).
	on-api "bedrock-converse-stream" {
		family "haiku" {
			revision ">=4.5 <4.6" {
				supports-server-compaction #true
			}
			revision ">=5.5 <5.6" {
				supports-server-compaction #true
			}
		}
		family "sonnet" {
			revision ">=5 <5.1" {
				supports-server-compaction #true
			}
			revision ">=5.5 <5.6" {
				supports-server-compaction #true
			}
		}
		family "opus" {
			revision ">=4.7 <4.9" {
				supports-server-compaction #true
			}
			revision ">=5 <5.1" {
				supports-server-compaction #true
			}
			revision ">=5.5 <5.6" {
				supports-server-compaction #true
			}
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "moonshot.kimi-k2-thinking" {
		thinking-requires-effort #true
	}
	// residue: the inference-profile prefixes leave the K3 rows in the
	// "unknown" class, so an exact selector is the only match. K3 reasons via
	// OpenAI-style reasoning_effort (low/high/max, default max), matching
	// Moonshot's official API and every other provider's K3 entry. Verified
	// live via Converse on global.moonshotai.kimi-k3: identical prompt yields
	// ~1K output tokens at "high" vs ~2.4K at "max" (invalid values are
	// accepted silently and behave like the max default).
	models "*.moonshotai.kimi-k3" {
		thinking-mode "effort"
		thinking-efforts "low" "high" "max"
		thinking-default-level "max"
		thinking-requires-effort #true
	}
	// The Qwen rows arrive with maxTokens copied from the upstream context
	// window (262000 on a 262144 window), so a request that does not set an
	// output budget of its own asks Bedrock for more than the model accepts
	// and gets a 400 back ("you requested 262000 output tokens"). AWS
	// publishes the real caps on the model cards — 8K for Qwen3-Next 80B A3B
	// and Qwen3 VL 235B A22B, 16K for Qwen3 Coder Next — and the context
	// windows already match, so only the output side needs patching (#12089).
	models "qwen.qwen3-next-80b-a3b" {
		limits-patch {
			max-tokens 8000
		}
	}
	models "qwen.qwen3-vl-235b-a22b" {
		limits-patch {
			max-tokens 8000
		}
	}
	models "qwen.qwen3-coder-next" {
		limits-patch {
			max-tokens 16000
		}
	}
}
