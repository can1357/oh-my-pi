// Merge Gateway preserves route-authored thinking metadata and serves DeepSeek through DSML templates.

provider "merge-gateway" {
	default-model "openai/gpt-5.6-sol"
	env "MERGE_GATEWAY_API_KEY"
	discovery label="Merge Gateway"
	dynamic-models-authoritative #true

	trust-explicit-thinking-only #true
	requires-structured-output-hardening #true
	class "deepseek" {
		stream-markup-healing-pattern "dsml"
	}
}
