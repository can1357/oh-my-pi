// Provider-wire compat for "aimlapi"; regenerated from the frozen census using deployment contract selectors.

provider "aimlapi" {
	thinking-mode "effort"
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "deepseek/deepseek-chat-v3.1" {
		requires-reasoning-content-for-all-assistant-turns #true
		thinking-efforts "high" "max"
	}
	models "deepseek-v4-pro" {
		thinking-efforts "low" "high" "max"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.1-codex" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.1-codex-mini" {
		thinking-efforts "medium" "high"
	}
	models "xiaomi/mimo-v2.5" "stepfun/step-3.7-flash" {
		edit-revision "sloppy.1"
	}
}
