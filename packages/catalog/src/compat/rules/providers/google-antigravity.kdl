// Provider-wire compat for "google-antigravity"; regenerated from the frozen census using deployment contract selectors.

provider "google-antigravity" {
	default-model "gemini-3.1-pro"
	// `fetchAvailableModels` is the account's served roster; bundled rows it
	// omits (e.g. Claude 5.5 on plans without it) 404 on every request (#14328).
	dynamic-models-authoritative #true
	kind-apis {
		image "google-gemini-cli"
	}
	web-search "gemini"
	// No size rejection up to a 64 MB body; 60 images at the 500 KiB resize
	// target stay near 41 MB. Gemini counts images only against its context.
	image-count-budget 60

	seed api="google-gemini-cli" base-url="https://daily-cloudcode-pa.googleapis.com" bundle="always" {
		model "gemini-3-pro-image" name="Gemini 3 Pro Image" {
			reasoning #false
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
	}

	// Routed wire profiles overwrite caller caps with fixed output limits.
	// Conservatively reject requested bounds for this provider, including
	// logical ids whose effort routing selects a profiled wire id later.
	preserves-max-output-tokens #false

	class "anthropic" {
		// Claude here is Vertex Anthropic: one image whose base64 passes
		// 5,242,880 bytes is a 400 "image exceeds 5 MB maximum" (half the
		// direct API's 10 MiB), and 8001 px is a 400 like on the direct API.
		// Declaring the contract makes the Cloud Code Assist wire clamp images
		// for Claude the way `anthropic-messages` does; Gemini on the same
		// gateway has no such limits and keeps them unset.
		max-image-dimension 8000
		max-image-payload-bytes 5242880
		// The Claude upstream rejects a message over 30 MB and, past 20 images,
		// any image edge over 3,000 px. The clamp above caps each image; with no
		// byte budget on this wire, the count bounds the body.
		image-count-budget 20
		family "opus" {
			thinking-mode "budget"
		}
	}
	class "gemini" {
		// Cloud Code Assist rejects an unsigned first function call; the bypass
		// sentinel is required only on that first call (secondary parallel calls
		// may stay unsigned). Host contract, so it lives with the provider.
		revision ">=3" {
			requires-skip-thought-signature-on-first-function-call #true
		}
		family "flash" {
			revision ">=3 <3.6" {
				thinking-effort-budgets {
					high 10000
					low 1000
					medium 4000
					minimal 1000
				}
				thinking-mode "budget"
				thinking-suppress-when-off #true
			}
			revision ">=3.6" {
				thinking-mode "google-level"
				thinking-requires-effort #true
			}
		}
		family "pro" {
			revision ">=3 <3.2" {
				thinking-suppress-when-off #true
			}
		}
	}
	// Cloud Code Assist bills a Gemini 2.5 or 3.x image a fixed 1,089 tokens
	// from 32px to 2048px (extreme strips bill less); priority=1 outranks the
	// lineage's 1,120 at equal specificity. verified: billing matched this rule
	// on Gemini 2.5 Flash Lite, 3.1 Flash Lite and 3.8 Flash.
	class "gemini" priority=1 {
		image-tokenization {
			regime "fixed"
			verified #true
			tokens 1089
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "claude-opus-4-6" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gemini-3-pro" {
		thinking-mode "google-level"
	}
	// Antigravity discovery lists image SKUs beside chat models with no output
	// modality, so they would build as chat. Accounts advertise either SKU in
	// `imageGenerationModelIds` (gemini-3.1-flash-image replaced
	// gemini-3-pro-image on some accounts, #11106).
	models "gemini-3-pro-image" "gemini-3.1-flash-image" {
		kind "image"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gemini-3.1-flash-lite" {
		thinking-mode "google-level"
		thinking-requires-effort #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gemini-3.1-pro" {
		thinking-effort-budgets {
			high 10001
			low 1001
		}
		thinking-mode "budget"
	}
}
