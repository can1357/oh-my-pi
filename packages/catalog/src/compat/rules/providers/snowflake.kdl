// Documented account-billed Cortex REST API, not verified CoCo-subscription usage.
// Model IDs and compatibility: https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-rest-api
// Output is capped at the Cortex REST API's documented 16,384-token maximum (rate-limit table;
// newer models absent from that table are assumed to share it). Context windows are conservative
// AI_COMPLETE configured ceilings, not verified REST maxima:
// https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-rest-api#label-cortex-rest-api-rate-limits
// https://docs.snowflake.com/en/user-guide/snowflake-cortex/aisql-regional-availability
// USD per million tokens estimates: Consumption Table 6(b) AI Credits x $2.00
// (on-demand global routing); regional routing and contract discounts change billing.
// https://www.snowflake.com/legal-files/CreditConsumptionTable.pdf
// https://docs.snowflake.com/en/user-guide/snowflake-cortex/pricing
provider "snowflake" {
	default-model "claude-opus-5-5"
	env "SNOWFLAKE_PAT"

	// Credential-scoped roster: never fetch during catalog generation. The `.invalid`
	// origin is a placeholder that snowflakeTransport replaces with the account URL.
	seed api="anthropic-messages" base-url="https://snowflake-account.invalid/api/v2/cortex" bundle="always" precedence="seed" {
		model "claude-opus-5-5" name="Claude Opus 5.5" {
			reasoning #true
			input "text" "image"
			cost input=4 output=20 cache-write=5 cache-read=0.2
			limits context=1000000 max-tokens=16384
		}
		model "claude-opus-5" name="Claude Opus 5" {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-write=6.25 cache-read=0.5
			limits context=1000000 max-tokens=16384
		}
		model "claude-opus-4-8" name="Claude Opus 4.8" {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-write=6.25 cache-read=0.5
			limits context=1000000 max-tokens=16384
		}
		model "claude-opus-4-7" name="Claude Opus 4.7" {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-write=6.25 cache-read=0.5
			limits context=1000000 max-tokens=16384
		}
		model "claude-opus-4-6" name="Claude Opus 4.6" {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-write=6.25 cache-read=0.5
			limits context=1000000 max-tokens=16384
		}
		model "claude-opus-4-5" name="Claude Opus 4.5" {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-write=6.25 cache-read=0.5
			limits context=200000 max-tokens=16384
		}
		model "claude-sonnet-5" name="Claude Sonnet 5" {
			reasoning #true
			input "text" "image"
			cost input=2 output=10 cache-write=2.5 cache-read=0.2
			limits context=1000000 max-tokens=16384
		}
		model "claude-sonnet-4-6" name="Claude Sonnet 4.6" {
			reasoning #true
			input "text" "image"
			cost input=3 output=15 cache-write=3.75 cache-read=0.3
			limits context=1000000 max-tokens=16384
		}
		model "claude-sonnet-4-5" name="Claude Sonnet 4.5" {
			reasoning #true
			input "text" "image"
			cost input=3 output=15 cache-write=3.75 cache-read=0.3
			limits context=200000 max-tokens=16384
		}
		model "claude-haiku-4-5" name="Claude Haiku 4.5" {
			reasoning #true
			input "text" "image"
			cost input=1 output=5 cache-write=1.25 cache-read=0.1
			limits context=200000 max-tokens=16384
		}
		model "openai-gpt-5.1" name="GPT-5.1" api="openai-completions" base-url="https://snowflake-account.invalid/api/v2/cortex/v1" {
			reasoning #true
			input "text" "image"
			cost input=1.25 output=10 cache-write=0 cache-read=0.13
			limits context=272000 max-tokens=16384
		}
		model "openai-gpt-5" name="GPT-5" api="openai-completions" base-url="https://snowflake-account.invalid/api/v2/cortex/v1" {
			reasoning #true
			input "text" "image"
			cost input=1.25 output=10 cache-write=0 cache-read=0.13
			limits context=272000 max-tokens=16384
		}
		model "openai-gpt-5-mini" name="GPT-5 Mini" api="openai-completions" base-url="https://snowflake-account.invalid/api/v2/cortex/v1" {
			reasoning #true
			input "text" "image"
			cost input=0.25 output=2 cache-write=0 cache-read=0.03
			limits context=272000 max-tokens=16384
		}
		model "openai-gpt-5-nano" name="GPT-5 Nano" api="openai-completions" base-url="https://snowflake-account.invalid/api/v2/cortex/v1" {
			reasoning #true
			input "text" "image"
			cost input=0.06 output=0.44 cache-write=0 cache-read=0.01
			limits context=272000 max-tokens=16384
		}
		model "openai-gpt-4.1" name="GPT-4.1" api="openai-completions" base-url="https://snowflake-account.invalid/api/v2/cortex/v1" {
			reasoning #false
			input "text" "image"
			cost input=2 output=8 cache-write=0 cache-read=0.5
			limits context=128000 max-tokens=16384
		}
	}

	// Claude thinking modes and effort ladders come from the Anthropic lineage rules
	// (classes/anthropic.kdl). Live Cortex probes matched them: Opus 4.7+/Sonnet 5
	// accept xhigh and max; Opus 4.6 and Sonnet 4.6 reject xhigh.
	// Cortex compatibility chart: ephemeral 5-minute caching and Bedrock-compatible betas only.
	class "anthropic" {
		supports-eager-tool-input-streaming #false
		supports-long-cache-retention #false
	}
	// Cortex documents reasoning_effort none/minimal/low/medium/high. Prefixed ids
	// (openai-gpt-*) carry no `gpt` family, so the <5.2 lineage ladder is restated
	// here; 5.2+ rows fall through to the unscoped lineage ladders in classes/openai.kdl.
	class "openai" {
		revision ">=5 <5.2" {
			thinking-mode "effort"
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	// Cortex compatibility chart: max_tokens/store are hard errors; non-OpenAI backends accept user/assistant/system roles only.
	on-api "openai-completions" {
		max-tokens-field "max_completion_tokens"
		supports-store #false
		supports-developer-role #false
		supports-reasoning-effort #true
	}
}
