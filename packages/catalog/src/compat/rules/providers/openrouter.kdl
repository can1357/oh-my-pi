// Provider-wire compat for "openrouter"; regenerated from the frozen census using deployment contract selectors.

provider "openrouter" {
	default-model "openai/gpt-5.5"
	env "OPENROUTER_API_KEY"
	discovery label="OpenRouter" allow-unauthenticated=#true
	kind-apis {
		image "openrouter-images"
	}
	web-search "openrouter"

	// TypeSafe's System One wire re-exposed by OpenRouter's Decisions API, so an
	// OpenRouter key alone reaches Jev for the judge role.
	seed api="openrouter-decisions" base-url="https://openrouter.ai/api" bundle="always" {
		model "typesafe/jev-1.13" name="TypeSafe jev via OpenRouter" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
	}

	// Replaces the OpenRouter provider wire-model-id dispatch branch.
	wire-model-id-mode "openrouter"
	// Replaces the strict-mode provider whitelist entry.
	supports-strict-mode #true
	thinking-format "openrouter"
	thinking-mode "effort"
	class "anthropic" {
		// OpenRouter's Anthropic upstream rejects oversized compiled strict-tool
		// grammars; retry the turn without strict tools. Replaces the
		// isOpenRouterAnthropicModel checks in the OpenAI request builders.
		retry-without-strict-on-grammar-error #true
	}
	class "meta" {
		family "muse-spark" {
			filter-reasoning-history #true
			allows-synthetic-reasoning-content-for-tool-calls #false
		}
	}
	class "minimax" {
		family "m3" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	class "openai" {
		family "o-series" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	class "stepfun" {
		family "step" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*thinking-2507" "*thinking:free" "arcee-ai/trinity-large-thinking" \
		"nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free" {
		thinking-requires-effort #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "deepseek/deepseek-chat-v3.1" "deepseek/deepseek-v4-pro" {
		thinking-efforts "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai/gpt-5.1-codex-mini" {
		thinking-efforts "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "openai/o1:batch" "openai/o3:batch" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-requires-effort #true
	}
	// The proxy conservatively classifies this tool-capable text+image output row
	// as chat; OpenRouter's dedicated image roster confirms the image transport.
	models "google/gemini-3-pro-image" {
		kind "image"
	}
	models "typesafe/jev-1.13" {
		kind "judge"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "qwen/qwen3-coder" {
		thinking-format "openrouter"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "z*5" "z-ai/glm-4.6*" "z-ai/glm-4.7*" "amazon/nova-2-lite-v1" "baidu/ernie-4.5-vl-28b-a3b" "cohere/north-mini-code:free" \
		"minimax/minimax-m1" "nvidia/llama-3.3-nemotron-super-49b-v1.5" "openai/gpt-5.1-codex" \
		"openai/gpt-5.1-codex-max" "openai/gpt-chat-latest" "z-ai/glm-4.5v" "z-ai/glm-5.1" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "z-ai/glm-5.2*" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
