// Provider-scoped runtime-discovery vocabulary.

discovery {
	// GMI Cloud's /v1/models returns bare {id} rows for the open-weight
	// models it resells under canonical namespaced ids, so discovery
	// recovers intrinsic base-model parameters (display name, context
	// window, output limit, thinking policy) from the bundled canonical
	// reference index. OpenCode Go additionally recovers intrinsic parameters
	// for its exact gateway-first Responses pins, whose bare ids otherwise carry
	// no capability metadata.
	// Pricing, wire policy, and routes are never borrowed across providers.
	recover-canonical-params "gmi-cloud" "opencode-go" "yolo-auto"
	// The OpenCode gateways share one operator and ship models before any
	// census bundles them (muse-spark-1.2[-contributor] was served only at
	// /responses while unbundled). An unbundled discovered id —
	// or its billing-variant base — that is bundled on either gateway with
	// an openai-responses route materializes on the discovering gateway's
	// responses route instead of the discovery route. Only the responses
	// signal is borrowed: anthropic and chat transports genuinely diverge
	// across the gateways (minimax-m2.5), and pricing never transfers.
	borrow-responses-route "opencode-go" "opencode-zen"
	// Exact gateway-first ids verified on responses before either sibling
	// catalog carried a usable route. The base pin also covers authored
	// billing variants below.
	responses-route-models "opencode-go" "deepseek-v4-flash" "muse-spark-1.2" "muse-spark-1.3"
	// Billing-variant SKUs sharing a transport with their base id.
	billing-variant-suffix "-free" "-contributor"
	// First-party gpt-5.6 SKUs that accept `reasoning: { mode: "pro" }` on the
	// Responses APIs; the generator projects `-pro` aliases from these base
	// ids. Sweep providers additionally drop stale generated aliases on regen
	// (openai-codex: subscription auth offers no pro reasoning).
	pro-reasoning-alias "openai" "gpt-5.6-luna" "gpt-5.6-sol" "gpt-5.6-terra"
	pro-reasoning-sweep "openai" "openai-codex"
	// Routing/quantization/serving markers a reseller or aggregator appends
	// to an upstream id (`:nitro`, `-fp8`, …) without changing model identity.
	// Effort/thinking suffixes come from the collapse vocabulary instead.
	// The effort/thinking/free tokens here are the reviewed canonical-safe
	// subset: `-max`, `-none`, and `-extra-high` name real product lanes and
	// MUST NOT coalesce, so they are deliberately absent.
	trailing-marker "customtools" "cloud" "exacto" "nitro" "original" "optimized" \
		"nvfp4" "fp8" "fp4" "bf16" "int8" "int4" \
		"thinking" "minimal" "low" "medium" "high" "xhigh" "free"
	// Identity-preserving ONLY when recovering bundled metadata for a proxied
	// id, never during canonical coalescing: Perplexity's `sonar-pro-search`
	// is a distinct model from `sonar-pro`, while `claude-opus-4-6-search`
	// on a proxy should still inherit upstream pricing/limits.
	reference-only-trailing-marker "search"
	// Vendor-lineage tokens anchoring generator-side canonical-family
	// extraction and attached-version separator insertion (`gpt5` -> `gpt-5`).
	// Broader than class taxonomy on purpose: open-weight lineages without a
	// compat class still coalesce across resellers.
	canonical-family-token "claude" "gemini" "gpt" "grok" "glm" "qwen" "minimax" "kimi" \
		"deepseek" "llama" "gemma" "nova" "mistral" "ministral" "pixtral" "codestral" \
		"devstral" "magistral" "ernie" "doubao" "seed" "aion" "olmo" "molmo" "nemotron" \
		"palmyra" "command" "codex" "coder"
	// Reseller wrapper prefixes and synthetic namespace prefixes stripped
	// during canonical candidate expansion.
	wrapper-prefix "duo-chat-"
	synthetic-prefix "hf:"
}
