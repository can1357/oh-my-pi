class "meta" {
	bounded "muse-spark"
	bounded "muse-wonder"
	bounded "llama"
	// SambaNova serves the bare `Meta-Llama-*` spelling with no namespace
	// segment, which `bounded "llama"` never sees (prefix-anchored) and
	// `namespace "meta-llama"` cannot match.
	bounded "meta-llama"
	namespace "meta-llama"

	family "llama" glob="*llama*"
	family "muse-spark" glob="*muse-spark*"
	family "muse-wonder" glob="*muse-wonder*"

	revision prefix="muse-spark-"
	revision prefix="muse-wonder-"
}
