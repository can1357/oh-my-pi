class "qwen" {
    bounded "qwen"
    bounded "deepseek-r1-distill-qwen"
    glob "*distill-qwen*"

    family "qwq" glob="*qwq*"
    family "coder" glob="*qwen3-coder*"
    family "next" glob="*qwen3-next*"
    family "omni" glob="*qwen3-omni*"
    family "vl" glob="*qwen3-vl*"
    family "qwenlong" glob="*qwenlong*"

    revision prefix="qwen"

    override id="kilo-qwq-32b-family" provider="kilo" model="qwq-32b" logical="qwen/qwq-32b" class="qwen" rationale="The reviewed Kilo QwQ deployment belongs to the Qwen family despite its opaque product spelling" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
    override id="nanogpt-eva-qwen-2-5-family" provider="nanogpt" model="EVA-Qwen2.5-32B-v0.2" logical="EVA-UNIT-01/EVA-Qwen2.5-32B-v0.2" class="qwen" rationale="The reviewed EVA deployment is a Qwen 2.5 derivative despite its opaque product namespace" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
    override id="nanogpt-eva-qwen-2-5-72b-family" provider="nanogpt" model="EVA-Qwen2.5-72B-v0.2" logical="EVA-UNIT-01/EVA-Qwen2.5-72B-v0.2" class="qwen" rationale="The reviewed EVA 72B deployment is a Qwen 2.5 derivative despite its opaque product namespace" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
    override id="nanogpt-qwenlong-l1-family" provider="nanogpt" model="QwenLong-L1-32B" logical="Tongyi-Zhiwen/QwenLong-L1-32B" class="qwen" rationale="The reviewed Tongyi Zhiwen QwenLong deployment belongs to the Qwen family" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
    override id="nanogpt-dolphin-qwen-family" provider="nanogpt" model="dolphin-2.9.2-qwen2-72b" logical="cognitivecomputations/dolphin-2.9.2-qwen2-72b" class="qwen" rationale="The reviewed Dolphin deployment is a Qwen derivative" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
    override id="nanogpt-cogito-qwen-family" provider="nanogpt" model="cogito-v1-preview-qwen-32B" logical="deepcogito/cogito-v1-preview-qwen-32B" class="qwen" rationale="The reviewed Cogito deployment is a Qwen derivative" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
    override id="nanogpt-qwq-preview-family" provider="nanogpt" model="qwq-32b-preview" logical="qwen/qwq-32b-preview" class="qwen" rationale="The reviewed QwQ preview belongs to the Qwen family" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
    override id="nanogpt-grayline-qwen-family" provider="nanogpt" model="GrayLine-Qwen3-8B" logical="soob3123/GrayLine-Qwen3-8B" class="qwen" rationale="The reviewed GrayLine deployment is a Qwen derivative" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
    override id="novita-r1-qwen-family" provider="novita" model="deepseek-r1-0528-qwen3-8b" logical="deepseek/deepseek-r1-0528-qwen3-8b" class="qwen" rationale="The reviewed distillation lineage follows the Qwen student architecture" provenance="fixtures/llm-oracle/catalog/models.normalized.json"
