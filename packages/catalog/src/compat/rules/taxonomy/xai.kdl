class "xai" {
	// Cursor serves per-tier Grok siblings under a `cursor-` wrapper.
	prefix "cursor-grok-"
	bounded "grok"
	namespace "x-ai"
	// Bedrock Converse ids are dotted (`us.xai.grok-4.6`). Unbounded
	// namespace only splits on `/`, so `xai` never matched those rows.
	namespace "xai" bounded=#true

	family "grok" glob="*grok*"

	revision prefix="cursor-grok-"
	revision prefix="grok-" anywhere=#true
}
