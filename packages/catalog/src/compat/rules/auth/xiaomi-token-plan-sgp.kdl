auth "xiaomi-token-plan-sgp" {
	name "Xiaomi Token Plan (Singapore)"
	login "api-key" {
		auth-url "https://platform.xiaomimimo.com/console/plan-manage"
		instructions "Copy your token-plan API key for the Singapore region"
		prompt "Paste your Xiaomi Token Plan Singapore API key (tp-...)" placeholder="tp-..."
		validate "chat-completions" label="xiaomi" base-url="https://token-plan-sgp.xiaomimimo.com/v1" model="mimo-v2.5"
	}
}
