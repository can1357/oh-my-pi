// TypeSafe Jev (System One) — judgment-only, not a chat-model provider.
// Answers typed questions via POST /v1/systemone through TypeSafeJudge.
// No `providers/jev.kdl` on purpose: never appears in `/model`; use `/login jev`.
auth "jev" {
	name "TypeSafe (Jev)"
	env "TYPESAFE_API_KEY"
	login "api-key" {
		auth-url "https://console.typesafe.ai/settings/keys"
		instructions "Create or copy your API key from the console."
		prompt "Paste your TypeSafe API key" placeholder="API key"
		validate "models-endpoint" label="TypeSafe" url="https://api.typesafe.ai/v1/models" base-url-env="TYPESAFE_BASE_URL"
	}
}
