auth "otari" {
	name "Otari"
	login "api-key" {
		auth-url "https://app.otari.ai/settings/api-keys"
		instructions "Create a workspace API key in Otari (Settings → API keys) and paste it here"
		prompt "Paste your Otari workspace API key" placeholder="tk_..."
		// `/api/v1/models` is key-protected: it answers 401 both without a
		// key and with a rejected one (verified 2026-11-02), so the probe
		// validates the pasted key against the live roster and bills nothing.
		// OTARI_BASE_URL (a self-hosted deployment's API root, e.g.
		// `https://host.example.com/api/v1`) redirects the probe so a
		// self-hosted key is never sent to the hosted gateway.
		validate "models-endpoint" label="Otari" url="https://api.otari.ai/api/v1/models" base-url-env="OTARI_BASE_URL"
	}
}
