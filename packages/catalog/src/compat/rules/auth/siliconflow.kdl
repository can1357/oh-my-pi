auth "siliconflow" {
	name "SiliconFlow"
	login "api-key" {
		auth-url "https://cloud.siliconflow.com/account/ak"
		instructions "Create or copy your API key from the SiliconFlow console"
		prompt "Paste your SiliconFlow API key" placeholder="sk-..."
		validate "models-endpoint" label="siliconflow" url="https://api.siliconflow.com/v1/models"
	}
}
