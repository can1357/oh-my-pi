// API-only variant of xAI's device authorization flow. Omitting
// grok-cli:access prevents this credential from authorizing Grok Build.
auth "xai-api-oauth" {
    name "xAI API OAuth (api:access only)"
    login "device-code" {
        client-id "b1a00492-073a-47ea-816f-4c329264a828"
        scopes "openid" "profile" "email" "offline_access" "api:access"
        device url="https://auth.x.ai/oauth2/device/code" {
            headers {
                Accept "application/json"
            }
        }
        token url-hook="xai-token-endpoint" {
            headers {
                Accept "application/json"
            }
        }
        response user-code="user_code" device-code="device_code" verification-uri="verification_uri" verification-uri-complete="verification_uri_complete" interval="interval" expires-in="expires_in"
        instructions "Enter code: {user_code}"
        credential {
            account-id claim="sub"
        }
        userinfo url="https://auth.x.ai/oauth2/userinfo" email="email" account-id="sub"
    }
    refresh {
        userinfo url="https://auth.x.ai/oauth2/userinfo" email="email" account-id="sub"
    }
}
