auth "cloud-ru" {
	name "Cloud.ru"
	login "api-key" {
		auth-url "https://console.cloud.ru"
		// The console's Key Secret is already the whole bearer (`<base64 key id>.<secret>`).
		instructions "Open AI Factory → Foundation Models → API Keys in the Cloud.ru console, create a key, and copy its Key Secret unchanged"
		prompt "Paste your Cloud.ru Foundation Models Key Secret" placeholder="Key Secret"
		normalize "strip-bearer"
		// Validate against inference, not /v1/models: Cloud.ru's models listing is
		// public and returns 200 for missing or bogus keys. Malformed keys fail
		// with 400 (`invalid api key secret`, classified as AuthFailed) and
		// unknown keys with 403 (`api key not found`). `optional=#true` keeps
		// transient or probe-model errors from blocking login.
		validate "chat-completions" label="Cloud.ru" base-url="https://foundation-models.api.cloud.ru/v1" model="ai-sage/GigaChat3-10B-A1.8B" optional=#true
	}
}
