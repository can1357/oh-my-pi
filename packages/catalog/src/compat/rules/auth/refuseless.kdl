auth "refuseless" {
	name "Refuseless"
	login "api-key" {
		auth-url "https://refuseless.com"
		instructions "Sign in to Refuseless and create an API key in the console"
		prompt "Paste your Refuseless API key" placeholder="abl_..."
		// `/v1/models` rejects a malformed, unknown, or revoked key with 401.
		validate "models-endpoint" label="Refuseless" url="https://api.refuseless.com/v1/models"
	}
}
