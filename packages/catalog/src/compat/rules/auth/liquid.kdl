// Liquid AI decision models (`d1-ultra`, `d1.1`).
auth "liquid" {
	name "Liquid AI"
	env "LIQUID_API_KEY"
	login "api-key" {
		auth-url "https://console.liquid.ai/"
		instructions "Create or copy your API key from the Liquid AI console."
		prompt "Paste your Liquid AI API key" placeholder="liquid_..."
		validate "models-endpoint" label="Liquid AI" url="https://api.liquid.ai/decisions/v1/models" base-url-env="LIQUID_BASE_URL" base-url-path="/decisions/v1/models"
	}
}
