auth "amazon-bedrock" {
	name "Amazon Bedrock"
	// Amazon Bedrock accepts bearer tokens, IAM keys, profiles, ECS/IRSA credential chains.
	env hook="aws-bedrock"
	// The OpenAI Chat Completions route (/openai/v1) authenticates through the
	// same AWS chain (SigV4, service "bedrock"), so it is a native-auth API too.
	native-auth-api "bedrock-converse-stream" "openai-completions"
}
