auth "google-antigravity" {
	name "Google Antigravity (Gemini, Claude, GPT-OSS)"
	disabled "Google Antigravity is paused: Google's terms do not allow third-party sign-in and Google has suspended accounts that used it (see #18341). Use GEMINI_API_KEY (AI Studio) or google-vertex instead."
	login-warning "Google's Antigravity terms do not allow signing in from third-party tools like omp, and Google has suspended accounts that did (see #18341). If you depend on this Google account, use GEMINI_API_KEY (AI Studio) or google-vertex instead."
	// AGY's consumer login displays a code on its hosted callback page.
	paste-code #true
	login "oauth-code" {
		// Antigravity uses different Google OAuth credentials for its additional models.
		client-id "MTA3MTAwNjA2MDU5MS10bWhzc2luMmgyMWxjcmUyMzV2dG9sb2poNGc0MDNlcC5hcHBzLmdvb2dsZXVzZXJjb250ZW50LmNvbQ==" encoding="base64"
		client-secret "R09DU1BYLUs1OEZXUjQ4NkxkTEoxbUxCOHNYQzR6NnFEQWY=" encoding="base64"
		authorize-url "https://accounts.google.com/o/oauth2/auth"
		scopes "https://www.googleapis.com/auth/cloud-platform" "https://www.googleapis.com/auth/userinfo.email" \
			"https://www.googleapis.com/auth/userinfo.profile" "https://www.googleapis.com/auth/cclog" \
			"https://www.googleapis.com/auth/experimentsandconfigs" "https://www.googleapis.com/auth/aicode" "openid"
		pkce #true
		authorize-params { access_type "offline"; prompt "consent" }
		instructions "Complete sign-in in your browser. Copy the authorization code displayed on the Antigravity page, paste it here, then press Enter."
		callback port=0 redirect-uri="https://antigravity.google/oauth-callback" manual-only=#true
		token url="https://oauth2.googleapis.com/token" body="form"
		credential {
			access "access_token"
			refresh "refresh_token"
			expires "seconds" path="expires_in" skew-ms=300000
		}
		userinfo url="https://www.googleapis.com/oauth2/v1/userinfo?alt=json" email="email"
		after-exchange hook="google-antigravity-project"
	}
	refresh {
		require "projectId"
		after-refresh hook="google-antigravity-project"
	}
	api-key-format "structured"
}
