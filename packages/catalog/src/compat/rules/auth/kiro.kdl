auth "kiro" {
    name "Kiro"
    env "KIRO_API_KEY"
    // Five-way login (IAM Identity Center and Builder ID device flows, ksk_ API
    // key, Google/GitHub device sign-in) is not expressible declaratively; see
    // `loginKiroHook` in `@oh-my-pi/pi-ai/src/registry/oauth/kiro.ts`. The
    // request key is the Kiro credential codec's encoding (`registry/kiro.ts`).
    login "custom" hook="kiro-login"
    refresh hook="kiro-refresh"
}
