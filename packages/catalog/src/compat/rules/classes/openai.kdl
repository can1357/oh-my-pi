// Model-lineage compat for "openai"; regenerated from the frozen census using class taxonomy selectors.

class "openai" {
	// Spark taxonomy includes arbitrary suffix SKUs; exact residues preserve
	// reviewed candidates without making custom/preview spellings eligible.
	family "codex-spark" {
		revision "=5.3" {
			models "gpt-5.3-codex-spark" "openai/gpt-5.3-codex-spark" {
				role-preset-priority { smol 10; }
			}
		}
	}
	// GPT taxonomy has no Luna/Sol/Mini or base-only family. Exact residue
	// selectors keep other GPT SKUs and older mini generations ineligible.
	models "gpt-5.6-luna" "openai/gpt-5.6-luna" {
		role-preset-priority { smol 30; }
	}
	models "gpt-5.4-mini" "openai/gpt-5.4-mini" {
		role-preset-priority { smol 32; }
	}
	models "gpt-5.6-sol" "openai/gpt-5.6-sol" {
		role-preset-priority { slow 1; }
	}
	models "gpt-5.5" "openai/gpt-5.5" {
		role-preset-priority { slow 21; }
	}
	on "openai-codex" {
		family "codex-spark" {
			revision "=5.3" {
				models "gpt-5.3-codex-spark" {
					role-preset-priority { smol 9; }
				}
			}
		}
		models "gpt-5.6-luna" {
			role-preset-priority { smol 29; }
		}
		models "gpt-5.4-mini" {
			role-preset-priority { smol 31; }
		}
		models "gpt-5.6-sol" {
			role-preset-priority { slow 0; }
		}
		models "gpt-5.5" {
			role-preset-priority { slow 20; }
		}
	}
	// Replaces the o-series mandatory-reasoning fallback.
	family "o-series" {
		thinking-requires-effort #true
	}
	// GPT wire ladders are model generations, not host contracts: <5.2 keeps
	// the classic four-tier scale, 5.2+ drops minimal for xhigh, and 5.6+
	// exposes the wire-exact five-tier low..max scale.
	family "gpt" {
		revision "<5.2" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	family "codex" {
		revision "<5.2" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
		revision "=5.1" {
			models "*codex-mini*" {
				thinking-efforts "medium" "high"
			}
		}
	}
	revision ">=5.2 <5.6" {
		thinking-efforts "low" "medium" "high" "xhigh"
	}
	revision ">=5.6" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		requires-reasoning-off-juice-instruction #true
	}
	// Delegation appetite is a lineage trait. GPT-5.6 was trained on Codex's
	// "no subagents unless asked" developer message; GPT-6 fans out on its own
	// and over-delegates under Claude-calibrated prompts (reflexive scouts,
	// single-agent babysitting), so it gets the restrained tier instead.
	revision "=5.6" {
		delegation-bias "gated"
	}
	revision ">=6" {
		delegation-bias "restrained"
	}
	// GPT-6 Astra changes reasoning effort mid-conversation through a
	// `configuration_update` input item so the request-level effort (and the
	// cached prompt prefix) stays put; every other SKU 400s on the item type.
	models "gpt-6-astra" {
		supports-configuration-update #true
	}
	// Codex SKUs: the advertised 400K figure includes the output budget; the
	// true prompt window is 272K. Spark budgets are its own family's.
	family "codex" {
		revision ">=1" {
			limits-patch {
				context-window 272000
			}
		}
	}
}
