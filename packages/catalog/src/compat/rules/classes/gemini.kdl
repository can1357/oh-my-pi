// Model-lineage compat for "gemini"; regenerated from the frozen census using class taxonomy selectors.

class "gemini" {
	// Gemini ladders follow the model generation on every host: pre-3.0 keeps
	// the four-tier scale, Gemini 3+ Pro exposes only low/high, and the 3+
	// Flash/Lite lines keep the four-tier scale.
	family "pro" {
		// Replaces the Gemini 2.5+ Pro mandatory-reasoning fallback.
		revision ">=2.5 <3" {
			thinking-requires-effort #true
		}
		revision "<3" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
		revision ">=3" {
			thinking-efforts "low" "high"
		}
	}
	family "flash" {
		revision ">=0" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	family "lite" {
		revision ">=0" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	// Direct Gemini 2.5 thinking budgets. Flash and Lite share the lower
	// documented ceiling; Pro keeps the full 32k high tier.
	on "google" "google-vertex" "opencode-zen" {
		family "pro" {
			revision ">=2.5 <2.6" {
				thinking-effort-budgets {
					minimal 128
					low 2048
					medium 8192
					high 32768
					xhigh 32768
					max 32768
				}
			}
		}
		family "flash" {
			revision ">=2.5 <2.6" {
				thinking-effort-budgets {
					minimal 128
					low 2048
					medium 8192
					high 24576
					xhigh 24576
					max 24576
				}
			}
		}
		family "lite" {
			revision ">=2.5 <2.6" {
				thinking-effort-budgets {
					minimal 128
					low 2048
					medium 8192
					high 24576
					xhigh 24576
					max 24576
				}
			}
		}
	}
	// Gemini 3.7 Flash is the one Flash revision whose native thinkingLevel does
	// not accept `minimal` (400 THINKING_LEVEL_MINIMAL). Only the direct
	// google-level transports emit `thinkingLevel` on the wire, so the tier is
	// dropped there; budget (anthropic-messages) and reasoning_effort resellers
	// never send the rejected value and keep the four-tier ladder. The collapsed
	// google-antigravity / google-gemini-cli variants remap minimal -> LOW and
	// carry their own explicit ladder, so they are unaffected.
	// https://ai.google.dev/gemini-api/docs/generate-content/thinking#thinking-levels
	on "google" "google-vertex" "opencode-zen" {
		family "flash" {
			revision ">=3.7 <3.8" {
				thinking-efforts "low" "medium" "high"
			}
		}
	}

	revision ">=3" {
		// Replaces the Google multimodal function-response baseline.
		multimodal-function-response #true
		// Replaces the Gemini 3+ mandatory-reasoning fallback.
		thinking-requires-effort #true
	}
	// Public Gemini requires the bypass sentinel on every unsigned call. The
	// Cloud Code Assist first-call variant is a host contract in providers/.
	on "google" "opencode-zen" {
		revision ">=3" {
			requires-skip-thought-signature #true
			supports-function-part-id #true
		}
	}
	on "google-antigravity" "google-gemini-cli" {
		family "flash" {
			stream-first-event-timeout-ms 60000
			flash-stream-leak-workaround #true
		}
	}

	thinking-loop-guard "gemini"
}
