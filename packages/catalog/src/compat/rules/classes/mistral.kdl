// Model-lineage compat for "mistral"; regenerated from the frozen census using class taxonomy selectors.

class "mistral" {
	on "amazon-bedrock" "openrouter" {
		family "mistral" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	on "amazon-bedrock" "vercel-ai-gateway" {
		family "mistral" {
			thinking-mode "budget"
		}
	}
	on "kilo" "mistral" "nanogpt" "nvidia" "venice" "vercel-ai-gateway" {
		family "mistral" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
}
