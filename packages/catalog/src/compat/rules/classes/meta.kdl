// Model-lineage compat for "meta"; regenerated from the frozen census using class taxonomy selectors.

class "meta" {
	// Exact ids on purpose: only an exact selector upgrades hosts whose
	// discovery misreports a Muse Spark revision as non-reasoning.
	// muse-spark-1.3 standard and contributor expose the max effort tier;
	// older revisions keep the 5-tier ladder.
	models "muse-spark-1.3" "muse-spark-1.3-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
		thinking-mode "effort"
	}
	// Meta documents `max` for Muse Wonder (dev.meta.ai/docs/reasoning); the
	// Muse Code-only Wonder Full and contributor tiers accept it too (verified
	// 2026-10-12).
	models "muse-wonder-1.0" "muse-wonder-1.0-contributor" "muse-wonder-full-1.0" "muse-wonder-full-1.0-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
		thinking-mode "effort"
	}
	models "muse-spark-1.1" "muse-spark-1.2" "muse-spark-1.2-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	on "kilo" "nvidia" {
		family "llama" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
}
