// Model-lineage compat for "meta"; regenerated from the frozen census using class taxonomy selectors.

class "meta" {
	// Exact ids on purpose: only an exact selector upgrades hosts whose
	// discovery misreports a Muse Spark revision as non-reasoning.
	// muse-spark-1.3 exposes the max effort tier; 1.3-contributor exposes it
	// by identity on every provider, and resolveThinkingPolicy strips it on
	// any endpoint but the direct Model API wire, where the captured Muse
	// User-Agent enables `max` in live tests. The cascade has no URL
	// dimension, so the endpoint half of the condition lives in TS.
	// Vendor documents `max` for standard 1.3 and announces Contributor `max`
	// for Muse Code subscriptions; PAYG success is observed wire behavior,
	// not a permission claim. Older revisions keep the 5-tier ladder.
	models "muse-spark-1.3" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
		thinking-mode "effort"
	}
	models "muse-spark-1.1" "muse-spark-1.2" "muse-spark-1.2-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	models "muse-spark-1.3-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
		thinking-mode "effort"
	}
	on "kilo" "nvidia" {
		family "llama" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
}
