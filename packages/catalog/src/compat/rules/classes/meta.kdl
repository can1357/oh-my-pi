// Model-lineage compat for "meta"; regenerated from the frozen census using class taxonomy selectors.

class "meta" {
	// Exact ids on purpose: only an exact selector upgrades hosts whose
	// discovery misreports a Muse Spark revision as non-reasoning.
	// muse-spark-1.3 exposes the max effort tier; older/contributor revisions
	// keep the 5-tier ladder.
	models "muse-spark-1.3" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
		thinking-mode "effort"
	}
	models "muse-spark-1.1" "muse-spark-1.2" "muse-spark-1.2-contributor" "muse-spark-1.3-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	// The `meta/`-prefixed ids are the same models served through reseller
	// namespaces (kilo, nanogpt, openrouter, vercel-ai-gateway, zenmux):
	// exact match runs against the provider-relative id, so the bare ids
	// alone miss them. Standard SKU only — like the bare-id rule above,
	// contributor revisions keep the five-tier ladder. No `thinking-mode`
	// here — the mode is an API dialect (budget on anthropic-messages,
	// effort elsewhere) and the API-derived default already reproduces
	// each row.
	models "meta/muse-spark-1.3" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
	}
	// Contributor revisions keep the five-tier ladder on reseller
	// namespaces too: without an exact rule, hosts whose discovery
	// misreports the revision as non-reasoning lose `thinking` on live
	// refresh while the bundled row advertises the ladder.
	models "meta/muse-spark-1.3-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	on "kilo" "nvidia" {
		family "llama" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
}
