// Model-lineage compat for "anthropic"; regenerated from the frozen census using class taxonomy selectors.

// Images bill ⌈w/28⌉·⌈h/28⌉ visual tokens on every host. Claude 4.7+ and
// Fable/Mythos read up to 2576px and 4,784 tokens; older lines fit 1568px and
// cap at 1,568 tokens, downscaling past it.
// https://platform.claude.com/docs/en/build-with-claude/vision#evaluate-image-size
// The class default is the high-res tier, so ids without a revision
// (`claude-opus-latest`, `~anthropic/claude-sonnet-latest`) and future lines
// are never undercounted; only Opus/Sonnet/Haiku revisions known to predate
// 4.7 take the standard tier. Separator-collapsed revisions parse as two
// digits (`claude-opus-45` is Opus 4.5 → 45), so 10–46 is standard too.
class "anthropic" {
	image-tokenization {
		regime "anthropic-patch"
		max-edge 2576
		max-tokens 4784
	}
	family "opus" {
		revision "<4.7" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
		revision ">=10 <47" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
	}
	family "sonnet" {
		revision "<4.7" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
		revision ">=10 <47" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
	}
	family "haiku" {
		revision "<4.7" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
		revision ">=10 <47" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
	}
}

class "anthropic" {
	family "fable" {
		revision ">=5.1" {
			// Fable 5.1+ binds signed thinking to the exact preceding conversation.
			thinking-prefix-binding #true
		}
	}
	// Adaptive Claude (Opus 4.7+, Sonnet/Fable/Mythos 5+, Haiku 5.5+) rejects explicit
	// sampling params (`temperature`, `top_p`, `top_k`) with a 400 on every
	// serving host. The `<10` bound keeps whole-number revisions such as
	// `claude-opus-45` (Opus 4.5) out of the range.
	family "opus" {
		revision ">=4.7 <10" {
			supports-sampling-params #false
		}
	}
	family "sonnet" {
		revision ">=5 <10" {
			supports-sampling-params #false
		}
	}
	family "fable" {
		revision ">=5 <10" {
			supports-sampling-params #false
		}
	}
	family "mythos" {
		revision ">=5 <10" {
			supports-sampling-params #false
		}
	}
	family "haiku" {
		revision ">=5.5 <10" {
			supports-sampling-params #false
		}
	}
	// On-demand compaction (compact-2026-09-04) works on the Claude API, Vertex,
	// and Amazon Bedrock's `/anthropic` routes, not Bedrock Converse.
	// Foundry / Claude Platform on AWS are first-party Anthropic routes whose
	// effective URLs are checked at request time.
	on "anthropic" "google-vertex" "amazon-bedrock" "bedrock-mantle" {
		family "fable" {
			revision ">=5" {
				supports-server-compaction #true
			}
		}
		family "mythos" {
			revision ">=5" {
				supports-server-compaction #true
			}
		}
		family "opus" {
			revision ">=4.6" {
				supports-server-compaction #true
			}
		}
		family "sonnet" {
			revision ">=4.6" {
				supports-server-compaction #true
			}
		}
		family "haiku" {
			revision ">=5.5 <6" {
				supports-server-compaction #true
			}
		}
		models "claude-mythos-preview" {
			supports-server-compaction #true
		}
	}
	// Sonnet 4.5 and newer end generation with `model_context_window_exceeded`
	// when prompt + max_tokens overruns the window, instead of a 400, so the
	// full output cap can be requested without sizing the prompt. Verified for
	// the Claude API only:
	// https://platform.claude.com/docs/en/build-with-claude/handling-stop-reasons#model-context-window-exceeded
	on "anthropic" {
		revision ">=4.5" {
			stops-output-at-context-window #true
		}
	}
	// Opus 5.5 rejects forced tool selection the way Fable/Mythos do — a
	// `tool_choice` of `tool` or `any` fails the request with 400
	// `invalid_request_error`: `tool_choice: type "tool" and "any" are not
	// supported for this model`. This holds on every route, including Bedrock
	// Converse (`toolChoice: {any: {}}`). The transports downgrade the selector
	// to `auto` so the tool stays offered instead of the turn dying.
	//
	// Upper-bounded on purpose: separator-collapsed ids parse their revision
	// as a whole number (`claude-opus-45` is Opus 4.5, revision 45), so an
	// open `>=5.5` would silently catch them, and a later Opus generation has
	// to be re-verified against the API before it inherits the restriction.
	family "opus" {
		revision ">=5.5 <6" {
			// Opus 5.5 binds signed thinking to the exact preceding conversation, so a
			// replay fails once the system prompt, tools or earlier messages change.
			// Like the Sonnet 5.5 rule, this one spans every provider, so it changes
			// pruning, implicit prompt refreshes and thinking replay everywhere. On
			// Bedrock Converse it also sends `block_binding` with its beta.
			// https://platform.claude.com/docs/en/build-with-claude/preserved-thinking
			thinking-prefix-binding #true
			supports-forced-tool-choice #false
		}
	}
	// Sonnet 5.5 rejects forced tool selection like Opus 5.5 (400 `tool_choice:
	// type "tool" and "any" are not supported for this model`); upper-bounded
	// for the same reason as the Opus rule above.
	// https://platform.claude.com/docs/en/models/sonnet-5-5/whats-new-sonnet-5-5
	family "sonnet" {
		revision ">=5.5 <6" {
			supports-forced-tool-choice #false
			// `thinking: {type: "disabled"}` is a 400; `between_tools` is the
			// lowest thinking setting.
			// https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#turn-off-up-front-thinking
			supports-between-tools-thinking #true
			// Signed thinking is bound to the exact preceding conversation.
			thinking-prefix-binding #true
		}
	}
	// Haiku 5.5 binds signed thinking to the exact preceding conversation like
	// Sonnet 5.5. It accepts a forced `tool_choice` (the response just skips
	// thinking), so it keeps forced tool selection.
	// https://platform.claude.com/docs/en/models/haiku-5-5/migration-guide
	family "haiku" {
		revision ">=5.5 <6" {
			thinking-prefix-binding #true
		}
	}
	on "anthropic" "cloudflare-ai-gateway" "google-vertex" {
		family "fable" {
			revision ">=5" {
				supports-mid-conversation-system #true
				supports-mid-conversation-tool-changes #true
				supports-turn-scoped-system #true
			}
		}
		family "mythos" {
			revision ">=5" {
				supports-mid-conversation-system #true
				supports-mid-conversation-tool-changes #true
				supports-turn-scoped-system #true
			}
		}
		family "fable" {
			revision ">=5.1" {
				supports-thinking-binding-controls #true
			}
		}
		family "sonnet" {
			revision ">=5.5" {
				supports-mid-conversation-system #true
				supports-mid-conversation-tool-changes #true
				supports-turn-scoped-system #true
			}
		}
		family "haiku" {
			revision ">=5.5 <6" {
				supports-mid-conversation-system #true
				supports-mid-conversation-tool-changes #true
				supports-turn-scoped-system #true
			}
		}
		family "opus" {
			revision ">=4.8" {
				supports-mid-conversation-system #true
				supports-mid-conversation-tool-changes #true
				supports-turn-scoped-system #true
			}
		}
	}
	// Vertex rejects `thinking.block_binding` on Sonnet 5.5 with 400
	// `thinking.adaptive.block_binding: Extra inputs are not permitted`, and
	// per-message `output_config` with 400 `messages.N.output_config: Extra
	// inputs are not permitted` (it takes no `output_config.effort` at all; see
	// `supports-output-effort` in providers/google-vertex.kdl).
	on "anthropic" "cloudflare-ai-gateway" {
		family "fable" {
			revision ">=5.1" {
				supports-per-message-effort #true
			}
		}
		family "mythos" {
			revision ">=5.1" {
				supports-per-message-effort #true
			}
		}
		family "sonnet" {
			revision ">=5.5" {
				supports-thinking-binding-controls #true
				supports-per-message-effort #true
			}
		}
		// Haiku 5.5 mirrors Sonnet 5.5; Vertex stays off until verified.
		family "haiku" {
			revision ">=5.5 <6" {
				supports-thinking-binding-controls #true
				supports-per-message-effort #true
			}
		}
		family "opus" {
			revision ">=5" {
				supports-per-message-effort #true
			}
			// Opus 5.5 is prefix-bound like Sonnet 5.5; without `drop_block` a
			// changed system prompt or tool set fails the replay with a 400.
			// Bounded for the same reason as the forced-tool-choice rule above.
			revision ">=5.5 <6" {
				supports-thinking-binding-controls #true
			}
		}
	}
	on "aimlapi" "gitlab-duo" "kilo" "nanogpt" "venice" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "gitlab-duo" \
		"google-antigravity" "google-vertex" "opencode-zen" "snowflake" "vercel-ai-gateway" "zenmux" {
		family "sonnet" {
			revision ">=3.7 <4.6" {
				thinking-mode "budget"
			}
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "gitlab-duo" \
		"google-vertex" "opencode-zen" "snowflake" "vercel-ai-gateway" {
		family "haiku" {
			thinking-mode "budget"
			// Haiku 5.5 is the first adaptive Haiku: `budget_tokens` is a 400.
			revision ">=5.5 <6" {
				thinking-mode "anthropic-adaptive"
			}
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "gitlab-duo" \
		"google-vertex" "opencode-zen" "snowflake" "vercel-ai-gateway" "zenmux" {
		family "opus" {
			revision ">=4.5 <4.6" {
				thinking-mode "anthropic-budget-effort"
			}
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "google-vertex" \
		"opencode-zen" "openrouter" "snowflake" "vercel-ai-gateway" "zenmux" {
		family "opus" {
			revision ">=4.6 <4.7" {
				thinking-efforts "low" "medium" "high" "max"
			}
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "google-vertex" \
		"opencode-zen" "snowflake" "vercel-ai-gateway" "zenmux" {
		revision ">=4.7 <45.1" {
			thinking-mode "anthropic-adaptive"
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "opencode-zen" "vercel-ai-gateway" \
		"zenmux" {
		family "opus" {
			revision ">=4 <4.5" {
				thinking-mode "budget"
			}
		}
	}
	on "amazon-bedrock" "cursor" "google-antigravity" "openrouter" {
		family "sonnet" {
			revision ">=4.6 <5" {
				thinking-efforts "minimal" "low" "medium" "high"
			}
		}
		revision ">=3.7 <4.6" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	on "amazon-bedrock" "google-antigravity" {
		family "sonnet" {
			revision ">=4.6 <5" {
				thinking-mode "budget"
			}
		}
	}
	on "anthropic" "cloudflare-ai-gateway" "github-copilot" "google-vertex" "opencode-zen" \
		"openrouter" "snowflake" "vercel-ai-gateway" "zenmux" {
		revision ">=4.7 <45.1" {
			thinking-efforts "low" "medium" "high" "xhigh" "max"
		}
	}
	on "anthropic" "cloudflare-ai-gateway" "github-copilot" "google-vertex" "opencode-zen" \
		"snowflake" "vercel-ai-gateway" "zenmux" {
		family "sonnet" {
			revision ">=4.6 <5" {
				thinking-efforts "low" "medium" "high"
			}
		}
		revision ">=4.6 <4.7" {
			thinking-mode "anthropic-adaptive"
		}
	}
	// Reviewed catalog-metadata corrections (stale upstream pricing/limits).
	on "anthropic" {
		family "opus" {
			revision "=4.5" {
				// stencil.so reports 3x the correct cache pricing.
				cost-patch {
					cache-read 0.5
					cache-write 6.25
				}
			}
		}
		// Anthropic's /v1/models omits token limits and pricing for the
		// Fable/Mythos generation; pin the model-card values.
		family "fable" {
			cost-patch {
				input 10.0
				output 50.0
				cache-read 1.0
				cache-write 12.5
			}
			// Fable 5.1 cut cache reads to $0.25/MTok, 0.025x input, a 75% rate
			// unique to the 5.1 generation; Fable 5 stays at the 0.1x family
			// default. https://www.anthropic.com/claude/fable
			//
			// `cost-patch` is an object axis, so the winning rule supplies the
			// whole payload rather than merging field-wise over the family
			// patch above. Restate input/output/cache-write, or a
			// discovery-sourced 5.1 row (Anthropic's /v1/models omits pricing)
			// would keep only the cache-read correction.
			revision "=5.1" {
				cost-patch {
					input 10.0
					output 50.0
					cache-read 0.25
					cache-write 12.5
				}
			}
			limits-patch {
				context-window 1000000
				max-tokens 128000
			}
		}
		// /v1/models reports neither reasoning, vision, pricing nor limits for
		// Haiku 5.5, so a discovered row would materialize as a text-only,
		// unpriced, non-reasoning model; pin the model card. Prompts over 100K
		// input tokens bill the whole request at the long-context rates.
		// https://platform.claude.com/docs/en/models/haiku-5-5/overview
		family "haiku" {
			revision ">=5.5 <6" {
				thinking-upgrade-neutral #true
				input-modalities "text" "image"
				cost-patch {
					input 0.1
					output 0.5
					cache-read 0.01
					cache-write 0.125
				}
				long-context-cost {
					input-threshold 100000
					input 0.5
					output 2.5
					cache-read 0.05
					cache-write 0.625
				}
				limits-patch {
					context-window 1000000
					max-tokens 128000
				}
			}
		}
		family "mythos" {
			cost-patch {
				input 10.0
				output 50.0
				cache-read 1.0
				cache-write 12.5
			}
			// Mythos 5.1 shares Fable 5.1's 0.025x cache-read rate ($0.25/MTok);
			// Mythos 5 stays at the 0.1x family default.
			// https://platform.claude.com/docs/en/about-claude/pricing
			//
			// `cost-patch` is an object axis, so the winning rule supplies the
			// whole payload rather than merging field-wise over the family
			// patch above (same shape as the fable `=5.1` override).
			revision "=5.1" {
				cost-patch {
					input 10.0
					output 50.0
					cache-read 0.25
					cache-write 12.5
				}
			}
			limits-patch {
				context-window 1000000
				max-tokens 128000
			}
		}
	}
	on "amazon-bedrock" {
		// Model metadata applies to every Bedrock request adapter.
		// Upstream metadata is stale for cache pricing and context.
		family "opus" {
			revision "=4.6" {
				cost-patch {
					cache-read 0.5
					cache-write 6.25
				}
				limits-patch {
					context-window 1000000
					max-tokens 128000
				}
			}
		}
		// AWS Bedrock Converse prompt-cache checkpoints, from the AWS model cards
		// (docs.aws.amazon.com/bedrock/latest/userguide/model-cards.html); cache
		// pricing is deliberately not used to infer these request shapes. Keep the
		// provider and adapter conjunctive so this policy stays on Converse.
		on-api "bedrock-converse-stream" {
			family "opus" {
				revision ">=4 <4.5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 1024
					prompt-cache-maximum-checkpoints 4
					prompt-cache {
						short 300
					}
				}
				revision "=4.5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 4096
					prompt-cache-maximum-checkpoints 4
					prompt-cache {
						short 300
						long 3600
					}
					supports-long-prompt-cache-retention #true
				}
				revision "=4.6" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 4096
					prompt-cache-maximum-checkpoints 4
					prompt-cache {
						short 300
					}
				}
				revision ">=4.7 <5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 4096
					prompt-cache-maximum-checkpoints 4
					supports-long-prompt-cache-retention #true
					prompt-cache {
						short 300
						long 3600
					}
				}
				revision ">=5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 512
					prompt-cache-maximum-checkpoints 4
					supports-long-prompt-cache-retention #true
					prompt-cache {
						short 300
						long 3600
					}
				}
			}
			family "sonnet" {
				revision "=3.5" {
					models "*3-5-sonnet-20241022-v2*" {
						prompt-cache-mode "explicit"
						prompt-cache-minimum-tokens 1024
						prompt-cache-maximum-checkpoints 4
						prompt-cache {
							short 300
						}
					}
				}
				revision "=3.7" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 1024
					prompt-cache-maximum-checkpoints 4
					prompt-cache {
						short 300
					}
				}
				revision ">=4 <4.5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 1024
					prompt-cache-maximum-checkpoints 4
					prompt-cache {
						short 300
					}
				}
				revision "=4.5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 4096
					prompt-cache-maximum-checkpoints 4
					supports-long-prompt-cache-retention #true
					prompt-cache {
						short 300
						long 3600
					}
				}
				revision "=4.6" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 1024
					prompt-cache-maximum-checkpoints 4
					prompt-cache {
						short 300
					}
				}
				revision ">=5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 4096
					prompt-cache-maximum-checkpoints 4
					supports-long-prompt-cache-retention #true
					prompt-cache {
						short 300
						long 3600
					}
				}
			}
			family "haiku" {
				revision "=3.5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 2048
					prompt-cache-maximum-checkpoints 4
					prompt-cache {
						short 300
					}
				}
				revision ">=4.5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 4096
					prompt-cache-maximum-checkpoints 4
					supports-long-prompt-cache-retention #true
					prompt-cache {
						short 300
						long 3600
					}
				}
			}
			family "fable" {
				revision ">=5" {
					prompt-cache-mode "explicit"
					prompt-cache-minimum-tokens 1024
					prompt-cache-maximum-checkpoints 4
					supports-long-prompt-cache-retention #true
					prompt-cache {
						short 300
						long 3600
					}
				}
			}
		}
	}
	// Messages routes on Bedrock Runtime and Mantle use the Anthropic five-minute
	// cache lifetime. Require both the AWS provider and Messages API: model IDs
	// alone do not distinguish Bedrock from gateways or other API lanes.
	on "amazon-bedrock" "bedrock-mantle" {
		on-api "anthropic-messages" {
			family "opus" {
				revision ">=4.7" {
					prompt-cache {
						short 300
					}
				}
			}
			family "sonnet" {
				revision ">=4.6" {
					prompt-cache {
						short 300
					}
				}
			}
			family "haiku" {
				revision ">=4.5" {
					prompt-cache {
						short 300
					}
				}
			}
			family "fable" {
				revision ">=5" {
					prompt-cache {
						short 300
					}
				}
			}
			family "mythos" {
				// The Mythos Preview id has no numeric revision to select.
				models "*mythos-preview*" {
					prompt-cache {
						short 300
					}
				}

				revision ">=5" {
					prompt-cache {
						short 300
					}
				}
			}
		}
	}
	// Claude 3.5 Haiku OAuth requests omit the Claude Code instruction.
	family "haiku" {
		revision "=3.5" {
			inject-claude-code-instruction #false
		}
	}

	// Cloud Code Assist exposes Claude through Google's wire envelope.
	on "google-antigravity" "google-gemini-cli" {
		supports-function-part-id #true
		cca-legacy-parameters-schema #true
	}
	on "google-antigravity" {
		drop-unsigned-thinking #true
		claude-thinking-beta-header #true
		antigravity-claude-tool-mode #true
		antigravity-usage-label "true"
	}
}

// Claude 4+ ships the server-side `web_search` tool on any Messages-compatible host.
class "anthropic" {
	on-api "anthropic-messages" {
		revision ">=4" {
			web-search "anthropic"
			web-search-model "claude-haiku-4-5"
		}
	}
}
