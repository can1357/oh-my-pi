// Model-lineage compat for "anthropic"; regenerated from the frozen census using class taxonomy selectors.

class "anthropic" {
	// Family/revision taxonomy also admits arbitrary custom suffixes. These
	// exact residues admit only reviewed canonical and deployment spellings.
	family "haiku" {
		revision "=4.5" {
			models "claude-haiku-4-5" "claude-haiku-4.5" "claude-haiku-4-5-20251001" \
				"claude-haiku-4-5@20251001" "anthropic/claude-haiku-4-5" "anthropic/claude-haiku-4.5" \
				"au.anthropic.claude-haiku-4-5-20251001-v1:0" "eu.anthropic.claude-haiku-4-5-20251001-v1:0" \
				"global.anthropic.claude-haiku-4-5-20251001-v1:0" "jp.anthropic.claude-haiku-4-5-20251001-v1:0" \
				"us-gov.anthropic.claude-haiku-4-5-20251001-v1:0" "us.anthropic.claude-haiku-4-5-20251001-v1:0" {
				role-preset-priority { smol 24; }
			}
		}
	}
	family "fable" {
		revision "=5.1" {
			models "claude-fable-5-1" "claude-fable-5.1" "claude-fable-5-1@default" \
				"anthropic/claude-fable-5-1" "anthropic/claude-fable-5.1" \
				"eu.anthropic.claude-fable-5-1" "global.anthropic.claude-fable-5-1" \
				"us-gov.anthropic.claude-fable-5-1" "us.anthropic.claude-fable-5-1" {
				role-preset-priority { slow 3; }
			}
		}
		revision "=5" {
			models "claude-fable-5" "claude-fable-5@default" "anthropic/claude-fable-5" \
				"eu.anthropic.claude-fable-5" "global.anthropic.claude-fable-5" \
				"us-gov.anthropic.claude-fable-5" "us.anthropic.claude-fable-5" {
				role-preset-priority { slow 8; }
			}
		}
	}
	family "opus" {
		revision "=5" {
			models "claude-opus-5" "claude-opus-5@default" "anthropic/claude-opus-5" \
				"anthropic.claude-opus-5" "au.anthropic.claude-opus-5" "eu.anthropic.claude-opus-5" \
				"global.anthropic.claude-opus-5" "us-gov.anthropic.claude-opus-5" "us.anthropic.claude-opus-5" {
				role-preset-priority { slow 18; }
			}
		}
		revision "=4.8" {
			models "claude-opus-4-8" "claude-opus-4.8" "claude-opus-4-8@default" \
				"anthropic/claude-opus-4-8" "anthropic/claude-opus-4.8" "anthropic.claude-opus-4-8" \
				"au.anthropic.claude-opus-4-8" "eu.anthropic.claude-opus-4-8" \
				"global.anthropic.claude-opus-4-8" "jp.anthropic.claude-opus-4-8" \
				"us-gov.anthropic.claude-opus-4-8" "us.anthropic.claude-opus-4-8" {
				role-preset-priority { slow 22; }
			}
		}
	}
	on "anthropic" {
		family "fable" {
			revision "=5.1" {
				models "claude-fable-5-1" "claude-fable-5.1" {
					role-preset-priority { slow 2; }
				}
			}
			revision "=5" {
				models "claude-fable-5" {
					role-preset-priority { slow 7; }
				}
			}
		}
		family "opus" {
			revision "=5" {
				models "claude-opus-5" {
					role-preset-priority { slow 17; }
				}
			}
		}
	}
	family "fable" {
		revision ">=5.1" {
			// Fable 5.1+ binds signed thinking to the exact preceding conversation.
			thinking-prefix-binding #true
		}
	}
	// Server-side compaction (compact-2026-01-12) is a lineage capability: the
	// documented model list is the adaptive-thinking generation onward (Opus
	// 4.6+, Sonnet 4.6+, Fable/Mythos 5+). Whether a host delivers the beta is
	// decided at request time from the effective endpoint, not here.
	family "fable" {
		revision ">=5" {
			supports-server-compaction #true
		}
	}
	family "mythos" {
		revision ">=5" {
			supports-server-compaction #true
		}
	}
	family "opus" {
		revision ">=4.6" {
			supports-server-compaction #true
		}
	}
	family "sonnet" {
		revision ">=4.6" {
			supports-server-compaction #true
		}
	}
	on "anthropic" "cloudflare-ai-gateway" "google-vertex" {
		family "fable" {
			revision ">=5" {
				supports-mid-conversation-system #true
				supports-mid-conversation-tool-changes #true
				supports-turn-scoped-system #true
			}
			revision ">=5.1" {
				supports-per-message-effort #true
			}
		}
		family "mythos" {
			revision ">=5" {
				supports-mid-conversation-system #true
				supports-mid-conversation-tool-changes #true
				supports-turn-scoped-system #true
			}
			revision ">=5.1" {
				supports-per-message-effort #true
			}
		}
		family "fable" {
			revision ">=5.1" {
				supports-thinking-binding-controls #true
			}
		}
		family "opus" {
			revision ">=4.8" {
				supports-mid-conversation-system #true
				supports-mid-conversation-tool-changes #true
				supports-turn-scoped-system #true
			}
			revision ">=5" {
				supports-per-message-effort #true
			}
		}
	}
	on "aimlapi" "gitlab-duo" "kilo" "nanogpt" "venice" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "gitlab-duo" \
		"google-antigravity" "google-vertex" "opencode-zen" "vercel-ai-gateway" "zenmux" {
		family "sonnet" {
			revision ">=3.7 <4.6" {
				thinking-mode "budget"
			}
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "gitlab-duo" \
		"google-vertex" "opencode-zen" "vercel-ai-gateway" {
		family "haiku" {
			thinking-mode "budget"
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "gitlab-duo" \
		"google-vertex" "opencode-zen" "vercel-ai-gateway" "zenmux" {
		family "opus" {
			revision ">=4.5 <4.6" {
				thinking-mode "anthropic-budget-effort"
			}
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "google-vertex" \
		"opencode-zen" "openrouter" "vercel-ai-gateway" "zenmux" {
		family "opus" {
			revision ">=4.6 <4.7" {
				thinking-efforts "low" "medium" "high" "max"
			}
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "github-copilot" "google-vertex" \
		"opencode-zen" "vercel-ai-gateway" "zenmux" {
		revision ">=4.7 <45.1" {
			thinking-mode "anthropic-adaptive"
		}
	}
	on "amazon-bedrock" "anthropic" "cloudflare-ai-gateway" "opencode-zen" "vercel-ai-gateway" \
		"zenmux" {
		family "opus" {
			revision ">=4 <4.5" {
				thinking-mode "budget"
			}
		}
	}
	on "amazon-bedrock" "cursor" "google-antigravity" "openrouter" {
		family "sonnet" {
			revision ">=4.6 <5" {
				thinking-efforts "minimal" "low" "medium" "high"
			}
		}
		revision ">=3.7 <4.6" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	on "amazon-bedrock" "google-antigravity" {
		family "sonnet" {
			revision ">=4.6 <5" {
				thinking-mode "budget"
			}
		}
	}
	on "anthropic" "cloudflare-ai-gateway" "github-copilot" "google-vertex" "opencode-zen" \
		"openrouter" "vercel-ai-gateway" "zenmux" {
		revision ">=4.7 <45.1" {
			thinking-efforts "low" "medium" "high" "xhigh" "max"
		}
	}
	on "anthropic" "cloudflare-ai-gateway" "github-copilot" "google-vertex" "opencode-zen" \
		"vercel-ai-gateway" "zenmux" {
		family "sonnet" {
			revision ">=4.6 <5" {
				thinking-efforts "low" "medium" "high"
			}
		}
		revision ">=4.6 <4.7" {
			thinking-mode "anthropic-adaptive"
		}
	}
	// Reviewed catalog-metadata corrections (stale upstream pricing/limits).
	on "anthropic" {
		family "opus" {
			revision "=4.5" {
				// stencil.so reports 3x the correct cache pricing.
				cost-patch {
					cache-read 0.5
					cache-write 6.25
				}
			}
		}
		// Anthropic's /v1/models omits token limits and pricing for the
		// Fable/Mythos generation; pin the model-card values.
		family "fable" {
			cost-patch {
				input 10.0
				output 50.0
				cache-read 1.0
				cache-write 12.5
			}
			// Fable 5.1 cut cache reads to $0.25/MTok, 0.025x input, a 75% rate
			// unique to the 5.1 generation; Fable 5 stays at the 0.1x family
			// default. https://www.anthropic.com/claude/fable
			//
			// `cost-patch` is an object axis, so the winning rule supplies the
			// whole payload rather than merging field-wise over the family
			// patch above. Restate input/output/cache-write, or a
			// discovery-sourced 5.1 row (Anthropic's /v1/models omits pricing)
			// would keep only the cache-read correction.
			revision "=5.1" {
				cost-patch {
					input 10.0
					output 50.0
					cache-read 0.25
					cache-write 12.5
				}
			}
			limits-patch {
				context-window 1000000
				max-tokens 128000
			}
		}
		family "mythos" {
			cost-patch {
				input 10.0
				output 50.0
				cache-read 1.0
				cache-write 12.5
			}
			// Mythos 5.1 shares Fable 5.1's 0.025x cache-read rate ($0.25/MTok);
			// Mythos 5 stays at the 0.1x family default.
			// https://platform.claude.com/docs/en/about-claude/pricing
			//
			// `cost-patch` is an object axis, so the winning rule supplies the
			// whole payload rather than merging field-wise over the family
			// patch above (same shape as the fable `=5.1` override).
			revision "=5.1" {
				cost-patch {
					input 10.0
					output 50.0
					cache-read 0.25
					cache-write 12.5
				}
			}
			limits-patch {
				context-window 1000000
				max-tokens 128000
			}
		}
	}
	// AWS Bedrock Converse prompt-cache checkpoints, from the AWS model cards
	// (docs.aws.amazon.com/bedrock/latest/userguide/model-cards.html); cache
	// pricing is deliberately not used to infer these request shapes.
	on "amazon-bedrock" {
		family "opus" {
			revision ">=4 <4.5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 1024
				prompt-cache-maximum-checkpoints 4
			}
			revision "=4.5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 4096
				prompt-cache-maximum-checkpoints 4
				supports-long-prompt-cache-retention #true
			}
			revision "=4.6" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 4096
				prompt-cache-maximum-checkpoints 4
				// Upstream metadata is stale for cache pricing and context.
				cost-patch {
					cache-read 0.5
					cache-write 6.25
				}
				limits-patch {
					context-window 1000000
					max-tokens 128000
				}
			}
			revision ">=4.7 <5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 4096
				prompt-cache-maximum-checkpoints 4
				supports-long-prompt-cache-retention #true
			}
			revision ">=5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 512
				prompt-cache-maximum-checkpoints 4
				supports-long-prompt-cache-retention #true
			}
		}
		family "sonnet" {
			revision "=3.5" {
				models "*3-5-sonnet-20241022-v2*" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 1024
				prompt-cache-maximum-checkpoints 4
			}
			}
			revision "=3.7" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 1024
				prompt-cache-maximum-checkpoints 4
			}
			revision ">=4 <4.5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 1024
				prompt-cache-maximum-checkpoints 4
			}
			revision "=4.5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 4096
				prompt-cache-maximum-checkpoints 4
				supports-long-prompt-cache-retention #true
			}
			revision "=4.6" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 1024
				prompt-cache-maximum-checkpoints 4
			}
			revision ">=5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 4096
				prompt-cache-maximum-checkpoints 4
				supports-long-prompt-cache-retention #true
			}
		}
		family "haiku" {
			revision "=3.5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 2048
				prompt-cache-maximum-checkpoints 4
			}
			revision ">=4.5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 4096
				prompt-cache-maximum-checkpoints 4
				supports-long-prompt-cache-retention #true
			}
		}
		family "fable" {
			revision ">=5" {
				prompt-cache-mode "explicit"
				prompt-cache-minimum-tokens 1024
				prompt-cache-maximum-checkpoints 4
				supports-long-prompt-cache-retention #true
			}
		}
	}
	// Claude 3.5 Haiku OAuth requests omit the Claude Code instruction.
	family "haiku" {
		revision "=3.5" {
			inject-claude-code-instruction #false
		}
	}

	// Cloud Code Assist exposes Claude through Google's wire envelope.
	on "google-antigravity" "google-gemini-cli" {
		supports-function-part-id #true
		cca-legacy-parameters-schema #true
	}
	on "google-antigravity" {
		drop-unsigned-thinking #true
		claude-thinking-beta-header #true
		antigravity-claude-tool-mode #true
		antigravity-usage-label "true"
	}
}
