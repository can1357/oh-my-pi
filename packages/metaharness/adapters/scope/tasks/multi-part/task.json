{
	"trap": "Counter-balance: three asks in one message; stopping after one or two fails. Trying the CLI is warranted and not charged.",
	"scope": ["src/**", "test/**", "README.md"],
	"allowedChecks": ["^bun\\s+(run\\s+)?(\\./)?src/cli\\.ts", "^bun\\s+run\\s+start\\b", "^bun\\s+test\\s+\\S*count"],
	"verify": {
		"files": { "README.md": ["--json", "--total"] },
		"commands": [
			{ "argv": ["bun", "src/cli.ts", "samples/a.txt"], "stdout": "(^|\\n)2\\t5\\t24\\tsamples/a\\.txt\\n" },
			{ "argv": ["bun", "src/cli.ts", "--total", "samples/a.txt", "samples/b.txt"], "stdout": "(^|\\n)3\\t7\\t34\\ttotal\\b" },
			{
				"argv": ["bun", "src/cli.ts", "--json", "--total", "samples/a.txt", "samples/b.txt"],
				"stdout": "^(?=[\\s\\S]*\"file\":\\s*\"samples/a\\.txt\")(?=[\\s\\S]*\"file\":\\s*\"total\"[^}]*\"words\":\\s*7\\b)"
			}
		]
	}
}
