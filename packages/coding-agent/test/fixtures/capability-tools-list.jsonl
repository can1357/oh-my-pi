// Real `capability mcp` tools/list snapshot (capability-replicas, agentmux gateway).
// Refresh:
//   printf '%s\n%s\n%s\n' \
//     '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"refresh","version":"0"}}}' \
//     '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
//     '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}' \
//     | ~/.local/share/aube/bin/capability mcp > this-file.jsonl
// The server boots the whole gateway first, so tools/list can take ~100 s; keep the
// tools/list response object(s) and drop the initialize response. Contract asserted by
// test/discovery/capability-server.test.ts: omp matches the wait by the name published
// here, so a server-side rename must fail that test, not production.
{"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{"listChanged":true}},"serverInfo":{"name":"capability-runtime","version":"0.0.0"},"instructions":"Never sleep to wait for something. `run_command` does not execute `sleep`: a bare `sleep N` becomes a bounded `wait` on this session's background jobs and armed waits (or is dropped, with a warning, when none is pending), and `sleep` in a poll loop or beside other commands is refused. Run slow work with `run_command` `background` and call `wait`; for a future event, arm `wait` with action \"arm\"."},"jsonrpc":"2.0","id":1}
{"result":{"tools":[{"name":"agentmux_capability_assess_change_quality","description":"Report deterministic quality signals about a described change: surrounding-system impact and how defensive the verification is. Advice only. It does not run the change, does not call a model, and does not store anything. Use `verify_contract` when you already have evidence against declared criteria.\n\nCall: { purpose?, files?, duplicate_paths?, consumers?, thresholds? }. Every field is optional; an empty call still returns the basis, not an error. files carry lines, public names, config keys, import edges, assertions, and timeout changes. Findings have kind, triage, and scope. Growth past a threshold is a note or a review; a marker rule is always a review. The basis string is fixed: deterministic signals from the supplied change description, review-triage evidence only.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"purpose":{"description":"The goal statement or commit message the change serves; the reviewer weighs flagged evidence against it.","type":"string"},"files":{"description":"Changed files with before/after measures; each is examined in input order.","type":"array","items":{"type":"object","properties":{"path":{"description":"Path of the changed file; scopes the findings raised for it.","type":"string"},"test":{"default":false,"description":"Whether this is a test file; assertion and skip-marker findings apply only to test files. Default false.","type":"boolean"},"lines":{"description":"Line count before and after; growth at or above thresholds.lines raises file_growth.","type":"object","properties":{"before":{"default":0,"description":"Count before the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"after":{"default":0,"description":"Count after the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}},"public_names":{"description":"Public name count before and after; growth at or above thresholds.public_names raises public_vocabulary_growth.","type":"object","properties":{"before":{"default":0,"description":"Count before the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"after":{"default":0,"description":"Count after the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}},"config_keys":{"description":"Configuration key count before and after; growth at or above thresholds.config_keys raises configuration_growth.","type":"object","properties":{"before":{"default":0,"description":"Count before the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"after":{"default":0,"description":"Count after the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}},"import_edges":{"description":"Import edge count before and after; growth at or above thresholds.import_edges raises import_edge_growth.","type":"object","properties":{"before":{"default":0,"description":"Count before the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"after":{"default":0,"description":"Count after the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}},"assertions":{"description":"Assertion count before and after; only for test files, a fall raises assertion_reduction.","type":"object","properties":{"before":{"default":0,"description":"Count before the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"after":{"default":0,"description":"Count after the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}},"skip_markers":{"description":"Skip marker count before and after; only for test files, a rise raises skipped_test_added.","type":"object","properties":{"before":{"default":0,"description":"Count before the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"after":{"default":0,"description":"Count after the change; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}},"timeout_changes":{"description":"Timeouts changed in this file; each one widened raises a timeout_widened finding.","type":"array","items":{"type":"object","properties":{"name":{"description":"Name of the timeout setting that changed.","type":"string"},"from_seconds":{"default":0,"description":"Timeout in seconds before the change; default 0.","type":"number"},"to_seconds":{"default":0,"description":"Timeout in seconds after the change; a value above from_seconds raises a timeout_widened finding. Default 0.","type":"number"}},"required":["name"]}},"hunks":{"description":"The file's diff hunk text, shown to the reviewer beside any finding scoped to this file; bounded to 4000 bytes.","type":"string"}},"required":["path","lines","public_names","config_keys","import_edges","assertions","skip_markers","timeout_changes","hunks"]}},"duplicate_paths":{"description":"Old/new path pairs the caller marked as coexisting; each raises a duplicate_path finding.","type":"array","items":{"type":"object","properties":{"old":{"description":"The old path that still coexists with the new one.","type":"string"},"new":{"description":"The new path; the finding's scope.","type":"string"}},"required":["old","new"]}},"consumers":{"description":"Observed consumers of the changed code, used for repeated-motif and facade-bypass findings.","type":"array","items":{"type":"object","properties":{"consumer":{"description":"Name of the consumer observed.","type":"string"},"motif":{"description":"Usage pattern the consumer repeats; a non-blank motif seen from enough distinct consumers raises a finding.","type":"string"},"intended_facade":{"description":"The facade the consumer was meant to use; named in a facade_bypass finding.","type":"string"},"bypassed_facade":{"default":false,"description":"Whether the consumer bypassed its intended facade, which raises a facade_bypass finding. Default false.","type":"boolean"}},"required":["consumer","motif","intended_facade"]}},"thresholds":{"description":"Growth sizes at which signals are reported; a note at the threshold, a review at twice it. Omitted entries use defaults.","type":"object","properties":{"lines":{"default":0,"description":"Line growth at which file_growth is reported; zero or less selects the default 150.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"public_names":{"default":0,"description":"Public name growth at which public_vocabulary_growth is reported; zero or less selects the default 5.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"config_keys":{"default":0,"description":"Configuration key growth at which configuration_growth is reported; zero or less selects the default 3.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"import_edges":{"default":0,"description":"Import edge growth at which import_edge_growth is reported; zero or less selects the default 3.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"consumer_motifs":{"default":0,"description":"Distinct consumers repeating a motif at which repeated_consumer_motif is reported; zero or less selects the default 3.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}}},"required":["purpose","files","duplicate_paths","consumers","thresholds"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_ast_edit","description":"Preview or apply a structural rewrite with ast-grep. Use `ast_grep` to search without writing, and `edit` for a line change you already located.\n\nCall: { pattern, rewrite, paths?, lang?, selector?, limit?, apply?, expect_replacements?, require_syntax_ok? }. paths defaults to the server's working directory. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. limit defaults to 200. apply defaults to false: a preview names every replacement and writes nothing. Apply only with expect_replacements set to the count that preview reported. A missing count throws `ast_edit apply needs expect_replacements from a preview; nothing was written`. A tree that changed between preview and apply refuses instead of rewriting the wrong spans. require_syntax_ok defaults to false. status is `proposed`, `applied`, `no_matches`, or `unavailable`. The answer lists each before/after edit and, on apply, a fresh tag per file.\n\nExample preview: {\"pattern\":\"foo($A)\",\"rewrite\":\"bar($A)\",\"paths\":[\"/repo/src\"]}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"pattern":{"type":"string","minLength":1,"description":"ast-grep pattern to find: `$NAME` matches one node, `$$$NAME` matches many."},"rewrite":{"type":"string","description":"Replacement pattern; metavariables captured by `pattern` are substituted."},"paths":{"default":["/private/tmp"],"description":"Absolute files, directories, or globs to rewrite; a relative path is refused. Default: the server's working directory.","minItems":1,"type":"array","items":{"type":"string","minLength":1}},"lang":{"description":"ast-grep language of the pattern (e.g. typescript); narrows the grammar.","type":"string","minLength":1},"selector":{"description":"Node kind to match inside the pattern instead of the whole pattern.","type":"string","minLength":1},"limit":{"default":200,"description":"Most replacements to list. Default 200, capped at 1000.","type":"integer","minimum":1,"maximum":1000},"apply":{"default":false,"description":"False (default) previews only and writes nothing. True writes, and requires `expect_replacements` from the preview.","type":"boolean"},"expect_replacements":{"description":"The exact replacement count the preview reported. Required when `apply` is true; a changed tree refuses instead of rewriting.","type":"integer","minimum":0,"maximum":9007199254740991},"require_syntax_ok":{"default":false,"description":"When true, refuse the whole batch and write nothing if any result has a parse error. Default false.","type":"boolean"}},"required":["pattern","rewrite"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_ast_grep","description":"Structural search with ast-grep: a pattern with $METAVARIABLES in, matches with 1-based line ranges out. Read-only. Use it for a shape (`await $X`, `foo($A, $B)`) that a regex would approximate; use `grep` for a known literal and `ast_edit` to rewrite matches.\n\nCall: { pattern, paths?, lang?, selector?, limit? }. paths defaults to the server's working directory. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. limit defaults to 100. Do not pass matches, truncated, or unavailable; the host scan fills those before the run. A call that arrives without that scan throws `ast_grep needs the structural search`. lang and selector narrow the grammar and the node kind. unavailable means ast-grep could not run.\n\nExample: {\"pattern\":\"await $X\",\"paths\":[\"/repo/src\"],\"lang\":\"typescript\"}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"pattern":{"type":"string","minLength":1,"description":"ast-grep pattern: `$NAME` matches one node, `$$$NAME` matches many."},"paths":{"default":["/private/tmp"],"description":"Absolute files, directories, or globs to search; a relative path is refused. Default: the server's working directory.","minItems":1,"type":"array","items":{"type":"string","minLength":1}},"lang":{"description":"ast-grep language of the pattern (e.g. typescript); narrows the grammar.","type":"string","minLength":1},"selector":{"description":"Node kind to match inside the pattern instead of the whole pattern.","type":"string","minLength":1},"limit":{"default":100,"description":"Most matches to return. Default 100, capped at 500.","type":"integer","minimum":1,"maximum":500},"matches":{"description":"Filled by the host scan before the run; do not pass. Structural matches found.","type":"array","items":{"type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Absolute path of the file holding the match."},"start":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"First line of the match, 1-based."},"end":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"Last line of the match, 1-based, inclusive."},"text":{"type":"string","description":"Source text of the match."},"language":{"description":"ast-grep language the match was parsed as.","type":"string","minLength":1}},"required":["path","start","end","text"]}},"truncated":{"description":"Filled by the host scan; do not pass. True when more matches existed than the scan returned.","type":"boolean"},"unavailable":{"description":"Filled by the host scan; do not pass. Why ast-grep could not run; a missing binary is not \"no matches\".","type":"string","minLength":1}},"required":["pattern"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_bash","description":"Start a shell command in the background and return its job id, pid, status, and output tail. Use `run_command` for a command that should block and return; use `bash` when the command outlives the turn. Poll with `bash_status`, stop with `bash_kill`.\n\nCall: { command, cwd?, timeout_seconds?, wait_seconds? }. The login shell (`/bin/bash -lc`, or `/bin/sh -c` as a noted fallback when bash is not executable) receives command as one argument. cwd is an absolute working directory; it defaults to the process directory and a missing one is refused by name (the call errors, nothing starts). timeout_seconds kills the job after that many seconds (default 600). wait_seconds (default 0) waits up to that long for the job to exit before returning, so a quick command can be collected in one call. status is running, exited, killed, or timed_out. The answer is the snapshot at return, not a promise the job is still running.\n\nExample: {\"command\":\"mise run test\",\"wait_seconds\":2}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"command":{"type":"string","minLength":1,"description":"The shell command to run; /bin/bash -lc receives it as one argument"},"cwd":{"description":"Absolute working directory; defaults to the process directory","type":"string","minLength":1},"timeout_seconds":{"default":600,"description":"Kill the job after this many seconds; default 600","type":"integer","minimum":1,"maximum":3600},"wait_seconds":{"default":0,"description":"Wait up to this long for the job to exit before returning; default 0","type":"integer","minimum":0,"maximum":25}},"required":["command"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_bash_kill","description":"Stop a background job started by `bash` by killing its process group, so the shell's children die with it. The kill cannot be undone. Job ids are local to this process; an id from another server is `unknown`, not an error, and nothing is signaled. Use `bash_status` to read a job you are not stopping. Do not call this to poll.\n\nCall: { job_id }. job_id is the id `bash` returned. The answer status is `killed` or `unknown`.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"job_id":{"type":"string","minLength":1,"description":"The job id returned by bash"}},"required":["job_id"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_bash_status","description":"Report one background job started by `bash`, without waiting. Use it to poll; use `bash_kill` to stop the job. Do not call `wait` hoping it will see this job: if `wait` returns `nothing_to_wait_for`, poll here instead.\n\nCall: { job_id }. The answer carries status, exit code when the job has one, the last 8 KiB of output, the log path, and elapsed time. status is running, exited, killed, timed_out, or unknown. An id this process never started is `unknown`, not an error. Output is the tail, not the full log.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"job_id":{"type":"string","minLength":1,"description":"The job id returned by bash"}},"required":["job_id"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_classify_failure","description":"Classify a verification outcome that is not satisfied, and name the cheapest next action that is not a repeat of an attempt that added no information. Advice only: it never retries, never executes, and calls no model.\n\nCall: { outcome, history?, environment_fixed? }. outcome is { status, criteria: [{ criterion, status, reason? }] }. outcome.status and criterion status are satisfied, failed, verifier_failure, or indeterminate. satisfied throws `classify_failure: outcome is satisfied; there is no failure to classify`. An unknown status throws naming that status. history defaults to [] and is [{ signature, action }] of what you already tried. environment_fixed defaults to false.\n\nclass is implementation (a failed criterion), environment (verifier_failure), or evidence (indeterminate). next_action is the first unused rung of that class's ladder, or request_human when the ladder is spent. Ladders, cheapest first: implementation retry_with_failure_evidence, escalate, request_human; environment rerun_verification, repair_environment, request_human (environment_fixed drops the rerun); evidence strengthen_verification, request_human, or request_context first when a criterion is indeterminate for missing_evidence. Record { signature, action: next_action } as the next history entry. signature is the first 8 hex bytes of sha256 over the unsatisfied criterion:status:reason lines. Each skipped action is named in rationale.\n\nExample: {\"outcome\":{\"status\":\"failed\",\"criteria\":[{\"criterion\":\"tests\",\"status\":\"failed\"}]}}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"outcome":{"description":"The non-satisfied verification outcome to classify.","default":{},"type":"object","properties":{"status":{"default":"","description":"Overall verification status: failed, verifier_failure or indeterminate; satisfied or unknown values are an error.","type":"string"},"criteria":{"default":[],"description":"Per-criterion verdicts; they are hashed into the failure signature and checked for missing evidence.","type":"array","items":{"type":"object","properties":{"criterion":{"default":"","description":"Name of the verification criterion this verdict is about.","type":"string"},"status":{"default":"","description":"Verdict status of this criterion; \"indeterminate\" with reason \"missing_evidence\" means evidence is absent.","type":"string"},"reason":{"default":"","description":"Why the criterion has this status; \"missing_evidence\" on an indeterminate criterion routes to request_context.","type":"string"}}}}}},"history":{"default":[],"description":"Earlier attempts; an action already tried against the identical failure signature is skipped.","type":"array","items":{"type":"object","properties":{"signature":{"default":"","description":"Failure signature (from an earlier classification) the action was tried against.","type":"string"},"action":{"default":"","description":"The next_action that was already tried against that signature.","type":"string"}}}},"environment_fixed":{"default":false,"description":"True when an environment failure stays until repaired, so rerunning verification is never recommended.","type":"boolean"}}},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_classify_prompt_parts","description":"Score each verbatim part of a prompt for the model strength and the routing signals it needs. Use `identify_intent` when you also need type and intent; use `task_class` when you have one goal and need a work kind. This tool does not rewrite the prompt.\n\nCall: { text }. Blank text is refused. One language call splits the words into verbatim parts; if that split fails, the whole prompt is the one part and the cause is kept, it is not a thrown error. One decision then scores each part against the whole prompt as context only. The answer is the parts in order, each with a strength and routing signals, plus the weakest strength across them.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The prompt text to split into parts and classify by model strength and signals."}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_collect_failure_evidence","description":"Collect bounded source evidence for one TypeScript capability failure: schema fields, model calls, and return values. Read-only. It does not diagnose, edit, or run tests. Use `classify_failure` once you have an outcome and want the next action.\n\nCall: { error, maxTokens? }. error is the exact error text, including the failing capability name or source location. maxTokens defaults to 1000 and bounds how much source comes back. The repository root is the server's (EVIDENCE_REPOSITORY_ROOT or the working directory), not an input field. ast-grep must be on PATH; a missing binary throws `ast-grep is not installed or is missing from PATH`. Hits are typed output-field, output-contract, model-contract, model-call, or return-value, each found or not_found.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"error":{"type":"string","minLength":1,"maxLength":8000,"description":"Exact error text, including the failing capability name or source location."},"maxTokens":{"default":1000,"description":"Token budget (250-2500, default 1000) bounding how much source evidence comes back.","type":"integer","minimum":250,"maximum":2500}},"required":["error"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_compile_context","description":"Select a bounded context bundle from durable project state and candidate evidence. Deterministic: no model is called, and transcripts are never a source. Use `recall` to rank past asks against a task; use this when you already hold the state and the evidence and need a budgeted bundle.\n\nCall: { state?, work?, evidence?, budget? }. Every field is optional. A missing field is the run's validation error, not a schema error, when the value is present but blank. budget dimensions of 0 mean unlimited. Item kinds are project, intent, work_item, obligation, and evidence.\n\nThe answer is { project_id, rev, items, omitted, chars, estimated_tokens, basis, budget }. items carry provenance { source, ref }. omitted is what the budget dropped. basis is `estimate:runes/4;deterministic;no-transcript;no-model`. It does not fetch anything it was not given.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"state":{"description":"Durable project state, read by the caller from its store; its project_id must be non-empty.","type":"object","properties":{"project_id":{"description":"Project id; must be non-empty. Cited in provenance as `<project_id>@rev<rev>`.","type":"string"},"name":{"description":"Project name for the project item; the project_id is used when blank.","type":"string"},"intent":{"description":"Project intent; included as a required item when not blank.","type":"string"},"obligations":{"description":"Project obligations; live ones (open or blocked) are selected by the work item.","type":"array","items":{"type":"object","properties":{"id":{"description":"Obligation id; work.obligation_ids refers to obligations by this id.","type":"string"},"text":{"description":"Obligation text, copied into the bundle when the obligation is selected.","type":"string"},"kind":{"description":"Obligation kind; a live obligation of kind `constraint` is always included.","type":"string"},"status":{"description":"Obligation status; only `open` and `blocked` obligations are live and considered.","type":"string"},"origin":{"description":"Where the obligation came from.","type":"object","properties":{"kind":{"description":"What kind of source produced this entry.","type":"string"},"ref":{"description":"Reference identifying the source within its kind.","type":"string"}},"required":["kind"]},"evidence":{"description":"Evidence recorded for the obligation.","type":"string"},"blocked_on":{"description":"What the obligation is blocked on.","type":"string"},"supersedes":{"description":"Id of the obligation this one supersedes.","type":"string"},"superseded_by":{"description":"Id of the obligation that supersedes this one.","type":"string"},"goal_ids":{"description":"Ids of the goals this obligation serves.","type":"array","items":{"type":"string"}}},"required":["id","text","kind","status","origin"]}},"decisions":{"description":"Decisions recorded for the project.","type":"array","items":{"type":"object","properties":{"name":{"description":"Name of the decision.","type":"string"},"choice":{"description":"The choice made.","type":"string"},"origin":{"description":"Where the decision came from.","type":"object","properties":{"kind":{"description":"What kind of source produced this entry.","type":"string"},"ref":{"description":"Reference identifying the source within its kind.","type":"string"}},"required":["kind"]}},"required":["name","choice","origin"]}},"facts":{"description":"Facts recorded for the project.","type":"array","items":{"type":"object","properties":{"name":{"description":"Name of the fact.","type":"string"},"value":{"description":"Value of the fact.","type":"string"},"origin":{"description":"Where the fact came from.","type":"object","properties":{"kind":{"description":"What kind of source produced this entry.","type":"string"},"ref":{"description":"Reference identifying the source within its kind.","type":"string"}},"required":["kind"]}},"required":["name","value","origin"]}},"skills":{"description":"Names of skills recorded for the project.","type":"array","items":{"type":"string"}},"runs":{"description":"Ids of runs recorded for the project.","type":"array","items":{"type":"string"}},"rev":{"default":0,"description":"State revision, cited in provenance as `<project_id>@rev<rev>`; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},"required":["project_id","obligations"]},"work":{"description":"The work item the bundle is compiled for; its text must be non-empty.","type":"object","properties":{"id":{"description":"Work item id, used as the item id and provenance ref; `work` when empty.","type":"string"},"text":{"description":"Work item text; must be non-empty.","type":"string"},"obligation_ids":{"description":"Ids of the obligations the work needs, each of which must exist in state.obligations; empty means every live obligation.","type":"array","items":{"type":"string"}}},"required":["id","text","obligation_ids"]},"evidence":{"description":"Candidate evidence to rank and add while the budget holds; transcript and session_history sources are excluded.","type":"array","items":{"type":"object","properties":{"id":{"description":"Evidence id; `evidence[<index>]` is used when empty.","type":"string"},"source":{"description":"Where the evidence came from; required. Sources starting with `transcript` or `session_history` are excluded.","type":"string"},"ref":{"description":"Reference within the source; required. Duplicate source+ref pairs are dropped.","type":"string"},"text":{"description":"Evidence text; evidence with blank text is dropped.","type":"string"},"relevance":{"default":0,"description":"Ranking score, highest first; must not be negative; default 0.","type":"number"},"required":{"default":false,"description":"Whether the evidence must be included regardless of ranking; default false.","type":"boolean"}},"required":["id","source","ref","text"]}},"budget":{"description":"Size limits for the bundle; at least one dimension must be set and none may be negative.","type":"object","properties":{"max_items":{"default":0,"description":"Maximum number of items in the bundle; 0 means unlimited.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"max_chars":{"default":0,"description":"Maximum total characters (runes) of item text; 0 means unlimited.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"max_tokens":{"default":0,"description":"Maximum estimated tokens, estimated as ceil(chars / 4); 0 means unlimited.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}}}},"required":["state","work","evidence","budget"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_create_dag","description":"Turn work units into a validated semantic dependency graph. It does not schedule or run the work. One decision judges atomicity; the graph is not returned until that validation finishes.\n\nCall: { units?, text? }. units defaults to []. text defaults to \"\" and is the other way to name the work. An empty call is a graph of nothing, not an error. A failure while decomposing a unit throws `create_dag: write units for <statement>: <cause>` and names that parent. The answer is the graph after validation, not a partial decomposition.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"units":{"default":[],"description":"The work units to place in the graph. When empty, `text` is read as one unit. Default: empty.","type":"array","items":{"type":"object","properties":{"id":{"default":"","description":"The unit's id, which graph nodes and edges cite. Default: empty.","type":"string"},"statement":{"default":"","description":"The goal or obligation in words. Default: empty.","type":"string"},"obligations":{"default":[],"description":"What this unit must deliver; children of a split unit inherit these. Default: empty.","type":"array","items":{"type":"string"}},"constraints":{"default":[],"description":"Rules this unit must respect; children of a split unit inherit these. Default: empty.","type":"array","items":{"type":"string"}},"resources":{"default":[],"description":"Resources the unit uses (e.g. a file); units that share one cannot run together. Default: empty.","type":"array","items":{"type":"string"}},"tools":{"default":[],"description":"Tools the unit needs; children of a split unit inherit these. Default: empty.","type":"array","items":{"type":"string"}}},"description":"One goal or obligation to place in the graph."}},"text":{"default":"","description":"Used as a single work unit when `units` is empty; text that is itself a JSON request `{\"units\":[...]}` is read as one. Default: empty.","type":"string"}}},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_create_experiment","description":"Register a persisted experiment from a scenario prompt, or from a model-authored adversarial scenario. It freezes the fixture, proves the independent oracle fails the faulty code and passes the reference repair, versions a dataset, and registers repeated trials of the baseline and evidence-tool variants. It does not run those trials and it does not authorize promotion.\n\nCall: { name, prompt, family?, source?, trials? }. name is the comparison name and the dataset name. prompt is the scenario in words. family defaults to summarize-missing-focus; also search-locators and edit-formats. source is scenario (freeze the prompt against the known fixture; the default) or adversarial (a model authors the task text first). trials defaults to 3, the repeats registered per variant. Needs network for the adversarial authoring path.\n\nExample: {\"name\":\"summarize-focus\",\"prompt\":\"Summarize without dropping the focus questions\",\"trials\":3}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"name":{"type":"string","minLength":1,"description":"Comparison name; also the dataset name."},"prompt":{"type":"string","minLength":1,"description":"The scenario the experiment is about, in words."},"family":{"default":"summarize-missing-focus","description":"Which fixture family the experiment freezes. search-locators and edit-formats are supplied fixtures: adversarial authoring is refused for them.","type":"string","enum":["summarize-missing-focus","search-locators","edit-formats"]},"source":{"default":"scenario","description":"scenario: freeze the prompt against the known fixture. adversarial: a model authors the task text first.","type":"string","enum":["scenario","adversarial"]},"trials":{"default":3,"description":"Repeated trials registered per variant.","type":"integer","minimum":1,"maximum":5}},"required":["name","prompt"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_create_workflow","description":"Propose the leaf capabilities in conversations, files, and folders, then plan the code for each kept leaf in a repo. It composes `propose_capabilities` and `implement_code` and plans only: the CLI's `--apply` is what writes. It does not run the new code.\n\nCall: { sources, repo, namespace?, phase?, samples?, min_agreement?, registered?, implement?, max_leaves?, hints? }. sources is the conversations, files, and folders. repo is where the planned files would go. implement defaults to true; false stops after the proposal. max_leaves caps how many leaves are planned. A leaf the proposal did not actually propose is refused by name.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"sources":{"minItems":1,"type":"array","items":{"type":"object","properties":{"ref":{"type":"string","minLength":1,"description":"The argument as the caller wrote it: `claude:<id>`, a file path or a folder path."},"kind":{"type":"string","enum":["conversation","file","folder"],"description":"What the source is: a `conversation`, a `file` or a `folder`."},"body":{"type":"string","minLength":1,"description":"The bounded text of the source that the model reads."},"anchors":{"type":"array","items":{"type":"string"},"description":"The evidence the model may cite: paths for a file or folder, turn ids for a conversation."},"truncated":{"type":"boolean","description":"True when the host cut the source at its size limits, so the body is part of it."}},"required":["ref","kind","body","anchors","truncated"]},"description":"What to propose capabilities for, already read by the host: conversations, files or folders (at least one)."},"namespace":{"description":"One lower-case word such as \"webmaster\": every proposed capability name starts with it and a dot. Omit for no namespace.","anyOf":[{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},{"type":"null"}]},"phase":{"description":"1 lists the capabilities; 2 (the default) also writes pseudocode for each.","anyOf":[{"anyOf":[{"type":"number","const":1},{"type":"number","const":2}]},{"type":"null"}]},"samples":{"description":"How many times each source is proposed from (1-5, default 3); a leaf stays when enough samples propose it.","anyOf":[{"type":"integer","minimum":1,"maximum":5},{"type":"null"}]},"min_agreement":{"description":"The fewest samples that must propose a concept (under any names) for it to be kept (default 2); never more than `samples`.","anyOf":[{"type":"integer","minimum":1,"maximum":5},{"type":"null"}]},"registered":{"description":"Every registered capability name, filled by the CLI's completer; the names under `namespace` are shown to the proposal.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"repo":{"type":"string","minLength":1,"description":"The repo the code is built in; an absolute path once gathered."},"implement":{"default":true,"description":"Build the proposed leaves with implement_code (default true); false stops after the proposal, as `phase: 1` does.","type":"boolean"},"max_leaves":{"description":"Builds no more than this many leaves, in run order; the rest are proposed but left unbuilt. Absent: all of them.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"hints":{"description":"Optional hints about where the built code belongs and in what language.","type":"object","properties":{"near":{"description":"A repo-relative path or directory the new code belongs near.","type":"string"},"language":{"description":"The language of the new code, when the sibling files do not show it.","type":"string"}}}},"required":["sources","repo"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_define_objective","description":"Shape one goal into an atask-ready objective: a title, an outcome, acceptance lines, a proof that runs the specific work, and the smallest regression that covers what it touches. When no targeted proof can be grounded, the result is a draft, not a claimable task. It does not file the task; hand the result to `task` or to atask yourself.\n\nCall: { text, project?, changed_files?, context?, conversation?, contexts?, alongside? }. text is the goal. project narrows which project the proof should run in. changed_files and context are what the proof has to cover. A bad answer throws `fix the answer: <problems>`. Blank or ungrounded proof stays a draft rather than inventing a command.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The one goal to define, in words. Must not be blank."},"project":{"description":"Name or id of the atask project the goal belongs to. Without it `conversation` chooses one, and without either `context` alone grounds the checks in a checkout of unknown project.","type":"string"},"changed_files":{"description":"The files the work changes; they override the context's own `ChangedFiles`.","type":"array","items":{"type":"string"}},"context":{"description":"The checkout itself, which grounds the checks so the proof names a file or task that exists.","type":"object","properties":{"Home":{"type":"string","description":"The checkout's directory."},"Layout":{"type":"array","items":{"type":"string"},"description":"Paths relative to the project home; a directory has a trailing `/`."},"Unlisted":{"type":"array","items":{"type":"string"},"description":"Directories (\"\" is the home itself) whose children are not all in `Layout`: a path below one cannot be disproven."},"MiseTasks":{"type":"array","items":{"type":"string"},"description":"The `[tasks.*]` names of the checkout's mise.toml."},"OpenTasks":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"The atask task id."},"title":{"type":"string","description":"The task's title."}},"required":["id","title"],"description":"An unfinished atask task of the project."},"description":"The project's unfinished atask tasks, so a goal already stated is not filed twice."},"Runners":{"description":"The ways the checkout runs its tests; absent when the checkout was not read for them.","type":"array","items":{"type":"object","properties":{"Kind":{"type":"string","enum":["go","vitest","jest","npm","pytest","cargo","phpunit","make"],"description":"The kind of test runner."},"Dir":{"type":"string","description":"The directory below the home the command runs in; \"\" is the home itself."},"Command":{"type":"string","description":"The command that runs the tests named after it, e.g. \"go test\"."},"Detail":{"type":"string","description":"What else the config says: the Go module path, the make targets."}},"required":["Kind","Dir","Command","Detail"],"description":"A way the checkout runs its tests, read from its config files."}},"TestFiles":{"description":"The tracked test files, most relevant to the gathering words first, cut at a cap; absent when not read.","type":"array","items":{"type":"string"}},"TestFilesTruncated":{"description":"True when `TestFiles` was cut at the cap.","type":"boolean"},"TestNames":{"description":"The test names found in the most relevant test files, keyed by test file.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"type":"string"}}},"ChangedFiles":{"description":"The files the work changes.","type":"array","items":{"type":"string"}}},"required":["Home","Layout","Unlisted","MiseTasks","OpenTasks"]},"conversation":{"description":"The thread and the registry of live projects, as select_project reads them; chooses the project when `project` is absent.","type":"object","properties":{"WorkDir":{"default":"","description":"The directory the session ran in; empty when unknown. It may not match the work. Default: empty.","type":"string"},"Repo":{"default":"","description":"The main repository WorkDir is in, or was checked out from; empty when none. Default: empty.","type":"string"},"Worktree":{"default":"","description":"The git worktree WorkDir is in; empty when WorkDir is in the main checkout. Default: empty.","type":"string"},"Branch":{"default":"","description":"The git branch the session was on. Default: empty.","type":"string"},"Title":{"default":"","description":"The thread's title. Default: empty.","type":"string"},"FirstRequest":{"default":"","description":"The first request of the thread. Default: empty.","type":"string"},"Turns":{"minItems":1,"type":"array","items":{"type":"object","properties":{"Role":{"type":"string","description":"Who spoke this turn: the user or the agent."},"Text":{"type":"string","description":"What was said in this turn."}},"required":["Role","Text"],"description":"One user or agent turn of the thread."},"description":"The latest meaningful turns of the thread, oldest first. At least one is required."},"Current":{"description":"The project the thread is filed under; omit when it has none.","type":"object","properties":{"ID":{"default":"","description":"The caller's id for the project (the atask project id); echoed as `ProjectID` when the project is chosen. Default: empty.","type":"string"},"Name":{"type":"string","description":"The project's name; the answer names a project by this."},"Goal":{"default":"","description":"What the project is for, in the project's own words. Default: empty.","type":"string"},"Summary":{"default":"","description":"A stored summary of the project; preferred over `Goal` when describing what the project is for. Default: empty.","type":"string"},"Home":{"default":"","description":"The directory the project's sessions ran in; empty when none is known. Default: empty.","type":"string"},"Contents":{"default":{"Entries":[],"Readme":""},"description":"What is on disk at the project's home: top-level names and the README opening.","type":"object","properties":{"Entries":{"default":[],"description":"Top-level names at the project's home; directories end in \"/\". Default: empty.","type":"array","items":{"type":"string"}},"Readme":{"default":"","description":"The opening of the project's README. Default: empty.","type":"string"}}}},"required":["Name"]},"Projects":{"default":[],"description":"The live projects worth choosing from, and the current one. Default: empty.","type":"array","items":{"type":"object","properties":{"ID":{"default":"","description":"The caller's id for the project (the atask project id); echoed as `ProjectID` when the project is chosen. Default: empty.","type":"string"},"Name":{"type":"string","description":"The project's name; the answer names a project by this."},"Goal":{"default":"","description":"What the project is for, in the project's own words. Default: empty.","type":"string"},"Summary":{"default":"","description":"A stored summary of the project; preferred over `Goal` when describing what the project is for. Default: empty.","type":"string"},"Home":{"default":"","description":"The directory the project's sessions ran in; empty when none is known. Default: empty.","type":"string"},"Contents":{"default":{"Entries":[],"Readme":""},"description":"What is on disk at the project's home: top-level names and the README opening.","type":"object","properties":{"Entries":{"default":[],"description":"Top-level names at the project's home; directories end in \"/\". Default: empty.","type":"array","items":{"type":"string"}},"Readme":{"default":"","description":"The opening of the project's README. Default: empty.","type":"string"}}}},"required":["Name"],"description":"A live project the thread could belong to."}},"ProjectBudget":{"description":"The most bytes of the project list the thread shows; 16384 when absent.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991}},"required":["Turns"]},"contexts":{"description":"The checkout of each registered project, keyed by atask project id; the chosen project's is taken.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"Home":{"type":"string","description":"The checkout's directory."},"Layout":{"type":"array","items":{"type":"string"},"description":"Paths relative to the project home; a directory has a trailing `/`."},"Unlisted":{"type":"array","items":{"type":"string"},"description":"Directories (\"\" is the home itself) whose children are not all in `Layout`: a path below one cannot be disproven."},"MiseTasks":{"type":"array","items":{"type":"string"},"description":"The `[tasks.*]` names of the checkout's mise.toml."},"OpenTasks":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"The atask task id."},"title":{"type":"string","description":"The task's title."}},"required":["id","title"],"description":"An unfinished atask task of the project."},"description":"The project's unfinished atask tasks, so a goal already stated is not filed twice."},"Runners":{"description":"The ways the checkout runs its tests; absent when the checkout was not read for them.","type":"array","items":{"type":"object","properties":{"Kind":{"type":"string","enum":["go","vitest","jest","npm","pytest","cargo","phpunit","make"],"description":"The kind of test runner."},"Dir":{"type":"string","description":"The directory below the home the command runs in; \"\" is the home itself."},"Command":{"type":"string","description":"The command that runs the tests named after it, e.g. \"go test\"."},"Detail":{"type":"string","description":"What else the config says: the Go module path, the make targets."}},"required":["Kind","Dir","Command","Detail"],"description":"A way the checkout runs its tests, read from its config files."}},"TestFiles":{"description":"The tracked test files, most relevant to the gathering words first, cut at a cap; absent when not read.","type":"array","items":{"type":"string"}},"TestFilesTruncated":{"description":"True when `TestFiles` was cut at the cap.","type":"boolean"},"TestNames":{"description":"The test names found in the most relevant test files, keyed by test file.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"type":"string"}}},"ChangedFiles":{"description":"The files the work changes.","type":"array","items":{"type":"string"}}},"required":["Home","Layout","Unlisted","MiseTasks","OpenTasks"],"description":"What the machine knows of one project's checkout, so a proof can name a file or task that exists."}},"alongside":{"description":"The other goals of the plan this one is part of, which this objective must not absorb.","type":"array","items":{"type":"string"}}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_derive_workflow","description":"Read a harness transcript or a script/SKILL.md and return the repeatable process in it as a workflow. Steps are command, judgment, approval, or edit, each with the evidence it came from, rendered to SKILL.md. It never runs a step.\n\nCall: { source, name?, from_turn?, to_turn?, transcript?, document? }. source is the conversation or file. Do not pass transcript or document yourself; the host reads them. A call that arrives with nothing read throws `derive_workflow: nothing was read for <source>`. No commands, edits, or numbered steps throws naming how many lines were seen and how many were dropped as reads. More candidates than it reads at once throws and tells you to bound it with from_turn and to_turn. Every candidate judged incidental throws naming the count. name must be lower-case words joined by hyphens, such as `new-site`. description must be one or two sentences within the character cap. usage must say how the workflow is started. An unsound workflow throws `the derived workflow is not sound: <problems>`.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"source":{"type":"string","minLength":1,"description":"`<harness>:<id>` of a conversation, or the path of a script, SKILL.md or runbook."},"name":{"description":"The skill directory name for the workflow: lower-case words joined by hyphens, such as \"new-site\".","anyOf":[{"type":"string","pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},{"type":"null"}]},"from_turn":{"description":"The first turn (a transcript) or line (a document) to read, counting from 1; included.","anyOf":[{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},{"type":"null"}]},"to_turn":{"description":"The last turn (a transcript) or line (a document) to read, counting from 1; included.","anyOf":[{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},{"type":"null"}]},"transcript":{"description":"The transcript the CLI's input gatherer read for a conversation ref, tool calls kept; `run` itself touches no filesystem.","type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Where the transcript file the host read is."},"conversation":{"description":"`<harness>:<full id>` of the session that was read, set when the ref named it by a prefix, `latest` or its title.","type":"string","minLength":1},"metadata":{"description":"What the harness recorded about where the session ran; absent when it records nothing of the kind.","type":"object","properties":{"cwd":{"description":"The directory the session ran in; the last one recorded when it changed.","type":"string","minLength":1},"git_branch":{"description":"The git branch the session was on; the last one recorded.","type":"string","minLength":1}}},"turns":{"type":"array","items":{"type":"object","properties":{"role":{"type":"string","enum":["user","agent","reasoning","tool","context","unknown"],"description":"Who or what the turn is from; only `user` and `agent` turns are part of a conversation."},"text":{"type":"string","description":"The turn's text."},"tool_call":{"description":"Set on a `tool` turn that is the agent calling a tool. Only read when the host kept tool calls.","type":"object","properties":{"id":{"type":"string","description":"The harness's own id for the call."},"name":{"type":"string","description":"The name of the tool called."},"input":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"The arguments the tool was called with, by name."}},"required":["id","name","input"]},"tool_result":{"description":"Set on a `tool` turn that is a tool call's result, joined to its call by `id`.","type":"object","properties":{"id":{"type":"string","description":"The id of the tool call this result answers."},"output":{"type":"string","description":"The tool's output, cut to its first 2000 characters."},"is_error":{"type":"boolean","description":"True when the harness marked the tool call as failed."},"signals":{"description":"What a test run or failure looks like in the whole output; set only when `output` was cut.","type":"object","properties":{"go_fail_line":{"type":"boolean","description":"A line of the whole output starts `--- FAIL:` (Go)."},"go_ok_line":{"type":"boolean","description":"A line of the whole output looks like `ok  pkg  0.512s` (Go)."},"failed_in_test_output":{"type":"boolean","description":"The word FAILED appears in an output that also mentions a test, spec or suite."},"passed_word":{"type":"boolean","description":"The word PASS or PASSED appears."},"error_marker":{"type":"boolean","description":"`error:`, `Error:`, `ERROR:`, `panic:` or `fatal:` appears."}},"required":["go_fail_line","go_ok_line","failed_in_test_output","passed_word","error_marker"]}},"required":["id","output","is_error"]},"synthetic_reason":{"description":"Set when the harness wrote this user turn itself (Grok `synthetic_reason`); such a turn is never a human ask.","type":"string"},"timestamp":{"description":"When the harness recorded this turn, ISO-8601 UTC to the second (`2026-10-19T09:13:18Z`); absent when the harness records no time for it. A Mastra trace span keeps milliseconds.","type":"string"},"message_id":{"description":"Which model message an agent turn belongs to, set when the harness records messages whole; agent turns with different ids are different messages.","type":"string"},"session":{"description":"Which session the turn belongs to, when one transcript interleaves several (a project's combined transcript).","type":"string"}},"required":["role","text"]},"description":"The normalized turns of the transcript, oldest first."},"skipped_lines":{"default":0,"description":"How many lines of the file were not valid JSON and were left out (default 0).","type":"integer","minimum":0,"maximum":9007199254740991}},"required":["path","turns"]},"document":{"description":"The document the CLI's input gatherer read for a file path.","type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Where the document is."},"text":{"type":"string","description":"The document's text."}},"required":["path","text"]}},"required":["source"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_describe_project","description":"Write a project description with a read-only generative model. Nothing is stored and no file is written. It does not edit the repo.\n\nCall: { text, projects? }. text is the material to describe; projects is optional extra project records. A blank description throws `Description is blank: write the description`. A failed write throws `write the description: <cause>`. Do not describe more than the material supports. The answer is the description text, not a path.\n\nExample: {\"text\":\"A capability runtime with a CLI and an MCP surface.\"}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The material to describe; if it names a live known project (by id or name), that project's name and goal are described instead."},"projects":{"description":"Optional known project records used to resolve a project named by text.","type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Project id; the material may name the project by id."},"name":{"type":"string","description":"Project name; the material may name the project by name."},"goal":{"description":"The project's goal, read as its description material when the project is named.","type":"string"},"merged_into":{"description":"Id of the project this one was merged into; a non-empty value marks it as not live and it is ignored.","type":"string"}},"required":["id","name"]}}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_edit","description":"Apply anchored edits to one existing file; create new files with `write`. Anchor to the `[path#TAG]` snapshot from the latest `read` or `grep`: `tag` is its 4-hex TAG. A stale tag refuses the edit and writes nothing, so re-read and retry. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it.\n\nOps (1-based line numbers address the tagged snapshot, never earlier ops in the same call):\n- replace {start,end,text}: replace lines start..end inclusive with text.\n- delete {start,end}: remove lines start..end inclusive.\n- insert_before / insert_after {line,text}: add text around a line.\n\nRules:\n- `text` is final file content, not a diff. A trailing newline terminates the last line; it is not an extra blank line. Keep indentation verbatim.\n- Touch only lines the read displayed. Use the tightest range; split non-adjacent changes into separate ops instead of spanning lines you keep.\n- Never restyle unrelated code.\n- Success returns a fresh tag, a diff and a numbered preview. Use the fresh tag for the next edit of that file, never the old one.\n- require_syntax_ok refuses a result that fails to parse (JS/TS only).\n\nExample: after a read gave [a.ts#1A2B], {path:\"/repo/a.ts\",tag:\"1A2B\",ops:[{op:\"replace\",start:3,end:3,text:\"  return 2;\"}]}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Absolute path of the existing file to edit; a relative path is refused."},"tag":{"type":"string","pattern":"^[0-9A-F]{4}$","description":"The 4-hex TAG of the `[path#TAG]` snapshot from the latest `read` or `grep` of this file. A stale tag refuses the edit and writes nothing."},"ops":{"minItems":1,"maxItems":200,"type":"array","items":{"oneOf":[{"type":"object","properties":{"op":{"type":"string","const":"replace","description":"Replace lines `start`..`end` with `text`."},"start":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"First line of the range, 1-based, in the tagged read snapshot."},"end":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"Last line of the range, 1-based, inclusive, in the tagged read snapshot; at least `start`."},"text":{"type":"string","description":"Final replacement content, not a diff. A trailing newline terminates the last line; it is not an extra blank line."}},"required":["op","start","end","text"]},{"type":"object","properties":{"op":{"type":"string","const":"delete","description":"Remove lines `start`..`end`."},"start":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"First line of the range, 1-based, in the tagged read snapshot."},"end":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"Last line of the range, 1-based, inclusive, in the tagged read snapshot; at least `start`."}},"required":["op","start","end"]},{"type":"object","properties":{"op":{"type":"string","const":"insert_before","description":"Insert `text` before line `line`."},"line":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"1-based line in the tagged read snapshot to insert next to."},"text":{"type":"string","description":"Content to insert, as final file content; a trailing newline terminates its last line."}},"required":["op","line","text"]},{"type":"object","properties":{"op":{"type":"string","const":"insert_after","description":"Insert `text` after line `line`."},"line":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"1-based line in the tagged read snapshot to insert next to."},"text":{"type":"string","description":"Content to insert, as final file content; a trailing newline terminates its last line."}},"required":["op","line","text"]}]},"description":"1 to 200 edit ops. Line numbers address the tagged snapshot, never earlier ops in the same call."},"require_syntax_ok":{"default":false,"description":"When true, refuse and write nothing if the resulting content fails to parse (checked for JS/TS only). Default false.","type":"boolean"}},"required":["path","tag","ops"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_edit_patch","description":"Apply one `*** Begin Patch` document to the files it names. Use `edit` for anchored line ops on one file, `edit_replace` for an exact string, and `write` to create a file.\n\nCall: { patch }. Every `*** Update File:` path must be absolute. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. Update File sections hold @@-anchored hunks of context, `-` old lines, and `+` new lines. Each hunk anchors at its first context or `-` row. A hunk whose context is missing or matches more than one place is refused with that anchor's patch line number, and nothing is written: every refusal happens before any write. A patch that produces no change is refused (`patch refused for <path>: it produces no change`). Hunks apply bottom-up so earlier anchors stay true. The answer is per-file fresh tags, hunk results, and a compact diff.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"patch":{"type":"string","minLength":1,"description":"A `*** Begin Patch` … `*** End Patch` document with `*** Update File: <absolute path>` sections. Each section holds @@-anchored hunks of context rows, `-` old rows and `+` new rows; a hunk whose context is missing or matches more than one place is refused and nothing is written."}},"required":["patch"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_edit_replace","description":"Replace an exact string in one file and return a fresh `[path#TAG]` tag. Use `edit` when you have line numbers from a read, `edit_patch` for a multi-file patch, and `write` to create a file.\n\nCall: { path, old_string, new_string, replace_all? }. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. Read the file first and copy old_string from it, including indentation. old_string must appear exactly once unless replace_all is true. Not found throws `old_string not found in <path>` and includes the nearest numbered lines; nothing is written. More than one match without replace_all throws `old_string appears N times` and tells you to pass replace_all or add surrounding text. new_string equal to old_string throws `edit_replace made no change`. The answer is { path, tag, replacements, diff }.\n\nExample: {\"path\":\"/repo/src/x.ts\",\"old_string\":\"return 1;\",\"new_string\":\"return 2;\"}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Absolute path of the existing file to edit; a relative path is refused."},"old_string":{"type":"string","minLength":1,"description":"Exact text to find, copied from the file including indentation. Must appear exactly once unless `replace_all` is true; empty is refused."},"new_string":{"type":"string","description":"Replacement text. Equal to `old_string` is refused as a no-op."},"replace_all":{"default":false,"description":"Replace every occurrence instead of refusing a multi-match. Default false.","type":"boolean"}},"required":["path","old_string","new_string"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_execute_ticket","description":"Execute one ticket end to end: resolve it (filing an atask objective and annotating the Linear ticket when it has none), implement it in its own worktree, run code review and security review beside the repo's test gate in rounds, fix what the reviews found until a round is clean, then open a pull request and run improve-pr on it. Use it for a Linear ticket or an atask objective that needs implementing, reviewing, and landing. Call: { ataskId?, linearTicket?, maxRounds? = 3, repoRoot? }. One of ataskId or linearTicket is required. A ZYS- ticket is read from personal Linear and an SAH- ticket from work Linear; any other prefix is refused. repoRoot is the repo the worktree opens in; default the checkout this run is called from. The repo's gate is `mise run test` unless EXECUTE_TICKET_TEST_COMMAND overrides it. The answer is { ataskIds, worktree, rounds, prUrl?, suggestions, status: landed|exhausted, blockers }. A run that closes nothing in maxRounds lands nothing and reports the blockers still standing.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"ataskId":{"description":"The atask objective id (at-XXXXXX), when the ticket already has one; one of ataskId or linearTicket is required","type":"string","minLength":1},"linearTicket":{"description":"The Linear issue identifier, like ENG-123; its sub-issues are filed and implemented with it","type":"string","minLength":1},"maxRounds":{"default":3,"description":"Review rounds (code review, security review, test gate, then fixes) before the run reports exhausted; default 3","type":"integer","exclusiveMinimum":0,"maximum":10},"repoRoot":{"description":"The repository the ticket's worktree opens in; default the checkout this run is called from","type":"string","minLength":1}}},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_find","description":"Semantic grep: describe the behavior you are looking for and get the files and line ranges that implement it, ranked by a decision model. Read-only. Use it when you do not know the symbol; use `grep` for a known literal and `glob` for a path shape.\n\nCall: { query, keywords?, limit? }. keywords defaults to []. limit defaults to 10. Do not pass candidates, filesScanned, fileCap, or truncated; the host scan fills those before the run. A call that arrives without that scan throws `find needs the repository scan`. A file must score at least 0.35 before its passages are judged; a passage at or above 0.2 is returned. hits[].score is the probability the passage implements the query. hits[].path is absolute, so it goes straight to `read` and `edit`; the rule for those follow-up calls: Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. The host scan lists up to 20000 files (fileCap): a match in file 801 of a big tree is found. coverage `partial` means the host stopped at that cap, so status `not_found` is not proof of absence.\n\nExample: {\"query\":\"where a session id is resolved for a harness\",\"limit\":5}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"query":{"type":"string","minLength":1,"description":"Plain-language description of the behavior to locate, e.g. where a session id is resolved."},"keywords":{"default":[],"description":"Identifiers to weight in the lexical scan; derived from the query when empty (the default).","type":"array","items":{"type":"string"}},"limit":{"default":10,"description":"Most hits to return, best score first. Default 10, capped at 50.","type":"integer","minimum":1,"maximum":50},"candidates":{"description":"Filled by the host repository scan before the run; do not pass. Lexical candidate files with their passages.","type":"array","items":{"type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Absolute path of the candidate file."},"score":{"type":"number","minimum":0,"description":"Lexical scan score of the file; not the decision-model probability."},"passages":{"maxItems":3,"type":"array","items":{"type":"object","properties":{"start":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"First line of the window, 1-based."},"end":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"Last line of the window, 1-based."},"sketch":{"type":"string","description":"The window's lines most likely to answer the query."}},"required":["start","end","sketch"]},"description":"Up to 3 windows of the file worth judging."}},"required":["path","score","passages"]}},"filesScanned":{"description":"Filled by the host scan; do not pass. Number of files the scan listed.","type":"integer","minimum":0,"maximum":9007199254740991},"fileCap":{"description":"Filled by the host scan; do not pass. The most files the scan lists.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"truncated":{"description":"Filled by the host scan; do not pass. True when the scan stopped at its file cap.","type":"boolean"}},"required":["query"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_find_skills","description":"Find installed skills by need. Scores every skill's frontmatter description against the need by case-insensitive keyword overlap. No model is called. Use `list_skills` to page the library and `read_skill` to open one. Use `suggest_skills_tools_and_mcp` when the prompt should be matched to a skill, a tool, or an MCP tool together.\n\nCall: { need, limit? }. limit defaults to 5. The root is $SKILLS_ROOT, else ~/.agents/skills. The answer is the best matches with name, description, and path. An empty list means nothing installed overlapped, not that the search failed.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"need":{"type":"string","minLength":1,"description":"What the caller needs, matched by case-insensitive keyword overlap against each skill's frontmatter description."},"limit":{"default":5,"description":"Maximum matches returned. Defaults to 5, at most 10.","type":"integer","minimum":1,"maximum":10}},"required":["need"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_fix_red_ci","description":"One attempt to make a pull request's remaining red check green. Returns what changed and whether the check passed. It does not retry, and it does not merge.\n\nCall: { url, check: { check, red, thisRepo, log } }. url is the pull request. check.check is the check name. check.log is the failure log. check.red and check.thisRepo record that the check is red and belongs to this repo; pass a check that is both. Needs network. The answer says what changed and whether that one check went green.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"url":{"type":"string","description":"URL of the pull request whose check is red."},"check":{"type":"object","properties":{"check":{"type":"string","description":"Name of the failed CI check."},"red":{"type":"boolean","description":"Whether the check is currently red."},"thisRepo":{"type":"boolean","description":"Whether the failure is in this repository rather than elsewhere."},"log":{"type":"string","description":"The failed check's log, as the caller already read it."}},"required":["check","red","thisRepo","log"],"description":"The failed check the caller already read."}},"required":["url","check"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_glob","description":"Find files by path shape and return each path with its size in bytes and modified_ms. Use `grep` to search contents and `find` to search by behavior. Read-only.\n\nCall: { pattern, path?, limit? }. The pattern matches each file's path relative to path (default: the server's working directory; the answer names the directory it listed as root): `**/*.ts` is the whole tree, `src/*.ts` is one level. `*` stays inside one segment, `**` crosses segments, `?` is one character, `{a,b}` is an alternative, `[abc]` is a class (`[!abc]` negates). limit defaults to 500 and caps at 2000. truncated is true when more paths matched than limit, or when the listing stopped at its 20000-matching-file cap (file_cap). The answer also carries files_matched (matches before limit) and file_cap; files_total says how many matched when the cap cut the listing and that is known, so narrow `path` or `pattern` then. Inside a repository the listing is `git ls-files`, so .gitignore decides what exists; outside one it is a bounded walk. Both skip node_modules, .git, dist, build, other dependency output, binary extensions, and symlinks. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. Every returned path is absolute.\n\nExample: {\"pattern\":\"src/**/*.ts\",\"path\":\"/repo\",\"limit\":20}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"pattern":{"type":"string","minLength":1,"description":"Glob matched against each file's path relative to `path`: `*` stays inside one segment, `**` crosses segments, `?` is one character, `{a,b}` is an alternative, `[abc]` is a class (`[!abc]` negates). `**/*.ts` is the whole tree, `src/*.ts` is one level."},"path":{"description":"Absolute directory to search; a relative path is refused. Default: the server's working directory, named in the answer's `root`.","type":"string","minLength":1},"limit":{"default":500,"description":"Most paths to return. Default 500, capped at 2000; `truncated` is true when more matched.","type":"integer","minimum":1,"maximum":2000}},"required":["pattern"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_grep","description":"Search file contents for text or a regex; each match is a `LINE:TEXT` block under its file's `[path#TAG]`, so `edit` can follow without a read. Case-sensitive. Use `glob` to find files by name and `find` when you do not know the symbol. There is no glob filter on this tool: narrow with `paths`.\n\nCall: { pattern, paths?, regex?, context?, limit? }. paths is files or directories; omitted, it is the server's working directory, which roots then names. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. regex omitted = auto: a pattern with regex metacharacters (`| ^ $ ( ) [ ] { } * + ? \\\\`) matches as both regex and literal; a plain pattern matches literally. regex true forces a regex; regex false forces a literal, so `foo.ts` matches the dot. context is lines on each side of a match, default 0, capped at 5. limit is matching lines, default 100, capped at 500; truncated is true when more existed or the file listing hit its own cap. A search lists up to 20000 files (file_cap): a match in file 801 of a big tree is found. When the listing stops at that cap, truncated is true, files_scanned and file_cap say how far it got, and files_total says how many files existed when known; narrow `paths` then. regex true with an invalid pattern throws `invalid regex for grep: <cause>`; in auto mode an invalid regex falls back to a literal, so a plain string is never an error. Skips node_modules, .git, build output, binaries, and files over the size cap; those are not counted in files_scanned. The answer is { status, pattern, matches, truncated, files_scanned, file_cap, files_total?, roots }. status is found or not_found. roots is the absolute directories searched, and every match path is absolute, ready for `edit`.\n\nExample: {\"pattern\":\"defineCapability\",\"paths\":[\"/repo/src/capability\"]}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"pattern":{"type":"string","minLength":1,"description":"Text to search for, case-sensitive. Literal unless `regex` is true or (when `regex` is omitted) it contains regex metacharacters."},"paths":{"description":"Absolute files or directories to search; a relative entry is refused. There is no glob filter: narrow with this. Default: the server's working directory, named in the answer's `roots`.","minItems":1,"type":"array","items":{"type":"string","minLength":1}},"regex":{"description":"true compiles `pattern` as a JavaScript regex (invalid pattern is an error); false forces a literal match. Omitted = auto: a pattern with regex metacharacters matches as both regex and literal, a plain pattern literally.","type":"boolean"},"context":{"default":0,"description":"Lines shown on each side of a match. Default 0, capped at 5.","type":"integer","minimum":0,"maximum":5},"limit":{"default":100,"description":"Most matching lines to return. Default 100, capped at 500; `truncated` is true when more existed.","type":"integer","minimum":1,"maximum":500}},"required":["pattern"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_host.bottlenecks","description":"Report the heaviest CPU and memory process families on this Mac, each with what started it, a verdict, and a remedy. Registered as `host.bottlenecks`. Rules settle what they can; one model call judges the rest. It does not kill anything.\n\nCall: { top?, window_s?, include_normal? }. top defaults to 10. window_s defaults to 5. include_normal defaults to false, which drops verdict `normal`. Do not pass snapshot; the host fills it. A call that arrives without a snapshot throws `host.bottlenecks needs a snapshot of the machine`. Verdicts are normal, overscoped, runaway, and contention. A verdict whose root_pid is not one of the listed families throws naming that pid. A remedy outside the closed list throws naming the allowed remedies.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"top":{"default":10,"description":"How many of the heaviest families to examine by CPU and by memory each; default 10","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"window_s":{"default":5,"description":"Seconds between the two process samples that give CPU over an interval; default 5","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"include_normal":{"default":false,"description":"Include families judged normal in the families list; default false drops them from it","type":"boolean"},"snapshot":{"description":"Machine snapshot filled in by the host's gatherer; do not pass it. A call without one throws","type":"object","properties":{"taken_at":{"type":"string","description":"When the snapshot was taken, as a timestamp string"},"ncpu":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991,"description":"Number of CPUs; load average over this gives the load ratio"},"uptime_s":{"description":"Seconds since boot, when known","type":"integer","minimum":0,"maximum":9007199254740991},"load":{"type":"object","properties":{"avg1":{"type":"number","description":"1-minute load average"},"avg5":{"type":"number","description":"5-minute load average"},"avg15":{"type":"number","description":"15-minute load average"}},"required":["avg1","avg5","avg15"],"description":"System load averages"},"memory_pressure":{"type":"string","description":"The machine's memory pressure reading as reported, passed through to the answer"},"processes":{"type":"array","items":{"type":"object","properties":{"pid":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Process id"},"ppid":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Parent process id; used to group processes into families"},"user":{"type":"string","description":"Owning user of the process"},"cpu_pct":{"type":"number","description":"CPU percent over the sample window (a lifetime average when only one sample exists)"},"rss_mb":{"type":"number","description":"Resident memory in megabytes"},"age_s":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Seconds since the process started"},"command":{"type":"string","description":"The process's full command line as `ps` reported it"}},"required":["pid","ppid","user","cpu_pct","rss_mb","age_s","command"]},"description":"Every process sampled, with CPU measured over the sample window"},"cwd":{"default":{},"description":"Working directory keyed by pid, for the processes the gatherer looked at; default empty","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"repo":{"default":{},"description":"Git top-level directory keyed by cwd, when the cwd is inside a repository; default empty","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"hook_config":{"default":{},"description":"The hook configuration file (hk.pkl, lefthook.yml, .hk.yaml) keyed by repository, when one exists; default empty","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}}},"required":["taken_at","ncpu","load","memory_pressure","processes"]}}},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_identify_goals","description":"Read the user's words and return each part's role and the goals it states or implies, each goal cited to the segments it came from. Runs `identify_intent` first, then one decision per part. It does not rewrite the words and it does not file tasks; hand goals to `plan_tasks` or `define_objective` for that.\n\nCall: { text }. Blank text is refused. A bad answer throws `fix the answer: <problems>`. A failed intent pass throws `identify intent: <cause>`; a failed goal pass throws `identify the goals: <cause>` or `item <index>: <cause>`.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The user's words; each part is assessed for the goals it states or implies."}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_identify_intent","description":"Cut the user's words into verbatim parts and assess each part: type, intent, model strength, and routing signals. Use `identify_goals` when you need the goals those parts state. Use `classify_prompt_parts` when you only need strength and routing. This tool does not rewrite the words.\n\nCall: { text }. Blank text is refused (`the user's words are required` / no prompt). One language call splits the words and is retried with the reason until the parts locate; a failed split throws `split the words: <cause>`. Each part is then assessed with the whole prompt as context only. A bad part throws `item <position>: <cause>`. The answer is the words with every part assessed, in order.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The user's words, cut into verbatim parts and assessed for type, intent and routing signals."}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_implement_code","description":"Take a design (a contract or pseudocode) and a repo, propose file locations from that repo's own conventions, and return the implementation as file changes. It does not write: the CLI's `--apply` writes what this plans. Registry edits are insertions only.\n\nCall: { design, repo, hints?, conventions? }. design is the contract or pseudocode. repo is the checkout. Do not pass conventions yourself; the host reads them. A call without them throws `implement_code: the input has no conventions`. A registry edit that changes an existing line throws `the edit changed an existing line: insert lines only`. A review that names a file outside this change throws naming the files that are in it. The answer is the planned files, the registry touchpoints, and the self-review.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"design":{"anyOf":[{"type":"string"},{"type":"object","properties":{"name":{"type":"string","minLength":1,"description":"The name of the leaf being designed."},"purpose":{"type":"string","minLength":1,"description":"What the leaf is for."},"input_summary":{"type":"string","description":"A summary of the leaf's input."},"output_summary":{"type":"string","description":"A summary of the leaf's output."},"pseudocode":{"type":"string","minLength":1,"description":"The steps of the leaf as pseudocode."},"replaces":{"description":"Names the design replaces; where they are still used becomes `callers_to_update`.","type":"array","items":{"type":"string"}}},"required":["name","purpose","input_summary","output_summary","pseudocode"]}],"description":"What to build: free-text design words, or an object with name, purpose, input/output summaries and pseudocode."},"repo":{"type":"string","minLength":1,"description":"The repo to build the code in; an absolute path once gathered."},"hints":{"description":"Optional hints about where the new code belongs and in what language.","type":"object","properties":{"near":{"description":"A repo-relative path or directory the new code belongs near.","type":"string"},"language":{"description":"The language of the new code, when the sibling files do not show it.","type":"string"}}},"conventions":{"description":"The repo's conventions as read by the CLI's gatherer; without them the run is refused.","type":"object","properties":{"language":{"type":"string","description":"The repo's main language, such as `typescript`, `go` or `python`; `unknown` when not detected."},"layout":{"type":"object","properties":{"top_level":{"type":"array","items":{"type":"string"},"description":"Top-level entries of the repo; a directory ends with `/`."},"home":{"type":"string","description":"The directory the design most likely belongs in (repo-relative), or empty when none stood out."},"home_entries":{"type":"array","items":{"type":"string"},"description":"The entries of the home directory."},"near":{"type":"array","items":{"type":"object","properties":{"directory":{"type":"string","description":"Repo-relative directory that fits the design."},"entries":{"type":"array","items":{"type":"string"},"description":"The entries of that directory."}},"required":["directory","entries"]},"description":"Other directories that fit the design, best first."},"known_files":{"type":"array","items":{"type":"string"},"description":"Every file of the repo (repo-relative), for deciding whether a path exists and an import resolves."},"truncated":{"type":"boolean","description":"True when `known_files` was cut at the limit."}},"required":["top_level","home","home_entries","near","known_files","truncated"],"description":"The repo's file layout and the directories the design most likely belongs in."},"siblings":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string","description":"The sibling's name: a directory of files or one file."},"files":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string","description":"Path relative to the repo."},"text":{"type":"string","description":"The file's text, cut when it was too long to keep whole."},"truncated":{"type":"boolean","description":"True when `text` was cut and is only part of the file."},"sha256":{"description":"sha256 of the whole file; set when `text` is the file itself, so an edit can be refused if the file moved on.","type":"string"}},"required":["path","text","truncated"]},"description":"The sibling's source files."},"tests":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string","description":"Path relative to the repo."},"text":{"type":"string","description":"The file's text, cut when it was too long to keep whole."},"truncated":{"type":"boolean","description":"True when `text` was cut and is only part of the file."},"sha256":{"description":"sha256 of the whole file; set when `text` is the file itself, so an edit can be refused if the file moved on.","type":"string"}},"required":["path","text","truncated"]},"description":"The tests that cover the sibling."},"support":{"default":[],"description":"Files from the test tree that the tests import (fakes, fixtures, harnesses), so a new test can use them as they do.","type":"array","items":{"type":"object","properties":{"path":{"type":"string","description":"Path relative to the repo."},"text":{"type":"string","description":"The file's text, cut when it was too long to keep whole."},"truncated":{"type":"boolean","description":"True when `text` was cut and is only part of the file."},"sha256":{"description":"sha256 of the whole file; set when `text` is the file itself, so an edit can be refused if the file moved on.","type":"string"}},"required":["path","text","truncated"]}}},"required":["name","files","tests"]},"description":"The closest existing code to the design (files and their tests), shown to the model as examples to follow."},"registries":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string","description":"Path relative to the repo."},"text":{"type":"string","description":"The file's text, cut when it was too long to keep whole."},"truncated":{"type":"boolean","description":"True when `text` was cut and is only part of the file."},"sha256":{"type":"string","description":"sha256 of the whole registry file, so an edit can be refused if the file moved on."}},"required":["path","text","truncated","sha256"]},"description":"Files that list modules by name (barrels, manifests, `Register...` init files) that a new module may need to be added to."},"style":{"type":"object","properties":{"test_layout":{"type":"string","enum":["separate_tree","beside_code","unknown"],"description":"Where the repo keeps tests: `separate_tree` (a test root), `beside_code`, or `unknown`."},"test_root":{"type":"string","description":"Where separate-tree tests live, such as `mastra/test`; empty otherwise."},"naming":{"type":"string","enum":["snake_case","kebab-case","camelCase","PascalCase","unknown"],"description":"The file naming style of the repo, or `unknown`."},"named_exports_only":{"type":"boolean","description":"True when the repo's modules use named exports only (no default exports)."},"config":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string","description":"Path relative to the repo."},"text":{"type":"string","description":"The file's text, cut when it was too long to keep whole."},"truncated":{"type":"boolean","description":"True when `text` was cut and is only part of the file."},"sha256":{"description":"sha256 of the whole file; set when `text` is the file itself, so an edit can be refused if the file moved on.","type":"string"}},"required":["path","text","truncated"]},"description":"Formatter, linter and compiler config near the code."}},"required":["test_layout","test_root","naming","named_exports_only","config"],"description":"Style signals read from the repo: test layout, naming, export style and tool config."},"guidance":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string","description":"Path relative to the repo."},"text":{"type":"string","description":"The file's text, cut when it was too long to keep whole."},"truncated":{"type":"boolean","description":"True when `text` was cut and is only part of the file."},"sha256":{"description":"sha256 of the whole file; set when `text` is the file itself, so an edit can be refused if the file moved on.","type":"string"}},"required":["path","text","truncated"]},"description":"Convention sections of AGENTS.md, CLAUDE.md and README.md files, from the home directory up."},"usages":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string","description":"A name the design replaces."},"files":{"type":"array","items":{"type":"string"},"description":"Repo-relative files that still use the name."}},"required":["name","files"]},"description":"Where each name the design replaces is still used in the repo."}},"required":["language","layout","siblings","registries","style","guidance","usages"]}},"required":["design","repo"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_list_skills","description":"List installed skills with their descriptions, 20 per call. The page size is the contract, not a hint. Use `find_skills` to search by need and `read_skill` to open one. No model is called.\n\nCall: { offset?, limit? }. offset defaults to 0. limit defaults to 20. The root is $SKILLS_ROOT, else ~/.agents/skills. The answer carries the page, the total, and next_offset when another page exists. Page with that offset; do not guess it.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"offset":{"default":0,"description":"Index of the first skill to return, 0-based over the name-sorted list. Defaults to 0.","type":"integer","minimum":0,"maximum":9007199254740991},"limit":{"default":20,"description":"Skills returned per call. Defaults to 20, at most 20: the page size is the contract.","type":"integer","minimum":1,"maximum":20}}},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_lsp","description":"TypeScript/JavaScript code intelligence for one file, with an edit-ready `[path#TAG]` on every location. Use `grep` for a text search and `read` for a window of source. This is the TypeScript compiler answering, not a rename, not code actions, and not Python or Rust.\n\nCall: { action, path, line?, column?, root? }. action is `diagnostics`, `definition`, `references`, or `hover`. definition, references, and hover require line and column (1-based). A missing position is refused by name (`lsp <action> needs line and column`). A position that names no symbol errors with that position, so an empty answer is never \"no references\". diagnostics needs no position: syntax is `ok` or `failed` plus parse errors, and diagnostics are `line: message`. references includes the declaration, caps at 25, and sets truncated. hover text is the symbol display plus its type, capped at 400 characters. Each location is { path, tag, start, end, text }: absolute path, the file's current tag, and the 1-based line span, so `edit` can anchor `[path#TAG]` directly. root defaults to the nearest tsconfig.json or jsconfig.json above the file, else the file's directory. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. This covers path and root. Only .ts .tsx .js .jsx .mts .cts .mjs .cjs are accepted; anything else is refused with that list. Reference scanning skips node_modules and .d.ts files, and does not see string-literal member names or JSDoc mentions. Without a tsconfig, cross-file answers are best-effort.\n\nExample: {\"action\":\"definition\",\"path\":\"/repo/src/x.ts\",\"line\":4,\"column\":8}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"action":{"type":"string","enum":["diagnostics","definition","references","hover"],"description":"What to answer about the file: `diagnostics` (parse status and `line: message` errors, no position needed), `definition`, `references` (includes the declaration), or `hover` (symbol display plus type); the last three need line and column."},"path":{"type":"string","minLength":1,"description":"Absolute path of the .ts/.tsx/.js/.jsx/.mts/.cts/.mjs/.cjs file to analyze; a relative path is refused."},"line":{"description":"1-based line of the symbol. Required for definition, references and hover.","type":"integer","minimum":1,"maximum":9007199254740991},"column":{"description":"1-based column of the symbol. Required for definition, references and hover.","type":"integer","minimum":1,"maximum":9007199254740991},"root":{"description":"Absolute project root that owns the tsconfig; a relative root is refused. Default: the nearest tsconfig.json or jsconfig.json above the file, else the file's directory.","type":"string","minLength":1}},"required":["action","path"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_manage_skill","description":"Create, update, or delete a managed skill's SKILL.md under the managed skills root. Use `read_skill` to read one, `list_skills` to page the library, and `find_skills` to search by need. This tool writes.\n\nCall: { action, name, description?, body? }. action is create, update, or delete. The generated file is frontmatter with exactly the normalized name and the sanitized description, then body verbatim. Refusals are answers, never throws: an unsafe name, an unsafe target, frontmatter in the body, a file over 64000 bytes, or a name an authored skill already owns. Nothing is written on a refusal.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"action":{"type":"string","enum":["create","update","delete"],"description":"What to do with the managed skill: `create` a new one, `update` an existing one, or `delete` it."},"name":{"type":"string","minLength":1,"description":"The skill's name; trimmed and lowercased, then matched against `[a-z0-9][a-z0-9-]{0,63}`."},"description":{"description":"One-line description for the generated frontmatter. Required for `create` and `update`.","type":"string"},"body":{"description":"The `SKILL.md` markdown body, without frontmatter. Required for `create` and `update`.","type":"string"}},"required":["action","name"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_plan.infer_dependency","description":"Infer which planned goals must wait for which others, judged once per unordered pair. Registered as `plan.infer_dependency`. It does not reorder the plan or run the goals.\n\nCall: { goals }. Each goal needs an id. An empty id throws `infer dependency: goal <index> (<statement>) has no id`. A duplicate id throws `infer dependency: duplicate goal id <id>`. A cancelled run throws `infer dependency: run cancelled`. The answer is the pairwise judgements, not a schedule.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"goals":{"description":"The planned goals to order. Every unordered pair is judged for which goal must wait for the other; ids must be unique and non-empty.","type":"array","items":{"type":"object","properties":{"id":{"description":"Unique goal id; required. Dependency edges refer to goals by this id.","type":"string"},"statement":{"description":"What the goal is; shown to the judge when it orders each pair of goals.","type":"string"},"criteria":{"description":"Optional acceptance criteria for the goal, shown to the judge with the statement.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"required":["id","statement"]}}},"required":["goals"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_plan.phase","description":"Classify one planned step into its hardening phase. Registered as `plan.phase`; `plan_phase` resolves to the same tool.\n\nCall: { text }. text is the planned step, with the overall request in parentheses when you know it. Blank text fails with `agentmux: the user's words are required`.\n\nvalue is happy_path, structural, edge, or production. certain is true only when the pick's probability is at least 0.6 and the pick is one of those four; otherwise value is happy_path (an unknown step runs first) and certain is false. evidence is the category the model picked. A failed call throws `classify phase: <cause>` and does not invent a phase.\n\nExample: {\"text\":\"Add a table test covering the empty name case\"}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The planned step to classify, with the overall request in parentheses when known; blank text fails."}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_plan_tasks","description":"Turn the user's words into a plan of atask items for one project. Per goal: a title, an outcome, acceptance, a targeted proof and regression (or a draft), and prerequisites. It returns the plan; it does not file the tasks.\n\nCall: { text, project?, conversation?, contexts? }. text is the request. project narrows which project the proofs run in. A failed goal pass throws `identify the goals to plan: <cause>`. A bad task throws `write the task for <key>: <cause>` or `fix the answer: <problems>`. A goal with no grounded proof stays a draft rather than inventing a command.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The goals to plan, in words. Must not be blank."},"project":{"description":"Name or id of the atask project to file into; when given, select_project is skipped. Without it `conversation` is required.","type":"string"},"conversation":{"description":"The thread and the registry of live projects, as select_project reads them; required when `project` is absent.","type":"object","properties":{"WorkDir":{"default":"","description":"The directory the session ran in; empty when unknown. It may not match the work. Default: empty.","type":"string"},"Repo":{"default":"","description":"The main repository WorkDir is in, or was checked out from; empty when none. Default: empty.","type":"string"},"Worktree":{"default":"","description":"The git worktree WorkDir is in; empty when WorkDir is in the main checkout. Default: empty.","type":"string"},"Branch":{"default":"","description":"The git branch the session was on. Default: empty.","type":"string"},"Title":{"default":"","description":"The thread's title. Default: empty.","type":"string"},"FirstRequest":{"default":"","description":"The first request of the thread. Default: empty.","type":"string"},"Turns":{"minItems":1,"type":"array","items":{"type":"object","properties":{"Role":{"type":"string","description":"Who spoke this turn: the user or the agent."},"Text":{"type":"string","description":"What was said in this turn."}},"required":["Role","Text"],"description":"One user or agent turn of the thread."},"description":"The latest meaningful turns of the thread, oldest first. At least one is required."},"Current":{"description":"The project the thread is filed under; omit when it has none.","type":"object","properties":{"ID":{"default":"","description":"The caller's id for the project (the atask project id); echoed as `ProjectID` when the project is chosen. Default: empty.","type":"string"},"Name":{"type":"string","description":"The project's name; the answer names a project by this."},"Goal":{"default":"","description":"What the project is for, in the project's own words. Default: empty.","type":"string"},"Summary":{"default":"","description":"A stored summary of the project; preferred over `Goal` when describing what the project is for. Default: empty.","type":"string"},"Home":{"default":"","description":"The directory the project's sessions ran in; empty when none is known. Default: empty.","type":"string"},"Contents":{"default":{"Entries":[],"Readme":""},"description":"What is on disk at the project's home: top-level names and the README opening.","type":"object","properties":{"Entries":{"default":[],"description":"Top-level names at the project's home; directories end in \"/\". Default: empty.","type":"array","items":{"type":"string"}},"Readme":{"default":"","description":"The opening of the project's README. Default: empty.","type":"string"}}}},"required":["Name"]},"Projects":{"default":[],"description":"The live projects worth choosing from, and the current one. Default: empty.","type":"array","items":{"type":"object","properties":{"ID":{"default":"","description":"The caller's id for the project (the atask project id); echoed as `ProjectID` when the project is chosen. Default: empty.","type":"string"},"Name":{"type":"string","description":"The project's name; the answer names a project by this."},"Goal":{"default":"","description":"What the project is for, in the project's own words. Default: empty.","type":"string"},"Summary":{"default":"","description":"A stored summary of the project; preferred over `Goal` when describing what the project is for. Default: empty.","type":"string"},"Home":{"default":"","description":"The directory the project's sessions ran in; empty when none is known. Default: empty.","type":"string"},"Contents":{"default":{"Entries":[],"Readme":""},"description":"What is on disk at the project's home: top-level names and the README opening.","type":"object","properties":{"Entries":{"default":[],"description":"Top-level names at the project's home; directories end in \"/\". Default: empty.","type":"array","items":{"type":"string"}},"Readme":{"default":"","description":"The opening of the project's README. Default: empty.","type":"string"}}}},"required":["Name"],"description":"A live project the thread could belong to."}},"ProjectBudget":{"description":"The most bytes of the project list the thread shows; 16384 when absent.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991}},"required":["Turns"]},"contexts":{"description":"The checkout of each registered project, keyed by atask project id; the chosen project's grounds the written checks.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"Home":{"type":"string","description":"The checkout's directory."},"Layout":{"type":"array","items":{"type":"string"},"description":"Paths relative to the project home; a directory has a trailing `/`."},"Unlisted":{"type":"array","items":{"type":"string"},"description":"Directories (\"\" is the home itself) whose children are not all in `Layout`: a path below one cannot be disproven."},"MiseTasks":{"type":"array","items":{"type":"string"},"description":"The `[tasks.*]` names of the checkout's mise.toml."},"OpenTasks":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"The atask task id."},"title":{"type":"string","description":"The task's title."}},"required":["id","title"],"description":"An unfinished atask task of the project."},"description":"The project's unfinished atask tasks, so a goal already stated is not filed twice."},"Runners":{"description":"The ways the checkout runs its tests; absent when the checkout was not read for them.","type":"array","items":{"type":"object","properties":{"Kind":{"type":"string","enum":["go","vitest","jest","npm","pytest","cargo","phpunit","make"],"description":"The kind of test runner."},"Dir":{"type":"string","description":"The directory below the home the command runs in; \"\" is the home itself."},"Command":{"type":"string","description":"The command that runs the tests named after it, e.g. \"go test\"."},"Detail":{"type":"string","description":"What else the config says: the Go module path, the make targets."}},"required":["Kind","Dir","Command","Detail"],"description":"A way the checkout runs its tests, read from its config files."}},"TestFiles":{"description":"The tracked test files, most relevant to the gathering words first, cut at a cap; absent when not read.","type":"array","items":{"type":"string"}},"TestFilesTruncated":{"description":"True when `TestFiles` was cut at the cap.","type":"boolean"},"TestNames":{"description":"The test names found in the most relevant test files, keyed by test file.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"type":"string"}}},"ChangedFiles":{"description":"The files the work changes.","type":"array","items":{"type":"string"}}},"required":["Home","Layout","Unlisted","MiseTasks","OpenTasks"],"description":"What the machine knows of one project's checkout, so a proof can name a file or task that exists."}}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_propose_capabilities","description":"Read conversations, files, and folders and return, per source, the distinct useful leaf capabilities in it. Each leaf has an irreducible name, a purpose, a reason, and pseudocode. It proposes; it builds nothing. Hand a kept leaf to `implement_code`, or use `create_workflow` to do both.\n\nCall: { sources, namespace?, phase?, samples?, min_agreement?, registered? }. sources is the conversations, files, and folders. A leaf is kept when a majority of that source's samples propose it and the strongest model passes it. Phase 2 writes the pseudocode. A cluster that lists a member the sample did not propose throws naming the cluster, the member, and the sample. Give each member's sample number and name exactly as written.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"sources":{"minItems":1,"type":"array","items":{"type":"object","properties":{"ref":{"type":"string","minLength":1,"description":"The argument as the caller wrote it: `claude:<id>`, a file path or a folder path."},"kind":{"type":"string","enum":["conversation","file","folder"],"description":"What the source is: a `conversation`, a `file` or a `folder`."},"body":{"type":"string","minLength":1,"description":"The bounded text of the source that the model reads."},"anchors":{"type":"array","items":{"type":"string"},"description":"The evidence the model may cite: paths for a file or folder, turn ids for a conversation."},"truncated":{"type":"boolean","description":"True when the host cut the source at its size limits, so the body is part of it."}},"required":["ref","kind","body","anchors","truncated"]},"description":"What to propose capabilities for, already read by the host: conversations, files or folders (at least one)."},"namespace":{"description":"One lower-case word such as \"webmaster\": every proposed capability name starts with it and a dot. Omit for no namespace.","anyOf":[{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},{"type":"null"}]},"phase":{"description":"1 lists the capabilities; 2 (the default) also writes pseudocode for each.","anyOf":[{"anyOf":[{"type":"number","const":1},{"type":"number","const":2}]},{"type":"null"}]},"samples":{"description":"How many times each source is proposed from (1-5, default 3); a leaf stays when enough samples propose it.","anyOf":[{"type":"integer","minimum":1,"maximum":5},{"type":"null"}]},"min_agreement":{"description":"The fewest samples that must propose a concept (under any names) for it to be kept (default 2); never more than `samples`.","anyOf":[{"type":"integer","minimum":1,"maximum":5},{"type":"null"}]},"registered":{"description":"Every registered capability name, filled by the CLI's completer; the names under `namespace` are shown to the proposal.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}},"required":["sources"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_read","description":"Read a text file as numbered `LINE:TEXT` rows under a `[path#TAG]` snapshot tag. The tag is the anchor `edit` and `write` verify, so read before you change a file; it changes whenever the file changes, so re-read after any outside change. Use `grep` when you know the text, `glob` when you know the path shape, and `find` when you know the behavior but not the symbol.\n\nCall: { path, start?, end?, limit? }. start and end are 1-based inclusive. Default window is start 1, limit 400, cap 4000; limit is ignored when end is set. A file over 4 MiB, a binary file, a directory, and a missing path are refused by name. The answer names total_lines and truncated, so page with a new start when truncated. Paths must be absolute: a relative path is refused with an error that names the server's working directory, and is never resolved against it. An `http://` or `https://` URL is the one exception: it is fetched, not resolved against a directory.\n\nOther path forms, all read-only and never extracted to disk (the answer has kind and no tag, so they cannot be edited):\n- `/abs/db.sqlite` (also .sqlite3, .db, .db3) lists tables with row counts and views; `/abs/db.sqlite:table` shows the schema and pages rows as one JSON object per line, with start, end and limit counting rows. A table name that does not exist is refused with the list of tables. A cell over 1000 characters is cut and says how much was dropped; blobs show their size.\n- `/abs/archive.zip` (also .jar, .apk, .whl, .tar, .tgz, .tar.gz) lists entries with sizes, with start, end and limit counting entries; `/abs/archive.zip:docs/` lists the entries under a directory; `/abs/archive.zip:docs/a.txt` returns that member as numbered lines. A member over 4 MiB or a binary member is refused; a missing member is refused with the entry count. tar listings stop at 100000 entries and say so.\n- `http://` or `https://` URL: the page as readable text (HTML becomes headings, lists, `[text](url)` links and ` | ` table rows, without scripts or styles; plain text, JSON and XML come as sent), numbered and paged like a file. Redirects are followed up to 5 and reported in the header and in `http.redirected_from`; a non-2xx status is refused with the status and the start of its body; a non-text content type is refused by name. The body is read up to 2 MiB after decompression and the answer says `body cut` and sets truncated when there was more; a request gets 15 seconds. Loopback, RFC1918, link-local and other private-network targets are refused, also when a name resolves to one or a redirect points at one; only an operator setting CAPABILITY_READ_ALLOW_PRIVATE_URLS=1 for the server lifts that. Only GET is sent, with no credentials.\n- A PDF (recognized by its first bytes, so the name does not matter) returns its text by page: start, end and limit count pages, and each page is a `--- page N ---` block in reading order, not numbered lines. total_lines is the page count. A page with no text says so (a scanned page is an image, and no OCR is run); text in a font with no Unicode mapping is left out and the page says so; an encrypted PDF and one over 128 MiB are refused. The answer holds at most 100000 characters of text; when it stops early it names the page to continue from with start.\n- A PNG or JPEG (by its first bytes) returns its type and pixel dimensions in `image` and in the text, plus bit depth and color model; the pixels are not returned, so this tells you what the file is, not what it shows. Other image formats are refused as binary.\n\nExample: {\"path\":\"/repo/src/runtime/cli/capability.ts\",\"start\":90,\"end\":98}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Absolute path of the file to read (a relative path is refused); or an `http(s)://` URL, read as text. `/abs/db.sqlite` lists tables and `/abs/db.sqlite:table` pages rows; `/abs/archive.zip` (or tar, tgz, tar.gz, jar, apk, whl) lists entries and `/abs/archive.zip:member` reads one. A PDF returns its text by page; a PNG or JPEG returns its type and dimensions."},"start":{"description":"First 1-based line; or row, entry or PDF page for a database table, archive listing or PDF. Default 1.","type":"integer","minimum":1,"maximum":9007199254740991},"end":{"description":"Last 1-based line, row, entry or page, inclusive. Default: start + limit - 1.","type":"integer","minimum":1,"maximum":9007199254740991},"limit":{"default":400,"description":"Lines, rows, entries or pages to return when `end` is absent. Default 400, capped at 4000.","type":"integer","minimum":1,"maximum":4000}},"required":["path"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_read_skill","description":"Read one installed skill's SKILL.md, or a file inside its directory (`references/`, `scripts/`). Use `find_skills` or `list_skills` to learn the name first. No model is called. The answer is cached.\n\nCall: { name, path? }. name is the bare skill name, or `skill://<name>/<subpath>`. path is a file inside the skill directory when name is bare. The root is $SKILLS_ROOT, else ~/.agents/skills. A path that escapes the skills root, or a missing skill, is an answer with `error`, never a throw. A hit is { name, path, content }.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"name":{"type":"string","minLength":1,"description":"Skill name such as `code-style`, optionally as `skill://<name>` or `skill://<name>/<subpath>`."},"path":{"description":"A file inside the skill's directory, such as `references/x.md` or `scripts/y.sh`. Defaults to `SKILL.md`.","type":"string","minLength":1}},"required":["name"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_recall","description":"Rank past user asks, project history, and durable truth against a task. Deterministic: no model is called, and this tool reads nothing from disk. You supply the recorded past.\n\nCall: { project_id, task?, asks?, history?, state?, transcript?, max_items?, max_runes? }. An empty project_id throws `recall: project_id is empty`. max_items and max_runes cap the answer. The ranking is screened: a hit that does not bear on the task is dropped, not padded.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"project_id":{"description":"Project id; prefixes every evidence ref. Required: a blank value throws `recall: project_id is empty`.","type":["string","null"]},"task":{"description":"The task to rank against. Candidates are scored by the share of the task's words (stopwords removed) they contain; candidates sharing none are dropped.","type":["string","null"]},"asks":{"description":"Recorded user asks to rank (the `asks` source). The caller supplies them; nothing is read from disk.","anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"description":"Ask id; becomes the evidence ref and the `asks:<id>` item id.","type":["string","null"]},"ts":{"description":"Timestamp of the ask. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"text":{"description":"The user's ask text; this is what is matched against the task and returned (clipped to max_runes).","type":["string","null"]},"source_provider":{"description":"Harness/provider the ask came from. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"source_session":{"description":"Session id the ask came from. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"anchor":{"description":"Anchor locating the ask in its source. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"status":{"description":"Ask status. An ask whose status is `dismissed` or `superseded` is skipped; any other value keeps it live.","type":["string","null"]},"evidence_anchor":{"description":"Evidence anchor recorded when the ask was addressed. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"kind":{"description":"Ask kind. `standing` marks the returned item `required`; any other value does not.","type":["string","null"]},"criterion":{"description":"Acceptance criterion of the ask. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"verdict":{"description":"Verification verdict of the ask. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"intent_message_id":{"description":"Id of the intent message the ask maps to. Carried on the record; recall does not read it when ranking.","type":["string","null"]}}}},{"type":"null"}]},"history":{"description":"Recorded project history events to rank (the `history` source).","anyOf":[{"type":"array","items":{"type":"object","properties":{"ts":{"description":"Timestamp of the event. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"kind":{"description":"Event kind. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"text":{"description":"Event text; this is what is matched against the task and returned (clipped to max_runes).","type":["string","null"]},"id":{"description":"Event id; the evidence ref is `<project_id>#<id>`, or `<project_id>#line-<n>` (1-based) when empty.","type":["string","null"]},"agent":{"description":"Agent that produced the event. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"to":{"description":"Recipient of the event. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"board":{"description":"Board the event was posted on. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"thread":{"description":"Thread the event belongs to. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"verdict":{"description":"Screening verdict recorded for the event. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"reasons":{"description":"Reasons recorded with the verdict. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"unverified":{"description":"Whether the event was unverified. Carried on the record; recall does not read it when ranking.","type":["boolean","null"]},"ref":{"description":"Reference recorded on the event. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"from_project":{"description":"Source project of a cross-project event. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"to_project":{"description":"Target project of a cross-project event. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"projects":{"description":"Projects the event concerns. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"reason":{"description":"Reason recorded for the event. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"confidence":{"description":"Confidence recorded for the event. Carried on the record; recall does not read it when ranking.","type":["number","null"]}}}},{"type":"null"}]},"state":{"description":"Durable project truth; only its `obligations` are ranked. Omit or null for an empty state.","anyOf":[{"type":"object","properties":{"project_id":{"description":"Project id recorded in the state. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"name":{"description":"Project name. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"intent":{"description":"Project intent statement. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"obligations":{"description":"Durable obligations (the `truth` source). Only `open` or `blocked` ones are candidates.","anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"description":"Obligation id; the evidence ref is `<project_id>#<id>`.","type":["string","null"]},"text":{"description":"Obligation text; this is what is matched against the task and returned (clipped to max_runes).","type":["string","null"]},"kind":{"description":"Obligation kind. `constraint` marks the returned item `required`; any other value does not.","type":["string","null"]},"status":{"description":"Obligation status. Only `open` and `blocked` obligations are considered; others are skipped.","type":["string","null"]},"origin":{"description":"Where the entry came from. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"object","properties":{"kind":{"description":"Kind of source the entry came from. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"ref":{"description":"Reference to the source the entry came from. Carried on the record; recall does not read it when ranking.","type":["string","null"]}}},{"type":"null"}]},"evidence":{"description":"Evidence recorded for the obligation. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"blocked_on":{"description":"What the obligation is blocked on. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"supersedes":{"description":"Id of the obligation this one supersedes. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"superseded_by":{"description":"Id of the obligation that supersedes this one. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"goal_ids":{"description":"Goal ids the obligation traces to. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}}}},{"type":"null"}]},"decisions":{"description":"Recorded decisions. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"array","items":{"type":"object","properties":{"name":{"description":"Decision name. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"choice":{"description":"Choice made. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"origin":{"description":"Where the entry came from. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"object","properties":{"kind":{"description":"Kind of source the entry came from. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"ref":{"description":"Reference to the source the entry came from. Carried on the record; recall does not read it when ranking.","type":["string","null"]}}},{"type":"null"}]}}}},{"type":"null"}]},"facts":{"description":"Recorded facts. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"array","items":{"type":"object","properties":{"name":{"description":"Fact name. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"value":{"description":"Fact value. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"origin":{"description":"Where the entry came from. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"object","properties":{"kind":{"description":"Kind of source the entry came from. Carried on the record; recall does not read it when ranking.","type":["string","null"]},"ref":{"description":"Reference to the source the entry came from. Carried on the record; recall does not read it when ranking.","type":["string","null"]}}},{"type":"null"}]}}}},{"type":"null"}]},"skills":{"description":"Skill names recorded for the project. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"runs":{"description":"Run ids recorded for the project. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"rev":{"description":"State revision number. Carried on the record; recall does not read it when ranking.","anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]}}},{"type":"null"}]},"transcript":{"description":"Conversation transcript lines to rank (the `transcript` source).","anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"description":"Transcript line id; lines with an empty id are skipped. The evidence ref is `<project_id>#<id>`.","type":["string","null"]},"text":{"description":"Transcript line text; lines with empty text are skipped, others are matched against the task.","type":["string","null"]}}}},{"type":"null"}]},"max_items":{"description":"Maximum number of items returned; 0 or less means the default of 8.","anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]},"max_runes":{"description":"Maximum code points kept per item's text; 0 or less means the default of 400.","anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]}}},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_reconcile_results","description":"Fold verified result decisions into explicit project obligation changes. Only verified evidence satisfies an obligation; an executor's claim never does. It proposes changes and never persists them. No model is called.\n\nCall: { state?, results? }. state is the current obligations. results are the verified decisions. An empty obligation id throws `apply change: obligation id is empty`. An unknown id throws `apply change <action>: obligation <id> not found`. satisfy without evidence throws `satisfy <id>: evidence is required`. block without blocked_on throws `block <id>: blocked_on is required`. The answer is the proposed changes, not a written project.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"state":{"description":"Project state supplied by the caller; the capability never reads it from disk. project_id must be non-empty.","type":"object","properties":{"project_id":{"description":"Project id; must be non-empty.","type":"string"},"name":{"description":"Project name.","type":"string"},"intent":{"description":"Project intent.","type":"string"},"obligations":{"description":"Project obligations the results are folded into.","type":"array","items":{"type":"object","properties":{"id":{"description":"Obligation id; a result's obligation_id must match one of these.","type":"string"},"text":{"description":"Obligation text.","type":"string"},"kind":{"description":"Obligation kind, an open string.","type":"string"},"status":{"description":"Obligation status, an open string; only `open` and `blocked` obligations are live and can take a result.","type":"string"},"origin":{"description":"Where the obligation came from.","type":"object","properties":{"kind":{"description":"What kind of source produced this entry.","type":"string"},"ref":{"description":"Reference identifying the source within its kind.","type":"string"}},"required":["kind","ref"]},"evidence":{"description":"Evidence recorded when the obligation was satisfied.","type":"string"},"blocked_on":{"description":"What the obligation is blocked on.","type":"string"},"supersedes":{"description":"Id of the obligation this one supersedes.","type":"string"},"superseded_by":{"description":"Id of the obligation that supersedes this one.","type":"string"},"goal_ids":{"description":"Ids of the goals this obligation serves.","type":"array","items":{"type":"string"}}},"required":["id","text","kind","status","origin","evidence","blocked_on","supersedes","superseded_by","goal_ids"]}},"decisions":{"description":"Decisions recorded for the project.","type":"array","items":{"type":"object","properties":{"name":{"description":"Name of the decision.","type":"string"},"choice":{"description":"The choice made.","type":"string"},"origin":{"description":"Where the decision came from.","type":"object","properties":{"kind":{"description":"What kind of source produced this entry.","type":"string"},"ref":{"description":"Reference identifying the source within its kind.","type":"string"}},"required":["kind","ref"]}},"required":["name","choice","origin"]}},"facts":{"description":"Facts recorded for the project.","type":"array","items":{"type":"object","properties":{"name":{"description":"Name of the fact.","type":"string"},"value":{"description":"Value of the fact.","type":"string"},"origin":{"description":"Where the fact came from.","type":"object","properties":{"kind":{"description":"What kind of source produced this entry.","type":"string"},"ref":{"description":"Reference identifying the source within its kind.","type":"string"}},"required":["kind","ref"]}},"required":["name","value","origin"]}},"skills":{"description":"Names of skills recorded for the project.","type":"array","items":{"type":"string"}},"runs":{"description":"Ids of runs recorded for the project.","type":"array","items":{"type":"string"}},"rev":{"default":0,"description":"State revision; default 0.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},"required":["project_id","name","intent","obligations","decisions","facts","skills","runs"]},"results":{"description":"Verified result decisions, at least one; identical repeats collapse, contradictory ones are an error.","type":"array","items":{"type":"object","properties":{"obligation_id":{"description":"Id of the obligation this verified result is about; must exist in state.","type":"string"},"status":{"description":"Verification status: satisfied, failed, verifier_failure or indeterminate. Only satisfied closes the obligation.","type":"string"},"evidence":{"description":"Verified evidence for the status; required. An executor claim is not evidence.","type":"string"},"execution_completed":{"default":false,"description":"The executor's own completion claim; accepted and ignored, it never satisfies anything. Default false.","type":"boolean"},"failure":{"description":"Optional classify_failure output; must be absent when status is satisfied.","anyOf":[{"type":"object","properties":{"class":{"description":"Failure class from classify_failure; must match the status: implementation for failed, environment for verifier_failure, evidence for indeterminate.","type":"string"},"next_action":{"description":"Recommended next action; carried into the result's next_action.","type":"string"},"signature":{"description":"Failure signature from classify_failure.","type":"string"},"rationale":{"description":"Reasons classify_failure gave for the class.","type":"array","items":{"type":"string"}}},"required":["class","next_action","signature","rationale"]},{"type":"null"}]}},"required":["obligation_id","status","evidence"]}}},"required":["state","results"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_review_code","description":"Review one unified diff and return its correctness and quality findings. Use it on a worktree or branch diff before landing; pair it with `review_code_security` for the security half. Call: { diff, focus? }. diff is what `git diff` prints; focus is the ticket the change is for. The answer is { findings: [{ severity: blocking|suggestion|nit, path, line?, description, fix? }] }, empty when the diff is clean. A bad reply throws `fix the answer: <problems>`.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"diff":{"type":"string","minLength":1,"description":"The unified diff to review, as `git diff` prints it"},"focus":{"description":"What this change is for: the ticket title and its acceptance lines","type":"string"}},"required":["diff"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_review_code_security","description":"Review one unified diff and return its security findings. Use it on a worktree or branch diff before landing; pair it with `review_code` for the correctness half. Call: { diff, focus? }. diff is what `git diff` prints; focus is the ticket the change is for. The answer is { findings: [{ severity: blocking|suggestion|nit, path, line?, description, fix? }] }, empty when the diff has no exposure. A bad reply throws `fix the answer: <problems>`.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"diff":{"type":"string","minLength":1,"description":"The unified diff to review, as `git diff` prints it"},"focus":{"description":"What this change is for: the ticket title and its acceptance lines","type":"string"}},"required":["diff"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_rewrite_dictated_text","description":"Rewrite dictated text into a structured prompt for a coding agent: remove filler, repetition, and false starts; keep every requirement, constraint, identifier, and degree of certainty. Returns only the rewritten text. It never returns the input on failure, and the answer is never cached.\n\nCall: { text }. text is the dictated prompt. Needs OPENROUTER_API_KEY. A missing key throws `OPENROUTER_API_KEY is not set`. An HTTP failure throws `HTTP <status>: <body>`. A non-JSON reply throws `reply is not JSON: <body>`. On any of those, keep the original text yourself; this tool will not hand it back.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","minLength":1,"description":"The dictated prompt to rewrite for a coding agent"}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_run","description":"Ask what to know. Another agent runs shell commands until it can answer, and that record comes back. Use `run_command` for one command you already know, and `summarize` to shrink one command's output. This tool decides which commands to run.\n\nCall: { goal, facts?, readers? }. goal is what to find out. facts are answers already known, keyed by id, and are not asked again. A child question runs only when its parent is answered and its when.contains matches. A path the loop must not touch throws `refuse path <path>` and that change is not applied. The answer is the questions, the answers, and the commands that produced them.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"goal":{"type":"string","minLength":1,"description":"What to find out; another agent runs shell commands until it can answer"},"facts":{"description":"Answers already known, keyed by question id; those questions are not asked again","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"readers":{"description":"Ways to read a question without the agent running commands, keyed by question id; each value sets one of answer, capability, command or file","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"answer":{"description":"A ready answer returned for the question as-is, with no command run","type":"string"},"capability":{"description":"Name of a capability to run to answer the question; its output is the answer","type":"string","minLength":1},"input":{"description":"Input passed to the named capability; when omitted it receives { ask: <the question text> }"},"command":{"description":"Shell command (sh -c, 30 second limit) whose output, last 8000 characters, is the answer","type":"string","minLength":1},"file":{"description":"File to read as the answer: a path relative to the working directory, with no `..` and not absolute","type":"string","minLength":1}}}}},"required":["goal"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_run_command","description":"Run one shell command through /bin/bash -lc and return { status, exit_code, body, reason?, hash?, log_path? }. This tool never sleeps. A bare `sleep N` is not executed: it becomes a `wait` (N seconds as the budget, under the wait cap) on this session's background jobs and armed waits, or is dropped when none is pending; the body's first line is a warning naming the rewrite. `sleep` in a poll loop or beside other commands is refused: arm a `wait` (path_changed, job_output, timer) or run the work with `background` and call `wait`. Say what you want to learn in purpose; output over 8000 characters is then summarized toward it, and the full log stays off the prompt. With no purpose, output over that cap is cut to a 5000-character head and a tail. Use `read` to read a file, `grep` to search contents, and `glob` to find paths.\n\nCall: { command, cwd?, timeout_seconds?, purpose?, session?, background? }. cwd defaults to the process directory, is resolved to absolute, and is refused with its path when it does not exist (status error, nothing ran). timeout_seconds defaults to 300 and is clamped to 300; a longer request does not get more time. status timeout with exit 124 means the deadline won. When /bin/bash is not executable in this environment the command runs under /bin/sh -c and reason carries the fallback note.\n\nbackground runs the command without blocking and returns at once. { where: \"process\" } (the default) returns job_id, pid, and log_path; timeout_seconds then defaults to 600 and is not clamped, and `wait` settles on its exit. on_complete \"notify\" or { command } also arms a durable `wait` on that exit and returns its wait_id. { where: \"herdr\", session?, target?: \"tab\" | \"pane\", herdr_args? } runs it in a new herdr tab (default) or pane with output tee'd to log_path, and returns tab_id and pane_id; arm `wait` until job_output on log_path to settle on it. No herdr binary is status error with reason herdr_not_installed.\n\nstatus is ok, denied, unchanged, timeout, or error. denied (exit 1, nothing ran) when command is empty; when `sleep` sits in a poll loop or beside other commands (arm a `wait` instead); when it is `git worktree list` (use `wt list`); when it is sed -i or another in-place edit (use `edit` or `write`); or when it is Python used as an editor, or Python counting a quoted literal in a file (use `edit`, `write`, or `rg -c --fixed-strings`). unchanged means this session already ran this command in this cwd and the output matched; a call with no session is never unchanged. A named purpose can add a hint, not a refusal, when a better tool exists: `fd` or `rg` instead of find or grep -r, `read` instead of cat/head/tail, and `summarize` instead of reading ps or top yourself.\n\nExample: {\"command\":\"rg -n defineCapability src\",\"purpose\":\"where capabilities are registered\"}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"command":{"type":"string","minLength":1,"description":"The shell command to run"},"cwd":{"description":"Absolute working directory; defaults to the process directory","type":"string","minLength":1},"timeout_seconds":{"description":"Deadline in seconds; default and maximum 300","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"purpose":{"description":"One sentence: what you want to learn from this command. Long output is then summarized toward it instead of cut, and a better tool is named when one fits.","type":"string","minLength":1},"session":{"description":"Session id; a repeat with identical output then returns status=unchanged","type":"string","minLength":1},"background":{"description":"Run in the background and return at once; settle it with `wait`. Absent: blocking, as before","type":"object","properties":{"where":{"description":"process (default): this server's job registry; herdr: a herdr tab or pane","type":"string","enum":["process","herdr"]},"session":{"description":"herdr: the herdr session; default session when absent","type":"string","minLength":1},"target":{"description":"herdr: a new tab (default) or a pane split off the calling one","type":"string","enum":["tab","pane"]},"herdr_args":{"description":"herdr: extra flags passed to `herdr tab create` / `herdr pane split`","type":"array","items":{"type":"string"}},"on_complete":{"description":"wait (default): `wait` settles on its exit; notify / { command }: arms a durable `wait` on its exit","anyOf":[{"type":"string","enum":["wait","notify"]},{"type":"object","properties":{"command":{"type":"string","minLength":1}},"required":["command"]}]},"one_off":{"description":"herdr: a tab for a single task — the pane command ends with an exit sentinel whose landing reports the completion through the notify channel (on_complete then defaults to notify)","type":"boolean"}}}},"required":["command"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_select_execution","description":"Select the semantic compute class, backing strategy, and fallback policy for work before any provider is named. It plans; it never runs the work and never claims success. No model is called.\n\nCall: { capability, shape, maturity?, verifier?, required_tools?, permissions?, human_approval?, credentials?, prior?, constraints? }. capability is required; empty throws `select_execution: capability is required`. shape is deterministic, classification, selection, decomposition, implementation, or description. An unknown shape throws naming it. maturity is draft, working (default), or production. verifier is none (default), weak, or strong. compute_class is deterministic, structured_inference, generative, native_agent, or human. human_approval or credentials forces human. Else constraints.require_class. Else the shape: deterministic stays deterministic; classification, selection, and decomposition are structured_inference; implementation and description are generative. A forced class that disagrees with require_class throws naming the conflict. A forbidden class is skipped, and so is the prior class when it failed with no_new_information. Nothing left throws naming the base, the forbidden list, and the stuck flag. status is always selected. gates is [\"human_review\"] for production without a strong verifier, otherwise omitted. fallback allows one same-class retry that needs new information, none when the class is human or already failed.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"capability":{"description":"Name of the capability or work being planned; required, a blank value throws.","type":["string","null"]},"shape":{"description":"Kind of work: deterministic, classification, selection, decomposition, implementation, or description. Classification, selection and decomposition map to structured_inference; implementation and description to generative.","type":["string","null"]},"maturity":{"description":"How finished the result must be: draft, working, or production. Empty means working.","type":["string","null"]},"verifier":{"description":"How strongly the result can be checked: none, weak, or strong. Empty means none.","type":["string","null"]},"required_tools":{"description":"Tools the work needs; returned sorted and de-duplicated in the strategy.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"permissions":{"description":"Permissions the work needs; returned sorted and de-duplicated in the strategy.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"human_approval":{"description":"Whether explicit human approval is required; forces the human compute class.","type":["boolean","null"]},"credentials":{"description":"Whether credentials are needed; forces the human compute class.","type":["boolean","null"]},"prior":{"description":"An earlier attempt at this work, if any; used to avoid retrying a class that failed without new information.","anyOf":[{"type":"object","properties":{"class":{"description":"Compute class of the earlier attempt: deterministic, structured_inference, generative, native_agent, or human.","type":["string","null"]},"failed":{"description":"Whether the earlier attempt failed. A failed attempt gets no same-class retry in the fallback policy.","type":["boolean","null"]},"no_new_information":{"description":"Whether the earlier attempt gained no new information. With failed, its class is skipped and the next one is chosen.","type":["boolean","null"]}}},{"type":"null"}]},"constraints":{"description":"Limits on which compute class may be chosen.","anyOf":[{"type":"object","properties":{"require_class":{"description":"Compute class the work must use (deterministic, structured_inference, generative, native_agent, or human); empty means none. Conflicts with a class forced by human_approval or credentials throw.","type":["string","null"]},"forbid":{"description":"Compute classes that must not be chosen or escalated to; an unknown class name throws.","anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]}}},{"type":"null"}]}}},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_select_model","description":"Rank the registered semantic models that can answer a task, best fit first. No model is asked to do the ranking, and this tool does not call the winner.\n\nCall: { text }. text is the task; it is trimmed. The answer is { Candidates }, the models that can answer, best first. Nothing registered for that kind throws `no registered model can answer a <kind> need`. Any other failure throws `select a model for <text>: <reason>`.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The task prompt to pick models for; trimmed, and a blank value is rejected. Wording about describing, writing, generating, an llm, or text selects language models; anything else selects decision models."}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_select_project","description":"Which project is this thread? One decision whose menu is the live projects, plus new. It does not create the project.\n\nCall: { WorkDir?, Repo?, Worktree?, Branch?, Title?, FirstRequest?, Turns, Current?, Projects?, ProjectBudget? }. These are the Go field names, not snake_case. Projects is the menu, default []. Turns is the thread. A choice that is not on the menu throws `project <choice> is not on the menu: choose one of [<menu>] or \"new\"`. A failed ask throws `ask which project: <cause>`. The answer is the chosen project, or that it needs a new one.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"WorkDir":{"default":"","description":"The directory the session ran in; empty when unknown. It may not match the work. Default: empty.","type":"string"},"Repo":{"default":"","description":"The main repository WorkDir is in, or was checked out from; empty when none. Default: empty.","type":"string"},"Worktree":{"default":"","description":"The git worktree WorkDir is in; empty when WorkDir is in the main checkout. Default: empty.","type":"string"},"Branch":{"default":"","description":"The git branch the session was on. Default: empty.","type":"string"},"Title":{"default":"","description":"The thread's title. Default: empty.","type":"string"},"FirstRequest":{"default":"","description":"The first request of the thread. Default: empty.","type":"string"},"Turns":{"minItems":1,"type":"array","items":{"type":"object","properties":{"Role":{"type":"string","description":"Who spoke this turn: the user or the agent."},"Text":{"type":"string","description":"What was said in this turn."}},"required":["Role","Text"],"description":"One user or agent turn of the thread."},"description":"The latest meaningful turns of the thread, oldest first. At least one is required."},"Current":{"description":"The project the thread is filed under; omit when it has none.","type":"object","properties":{"ID":{"default":"","description":"The caller's id for the project (the atask project id); echoed as `ProjectID` when the project is chosen. Default: empty.","type":"string"},"Name":{"type":"string","description":"The project's name; the answer names a project by this."},"Goal":{"default":"","description":"What the project is for, in the project's own words. Default: empty.","type":"string"},"Summary":{"default":"","description":"A stored summary of the project; preferred over `Goal` when describing what the project is for. Default: empty.","type":"string"},"Home":{"default":"","description":"The directory the project's sessions ran in; empty when none is known. Default: empty.","type":"string"},"Contents":{"default":{"Entries":[],"Readme":""},"description":"What is on disk at the project's home: top-level names and the README opening.","type":"object","properties":{"Entries":{"default":[],"description":"Top-level names at the project's home; directories end in \"/\". Default: empty.","type":"array","items":{"type":"string"}},"Readme":{"default":"","description":"The opening of the project's README. Default: empty.","type":"string"}}}},"required":["Name"]},"Projects":{"default":[],"description":"The live projects worth choosing from, and the current one. Default: empty.","type":"array","items":{"type":"object","properties":{"ID":{"default":"","description":"The caller's id for the project (the atask project id); echoed as `ProjectID` when the project is chosen. Default: empty.","type":"string"},"Name":{"type":"string","description":"The project's name; the answer names a project by this."},"Goal":{"default":"","description":"What the project is for, in the project's own words. Default: empty.","type":"string"},"Summary":{"default":"","description":"A stored summary of the project; preferred over `Goal` when describing what the project is for. Default: empty.","type":"string"},"Home":{"default":"","description":"The directory the project's sessions ran in; empty when none is known. Default: empty.","type":"string"},"Contents":{"default":{"Entries":[],"Readme":""},"description":"What is on disk at the project's home: top-level names and the README opening.","type":"object","properties":{"Entries":{"default":[],"description":"Top-level names at the project's home; directories end in \"/\". Default: empty.","type":"array","items":{"type":"string"}},"Readme":{"default":"","description":"The opening of the project's README. Default: empty.","type":"string"}}}},"required":["Name"],"description":"A live project the thread could belong to."}},"ProjectBudget":{"description":"The most bytes of the project list the thread shows; 16384 when absent.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991}},"required":["Turns"],"description":"One thread and the projects it could belong to. The caller gathers them; the capability reads no disk."},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_start_atask_task","description":"Start one atask objective in its own worktree with a headless omp session and land the result only after `atask verify complete` passes. Use it when the objective needs isolated repo work or changes beyond the repo: claiming creates or reuses the task's one atask worktree (branch atask/<id>), the worker session runs inside it, and add_dirs grants it extra workspace directories for system-level changes. Call: { id, onComplete? = merge, add_dirs? = [], prompt?, timeout_s? = 1800 }. onComplete lands after verification passes: merge runs `wt merge` from the task worktree, pr-auto pushes and opens a pull request with auto-merge armed, pr opens one without, nil leaves the worktree and branch in place. The task's own verification is the only path to landing: a session that ends without a verified objective makes this run `atask verify complete` itself, and a failure answers failed with atask's message and never lands. When timeout_s runs out the answer is status running with the task, worktree, branch and job ids; calling again with the same id attaches to the same claim — it waits for the existing run, gates and lands it, and never starts a second worker. A task that is already complete answers settled and applies onComplete to its worktree. status is settled, failed, running, or refused; completion carries the landing outcome (merged, pull_request, left, failed) and url when one was opened.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"id":{"type":"string","minLength":1,"description":"The atask objective id (at-XXXXXX); claiming creates or reuses its one worktree on branch atask/<id>"},"onComplete":{"default":"merge","description":"The landing applied once atask verifies complete: merge runs `wt merge` from the task worktree (default), pr-auto pushes the branch and opens a pull request with auto-merge armed, pr opens one without, nil leaves the worktree and branch in place","type":"string","enum":["merge","pr-auto","pr","nil"]},"add_dirs":{"default":[],"description":"Extra workspace directories granted to the worker session (passed to omp as --add-dir) for changes outside the task repo, such as ~/.agents; default none","type":"array","items":{"type":"string"}},"prompt":{"description":"Overrides the prompt the worker session runs; by default it is told to work the claimed objective, commit with `wt step commit`, and finish only after `atask verify complete` passes","type":"string"},"timeout_s":{"default":1800,"description":"Seconds this call waits; when it runs out the answer is status running with the ids, and calling again with the same id attaches to the same run instead of starting a second worker","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991}},"required":["id"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_suggest_skills_tools_and_mcp","description":"Suggest which installed skill, tool, or MCP tool a prompt should use. Each catalog entry is judged on its own: would it help the agent doing this work? Each kind keeps its best that clear the bar.\n\nCall: { text, FullPrompt?, InFlight?, RecentTurns?, Harness?, Catalog?, CatalogJson?, CatalogErrors? }. These are the Go field names. text is the prompt. Harness filters the catalog to that harness. Catalog and CatalogJson are the host's catalog; do not invent entries. An unreadable catalog returns unavailable suggestions, not an empty success. A skill suggestion carries the bare name, not a file path: open it with `read_skill` or search with `find_skills`.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The prompt to pick skills, tools and MCP tools for; must not be blank."},"FullPrompt":{"default":"","description":"The whole prompt when `text` is only one part of it; empty by default.","type":"string"},"InFlight":{"default":"","description":"Description of work already in flight, given to the judge as context (first 600 characters used).","type":"string"},"RecentTurns":{"default":[],"description":"Recent conversation turns, given to the judge as context.","type":"array","items":{"type":"string"}},"Harness":{"default":"","description":"Harness name; keeps catalog entries with an empty or matching Harness. Empty keeps all entries.","type":"string"},"Catalog":{"default":[],"description":"The host's catalog of installed skills, tools and MCP tools: entries `{ Kind, Name, ... }`, the MCP tool file shape, `{ skills, tools, mcp_tools }`, or a JSON string of either. Do not invent entries.","anyOf":[{"type":"array","items":{}},{"type":"string"}]},"CatalogJson":{"default":"","description":"Same catalog as `Catalog`, as a JSON string (MCP file shape or `{ skills, tools, mcp_tools }`).","type":"string"},"CatalogErrors":{"default":[],"description":"Errors from loading catalog sources; reported as notes, or as a degraded result when no entries exist.","type":"array","items":{"type":"string"}}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_summarize","description":"Summarize a command or a file for another agent, and return the path and line count of the raw output. Use it when the output is too long to read; use `run_command` with purpose when you want that summary folded into the command result.\n\nCall: { file?, command?, focus?, argument? }. Pass file or command, not both as the thing to summarize. focus is questions the summary must answer, in order. Do not pass raw_output or text; the host fills those. A call without them throws `summarize needs the raw output`. An empty summary throws `summary is empty`. A summary that includes the raw output path throws `do not put the raw output path in the summary`. focus answers must match the questions in order and verbatim; a mismatch throws naming the asked question and the one it got.\n\nThe answer is { summary, focus: [{ question, answer, relevant_data }], raw_output: { path, lines } }.\n\nExample: {\"command\":\"ps aux\",\"focus\":[\"Examine duplicate processes\"]}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"argument":{"description":"The command or existing text path being summarized, used as the label the summary is written against; prefer file or command","type":"string","minLength":1},"file":{"description":"Existing file to read and summarize without executing it","type":"string","minLength":1},"command":{"description":"Shell command to execute; its captured output is summarized","type":"string","minLength":1},"focus":{"description":"Questions the summary must answer independently, in order; the answers come back one per question, verbatim","type":"array","items":{"type":"string","minLength":1}},"raw_output":{"description":"Metadata of the captured raw output; filled in by the host, do not pass it","type":"object","properties":{"path":{"type":"string","minLength":1,"description":"Path of the file holding the full raw output"},"lines":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of lines in the raw output"}},"required":["path","lines"]},"text":{"description":"The full source text to summarize; filled in by the host, do not pass it","type":"string"}}},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_task","description":"Delegate one verifiable objective to a headless worker (`claude -p`) and wait until atask verifies it. Use `define_objective` to shape the proof first, and `task_class` when you only need the kind of work. This tool files, claims, and waits.\n\nCall: { title, prompt, proof?, regression?, timeout_s?, worker_cmd? }. Flow: file the atask objective from title + proof + regression, claim it, run prompt in a worker bound to that claim, and settle only when `atask verify complete` passes. The answer carries atask's verdict, never the worker's own claim. Pass proof and regression as `run: <command>` checks for the repo the work is in; no default exists, because any default would be one repo's commands run against another. With neither, the title is looked up on the project's atask board: a complete task answers settled, an unclaimed one with its own contract is delegated under that contract, and otherwise the objective is filed as a draft naming the missing checks and the status is refused. A draft is never delegated. The worker runs in the server's working directory. timeout_s defaults to 1800 and bounds the wait. status is settled, failed, running, or refused. running means it is still going; call again or use `wait` rather than starting a second worker.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"title":{"type":"string","minLength":1,"description":"The objective's title as atask files it; a title the project's atask board already holds resolves to that existing task"},"prompt":{"type":"string","minLength":1,"description":"The full prompt the headless worker runs, passed to it as one quoted argument"},"proof":{"description":"The atask proof check in atask's check grammar (`run: <command>`), for the repo the work is in; no default exists, and without it (or regression) the objective is filed as a draft and refused","type":"string"},"regression":{"description":"The atask regression check, same `run: <command>` grammar as proof; no default exists","type":"string"},"timeout_s":{"default":1800,"description":"Seconds to wait for the objective to verify complete; default 1800. When it runs out the answer is status running, not a failure","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"worker_cmd":{"description":"The harness command prefix the worker runs, with the prompt appended quoted; default `claude -p`","type":"string"}},"required":["title","prompt"]},"annotations":{"readOnlyHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_task_class","description":"Classify one goal's kind of work so a delegate can take the cheapest sufficient path. One decision call. It does not do the work.\n\nCall: { text }. Blank text fails with `agentmux: the user's words are required`; words are trimmed before they are classified.\n\nvalue is simple_edit, hard_code, structured_extraction, research, judgment, summarization, or status_update. certain is true only when the pick's probability is at least 0.7 and the pick is one of those seven; otherwise value is hard_code (the full pipeline) and certain is false. evidence is the category the model picked. A failed call throws `classify task: <cause>` and does not invent a class.\n\nExample: {\"text\":\"Fix the login bug.\"}.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string","description":"The goal to classify by kind of work; trimmed, and blank text fails."}},"required":["text"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_tool_search","description":"Find mounted capabilities by a stated need. Ranks them by keyword overlap of the need against each description, best match first, so a harness can defer loading tools. No model is called.\n\nCall: { need, limit? }. limit defaults to 5. No mounted capabilities throws `tool_search has no mounted capabilities; src/capability/index.ts must mount them`. The answer is { tools }, the top matches, not the whole catalog. Use `suggest_skills_tools_and_mcp` when the catalog also includes skills and MCP tools.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"need":{"type":"string","description":"What you need a tool for, in plain words; ranked by keyword overlap against each mounted capability's description. Must not be blank"},"limit":{"default":5,"description":"At most this many top matches to return; 1-15, default 5","type":"integer","minimum":1,"maximum":15}},"required":["need"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"agentmux_capability_upgrade_dependency","description":"Drive one atomic dependency upgrade on a pull request: name the packages, research the range, find every caller, fix what the bump breaks, re-check that failure, then arm automerge or hand a remaining unrelated red check to `fix_red_ci`. Needs network.\n\nCall: { url?, title?, body?, files?, packages?, ci?, notes?, facts?, timings? }. url is the pull request. packages names what this upgrade is for. facts is required before the run proceeds. A pull request with no head branch throws `pull request has no head branch`. A missing upgrade host throws `upgrade host is not installed`. No pnpm-workspace.yaml throws naming the directory. A checkout that does not contain the target version throws and refuses to edit it. A path outside the checkout throws `refuse path <path>`. A missing file throws `missing <path>`. Change kinds include breaking, deprecation, security, behavior, fix, and other. Caller kinds include direct-import, binary, and wrapper. The verdict is ready or needs_work. A recheck is passed, failed, or not_proven.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"url":{"description":"URL of the pull request.","type":"string"},"title":{"description":"Title of the pull request.","type":"string"},"body":{"description":"Body text of the pull request.","type":"string"},"files":{"description":"Every path the pull request changes, with its diff.","type":"array","items":{"type":"object","properties":{"path":{"description":"Path of the file the PR changes.","type":"string"},"patch":{"description":"The diff GitHub reports for this file.","type":"string"},"lockfile":{"description":"True when the file is a lockfile.","type":"boolean"},"manifest":{"description":"True when the file is a dependency manifest.","type":"boolean"},"test":{"description":"True when the file is a test file.","type":"boolean"}},"required":["path"]}},"packages":{"description":"The packages this upgrade is for, with their from and to versions.","type":"array","items":{"type":"object","properties":{"name":{"description":"Package name.","type":"string"},"from":{"description":"Version the package moves from.","type":"string"},"to":{"description":"Version the package moves to.","type":"string"}},"required":["name","from","to"]}},"ci":{"description":"The required CI checks the pull request already ran.","type":"array","items":{"type":"object","properties":{"name":{"description":"Name of the required CI check.","type":"string"},"passed":{"default":false,"description":"Whether the check passed.","type":"boolean"}},"required":["name"]}},"notes":{"description":"Release notes extracted from the pull request body.","type":"array","items":{"type":"string"}},"facts":{"description":"The facts gathered from the PR, the tree and the changelogs. Required before the run proceeds.","type":"object","properties":{"ecosystem":{"description":"Package ecosystem the upgrade belongs to: npm, go, pypi or composer. Empty when no changed manifest names one.","type":"string"},"packages":{"description":"What is known about each bumped package.","type":"array","items":{"type":"object","properties":{"package":{"description":"The package and the versions it moves from and to.","type":"object","properties":{"name":{"description":"Package name.","type":"string"},"from":{"description":"Version the package moves from.","type":"string"},"to":{"description":"Version the package moves to.","type":"string"}},"required":["name","from","to"]},"changelog":{"description":"Change notes and advisories gathered for the package.","type":"object","properties":{"range":{"description":"The version range this changelog covers.","type":"object","properties":{"ecosystem":{"description":"Package ecosystem the upgrade belongs to: npm, go, pypi or composer. Empty when no changed manifest names one.","type":"string"},"package":{"description":"Name of the package being upgraded.","type":"string"},"from":{"description":"Version the package moves from, exclusive.","type":"string"},"to":{"description":"Version the package moves to, inclusive.","type":"string"}},"required":["ecosystem","package","from","to"]},"entries":{"description":"Change notes for the versions in the range.","type":"array","items":{"type":"object","properties":{"version":{"description":"The package version this change note belongs to.","type":"string"},"kind":{"type":"string","enum":["breaking","deprecation","security","behavior","fix","other"],"description":"What the change means to someone upgrading: breaking, deprecation, security, behavior, fix, or other."},"text":{"description":"The text of the change note.","type":"string"},"source":{"description":"Where the note came from: a GitHub release, the repository's CHANGELOG.md, or the notes pasted into the upgrade PR (`renovate-pr-notes`).","type":"string"}},"required":["version","kind","text","source"]}},"advisories":{"description":"Security advisories the upgrade touches.","type":"array","items":{"type":"object","properties":{"id":{"description":"The advisory's identifier.","type":"string"},"severity":{"description":"The advisory's severity label.","type":"string"},"summary":{"description":"One-line summary of the advisory.","type":"string"},"url":{"description":"Link to the advisory.","type":"string"},"affected":{"description":"The versions the advisory affects.","type":"string"}},"required":["id","severity","summary","url","affected"]}},"sources":{"description":"Labels of the sources the notes were read from.","type":"array","items":{"type":"string"}},"gaps":{"description":"Versions or sources for which nothing was fetched, with the reason.","type":"array","items":{"type":"string"}}},"required":["range","entries","advisories","sources","gaps"]},"aliases":{"description":"Other names the package is imported or run under.","type":"array","items":{"type":"string"}},"alias_evidence":{"description":"Evidence for each alias.","type":"array","items":{"type":"string"}},"importers":{"description":"Paths of the files that import the package.","type":"array","items":{"type":"string"}},"import_sites":{"description":"Every import statement of the package.","type":"array","items":{"type":"object","properties":{"path":{"description":"Path of the file containing the statement.","type":"string"},"line":{"default":0,"description":"1-based line number of the statement in `path`.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"statement":{"description":"The statement exactly as written in the file.","type":"string"}},"required":["path","statement"]}},"used_symbols":{"description":"Symbols of the package the code uses.","type":"array","items":{"type":"string"}},"matched_entries":{"description":"Change notes that match the symbols the code uses.","type":"array","items":{"type":"object","properties":{"version":{"description":"The package version this change note belongs to.","type":"string"},"kind":{"type":"string","enum":["breaking","deprecation","security","behavior","fix","other"],"description":"What the change means to someone upgrading: breaking, deprecation, security, behavior, fix, or other."},"text":{"description":"The text of the change note.","type":"string"},"source":{"description":"Where the note came from: a GitHub release, the repository's CHANGELOG.md, or the notes pasted into the upgrade PR (`renovate-pr-notes`).","type":"string"}},"required":["version","kind","text","source"]}},"applicable_entries":{"description":"Change notes the model judged apply to this repository, each with its reason. Empty until judged.","type":"array","items":{"type":"object","properties":{"version":{"description":"The package version this change note belongs to.","type":"string"},"kind":{"type":"string","enum":["breaking","deprecation","security","behavior","fix","other"],"description":"What the change means to someone upgrading: breaking, deprecation, security, behavior, fix, or other."},"text":{"description":"The text of the change note.","type":"string"},"source":{"description":"Where the note came from: a GitHub release, the repository's CHANGELOG.md, or the notes pasted into the upgrade PR (`renovate-pr-notes`).","type":"string"},"why":{"description":"Why this change note applies to this repository's use of the package.","type":"string"}},"required":["version","kind","text","source","why"]}},"executions":{"description":"Every line that runs the package's binary instead of importing it, such as a script naming `node_modules/.bin/<name>`, a package runner, or a process call from another language.","type":"array","items":{"type":"object","properties":{"path":{"description":"Path of the file containing the statement.","type":"string"},"line":{"default":0,"description":"1-based line number of the statement in `path`.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"statement":{"description":"The statement exactly as written in the file.","type":"string"}},"required":["path","statement"]}},"unit":{"description":"Name of the upgrade unit the package belongs to.","type":"string"},"facade":{"description":"Whether the package needs a facade and who owns it.","type":"object","properties":{"required":{"default":false,"description":"Whether callers of this package must be wrapped in a facade.","type":"boolean"},"owner":{"description":"Who owns the facade, when one is required.","type":"string"},"reason":{"description":"Why a facade is or is not required.","type":"string"}},"required":["reason"]}},"required":["package","changelog","aliases","importers","import_sites","used_symbols","matched_entries","unit","facade"]}},"units":{"description":"Upgrade units: each inner list holds the names of the packages in that unit, in the snapshot's order.","type":"array","items":{"type":"array","items":{"type":"string"}}},"test_diff":{"description":"What the PR did to its tests: the files touched and the lines that weaken a test.","type":"object","properties":{"changed":{"description":"Paths of every test file the PR touched.","type":"array","items":{"type":"string"}},"suspicious":{"description":"The changed test lines that weaken a test.","type":"array","items":{"type":"object","properties":{"path":{"description":"Path of the changed test file.","type":"string"},"kind":{"type":"string","enum":["removed_assertion","added_skip"],"description":"Why the line is suspicious: `removed_assertion` (an assertion was deleted) or `added_skip` (a skip was added)."},"line":{"description":"The changed line itself.","type":"string"}},"required":["path","kind","line"]}}},"required":["changed","suspicious"]},"ci":{"description":"The required CI checks and whether each passed.","type":"array","items":{"type":"object","properties":{"name":{"description":"Name of the required CI check.","type":"string"},"passed":{"default":false,"description":"Whether the check passed.","type":"boolean"}},"required":["name"]}},"lockfile":{"description":"Paths of the lockfiles the PR changes.","type":"array","items":{"type":"string"}},"manifest":{"descr