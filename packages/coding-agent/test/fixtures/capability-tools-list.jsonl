ription":"Device profile the metrics were measured under."},"metrics":{"type":"object","properties":{"ttfb_ms":{"description":"Time to first byte in milliseconds; null when not measured.","type":["number","null"]},"lcp_ms":{"description":"Largest Contentful Paint in milliseconds; null when not measured.","type":["number","null"]},"fcp_ms":{"description":"First Contentful Paint in milliseconds; null when not measured.","type":["number","null"]},"inp_ms":{"description":"Interaction to Next Paint in milliseconds; null when not measured.","type":["number","null"]},"si_ms":{"description":"Speed Index in milliseconds; null when not measured.","type":["number","null"]},"tbt_ms":{"description":"Total Blocking Time in milliseconds; null when not measured.","type":["number","null"]},"cls":{"description":"Cumulative Layout Shift, a unitless score; null when not measured.","type":["number","null"]},"perf_score":{"description":"Lighthouse performance score from 0 to 1, higher is better; null when not measured.","type":["number","null"]},"weight_bytes":{"description":"Total page weight in bytes; null when not measured.","type":["number","null"]},"image_count":{"description":"Number of images on the page; null when not measured.","type":["number","null"]},"resource_summary":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"type":{"type":"string","description":"Lighthouse resource type, such as `script`, `image`, `third-party`, or `total`."},"requests":{"type":"number","description":"Requests of this type."},"transfer_bytes":{"type":"number","description":"Bytes transferred for this type."}},"required":["type","requests","transfer_bytes"]}},{"type":"null"}],"description":"Page weight and request count by resource type (Lighthouse `resource-summary`); null when not measured."},"unused_css_bytes":{"description":"Bytes of CSS the page never uses; null when not measured.","type":["number","null"]},"unused_js_bytes":{"description":"Bytes of JavaScript the page never runs