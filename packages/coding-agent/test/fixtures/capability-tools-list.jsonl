ies":false}},"trials":{"type":"integer","minimum":1,"maximum":100},"scorerIds":{"default":[],"type":"array","items":{"type":"string"}}},"required":["name","origin","variants","trials"],"additionalProperties":false},"execution":{"taskSupport":"forbidden"}}]},"jsonrpc":"2.0","id":2}
