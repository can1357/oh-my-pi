// Canonical grammar for the sloppy edit payload (constrained decoding).
//
// Shape:
//   <SM:EDIT path="relative/path.ts">   open edits in that file (`all` attr: every match)
//   <SM:EDIT>                           more edits in the same file
//   <SM:FIND> ... </SM:FIND>           current-text block; … elides gaps
//   <SM:PUT> ... </SM:PUT>             final text replacing the whole <SM:FIND> match
//                                        (<SM:PUT></SM:PUT> on one line deletes the match)
//   </SM:EDIT>                          optional block close
// Content lines between tags are raw file bytes: no entity escaping, no CDATA.
start: edit+
edit: edit_open pair+ edit_close?
edit_open: "<SM:EDIT" attr* ">" LF
attr: WS_INLINE (path_attr | all_attr)
path_attr: /(?:path|file)="[^"\n]*"/
all_attr: "all"
edit_close: "</SM:EDIT>" LF?
pair: find put?
find: "<SM:FIND>" LF content_line* "</SM:FIND>" LF
put: "<SM:PUT>" LF content_line* "</SM:PUT>" LF
   | "<SM:PUT></SM:PUT>" LF
content_line: TEXT LF | LF
TEXT: /[^\n]+/

%import common.LF
%import common.WS_INLINE
