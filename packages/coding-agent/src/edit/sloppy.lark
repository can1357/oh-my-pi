// Canonical grammar for the sloppy edit payload (constrained decoding).
//
// Shape:
//   *** Begin Patch   envelope sentinel (stripped by the runtime)
//   §relative/path    start an operation in that file (§*path: every match)
//   §                 start another operation in the same file (§*: every match)
//   <match lines>     current-text pattern with … gaps and selections
//                      Preferred selection: ⟪old│new⟫; no » follows.
//                      ＋text lines insert `text` as a new line in place.
//                      Legacy selection: ⟪old⟫; a » starts whole REWRITE.
//   »                 optional REWRITE separator
//   <rewrite lines>   final text
//   *** End Patch     envelope sentinel (stripped by the runtime)
start: begin_patch op+ end_patch
begin_patch: "*** Begin Patch" LF
end_patch:   "*** End Patch" LF?

op: op_header match_line+ rewrite?
op_header: "§" ALL? PATH? LF
ALL: "*"
PATH: /[^*§«»\n][^\n]*/

rewrite: rewrite_sep rewrite_line*
rewrite_sep: "»" LF
rewrite_line: content_line | blank_line

match_line: content_line | blank_line
content_line: /[^§«»\n][^\n]*/ LF
blank_line: LF

%import common.LF
