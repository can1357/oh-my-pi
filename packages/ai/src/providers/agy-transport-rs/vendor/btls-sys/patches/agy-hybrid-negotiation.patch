+// The server accepts exactly one hybrid group. All I/O stays in memory, and
+// initial shares are explicit, so the selected group and HRR expectations do
+// not depend on defaults, scheduling, or external servers. Production key
+// generation still uses the normal cryptographic RNG.
+class SSLHybridGroupTest : public ::testing::TestWithParam<uint16_t> {
+ protected:
+  bool IsP384() const { return GetParam() == SSL_GROUP_SECP384R1_MLKEM1024; }
+  const EC_GROUP *Curve() const {
+    return IsP384() ? EC_group_p384() : EC_group_p256();
+  }
+  size_t ECSecretBytes() const { return IsP384() ? 48 : 32; }
+  size_t ECShareBytes() const { return 1 + 2 * ECSecretBytes(); }
+  size_t PublicKeyBytes() const {
+    return ECShareBytes() +
+           (IsP384() ? MLKEM1024_PUBLIC_KEY_BYTES : MLKEM768_PUBLIC_KEY_BYTES);
+  }
+  size_t CiphertextBytes() const {
+    return ECShareBytes() +
+           (IsP384() ? MLKEM1024_CIPHERTEXT_BYTES : MLKEM768_CIPHERTEXT_BYTES);
+  }
+
+  void SetUp() override {
+    client_ctx_.reset(SSL_CTX_new(TLS_method()));
+    server_ctx_.reset(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(client_ctx_);
+    ASSERT_TRUE(server_ctx_);
+    for (SSL_CTX *ctx : {client_ctx_.get(), server_ctx_.get()}) {
+      ASSERT_TRUE(SSL_CTX_set_min_proto_version(ctx, TLS1_3_VERSION));
+      ASSERT_TRUE(SSL_CTX_set_max_proto_version(ctx, TLS1_3_VERSION));
+    }
+    auto cert = GetTestCertificate();
+    auto key = GetTestKey();
+    ASSERT_TRUE(cert);
+    ASSERT_TRUE(key);
+    ASSERT_TRUE(SSL_CTX_use_certificate(server_ctx_.get(), cert.get()));
+    ASSERT_TRUE(SSL_CTX_use_PrivateKey(server_ctx_.get(), key.get()));
+    const uint16_t group = GetParam();
+    ASSERT_TRUE(SSL_CTX_set1_group_ids(server_ctx_.get(), &group, 1));
+    const uint16_t groups[] = {
+        SSL_GROUP_X25519_MLKEM768, SSL_GROUP_SECP256R1_MLKEM768,
+        SSL_GROUP_SECP384R1_MLKEM1024, SSL_GROUP_X25519, SSL_GROUP_SECP256R1,
+        SSL_GROUP_SECP384R1, SSL_GROUP_SECP521R1};
+    ASSERT_TRUE(SSL_CTX_set_client_hello_group_ids(client_ctx_.get(), groups,
+                                                  std::size(groups)));
+  }
+
+  UniquePtr<SSL_CTX> client_ctx_, server_ctx_;
+};
+
+INSTANTIATE_TEST_SUITE_P(
+    NISTCurves, SSLHybridGroupTest,
+    ::testing::Values(SSL_GROUP_SECP256R1_MLKEM768,
+                      SSL_GROUP_SECP384R1_MLKEM1024));
+
+TEST_P(SSLHybridGroupTest, NegotiatesSelectedGroupAndHelloRetryRequest) {
+  for (bool retry : {false, true}) {
+    SCOPED_TRACE(retry);
+    UniquePtr<SSL> client, server;
+    ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx_.get(),
+                                      server_ctx_.get()));
+    const uint16_t group = GetParam();
+    const uint16_t initial[] = {SSL_GROUP_X25519_MLKEM768, SSL_GROUP_X25519};
+    ASSERT_TRUE(SSL_set1_client_key_shares(
+        client.get(), retry ? initial : &group, retry ? std::size(initial) : 1));
+    ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+    EXPECT_EQ(SSL_get_group_id(client.get()), group);
+    EXPECT_EQ(SSL_get_group_id(server.get()), group);
+    EXPECT_EQ(client->s3->used_hello_retry_request, retry);
+    EXPECT_EQ(server->s3->used_hello_retry_request, retry);
+    EXPECT_EQ(SSL_get_negotiated_group(client.get()),
+              IsP384() ? NID_SecP384r1MLKEM1024 : NID_SecP256r1MLKEM768);
+
+    static const uint8_t message[] = {1, 2, 3, 4};
+    uint8_t received[sizeof(message)];
+    ASSERT_EQ(SSL_write(client.get(), message, sizeof(message)),
+              int(sizeof(message)));
+    ASSERT_EQ(SSL_read(server.get(), received, sizeof(received)),
+              int(sizeof(received)));
+    EXPECT_EQ(Bytes(received), Bytes(message));
+    ASSERT_EQ(SSL_write(server.get(), message, sizeof(message)),
+              int(sizeof(message)));
+    ASSERT_EQ(SSL_read(client.get(), received, sizeof(received)),
+              int(sizeof(received)));
+    EXPECT_EQ(Bytes(received), Bytes(message));
+  }
+}
+
+TEST_P(SSLHybridGroupTest, TLS12RejectsHybridGroups) {
+  for (SSL_CTX *ctx : {client_ctx_.get(), server_ctx_.get()}) {
+    ASSERT_TRUE(SSL_CTX_set_min_proto_version(ctx, TLS1_2_VERSION));
+    ASSERT_TRUE(SSL_CTX_set_max_proto_version(ctx, TLS1_2_VERSION));
+    // A static-RSA fallback would not exercise group selection at all.
+    ASSERT_TRUE(SSL_CTX_set_strict_cipher_list(
+        ctx, "ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES128-GCM-SHA256"));
+  }
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx_.get(),
+                                    server_ctx_.get()));
+  EXPECT_FALSE(CompleteHandshakes(client.get(), server.get()));
+  EXPECT_FALSE(SSL_is_init_finished(client.get()));
+  EXPECT_FALSE(SSL_is_init_finished(server.get()));
+  ERR_clear_error();
+}
+
+TEST_P(SSLHybridGroupTest, WireAndSecretEncoding) {
+  // Independent primitive-level peers use the fixed EC scalar one and fixed
+  // ML-KEM seed/encapsulation entropy. In particular, two implementations with
+  // the same accidental concatenation reversal cannot make this test pass.
+  const char *name = IsP384() ? "SecP384r1MLKEM1024" : "SecP256r1MLKEM768";
+  const int nid = IsP384() ? NID_SecP384r1MLKEM1024 : NID_SecP256r1MLKEM768;
+  EXPECT_STREQ(SSL_get_group_name(GetParam()), name);
+  EXPECT_EQ(OBJ_sn2nid(name), nid);
+  EXPECT_EQ(OBJ_ln2nid(name), nid);
+  EXPECT_STREQ(OBJ_nid2sn(nid), name);
+
+  uint8_t seed[MLKEM_SEED_BYTES], entropy[BCM_MLKEM_ENCAP_ENTROPY];
+  for (size_t i = 0; i < sizeof(seed); i++) {
+    seed[i] = static_cast<uint8_t>(i);
+  }
+  for (size_t i = 0; i < sizeof(entropy); i++) {
+    entropy[i] = static_cast<uint8_t>(0xa0 + i);
+  }
+  union {
+    MLKEM768_private_key p768;
+    MLKEM1024_private_key p1024;
+  } peer_private;
+  ScopedCBB peer_public;
+  ASSERT_TRUE(CBB_init(peer_public.get(), PublicKeyBytes()));
+  ASSERT_TRUE(EC_POINT_point2cbb(peer_public.get(), Curve(),
+                                EC_GROUP_get0_generator(Curve()),
+                                POINT_CONVERSION_UNCOMPRESSED, nullptr));
+  uint8_t *encoded_public;
+  ASSERT_TRUE(CBB_add_space(peer_public.get(), &encoded_public,
+                            PublicKeyBytes() - ECShareBytes()));
+  if (IsP384()) {
+    BCM_mlkem1024_generate_key_external_seed(encoded_public,
+                                             &peer_private.p1024, seed);
+  } else {
+    BCM_mlkem768_generate_key_external_seed(encoded_public,
+                                            &peer_private.p768, seed);
+  }
+
+  auto server = SSLKeyShare::Create(GetParam());
+  ASSERT_TRUE(server);
+  EXPECT_EQ(server->GroupID(), GetParam());
+  ScopedCBB server_ciphertext;
+  ASSERT_TRUE(CBB_init(server_ciphertext.get(), CiphertextBytes()));
+  Array<uint8_t> server_secret;
+  uint8_t alert = 0;
+  ASSERT_TRUE(server->Encap(server_ciphertext.get(), &server_secret, &alert,
+                           Span(CBB_data(peer_public.get()),
+                                CBB_len(peer_public.get()))));
+  const auto ciphertext = Span(CBB_data(server_ciphertext.get()),
+                               CBB_len(server_ciphertext.get()));
+  ASSERT_EQ(ciphertext.size(), CiphertextBytes());
+  ASSERT_EQ(server_secret.size(), ECSecretBytes() + MLKEM_SHARED_SECRET_BYTES);
+  ASSERT_EQ(ciphertext[0], POINT_CONVERSION_UNCOMPRESSED);
+  // With scalar one, ECDH is exactly the peer public point's x-coordinate.
+  EXPECT_EQ(Bytes(MakeConstSpan(server_secret).first(ECSecretBytes())),
+            Bytes(ciphertext.subspan(1, ECSecretBytes())));
+  uint8_t mlkem_secret[MLKEM_SHARED_SECRET_BYTES];
+  if (IsP384()) {
+    ASSERT_TRUE(MLKEM1024_decap(mlkem_secret,
+                              ciphertext.data() + ECShareBytes(),
+                              MLKEM1024_CIPHERTEXT_BYTES,
+                              &peer_private.p1024));
+  } else {
+    ASSERT_TRUE(MLKEM768_decap(mlkem_secret,
+                             ciphertext.data() + ECShareBytes(),
+                             MLKEM768_CIPHERTEXT_BYTES, &peer_private.p768));
+  }
+  EXPECT_EQ(Bytes(MakeConstSpan(server_secret).subspan(ECSecretBytes())),
+            Bytes(mlkem_secret));
+
+  auto client = SSLKeyShare::Create(GetParam());
+  ASSERT_TRUE(client);
+  ScopedCBB client_public, peer_ciphertext;
+  ASSERT_TRUE(CBB_init(client_public.get(), PublicKeyBytes()));
+  ASSERT_TRUE(client->Generate(client_public.get()));
+  const auto public_key = Span(CBB_data(client_public.get()),
+                               CBB_len(client_public.get()));
+  ASSERT_EQ(public_key.size(), PublicKeyBytes());
+  ASSERT_EQ(public_key[0], POINT_CONVERSION_UNCOMPRESSED);
+  ASSERT_TRUE(CBB_init(peer_ciphertext.get(), CiphertextBytes()));
+  ASSERT_TRUE(EC_POINT_point2cbb(peer_ciphertext.get(), Curve(),
+                                EC_GROUP_get0_generator(Curve()),
+                                POINT_CONVERSION_UNCOMPRESSED, nullptr));
+  uint8_t *encoded_ciphertext;
+  ASSERT_TRUE(CBB_add_space(peer_ciphertext.get(), &encoded_ciphertext,
+                            CiphertextBytes() - ECShareBytes()));
+  CBS mlkem_public;
+  CBS_init(&mlkem_public, public_key.data() + ECShareBytes(),
+           public_key.size() - ECShareBytes());
+  if (IsP384()) {
+    MLKEM1024_public_key peer_key;
+    ASSERT_TRUE(MLKEM1024_parse_public_key(&peer_key, &mlkem_public));
+    BCM_mlkem1024_encap_external_entropy(encoded_ciphertext, mlkem_secret,
+                                         &peer_key, entropy);
+  } else {
+    MLKEM768_public_key peer_key;
+    ASSERT_TRUE(MLKEM768_parse_public_key(&peer_key, &mlkem_public));
+    BCM_mlkem768_encap_external_entropy(encoded_ciphertext, mlkem_secret,
+                                        &peer_key, entropy);
+  }
+  Array<uint8_t> client_secret;
+  ASSERT_TRUE(client->Decap(&client_secret, &alert,
+                           Span(CBB_data(peer_ciphertext.get()),
+                                CBB_len(peer_ciphertext.get()))));
+  ASSERT_EQ(client_secret.size(), ECSecretBytes() + MLKEM_SHARED_SECRET_BYTES);
+  EXPECT_EQ(Bytes(MakeConstSpan(client_secret).first(ECSecretBytes())),
+            Bytes(public_key.subspan(1, ECSecretBytes())));
+  EXPECT_EQ(Bytes(MakeConstSpan(client_secret).subspan(ECSecretBytes())),
+            Bytes(mlkem_secret));
+}
