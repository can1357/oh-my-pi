+TEST_P(SSLHybridGroupTest, RejectsMalformedShares) {
+  auto client = SSLKeyShare::Create(GetParam());
+  auto server = SSLKeyShare::Create(GetParam());
+  ASSERT_TRUE(client);
+  ASSERT_TRUE(server);
+  ScopedCBB public_key, ciphertext;
+  ASSERT_TRUE(CBB_init(public_key.get(), PublicKeyBytes()));
+  ASSERT_TRUE(CBB_init(ciphertext.get(), CiphertextBytes()));
+  ASSERT_TRUE(client->Generate(public_key.get()));
+  const auto public_bytes = Span(CBB_data(public_key.get()),
+                                 CBB_len(public_key.get()));
+  Array<uint8_t> server_secret;
+  uint8_t alert = 0;
+  ASSERT_TRUE(server->Encap(ciphertext.get(), &server_secret, &alert,
+                           public_bytes));
+  const auto ciphertext_bytes = Span(CBB_data(ciphertext.get()),
+                                     CBB_len(ciphertext.get()));
+  ASSERT_EQ(public_bytes.size(), PublicKeyBytes());
+  ASSERT_EQ(ciphertext_bytes.size(), CiphertextBytes());
+
+  for (int mutation = 0; mutation < 7; mutation++) {
+    SCOPED_TRACE(mutation);
+    std::vector<uint8_t> bad(public_bytes.begin(), public_bytes.end());
+    switch (mutation) {
+      case 0: bad.clear(); break;
+      case 1: bad.pop_back(); break;
+      case 2: bad.push_back(0); break;
+      case 3: bad[0] = 0; break;  // Infinity is not a valid TLS EC point.
+      case 4: bad[0] = 2; break;  // Compressed points are not allowed.
+      case 5:
+        // The all-zero affine point is off-curve for both NIST curves.
+        std::fill(bad.begin() + 1, bad.begin() + ECShareBytes(), 0);
+        break;
+      case 6:
+        // An encoded ML-KEM coefficient of 4095 fails the modulus check.
+        bad[ECShareBytes()] = 0xff;
+        bad[ECShareBytes() + 1] |= 0x0f;
+        break;
+    }
+    auto rejecting_server = SSLKeyShare::Create(GetParam());
+    ASSERT_TRUE(rejecting_server);
+    ScopedCBB ignored_ciphertext;
+    ASSERT_TRUE(CBB_init(ignored_ciphertext.get(), 0));
+    Array<uint8_t> ignored_secret;
+    alert = 0;
+    EXPECT_FALSE(rejecting_server->Encap(ignored_ciphertext.get(),
+                                         &ignored_secret, &alert, bad));
+    EXPECT_EQ(alert, SSL_AD_ILLEGAL_PARAMETER);
+    ERR_clear_error();
+  }
+
+  for (int mutation = 0; mutation < 6; mutation++) {
+    SCOPED_TRACE(mutation);
+    std::vector<uint8_t> bad(ciphertext_bytes.begin(), ciphertext_bytes.end());
+    switch (mutation) {
+      case 0: bad.clear(); break;
+      case 1: bad.pop_back(); break;
+      case 2: bad.push_back(0); break;
+      case 3: bad[0] = 0; break;
+      case 4: bad[0] = 2; break;
+      case 5:
+        std::fill(bad.begin() + 1, bad.begin() + ECShareBytes(), 0);
+        break;
+    }
+    Array<uint8_t> ignored_secret;
+    alert = 0;
+    EXPECT_FALSE(client->Decap(&ignored_secret, &alert, bad));
+    EXPECT_EQ(alert, SSL_AD_ILLEGAL_PARAMETER);
+    ERR_clear_error();
+  }
+
+  // Correct-length invalid ML-KEM ciphertexts must NOT expose a failure oracle.
+  // They implicitly reject to a deterministic, unrelated KEM secret instead.
+  std::vector<uint8_t> bad(ciphertext_bytes.begin(), ciphertext_bytes.end());
+  bad[ECShareBytes()] ^= 0x80;
+  Array<uint8_t> rejected, repeated;
+  ASSERT_TRUE(client->Decap(&rejected, &alert, bad));
+  ASSERT_TRUE(client->Decap(&repeated, &alert, bad));
+  ASSERT_EQ(rejected.size(), server_secret.size());
+  EXPECT_EQ(Bytes(rejected), Bytes(repeated));
+  EXPECT_EQ(Bytes(MakeConstSpan(rejected).first(ECSecretBytes())),
+            Bytes(MakeConstSpan(server_secret).first(ECSecretBytes())));
+  EXPECT_NE(Bytes(MakeConstSpan(rejected).subspan(ECSecretBytes())),
+            Bytes(MakeConstSpan(server_secret).subspan(ECSecretBytes())));
+}
