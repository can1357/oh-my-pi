+// RFC 10024, sections 4.1-4.3. Unlike X25519MLKEM768, these two
+// groups put ECDHE first in the client share, server share, and shared secret.
+// P-256: 65 + 1184 byte client, 65 + 1088 byte server, 32 + 32 byte secret.
+// P-384: 97 + 1568 byte client, 97 + 1568 byte server, 48 + 32 byte secret.
+// The existing TLS 1.3 key schedule consumes the concatenated secret unchanged.
+template <uint16_t kGroupID>
+class ECMLKEMKeyShare : public SSLKeyShare {
+  static_assert(kGroupID == SSL_GROUP_SECP256R1_MLKEM768 ||
+                kGroupID == SSL_GROUP_SECP384R1_MLKEM1024);
+  static constexpr bool kIsP384 = kGroupID == SSL_GROUP_SECP384R1_MLKEM1024;
+  static constexpr size_t kECSecretBytes = kIsP384 ? 48 : 32;
+  static constexpr size_t kECShareBytes = 1 + 2 * kECSecretBytes;
+  static constexpr size_t kPublicKeyBytes =
+      kIsP384 ? MLKEM1024_PUBLIC_KEY_BYTES : MLKEM768_PUBLIC_KEY_BYTES;
+  static constexpr size_t kCiphertextBytes =
+      kIsP384 ? MLKEM1024_CIPHERTEXT_BYTES : MLKEM768_CIPHERTEXT_BYTES;
+  using PublicKey =
+      std::conditional_t<kIsP384, MLKEM1024_public_key, MLKEM768_public_key>;
+  using PrivateKey =
+      std::conditional_t<kIsP384, MLKEM1024_private_key, MLKEM768_private_key>;
+
+ public:
+  ECMLKEMKeyShare()
+      : ecdh_(kIsP384 ? EC_group_p384() : EC_group_p256(),
+              kIsP384 ? SSL_GROUP_SECP384R1 : SSL_GROUP_SECP256R1) {}
+
+  uint16_t GroupID() const override { return kGroupID; }
+
+  bool Generate(CBB *out) override {
+    uint8_t *public_key;
+    if (!ecdh_.Generate(out) ||
+        !CBB_add_space(out, &public_key, kPublicKeyBytes)) {
+      return false;
+    }
+    if constexpr (kIsP384) {
+      MLKEM1024_generate_key(public_key, /*optional_out_seed=*/nullptr,
+                             &private_key_);
+    } else {
+      MLKEM768_generate_key(public_key, /*optional_out_seed=*/nullptr,
+                            &private_key_);
+    }
+    return true;
+  }
+
+  bool Encap(CBB *out_ciphertext, Array<uint8_t> *out_secret,
+             uint8_t *out_alert, Span<const uint8_t> peer_key) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (peer_key.size() != kECShareBytes + kPublicKeyBytes) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+
+    PublicKey public_key;
+    CBS public_key_cbs;
+    CBS_init(&public_key_cbs, peer_key.data() + kECShareBytes, kPublicKeyBytes);
+    int ok;
+    if constexpr (kIsP384) {
+      ok = MLKEM1024_parse_public_key(&public_key, &public_key_cbs);
+    } else {
+      ok = MLKEM768_parse_public_key(&public_key, &public_key_cbs);
+    }
+    // Parsing includes the FIPS 203 encapsulation-key modulus check.
+    if (!ok) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+
+    Array<uint8_t> secret;
+    uint8_t *ciphertext;
+    if (!secret.InitForOverwrite(kECSecretBytes + MLKEM_SHARED_SECRET_BYTES) ||
+        !ecdh_.Generate(out_ciphertext) ||
+        !ecdh_.DecapTo(MakeSpan(secret).first(kECSecretBytes), out_alert,
+                      peer_key.first(kECShareBytes)) ||
+        !CBB_add_space(out_ciphertext, &ciphertext, kCiphertextBytes)) {
+      return false;
+    }
+    if constexpr (kIsP384) {
+      MLKEM1024_encap(ciphertext, secret.data() + kECSecretBytes, &public_key);
+    } else {
+      MLKEM768_encap(ciphertext, secret.data() + kECSecretBytes, &public_key);
+    }
+    *out_secret = std::move(secret);
+    return true;
+  }
+
+  bool Decap(Array<uint8_t> *out_secret, uint8_t *out_alert,
+             Span<const uint8_t> ciphertext) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (ciphertext.size() != kECShareBytes + kCiphertextBytes) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+
+    Array<uint8_t> secret;
+    if (!secret.InitForOverwrite(kECSecretBytes + MLKEM_SHARED_SECRET_BYTES) ||
+        !ecdh_.DecapTo(MakeSpan(secret).first(kECSecretBytes), out_alert,
+                      ciphertext.first(kECShareBytes))) {
+      return false;
+    }
+    int ok;
+    if constexpr (kIsP384) {
+      ok = MLKEM1024_decap(secret.data() + kECSecretBytes,
+                           ciphertext.data() + kECShareBytes, kCiphertextBytes,
+                           &private_key_);
+    } else {
+      ok = MLKEM768_decap(secret.data() + kECSecretBytes,
+                          ciphertext.data() + kECShareBytes, kCiphertextBytes,
+                          &private_key_);
+    }
+    // ML-KEM implicitly rejects invalid, correctly-sized ciphertexts with an
+    // unrelated secret. TLS's authenticated records detect this; do not add a
+    // decapsulation oracle. Lengths were checked above, so other failures are
+    // internal errors, as required by RFC 10024 section 4.2.
+    if (!ok) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    *out_secret = std::move(secret);
+    return true;
+  }
+
+ private:
+  ECKeyShare ecdh_;
+  PrivateKey private_key_;
+};
