+// Locate the server's key_share in an unencrypted ServerHello and change only
+// its ML-KEM ciphertext. All TLS lengths, group IDs, and EC points stay valid.
+static bool CorruptHybridServerCiphertext(Span<uint8_t> flight, uint16_t group,
+                                         size_t ec_share_bytes) {
+  CBS records;
+  CBS_init(&records, flight.data(), flight.size());
+  while (CBS_len(&records) != 0) {
+    uint8_t type;
+    uint16_t version;
+    CBS record;
+    if (!CBS_get_u8(&records, &type) || !CBS_get_u16(&records, &version) ||
+        !CBS_get_u16_length_prefixed(&records, &record)) {
+      return false;
+    }
+    if (type != SSL3_RT_HANDSHAKE) {
+      continue;
+    }
+    CBS hello, session_id, extensions;
+    if (!CBS_get_u8(&record, &type) || type != SSL3_MT_SERVER_HELLO ||
+        !CBS_get_u24_length_prefixed(&record, &hello) ||
+        !CBS_skip(&hello, 2 + SSL3_RANDOM_SIZE) ||
+        !CBS_get_u8_length_prefixed(&hello, &session_id) ||
+        !CBS_skip(&hello, 3) ||
+        !CBS_get_u16_length_prefixed(&hello, &extensions) || CBS_len(&hello)) {
+      return false;
+    }
+    while (CBS_len(&extensions) != 0) {
+      uint16_t extension;
+      CBS contents;
+      if (!CBS_get_u16(&extensions, &extension) ||
+          !CBS_get_u16_length_prefixed(&extensions, &contents)) {
+        return false;
+      }
+      if (extension == TLSEXT_TYPE_key_share) {
+        uint16_t selected_group;
+        CBS share;
+        if (!CBS_get_u16(&contents, &selected_group) ||
+            selected_group != group ||
+            !CBS_get_u16_length_prefixed(&contents, &share) ||
+            CBS_len(&contents) != 0 || CBS_len(&share) <= ec_share_bytes) {
+          return false;
+        }
+        const size_t offset = CBS_data(&share) - flight.data() + ec_share_bytes;
+        flight[offset] ^= 0x80;
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+TEST_P(SSLHybridGroupTest, CorruptedCiphertextFailsTLSAuthentication) {
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx_.get(),
+                                    server_ctx_.get()));
+  const uint16_t group = GetParam();
+  ASSERT_TRUE(SSL_set1_client_key_shares(client.get(), &group, 1));
+  int ret = SSL_do_handshake(client.get());
+  ASSERT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_WANT_READ);
+  ret = SSL_do_handshake(server.get());
+  ASSERT_EQ(SSL_get_error(server.get(), ret), SSL_ERROR_WANT_READ);
+
+  std::vector<uint8_t> flight(BIO_ctrl_pending(SSL_get_rbio(client.get())));
+  ASSERT_FALSE(flight.empty());
+  ASSERT_EQ(BIO_read(SSL_get_rbio(client.get()), flight.data(), flight.size()),
+            int(flight.size()));
+  ASSERT_TRUE(CorruptHybridServerCiphertext(MakeSpan(flight), group,
+                                           ECShareBytes()));
+  ASSERT_EQ(BIO_write(SSL_get_wbio(server.get()), flight.data(), flight.size()),
+            int(flight.size()));
+  ret = SSL_do_handshake(client.get());
+  ASSERT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_SSL);
+  EXPECT_TRUE(ErrorEquals(ERR_peek_last_error(), ERR_LIB_SSL,
+                         SSL_R_DECRYPTION_FAILED_OR_BAD_RECORD_MAC));
+  EXPECT_FALSE(SSL_is_init_finished(client.get()));
+  EXPECT_FALSE(SSL_is_init_finished(server.get()));
+  ERR_clear_error();
+}
