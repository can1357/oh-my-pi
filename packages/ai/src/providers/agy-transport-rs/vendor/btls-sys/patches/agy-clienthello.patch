+                                  SSL_SIGN_RSA_PKCS1_SHA1};
+  ASSERT_TRUE(SSL_CTX_set_client_hello_group_ids(ctx.get(), groups,
+                                                std::size(groups)));
+  ASSERT_TRUE(SSL_CTX_set_client_hello_sigalgs(ctx.get(), sigalgs,
+                                              std::size(sigalgs)));
+  ASSERT_TRUE(SSL_CTX_set_client_hello_cert_sigalgs(
+      ctx.get(), cert_sigalgs, std::size(cert_sigalgs)));
+  const uint16_t supported[] = {SSL_GROUP_X25519_MLKEM768, SSL_GROUP_X25519};
+  const uint16_t verifiable[] = {SSL_SIGN_ECDSA_SECP256R1_SHA256};
+  EXPECT_THAT(ctx->supported_group_list, ElementsAreArray(supported));
+  EXPECT_THAT(ctx->verify_sigalgs, ElementsAreArray(verifiable));
+
+  const uint16_t unknown_group = 0x11eb, unknown_sigalg = 0x0904;
+  EXPECT_FALSE(SSL_CTX_set1_group_ids(ctx.get(), &unknown_group, 1));
+  ERR_clear_error();
+  EXPECT_FALSE(SSL_CTX_set_verify_algorithm_prefs(ctx.get(), &unknown_sigalg, 1));
+  ERR_clear_error();
+  EXPECT_FALSE(SSL_CTX_set_client_hello_group_ids(ctx.get(), &unknown_group, 1));
+  ERR_clear_error();
+  EXPECT_FALSE(SSL_CTX_set_client_hello_sigalgs(ctx.get(), &unknown_sigalg, 1));
+  ERR_clear_error();
+
+  const uint16_t order[] = {TLSEXT_TYPE_signature_algorithms_cert,
+                            TLSEXT_TYPE_signature_algorithms,
+                            TLSEXT_TYPE_supported_groups};
+  ASSERT_TRUE(SSL_CTX_set_extension_order(ctx.get(), order, std::size(order)));
+  SSL_CTX_set_permute_extensions(ctx.get(), 0);
+  bssl::UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  EXPECT_EQ(SSL_VERIFY_PEER, SSL_get_verify_mode(ssl.get()));
+  EXPECT_THAT(ssl->config->supported_group_list, ElementsAreArray(supported));
+  EXPECT_THAT(ssl->config->verify_sigalgs, ElementsAreArray(verifiable));
+  std::vector<uint8_t> hello;
+  ASSERT_TRUE(GetClientHello(ssl.get(), &hello));
+  SSL_CLIENT_HELLO parsed;
+  auto body = Span(hello).subspan(SSL3_RT_HEADER_LENGTH + SSL3_HM_HEADER_LENGTH);
+  ASSERT_TRUE(SSL_parse_client_hello(ssl.get(), &parsed, body.data(), body.size()));
+  auto expect_vector = [&](uint16_t type, Span<const uint16_t> expected) {
+    const uint8_t *data;
+    size_t len;
+    ASSERT_TRUE(SSL_early_callback_ctx_extension_get(&parsed, type, &data, &len));
+    CBS extension, values;
+    CBS_init(&extension, data, len);
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&extension, &values));
+    EXPECT_EQ(0u, CBS_len(&extension));
+    for (uint16_t expected_id : expected) {
+      uint16_t id;
+      ASSERT_TRUE(CBS_get_u16(&values, &id));
+      EXPECT_EQ(expected_id, id);
+    }
+    EXPECT_EQ(0u, CBS_len(&values));
+  };
+  expect_vector(TLSEXT_TYPE_supported_groups, groups);
+  expect_vector(TLSEXT_TYPE_signature_algorithms, sigalgs);
+  expect_vector(TLSEXT_TYPE_signature_algorithms_cert, cert_sigalgs);
+
+  CBS extensions;
+  CBS_init(&extensions, parsed.extensions, parsed.extensions_len);
+  for (uint16_t expected_type : order) {
+    uint16_t type;
+    CBS extension;
+    ASSERT_TRUE(CBS_get_u16(&extensions, &type));
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &extension));
+    EXPECT_EQ(expected_type, type);
+  }
+  EXPECT_FALSE(tls1_check_group_id(ssl->s3->hs.get(), unknown_group));
+  bssl::UniquePtr<EVP_PKEY> key(EVP_PKEY_new());
+  ASSERT_TRUE(key);
+  uint8_t alert = 0;
+  EXPECT_FALSE(tls12_check_peer_sigalg(ssl->s3->hs.get(), &alert,
+                                      unknown_sigalg, key.get()));
+  EXPECT_EQ(SSL_AD_ILLEGAL_PARAMETER, alert);
+  ERR_clear_error();
+}
