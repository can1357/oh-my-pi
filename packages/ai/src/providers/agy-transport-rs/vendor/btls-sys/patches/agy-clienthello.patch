+TEST(SSLTest, ClientHelloTLS13CiphersLast) {
+  for (bool last : {false, true}) {
+    SCOPED_TRACE(last);
+    bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    SSL_CTX_set_preserve_tls13_cipher_list(ctx.get(), 1);
+    ASSERT_TRUE(SSL_CTX_set_cipher_list(
+        ctx.get(), "ECDHE-RSA-AES128-GCM-SHA256:TLS_AES_128_GCM_SHA256"));
+    SSL_CTX_set_tls13_ciphers_last(ctx.get(), last);
+    bssl::UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    std::vector<uint8_t> hello;
+    ASSERT_TRUE(GetClientHello(ssl.get(), &hello));
+    SSL_CLIENT_HELLO parsed;
+    auto body = Span(hello).subspan(SSL3_RT_HEADER_LENGTH + SSL3_HM_HEADER_LENGTH);
+    ASSERT_TRUE(
+        SSL_parse_client_hello(ssl.get(), &parsed, body.data(), body.size()));
+    CBS ciphers;
+    CBS_init(&ciphers, parsed.cipher_suites, parsed.cipher_suites_len);
+    uint16_t first, second;
+    ASSERT_TRUE(CBS_get_u16(&ciphers, &first));
+    ASSERT_TRUE(CBS_get_u16(&ciphers, &second));
+    EXPECT_EQ(last ? 0xc02f : 0x1301, first);
+    EXPECT_EQ(last ? 0x1301 : 0xc02f, second);
+    EXPECT_EQ(0u, CBS_len(&ciphers));
+  }
+}
