+int SSL_CTX_set_client_hello_sigalgs(SSL_CTX *ctx, const uint16_t *ids,
+                                   size_t num_ids) {
+  if (num_ids > 32766) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_INVALID_SIGNATURE_ALGORITHM);
+    return 0;
+  }
+  Array<uint16_t> wire, supported;
+  if (!wire.CopyFrom(Span(ids, num_ids)) ||
+      !supported.InitForOverwrite(num_ids)) {
+    return 0;
+  }
+  size_t count = 0;
+  for (uint16_t id : wire) {
+    if (id != SSL_SIGN_RSA_PKCS1_MD5_SHA1 &&
+        get_signature_algorithm(id) != nullptr) {
+      supported[count++] = id;
+    }
+  }
+  supported.Shrink(count);
+  if (num_ids != 0 && supported.empty()) {
+    // An empty verification list means defaults, not "reject everything".
+    OPENSSL_PUT_ERROR(SSL, SSL_R_INVALID_SIGNATURE_ALGORITHM);
+    return 0;
+  }
+  ctx->verify_sigalgs = std::move(supported);
+  ctx->client_hello_sigalgs = std::move(wire);
+  return 1;
+}
