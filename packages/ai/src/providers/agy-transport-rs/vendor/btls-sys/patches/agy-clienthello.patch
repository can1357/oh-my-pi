+int SSL_CTX_set_client_hello_group_ids(SSL_CTX *ctx, const uint16_t *ids,
+                                     size_t num_ids) {
+  if (num_ids > 32766) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_UNSUPPORTED_ELLIPTIC_CURVE);
+    return 0;
+  }
+  const auto advertised = Span(ids, num_ids);
+  if (!check_no_duplicates(advertised)) {
+    return 0;
+  }
+  Array<uint16_t> wire, supported;
+  if (!wire.CopyFrom(advertised) || !supported.InitForOverwrite(num_ids)) {
+    return 0;
+  }
+  size_t count = 0;
+  for (uint16_t id : advertised) {
+    if (ssl_group_id_to_nid(id) != NID_undef) {
+      supported[count++] = id;
+    }
+  }
+  supported.Shrink(count);
+  if (advertised.empty()) {
+    if (!supported.CopyFrom(DefaultSupportedGroupIds())) {
+      return 0;
+    }
+  } else if (supported.empty()) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_UNSUPPORTED_ELLIPTIC_CURVE);
+    return 0;
+  }
+  ctx->supported_group_list = std::move(supported);
+  ctx->client_hello_group_ids = std::move(wire);
+  return 1;
+}
