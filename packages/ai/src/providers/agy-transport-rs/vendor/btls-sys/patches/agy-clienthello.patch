+      ssl->config->compliance_policy == ssl_compliance_policy_cnsa_202407
+          ? Span<const uint16_t>(kCiphersCNSA)
+          : (has_aes_hw ? Span<const uint16_t>(kCiphersAESHardware)
+                        : Span<const uint16_t>(kCiphersNoAESHardware));
