+
+struct MLDSAX509TestParam {
+  const EVP_PKEY_ALG *(*algorithm)();
+  int nid;
+  size_t signature_len;
+};
+
+static const MLDSAX509TestParam kMLDSAX509TestParams[] = {
+    {EVP_pkey_ml_dsa_44, NID_ML_DSA_44, MLDSA44_SIGNATURE_BYTES},
+    {EVP_pkey_ml_dsa_65, NID_ML_DSA_65, MLDSA65_SIGNATURE_BYTES},
+    {EVP_pkey_ml_dsa_87, NID_ML_DSA_87, MLDSA87_SIGNATURE_BYTES},
+};
+
+static bssl::UniquePtr<EVP_PKEY> MakeMLDSAX509TestKey(const EVP_PKEY_ALG *alg,
+                                                     uint8_t seed_byte) {
+  uint8_t seed[MLDSA_SEED_BYTES] = {seed_byte};
+  return bssl::UniquePtr<EVP_PKEY>(
+      EVP_PKEY_from_private_seed(alg, seed, sizeof(seed)));
+}
+
+TEST(X509Test, MLDSAChainVerification) {
+  for (const auto &t : kMLDSAX509TestParams) {
+    SCOPED_TRACE(t.nid);
+    auto root_key = MakeMLDSAX509TestKey(t.algorithm(), 1);
+    auto intermediate_key = MakeMLDSAX509TestKey(t.algorithm(), 2);
+    auto leaf_key = MakeMLDSAX509TestKey(t.algorithm(), 3);
+    ASSERT_TRUE(root_key);
+    ASSERT_TRUE(intermediate_key);
+    ASSERT_TRUE(leaf_key);
+    auto root = MakeTestCert("Root", "Root", root_key.get(), /*is_ca=*/true);
+    auto intermediate = MakeTestCert("Root", "Intermediate",
+                                     intermediate_key.get(), /*is_ca=*/true);
+    auto leaf = MakeTestCert("Intermediate", "Leaf", leaf_key.get(),
+                             /*is_ca=*/false);
+    ASSERT_TRUE(root);
+    ASSERT_TRUE(intermediate);
+    ASSERT_TRUE(leaf);
+    ASSERT_TRUE(AddKeyUsage(root.get(), {KeyUsage::kKeyCertSign}));
+    ASSERT_TRUE(AddKeyUsage(intermediate.get(), {KeyUsage::kKeyCertSign}));
+    ASSERT_TRUE(AddKeyUsage(leaf.get(), {KeyUsage::kDigitalSignature}));
+    ASSERT_TRUE(AddExtendedKeyUsage(leaf.get(), {NID_server_auth}));
+    ASSERT_TRUE(X509_sign(root.get(), root_key.get(), nullptr));
+    ASSERT_TRUE(X509_sign(intermediate.get(), root_key.get(), nullptr));
+    ASSERT_TRUE(X509_sign(leaf.get(), intermediate_key.get(), nullptr));
+
+    // Force DER decoding, including each issuer's SubjectPublicKeyInfo. Merely
+    // verifying an in-memory EVP_PKEY would miss the default decoder allow-list.
+    root = ReencodeCertificate(root.get());
+    intermediate = ReencodeCertificate(intermediate.get());
+    leaf = ReencodeCertificate(leaf.get());
+    ASSERT_TRUE(root);
+    ASSERT_TRUE(intermediate);
+    ASSERT_TRUE(leaf);
+    for (X509 *cert : {root.get(), intermediate.get(), leaf.get()}) {
+      ASSERT_NE(nullptr, X509_get0_pubkey(cert));
+      EXPECT_EQ(t.nid, EVP_PKEY_id(X509_get0_pubkey(cert)));
+      EXPECT_EQ(t.nid, X509_get_signature_nid(cert));
+      const ASN1_BIT_STRING *sig;
+      const X509_ALGOR *alg;
+      X509_get0_signature(&sig, &alg, cert);
+      EXPECT_EQ(t.signature_len, static_cast<size_t>(ASN1_STRING_length(sig)));
+      EXPECT_EQ(nullptr, alg->parameter);
+      EXPECT_EQ(nullptr, X509_get0_tbs_sigalg(cert)->parameter);
+    }
+    EXPECT_EQ(X509_V_OK, Verify(leaf.get(), {root.get()}, {intermediate.get()},
+                                {}, X509_V_FLAG_CHECK_SS_SIGNATURE));
+
+    // A one-byte corruption, a truncation, and an overlong signature must each
+    // fail for both the leaf and intermediate, not merely fail DER parsing.
+    for (bool tamper_leaf : {true, false}) {
+      X509 *original = tamper_leaf ? leaf.get() : intermediate.get();
+      const ASN1_BIT_STRING *sig;
+      X509_get0_signature(&sig, nullptr, original);
+      const uint8_t *bytes = ASN1_STRING_get0_data(sig);
+      for (int mutation = 0; mutation < 3; mutation++) {
+        SCOPED_TRACE(tamper_leaf);
+        SCOPED_TRACE(mutation);
+        std::vector<uint8_t> bad_sig(bytes, bytes + t.signature_len);
+        if (mutation == 0) {
+          bad_sig[0] ^= 1;
+        } else if (mutation == 1) {
+          bad_sig.pop_back();
+        } else {
+          bad_sig.push_back(0);
+        }
+        bssl::UniquePtr<X509> bad(X509_dup(original));
+        ASSERT_TRUE(bad);
+        ASSERT_TRUE(X509_set1_signature_value(bad.get(), bad_sig.data(),
+                                              bad_sig.size()));
+        bad = ReencodeCertificate(bad.get());
+        ASSERT_TRUE(bad);
+        EXPECT_EQ(X509_V_ERR_CERT_SIGNATURE_FAILURE,
+                  Verify(tamper_leaf ? bad.get() : leaf.get(), {root.get()},
+                         {tamper_leaf ? intermediate.get() : bad.get()}, {}));
+        ERR_clear_error();
+      }
+    }
+  }
+}
