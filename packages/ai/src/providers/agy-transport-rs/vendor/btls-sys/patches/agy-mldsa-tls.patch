+    const int public_key_len = ASN1_STRING_length(public_key);
+    bssl::UniquePtr<uint8_t> public_key_copy(static_cast<uint8_t *>(OPENSSL_memdup(
+        ASN1_STRING_get0_data(public_key), public_key_len)));
+    ASSERT_TRUE(public_key_copy);
+    ASSERT_TRUE(X509_PUBKEY_set0_param(
+        X509_get_X509_PUBKEY(cert.get()), OBJ_nid2obj(t.nid), V_ASN1_NULL,
+        nullptr, public_key_copy.release(), public_key_len));
+    ASSERT_TRUE(X509_sign(cert.get(), key.get(), nullptr));
+    cert = ReencodeCertificate(cert.get());
+    ASSERT_TRUE(cert);
+    EXPECT_EQ(nullptr, X509_get0_pubkey(cert.get()));
+    ERR_clear_error();
+  }
