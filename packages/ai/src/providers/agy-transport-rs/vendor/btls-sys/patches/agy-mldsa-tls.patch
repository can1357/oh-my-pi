+
+struct MLDSATestParam {
+  uint16_t sigalg;
+  const EVP_PKEY_ALG *(*algorithm)();
+  int key_type;
+  size_t signature_len;
+  const char *name;
+};
+
+static const MLDSATestParam kMLDSATestParams[] = {
+    {SSL_SIGN_ML_DSA_44, EVP_pkey_ml_dsa_44, EVP_PKEY_ML_DSA_44,
+     MLDSA44_SIGNATURE_BYTES, "mldsa44"},
+    {SSL_SIGN_ML_DSA_65, EVP_pkey_ml_dsa_65, EVP_PKEY_ML_DSA_65,
+     MLDSA65_SIGNATURE_BYTES, "mldsa65"},
+    {SSL_SIGN_ML_DSA_87, EVP_pkey_ml_dsa_87, EVP_PKEY_ML_DSA_87,
+     MLDSA87_SIGNATURE_BYTES, "mldsa87"},
+};
+
+static UniquePtr<EVP_PKEY> MakeMLDSATestKey(const EVP_PKEY_ALG *alg,
+                                           uint8_t seed_byte) {
+  uint8_t seed[MLDSA_SEED_BYTES] = {seed_byte};
+  return UniquePtr<EVP_PKEY>(EVP_PKEY_from_private_seed(alg, seed, sizeof(seed)));
+}
+
+static constexpr time_t kMLDSATestTime = 1700000000;
+
+static UniquePtr<X509> MakeMLDSATestCertificate(EVP_PKEY *key, X509 *issuer,
+                                                EVP_PKEY *issuer_key) {
+  const bool is_ca = issuer == nullptr;
+  const char *common_name = is_ca ? "ML-DSA test CA" : "mldsa.example";
+  UniquePtr<X509> cert(X509_new());
+  UniquePtr<X509_NAME> name(X509_NAME_new());
+  UniquePtr<BASIC_CONSTRAINTS> bc(BASIC_CONSTRAINTS_new());
+  UniquePtr<ASN1_BIT_STRING> usage(ASN1_BIT_STRING_new());
+  if (!cert || !name || !bc || !usage ||
+      !X509_NAME_add_entry_by_txt(
+          name.get(), "CN", MBSTRING_ASC,
+          reinterpret_cast<const uint8_t *>(common_name), -1, -1, 0) ||
+      !X509_set_version(cert.get(), X509_VERSION_3) ||
+      !ASN1_INTEGER_set(X509_get_serialNumber(cert.get()), is_ca ? 1 : 2) ||
+      !X509_set_subject_name(cert.get(), name.get()) ||
+      !X509_set_issuer_name(cert.get(),
+                            is_ca ? name.get() : X509_get_subject_name(issuer)) ||
+      !X509_set_pubkey(cert.get(), key) ||
+      !ASN1_TIME_adj(X509_getm_notBefore(cert.get()), kMLDSATestTime, -1, 0) ||
+      !ASN1_TIME_adj(X509_getm_notAfter(cert.get()), kMLDSATestTime, 1, 0) ||
+      !ASN1_BIT_STRING_set_bit(usage.get(), is_ca ? 5 : 0, 1)) {
+    return nullptr;
+  }
+  bc->ca = is_ca ? ASN1_BOOLEAN_TRUE : ASN1_BOOLEAN_FALSE;
+  if (X509_add1_ext_i2d(cert.get(), NID_basic_constraints, bc.get(),
+                        /*crit=*/1, /*flags=*/0) != 1 ||
+      X509_add1_ext_i2d(cert.get(), NID_key_usage, usage.get(),
+                        /*crit=*/1, /*flags=*/0) != 1) {
+    return nullptr;
+  }
+  if (!is_ca) {
+    UniquePtr<X509_EXTENSION> san(X509V3_EXT_nconf_nid(
+        nullptr, nullptr, NID_subject_alt_name, "DNS:mldsa.example"));
+    UniquePtr<X509_EXTENSION> eku(X509V3_EXT_nconf_nid(
+        nullptr, nullptr, NID_ext_key_usage, "serverAuth,clientAuth"));
+    if (!san || !eku || !X509_add_ext(cert.get(), san.get(), -1) ||
+        !X509_add_ext(cert.get(), eku.get(), -1)) {
+      return nullptr;
+    }
+  }
+  if (!X509_sign(cert.get(), issuer_key, nullptr)) {
+    return nullptr;
+  }
+  return cert;
+}
+
+TEST(SSLTest, MLDSAKeyBinding) {
+  static_assert(SSL_SIGN_ML_DSA_44 == 0x0904, "IANA mldsa44");
+  static_assert(SSL_SIGN_ML_DSA_65 == 0x0905, "IANA mldsa65");
+  static_assert(SSL_SIGN_ML_DSA_87 == 0x0906, "IANA mldsa87");
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  SSL_set_connect_state(ssl.get());
+  for (const auto &t : kMLDSATestParams) {
+    SCOPED_TRACE(t.name);
+    EXPECT_EQ(t.key_type, SSL_get_signature_algorithm_key_type(t.sigalg));
+    EXPECT_EQ(nullptr, SSL_get_signature_algorithm_digest(t.sigalg));
+    EXPECT_FALSE(SSL_is_signature_algorithm_rsa_pss(t.sigalg));
+    EXPECT_STREQ(t.name, SSL_get_signature_algorithm_name(t.sigalg, 1));
+    ASSERT_TRUE(SSL_CTX_set1_sigalgs_list(ctx.get(), t.name));
+    const int pair[] = {NID_undef, t.key_type};
+    ASSERT_TRUE(SSL_CTX_set1_sigalgs(ctx.get(), pair, std::size(pair)));
+    EXPECT_THAT(ctx->verify_sigalgs, ElementsAre(t.sigalg));
+
+    auto key = MakeMLDSATestKey(t.algorithm(), 1);
+    ASSERT_TRUE(key);
+    ScopedCBB spki;
+    ASSERT_TRUE(CBB_init(spki.get(), 0));
+    ASSERT_TRUE(EVP_marshal_public_key(spki.get(), key.get()));
+    auto pub = ssl_parse_peer_subject_public_key_info(
+        Span(CBB_data(spki.get()), CBB_len(spki.get())));
+    ASSERT_TRUE(pub);
+    EXPECT_EQ(t.key_type, EVP_PKEY_id(pub.get()));
+    for (uint16_t version : {TLS1_VERSION, TLS1_1_VERSION, TLS1_2_VERSION,
+                             TLS1_3_VERSION}) {
+      ssl->s3->version = version;
+      for (const auto &candidate : kMLDSATestParams) {
+        for (bool verify : {false, true}) {
+          EXPECT_EQ(version == TLS1_3_VERSION && candidate.sigalg == t.sigalg,
+                    ssl_pkey_supports_algorithm(ssl.get(), pub.get(),
+                                                 candidate.sigalg, verify));
+        }
+      }
+    }
+  }
+}
+
+struct MLDSATamperData {
+  EVP_PKEY *key;
+  uint16_t sigalg;
+  bool called = false;
+};
+
+// Sign the actual CertificateVerify input with the real key, then change one
+// signature byte. The negative handshake must reach cryptographic verification.
+static const SSL_PRIVATE_KEY_METHOD kMLDSATamperMethod = {
+    [](SSL *ssl, uint8_t *out, size_t *out_len, size_t max_out,
+       uint16_t sigalg, const uint8_t *in,
+       size_t in_len) -> ssl_private_key_result_t {
+      auto *data = static_cast<MLDSATamperData *>(
+          SSL_CTX_get_app_data(SSL_get_SSL_CTX(ssl)));
+      ScopedEVP_MD_CTX ctx;
+      *out_len = max_out;
+      if (data == nullptr || sigalg != data->sigalg ||
+          !EVP_DigestSignInit(ctx.get(), nullptr, nullptr, nullptr, data->key) ||
+          !EVP_DigestSign(ctx.get(), out, out_len, in, in_len) || *out_len == 0) {
+        return ssl_private_key_failure;
+      }
+      out[0] ^= 1;
+      data->called = true;
+      return ssl_private_key_success;
+    },
+    nullptr,
+    nullptr,
+};
+
+TEST(SSLTest, MLDSACertificateVerifyAndChain) {
+  for (const auto &t : kMLDSATestParams) {
+    SCOPED_TRACE(t.name);
+    auto root_key = MakeMLDSATestKey(t.algorithm(), 1);
+    auto leaf_key = MakeMLDSATestKey(t.algorithm(), 2);
+    ASSERT_TRUE(root_key);
+    ASSERT_TRUE(leaf_key);
+    auto root = MakeMLDSATestCertificate(root_key.get(), nullptr, root_key.get());
+    ASSERT_TRUE(root);
+    auto leaf =
+        MakeMLDSATestCertificate(leaf_key.get(), root.get(), root_key.get());
+    ASSERT_TRUE(leaf);
+    ASSERT_TRUE(X509_verify(leaf.get(), root_key.get()));
+    EXPECT_EQ(t.key_type, X509_get_signature_nid(leaf.get()));
+
+    UniquePtr<SSL_CTX> client_ctx(SSL_CTX_new(TLS_method()));
+    UniquePtr<SSL_CTX> server_ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(client_ctx);
+    ASSERT_TRUE(server_ctx);
+    for (SSL_CTX *ctx : {client_ctx.get(), server_ctx.get()}) {
+      ASSERT_TRUE(SSL_CTX_set_min_proto_version(ctx, TLS1_3_VERSION));
+      ASSERT_TRUE(SSL_CTX_set_max_proto_version(ctx, TLS1_3_VERSION));
+      SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT,
+                         nullptr);
+      X509_VERIFY_PARAM_set_time_posix(SSL_CTX_get0_param(ctx), kMLDSATestTime);
+      ASSERT_TRUE(X509_STORE_add_cert(SSL_CTX_get_cert_store(ctx), root.get()));
+      ASSERT_TRUE(SSL_CTX_set_signing_algorithm_prefs(ctx, &t.sigalg, 1) && SSL_CTX_set_verify_algorithm_prefs(ctx, &t.sigalg, 1));
+      ASSERT_TRUE(SSL_CTX_use_certificate(ctx, leaf.get()));
+      ASSERT_TRUE(SSL_CTX_use_PrivateKey(ctx, leaf_key.get()));
+    }
+    // Exercise the production wire-list API, not just explicit verifier prefs.
+    ASSERT_TRUE(SSL_CTX_set_client_hello_sigalgs(client_ctx.get(), &t.sigalg, 1));
+    ClientConfig config;
+    config.verify_hostname = "mldsa.example";
+    UniquePtr<SSL> client, server;
+    ASSERT_TRUE(ConnectClientAndServer(&client, &server, client_ctx.get(),
+                                       server_ctx.get(), config));
+    EXPECT_EQ(TLS1_3_VERSION, SSL_version(client.get()));
+    EXPECT_EQ(t.sigalg, SSL_get_peer_signature_algorithm(client.get()));
+    EXPECT_EQ(t.sigalg, SSL_get_peer_signature_algorithm(server.get()));
+    EXPECT_EQ(X509_V_OK, SSL_get_verify_result(client.get()));
+    EXPECT_EQ(X509_V_OK, SSL_get_verify_result(server.get()));
+    UniquePtr<X509> peer(SSL_get_peer_certificate(client.get()));
+    ASSERT_TRUE(peer);
+    ASSERT_NE(nullptr, X509_get0_pubkey(peer.get()));
+    EXPECT_EQ(t.key_type, EVP_PKEY_id(X509_get0_pubkey(peer.get())));
+
+    // Both server and client CertificateVerify signatures must fail closed.
+    for (bool tamper_server : {true, false}) {
+      SCOPED_TRACE(tamper_server);
+      SSL_CTX *signer = tamper_server ? server_ctx.get() : client_ctx.get();
+      MLDSATamperData tamper{leaf_key.get(), t.sigalg};
+      SSL_CTX_set_app_data(signer, &tamper);
+      SSL_CTX_set_private_key_method(signer, &kMLDSATamperMethod);
+      ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx.get(),
+                                        server_ctx.get()));
+      ASSERT_TRUE(SSL_set1_host(client.get(), "mldsa.example"));
+      EXPECT_FALSE(CompleteHandshakes(client.get(), server.get()));
+      EXPECT_TRUE(tamper.called);
+      SSL *verifier = tamper_server ? client.get() : server.get();
+      EXPECT_EQ(X509_V_OK, SSL_get_verify_result(verifier));
+      EXPECT_TRUE(ErrorEquals(ERR_peek_last_error(), ERR_LIB_SSL,
+                               SSL_R_BAD_SIGNATURE));
+      ERR_clear_error();
+      ASSERT_TRUE(SSL_CTX_use_PrivateKey(signer, leaf_key.get()));
+      SSL_CTX_set_app_data(signer, nullptr);
+    }
+
+    // A valid CertificateVerify key must not rescue an invalid issuer signature.
+    UniquePtr<X509> bad_leaf(X509_dup(leaf.get()));
+    ASSERT_TRUE(bad_leaf);
+    const ASN1_BIT_STRING *signature;
+    X509_get0_signature(&signature, nullptr, bad_leaf.get());
+    const uint8_t *bytes = ASN1_STRING_get0_data(signature);
+    ASSERT_EQ(t.signature_len, static_cast<size_t>(ASN1_STRING_length(signature)));
+    std::vector<uint8_t> tampered(bytes, bytes + t.signature_len);
+    tampered[0] ^= 1;
+    ASSERT_TRUE(X509_set1_signature_value(bad_leaf.get(), tampered.data(),
+                                          tampered.size()));
+    ASSERT_TRUE(SSL_CTX_use_certificate(server_ctx.get(), bad_leaf.get()));
+    ASSERT_TRUE(CreateClientAndServer(&client, &server, client_ctx.get(),
+                                      server_ctx.get()));
+    EXPECT_FALSE(CompleteHandshakes(client.get(), server.get()));
+    EXPECT_EQ(X509_V_ERR_CERT_SIGNATURE_FAILURE,
+              SSL_get_verify_result(client.get()));
+    ERR_clear_error();
+  }
 }
 
