+      ASSERT_TRUE(cert);
+      EXPECT_FALSE(X509_verify(cert.get(), key.get()));
+      EXPECT_TRUE(ErrorEquals(ERR_get_error(),
+                               null_parameters ? ERR_LIB_X509 : ERR_LIB_ASN1,
+                               null_parameters ? X509_R_INVALID_PARAMETER
