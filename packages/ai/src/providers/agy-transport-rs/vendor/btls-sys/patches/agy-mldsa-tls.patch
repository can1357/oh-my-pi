+TEST(X509Test, MLDSAAlgorithmIdentifiers) {
+  for (const auto &t : kMLDSAX509TestParams) {
+    SCOPED_TRACE(t.nid);
+    auto key = MakeMLDSAX509TestKey(t.algorithm(), 1);
+    ASSERT_TRUE(key);
+    auto cert = MakeTestCert("Root", "Leaf", key.get(), /*is_ca=*/false);
+    ASSERT_TRUE(cert);
+    ASSERT_TRUE(X509_sign(cert.get(), key.get(), nullptr));
+
+    // Sign an otherwise valid TBSCertificate under deliberately invalid
+    // identifiers. Re-signing matters: a parameter-validation regression must
+    // not pass this test just because changing the identifier broke the signature.
+    const int wrong_nid = t.nid == NID_ML_DSA_44 ? NID_ML_DSA_65 : NID_ML_DSA_44;
+    for (bool null_parameters : {true, false}) {
+      bssl::UniquePtr<X509_ALGOR> alg(X509_ALGOR_new());
+      ASSERT_TRUE(alg);
+      ASSERT_TRUE(X509_ALGOR_set0(
+          alg.get(), OBJ_nid2obj(null_parameters ? t.nid : wrong_nid),
+          null_parameters ? V_ASN1_NULL : V_ASN1_UNDEF, nullptr));
+      ASSERT_TRUE(X509_set1_signature_algo(cert.get(), alg.get()));
+      uint8_t *tbs_bytes = nullptr;
+      int tbs_len = i2d_re_X509_tbs(cert.get(), &tbs_bytes);
+      bssl::UniquePtr<uint8_t> tbs(tbs_bytes);
+      ASSERT_GT(tbs_len, 0);
+      bssl::ScopedEVP_MD_CTX ctx;
+      ASSERT_TRUE(
+          EVP_DigestSignInit(ctx.get(), nullptr, nullptr, nullptr, key.get()));
+      std::vector<uint8_t> signature(t.signature_len);
+      size_t sig_len = signature.size();
+      ASSERT_TRUE(EVP_DigestSign(ctx.get(), signature.data(), &sig_len,
+                                 tbs.get(), tbs_len));
+      ASSERT_EQ(t.signature_len, sig_len);
+      ASSERT_TRUE(
+          X509_set1_signature_value(cert.get(), signature.data(), sig_len));
+      ctx.Reset();
+      ASSERT_TRUE(
+          EVP_DigestVerifyInit(ctx.get(), nullptr, nullptr, nullptr, key.get()));
+      ASSERT_TRUE(EVP_DigestVerify(ctx.get(), signature.data(), sig_len,
+                                   tbs.get(), tbs_len));
