{
	"name": "@oh-my-pi/pi-tui",
	"version": "19.2.1",
	"description": "TSP-first terminal UI: one component tree, rendered natively over the Tern Surface Protocol or as terminal rows",
	"keywords": [
		"cli",
		"terminal",
		"tsp",
		"tui",
		"ui"
	],
	"homepage": "https://omp.sh",
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/tui"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts"
	},
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.{ts,tsx}' '*.ts' && bun run check:types",
		"check:types": "bun check --no-script -p tsconfig.json",
		"lint": "oxlint .",
		"test": "bun test --parallel test/",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.{ts,tsx}' '*.ts'",
		"gen:glyphs": "bun scripts/gen-glyphs.ts",
		"bench": "bun bench/engine.tsx"
	},
	"dependencies": {
		"@oh-my-pi/pi-natives": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:",
		"@oh-my-pi/pi-wire": "catalog:"
	},
	"devDependencies": {
		"kitty-vt-wasm": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.4"
	}
}
