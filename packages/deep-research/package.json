{
	"name": "@pk-nerdsaver-ai/pi-deep-research",
	"version": "16.4.15",
	"description": "Supervisor/researcher deep research agent (TypeScript port of langchain-ai/open_deep_research) built on pi-ai",
	"homepage": "https://github.com/kingkillery/oh-my-pk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kingkillery/oh-my-pk.git",
		"directory": "packages/deep-research"
	},
	"bugs": {
		"url": "https://github.com/kingkillery/oh-my-pk/issues"
	},
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test --parallel"
	},
	"dependencies": {
		"@pk-nerdsaver-ai/pi-ai": "catalog:",
		"@pk-nerdsaver-ai/pi-catalog": "catalog:",
		"handlebars": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"CHANGELOG.md"
	]
}
