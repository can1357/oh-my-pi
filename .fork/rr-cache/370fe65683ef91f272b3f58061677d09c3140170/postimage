import { describe, expect, test } from "bun:test";
import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
import type { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
import type { NativeTaskResult, NativeTaskSpec } from "@oh-my-pi/pi-coding-agent/tools";

import { withNativeTaskSession } from "./helpers/native-task-session";

const TEST_TIMEOUT_MS = 30_000;
const TASK_NAME = "VerifyNativeHost";
const TASK_DESCRIPTION = "Maintain the extension-owned invariant";
const CHECK_FAILURE = "Proof service unavailable for VerifyNativeHost";


function nativeTaskSpec(proof: NativeTaskSpec["proof"], regression: NativeTaskSpec["regression"]): NativeTaskSpec {
	return { name: TASK_NAME, task: TASK_DESCRIPTION, proof, regression };
}

function installParentModel(session: AgentSession) {
	const model = createMockModel({ handler: () => ({ content: ["Parent finished"] }) });
	session.agent.streamFn = model.stream;
	return model;
}

describe("ExtensionContext.task native host dispatch", () => {
	test.serial(
		"returns a real native job before proof settles, attaches by stable name, and never calls the model",
		async () => {
			const gate = Promise.withResolvers<boolean>();
			const proofStarted = Promise.withResolvers<void>();
			const observed: string[] = [];
			let first: NativeTaskResult | undefined;
			let attached: NativeTaskResult | undefined;
			const request = nativeTaskSpec(
				async () => {
					observed.push("proof");
					proofStarted.resolve();
					return gate.promise;
				},
				async () => {
					observed.push("regression");
					return true;
				},
			);
			await withNativeTaskSession(pi => {
				pi.on("session_stop", async (_event, ctx) => {
					first = await ctx.task(request);
					attached = await ctx.task(request);
				});
			}, async nativeSession => {
				const model = installParentModel(nativeSession);
				try {
					await nativeSession.extensionRunner!.emitSessionStop({
						awaiting_async_work: false,
						messages: [],
						turn_id: 0,
						session_id: nativeSession.sessionId,
						stop_hook_active: false,
						signal: new AbortController().signal,
					});
					await proofStarted.promise;
					expect(first?.status).toBe("running");
					expect(first?.jobId).toBeTruthy();
					expect(first?.key).toContain(nativeSession.sessionId);
					expect(attached?.jobId).toBe(first?.jobId);
					expect(nativeSession.getAsyncJobSnapshot()?.running).toHaveLength(1);
					expect(nativeSession.nativeTaskHold?.status).toBe("running");
					expect(observed).toEqual(["proof"]);
					expect(model.calls).toHaveLength(0);
				} finally {
					gate.resolve(true);
				}
			});
		},
		TEST_TIMEOUT_MS,
	);

	test.serial(
		"holds the parent after session_stop and rechecks completion without a second model turn",
		async () => {
			const gate = Promise.withResolvers<boolean>();
			const taskRegistered = Promise.withResolvers<void>();
			const lifecycleCompleted = Promise.withResolvers<void>();
			let agentEndCount = 0;
			const stopStatuses: string[] = [];
			const request = nativeTaskSpec(
				async () => gate.promise,
				async () => true,
			);
			await withNativeTaskSession(pi => {
				pi.on("session_stop", async (_event, ctx) => {
					const result = await ctx.task({ ...request });
					stopStatuses.push(result.status);
					taskRegistered.resolve();
				});
			}, async nativeSession => {
				const model = installParentModel(nativeSession);
				const unsubscribe = nativeSession.subscribe(event => {
					if (event.type === "agent_end") { agentEndCount++; lifecycleCompleted.resolve(); }
			});
			try {
				const promptSettled = nativeSession.prompt("Run the parent once");
				await taskRegistered.promise;
				await promptSettled;
				expect(nativeSession.nativeTaskHold?.status).toBe("running");
				expect(nativeSession.isRunActive).toBe(true);
				expect(agentEndCount).toBe(0);
				gate.resolve(true);
				await lifecycleCompleted.promise;
				expect(agentEndCount).toBe(1);
				expect(stopStatuses).toEqual(["running", "completed"]);
				expect(model.calls).toHaveLength(1);
				expect(nativeSession.nativeTaskHold).toBeUndefined();
			} finally {
				gate.resolve(true);
				unsubscribe();
				await nativeSession.abort();
			}
			});
		},
		TEST_TIMEOUT_MS,
	);

	test.serial(
		"keeps a concrete unavailable proof blocker without regression or automatic respawn",
		async () => {
			let proofCalls = 0;
			let regressionCalls = 0;
			const request = nativeTaskSpec(
				async () => {
					proofCalls++;
					throw new Error(CHECK_FAILURE);
				},
				async () => {
					regressionCalls++;
					return true;
				},
			);
			await withNativeTaskSession(() => {}, async nativeSession => {
				const blocked = Promise.withResolvers<void>();
				const unsubscribe = nativeSession.subscribe(event => {
					if (event.type === "notice" && event.message.includes(CHECK_FAILURE)) blocked.resolve();
			});
			try {
				const running = await nativeSession.extensionRunner!.createContext().task(request);
				await blocked.promise;
				const result = await nativeSession.task({ ...request }, { refresh: false });
				expect(result.status).toBe("blocked");
				expect(result.blocker).toContain(CHECK_FAILURE);
				expect(result.jobId).toBe(running.jobId);
				expect(nativeSession.nativeTaskHold?.status).toBe("blocked");
				expect(regressionCalls).toBe(0);
				expect(proofCalls).toBe(1);
			} finally {
				unsubscribe();
			}
			});
		},
		TEST_TIMEOUT_MS,
	);

	test.serial(
		"lets an extension read a failed task's blocker through ctx.task without starting another worker",
		async () => {
			let proofCalls = 0;
			const request = nativeTaskSpec(
				async () => {
					proofCalls++;
					throw new Error(CHECK_FAILURE);
				},
				async () => true,
			);
			await withNativeTaskSession(() => {}, async nativeSession => {
				const blocked = Promise.withResolvers<void>();
				const unsubscribe = nativeSession.subscribe(event => {
					if (event.type === "notice" && event.message.includes(CHECK_FAILURE)) blocked.resolve();
				});
				try {
					const ctx = nativeSession.extensionRunner!.createContext();
					const running = await ctx.task(request);
					await blocked.promise;
					// The extension-visible receipt: the worker's real failure, read from the recorded task.
					const receipt = await ctx.task({ ...request }, { refresh: false });
					expect(receipt.status).toBe("blocked");
					expect(receipt.blocker).toContain(CHECK_FAILURE);
					expect(receipt.jobId).toBe(running.jobId);
					// Reading it never respawned the worker.
					expect(proofCalls).toBe(1);
				} finally {
					unsubscribe();
				}
			});
		},
		TEST_TIMEOUT_MS,
	);

	test.serial(
		"resumes the parent on native verification failure before allowing completion",
		async () => {
			let regressionCalls = 0;
			let repaired = false;
			let turns = 0;
			let ended = false;
			let endedBeforeRepair: boolean | undefined;
			const request = nativeTaskSpec(
				async () => {
					if (!repaired) throw new Error(CHECK_FAILURE);
					return true;
				},
				async () => {
					regressionCalls++;
					return repaired;
				},
			);
			await withNativeTaskSession(pi => {
				pi.on("session_stop", async (_event, ctx) => {
					if (!repaired) await ctx.task(request);
				});
			}, async nativeSession => {
				const model = createMockModel({
					handler: () => {
						if (++turns === 2) {
							endedBeforeRepair = ended;
							repaired = true;
						}
						return { content: [repaired ? "Repaired" : "Parent finished"] };
					},
			});
			nativeSession.agent.streamFn = model.stream;
			const completed = Promise.withResolvers<void>();
			const unsubscribe = nativeSession.subscribe(event => {
				if (event.type === "agent_end") {
					ended = true;
					completed.resolve();
				}
			});
			try {
				const promptSettled = nativeSession.prompt("Run the parent once");
				await promptSettled;
				await completed.promise;
				expect(endedBeforeRepair).toBe(false);
				expect(model.calls).toHaveLength(2);
				expect(JSON.stringify(model.calls[1])).toContain(CHECK_FAILURE);
				expect(nativeSession.nativeTaskHold).toBeUndefined();
				expect(regressionCalls).toBeGreaterThan(0);
				expect((await nativeSession.task(request, { refresh: false })).status).toBe("completed");
			} finally {
				unsubscribe();
				await nativeSession.abort();
			}
			});
		},
		TEST_TIMEOUT_MS,
	);

	test.serial("reports a missing native task tool instead of invoking a replacement or model", async () => {
		await withNativeTaskSession(() => {}, async nativeSession => {
			const model = installParentModel(nativeSession);
			const result = await nativeSession.extensionRunner!.createContext().task(nativeTaskSpec(
				async () => true, async () => true,
			));
			expect(result.status).toBe("blocked");
			expect(result.blocker).toContain(`Native task tool unavailable for ${TASK_NAME}`);
			expect(nativeSession.nativeTaskHold?.status).toBe("blocked");
			expect(model.calls).toHaveLength(0);
		}, ["read"]);
	}, TEST_TIMEOUT_MS);
});
